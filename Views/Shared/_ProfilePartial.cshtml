@*
    Shared Profile partial — rendered by each area's Profile/Index.cshtml
    Data is fetched via AJAX from /api/ProfileApi/me
    Updates are POSTed to /api/ProfileApi/update
*@

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />

<div class="container-fluid px-4 py-3">

    <!-- ===== Page Hero ===== -->
    <div class="prof-hero">
        <div class="prof-hero-bg"></div>
        <div class="prof-hero-content">
            <div class="prof-hero-avatar-wrap">
                <div class="prof-hero-avatar" id="heroAvatar">
                    <span id="heroInitials">--</span>
                    <img id="heroImg" src="" alt="Profile" style="display:none" />
                </div>
                <label class="prof-hero-avatar-edit" id="avatarEditLabel" title="Change photo" style="display:none">
                    <i class="fas fa-camera"></i>
                    <input type="file" accept="image/*" id="avatarInput" style="display:none" />
                </label>
            </div>
            <div class="prof-hero-info">
                <h1 class="prof-hero-name" id="heroName">Loading...</h1>
                <div class="prof-hero-meta">
                    <span class="prof-hero-badge" id="heroBadge"><i class="fas fa-id-badge"></i> <span id="heroRole">--</span></span>
                    <span class="prof-hero-email"><i class="fas fa-envelope"></i> <span id="heroEmail">--</span></span>
                    <span class="prof-hero-emp-no"><i class="fas fa-hashtag"></i> <span id="heroEmpNo">--</span></span>
                    <div id="externalLogins" style="margin-left:.6rem;display:inline-block">
                        <!-- External login status will be inserted here -->
                    </div>
                    <div id="mfaStatus" style="margin-left:.6rem;display:inline-block">
                        <!-- MFA status will be inserted here -->
                    </div>
                </div>
            </div>
            <div class="prof-hero-actions">
                <button type="button" class="prof-btn prof-btn-edit shadow-sm" id="editToggleBtn">
                    <i class="bi bi-pencil-square"></i> <span>Edit Profile</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ===== Alert ===== -->
    <div class="prof-alert prof-alert-success" id="profAlert" style="display:none">
        <div class="prof-alert-icon"><i class="fas fa-check-circle"></i></div>
        <span id="profAlertText"></span>
        <button class="prof-alert-close" onclick="this.parentElement.style.display='none'" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
    <div class="prof-alert prof-alert-error" id="profAlertError" style="display:none">
        <div class="prof-alert-icon"><i class="fas fa-exclamation-circle"></i></div>
        <span id="profAlertErrorText"></span>
        <button class="prof-alert-close" onclick="this.parentElement.style.display='none'" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>

    <!-- ===== VIEW MODE ===== -->
    <div id="viewMode">
        <div class="row g-3">
            <!-- Personal Info -->
            <div class="col-lg-6">
                <div class="prof-card">
                    <div class="prof-card-header">
                        <i class="fas fa-user"></i> Personal Information
                    </div>
                    <div class="prof-card-body">
                        <div class="prof-info-grid">
                            <div class="prof-info-item">
                                <span class="prof-info-label">First Name</span>
                                <span class="prof-info-value" id="vFirstName">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">Middle Name</span>
                                <span class="prof-info-value" id="vMiddleName">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">Last Name</span>
                                <span class="prof-info-value" id="vLastName">--</span>
                            </div>
                            <div class="prof-info-item" id="vContactRow">
                                <span class="prof-info-label">Contact</span>
                                <span class="prof-info-value" id="vContact">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">Email</span>
                                <span class="prof-info-value" id="vEmail">--</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Organization -->
            <div class="col-lg-6">
                <div class="prof-card">
                    <div class="prof-card-header">
                        <i class="fas fa-building"></i> Organization
                    </div>
                    <div class="prof-card-body">
                        <div class="prof-info-grid">
                            <div class="prof-info-item">
                                <span class="prof-info-label">Employee Number</span>
                                <span class="prof-info-value" id="vEmpNo">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">Department</span>
                                <span class="prof-info-value" id="vDepartment">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">Position</span>
                                <span class="prof-info-value" id="vPosition">--</span>
                            </div>
                            <div class="prof-info-item" id="vDateHiredRow">
                                <span class="prof-info-label">Date Hired</span>
                                <span class="prof-info-value" id="vDateHired">--</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Address -->
            <div class="col-12">
                <div class="prof-card">
                    <div class="prof-card-header">
                        <i class="fas fa-map-marker-alt"></i> Address
                    </div>
                    <div class="prof-card-body">
                        <div class="prof-info-grid prof-info-grid-5">
                            <div class="prof-info-item">
                                <span class="prof-info-label">Region</span>
                                <span class="prof-info-value" id="vRegion">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">Province</span>
                                <span class="prof-info-value" id="vProvince">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">City / Municipality</span>
                                <span class="prof-info-value" id="vCity">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">Barangay</span>
                                <span class="prof-info-value" id="vBarangay">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">Street / Address</span>
                                <span class="prof-info-value" id="vAddressLine">--</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== EDIT MODE ===== -->
    <div id="editMode" style="display:none">
        <div class="row g-3">
            <!-- Personal Info Edit -->
            <div class="col-lg-6">
                <div class="prof-card">
                    <div class="prof-card-header">
                        <i class="fas fa-user-pen"></i> Personal Information
                    </div>
                    <div class="prof-card-body">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="prof-form-label">First Name <span class="text-danger">*</span></label>
                                <input type="text" class="prof-form-input" id="eFirstName" required />
                            </div>
                            <div class="col-sm-6">
                                <label class="prof-form-label">Middle Name</label>
                                <input type="text" class="prof-form-input" id="eMiddleName" />
                            </div>
                            <div class="col-sm-6">
                                <label class="prof-form-label">Last Name <span class="text-danger">*</span></label>
                                <input type="text" class="prof-form-input" id="eLastName" required />
                            </div>
                            <div class="col-sm-6" id="eContactRow">
                                <label class="prof-form-label">Contact Number</label>
                                <input type="text" class="prof-form-input" id="eContact" placeholder="e.g. 09171234567" />
                            </div>
                            <div class="col-sm-12">
                                <label class="prof-form-label">Email</label>
                                <input type="email" class="prof-form-input" id="eEmail" />
                                <div id="eEmailError" class="text-danger" style="display:none;margin-top:.25rem;font-size:.9rem"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Password & Photo -->
            <div class="col-lg-6">
                <div class="prof-card">
                    <div class="prof-card-header">
                        <i class="fas fa-lock"></i> Change Password
                    </div>
                    <div class="prof-card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="prof-form-label">Current Password</label>
                                <div class="prof-password-wrap">
                                    <input type="password" class="prof-form-input" id="eCurrentPassword" placeholder="Enter current password" autocomplete="current-password" />
                                    <button type="button" class="prof-pw-toggle" tabindex="-1"><i class="fas fa-eye"></i></button>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="prof-form-label">New Password</label>
                                <div class="prof-password-wrap">
                                    <input type="password" class="prof-form-input" id="eNewPassword" placeholder="Enter new password" autocomplete="new-password" />
                                    <button type="button" class="prof-pw-toggle" tabindex="-1"><i class="fas fa-eye"></i></button>
                                </div>
                                <small class="text-muted" style="font-size:.78rem">Leave blank to keep current password</small>
                            </div>
                        </div>
                    </div>
                </div>

                @* <div class="prof-card mt-3">
                    <div class="prof-card-header">
                        <i class="fas fa-camera"></i> Profile Picture
                    </div>
                    <div class="prof-card-body">
                        <div class="prof-img-upload">
                            <div class="prof-img-preview-wrap" id="editImgWrap">
                                <div class="prof-img-placeholder" id="editImgPlaceholder"><i class="fas fa-user"></i></div>
                                <img id="editImgPreview" src="" alt="" class="prof-img-preview" style="display:none" />
                            </div>
                            <div>
                                <input type="file" accept="image/*" id="editImageInput" class="prof-form-input" style="max-width:250px;font-size:.85rem" />
                                <small class="text-muted d-block" style="font-size:.78rem">JPG, PNG or GIF. Max 5MB.</small>
                            </div>
                        </div>
                    </div>
                </div> *@
            </div>

            <!-- Address Edit with PSGC -->
            <div class="col-12">
                <div class="prof-card">
                    <div class="prof-card-header">
                        <i class="fas fa-map-marker-alt"></i> Address
                    </div>
                    <div class="prof-card-body">
                        <div class="row g-3">
                            <div class="col-md-6 col-lg-3">
                                <label class="prof-form-label">Region</label>
                                <select id="psgcRegion" class="prof-form-select"></select>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <label class="prof-form-label">Province</label>
                                <select id="psgcProvince" class="prof-form-select"></select>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <label class="prof-form-label">City / Municipality</label>
                                <select id="psgcCity" class="prof-form-select"></select>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <label class="prof-form-label">Barangay</label>
                                <select id="psgcBarangay" class="prof-form-select"></select>
                            </div>
                            <div class="col-12">
                                <label class="prof-form-label">Street / Address Line</label>
                                <input type="text" class="prof-form-input" id="eAddressLine" placeholder="House number, street, subdivision" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action buttons -->
            <div class="col-12">
                <div class="prof-edit-actions">
                    <button type="button" class="prof-btn prof-btn-cancel" id="cancelEditBtn">
                        Cancel
                    </button>
                    <button type="button" class="prof-btn prof-btn-save" id="saveProfileBtn">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MFA Modal -->
<div id="mfaModal" class="prof-modal-overlay" style="display:none;"> 
    <div class="prof-modal-card">
        <div class="prof-modal-header">
            <h5 class="mb-0 fw-bold"><i class="bi bi-shield-lock-fill me-2 text-primary"></i>Setup Authenticator App</h5>
            <button class="btn-close" id="closeMfaModalTop"></button>
        </div>
        <div class="prof-modal-body">
            <p class="text-secondary small mb-4">Scan this QR code with your authenticator app (like Google Authenticator or Microsoft Authenticator) to enable 2FA.</p>
            <div class="mfa-qr-container mb-4">
                <img id="mfaQr" src="" alt="QR" />
            </div>
            <div class="mb-4">
                <label class="prof-form-label text-muted small text-uppercase">Manual Entry Key</label>
                <div class="mfa-key-box">
                    <code id="mfaSharedKey"></code>
                </div>
            </div>
            <div class="d-flex gap-2 mb-4">
                <input id="mfaCode" placeholder="Enter 6-digit code" class="prof-form-input text-center fw-bold letter-spacing-1" maxlength="6" />
                <button id="verifyMfaBtn" class="prof-btn prof-btn-save px-4">Verify</button>
            </div>
            <div id="mfaRecovery" style="display:none;" class="mt-2 pt-3 border-top">
                <div class="alert alert-warning py-2 mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <span class="small fw-bold">Save these recovery codes!</span>
                </div>
                <pre id="mfaRecoveryCodes" class="mfa-recovery-box"></pre>
                <div class="d-flex gap-2 mt-3">
                    <button id="copyRecoveryBtn" class="prof-btn prof-btn-outline flex-grow-1 small py-2"><i class="bi bi-clipboard me-1"></i>Copy</button>
                    <button id="downloadRecoveryBtn" class="prof-btn prof-btn-outline flex-grow-1 small py-2"><i class="bi bi-download me-1"></i>Save</button>
                    <button id="printRecoveryBtn" class="prof-btn prof-btn-outline flex-grow-1 small py-2"><i class="bi bi-printer me-1"></i>Print</button>
                </div>
            </div>
        </div>
        <div class="prof-modal-footer">
            <button id="closeMfaModal" class="prof-btn prof-btn-cancel w-100">Close</button>
        </div>
    </div>
</div>

<!-- Premium Confirmation Modal -->
<div id="confirmModal" class="prof-modal-overlay" style="display:none;">
    <div class="prof-modal-card prof-modal-sm">
        <div class="prof-modal-body text-center py-4">
            <div class="confirm-icon-circle mb-3" id="confirmIcon">
                <i class="bi bi-question-lg"></i>
            </div>
            <h5 class="fw-bold mb-2" id="confirmTitle">Confirm Action</h5>
            <p class="text-secondary small mb-0" id="confirmText">Are you sure you want to proceed?</p>
        </div>
        <div class="prof-modal-footer d-flex gap-2">
            <button id="confirmCancelBtn" class="prof-btn prof-btn-cancel flex-grow-1">Cancel</button>
            <button id="confirmActionBtn" class="prof-btn prof-btn-save flex-grow-1" id="confirmBtnColor">Confirm</button>
        </div>
    </div>
</div>

<style>
    .prof-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(8px);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        animation: fadeIn 0.2s ease-out;
    }
    .prof-modal-card {
        background: #fff;
        border-radius: 20px;
        width: 100%;
        max-width: 480px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        overflow: hidden;
        animation: zoomIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .prof-modal-sm { max-width: 360px; }
    .prof-modal-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .prof-modal-body { padding: 1.5rem; }
    .prof-modal-footer { padding: 1.25rem 1.5rem; background: #f8fafc; border-top: 1px solid #f1f5f9; }
    
    .mfa-qr-container {
        background: #fff;
        padding: 1rem;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        display: inline-block;
        margin: 0 auto;
        display: flex;
        justify-content: center;
    }
    .mfa-qr-container img { width: 180px; height: 180px; }
    .mfa-key-box {
        background: #f1f5f9;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-family: 'JetBrains Mono', 'Courier New', monospace;
        font-size: 0.95rem;
        color: #0f172a;
        text-align: center;
        letter-spacing: 1px;
    }
    .mfa-recovery-box {
        background: #1e293b;
        color: #e2e8f0;
        padding: 1rem;
        border-radius: 10px;
        font-family: monospace;
        font-size: 0.85rem;
        white-space: pre-wrap;
        max-height: 120px;
        overflow-y: auto;
        text-align: center;
    }
    .letter-spacing-1 { letter-spacing: 4px; }
    
    .confirm-icon-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(0, 105, 148, 0.1);
        color: #006994;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        margin: 0 auto;
    }
    .confirm-icon-danger {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
    }
    
    .prof-google-btn {
        background: #fff;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-weight: 600;
        transition: all 0.2s;
    }
    .prof-google-btn:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
        transform: translateY(-1px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes zoomIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
</style>

<script src="~/js/psgc.js" asp-append-version="true"></script>
<script src="~/js/profile.js" asp-append-version="true"></script>
<script>
    (function () {
        // --- Premium Confirmation Utility ---
        function profConfirm(options) {
            const modal = document.getElementById('confirmModal');
            const icon = document.getElementById('confirmIcon');
            const title = document.getElementById('confirmTitle');
            const text = document.getElementById('confirmText');
            const cancelBtn = document.getElementById('confirmCancelBtn');
            const actionBtn = document.getElementById('confirmActionBtn');

            title.textContent = options.title || 'Are you sure?';
            text.textContent = options.text || '';
            actionBtn.textContent = options.confirmText || 'Confirm';
            
            if (options.isDanger) {
                icon.className = 'confirm-icon-circle confirm-icon-danger';
                icon.innerHTML = '<i class="bi bi-exclamation-triangle"></i>';
                actionBtn.className = 'prof-btn btn-danger flex-grow-1';
                actionBtn.style.background = '#ef4444';
            } else {
                icon.className = 'confirm-icon-circle';
                icon.innerHTML = '<i class="bi bi-question-lg"></i>';
                actionBtn.className = 'prof-btn prof-btn-save flex-grow-1';
                actionBtn.style.background = '';
            }

            modal.style.display = 'flex';

            return new Promise((resolve) => {
                const cleanup = (val) => {
                    modal.style.display = 'none';
                    actionBtn.onclick = null;
                    cancelBtn.onclick = null;
                    resolve(val);
                };
                actionBtn.onclick = () => cleanup(true);
                cancelBtn.onclick = () => cleanup(false);
            });
        }

        // Render link/unlink buttons and wire actions
        function updateExternalButtons(logins) {
            var container = document.getElementById('externalLogins');
            if (!container) return;
            container.innerHTML = '';

            var hasGoogle = logins && logins.some(function (l) { return l.loginProvider === 'Google'; });

            if (hasGoogle) {
                var btn = document.createElement('button');
                btn.className = 'prof-btn prof-google-btn shadow-sm';
                btn.innerHTML = '<i class="bi bi-google me-2" style="color:#db4437;"></i> Unlink Google';
                btn.onclick = async function () {
                    if (await profConfirm({
                        title: 'Unlink Google Account',
                        text: 'Are you sure you want to unlink your Google account? You will no longer be able to sign in using Google.',
                        confirmText: 'Unlink',
                        isDanger: true
                    })) {
                        btn.disabled = true;
                        fetch('/api/ProfileApi/unlink-external?provider=Google', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                            .then(r => r.json()).then(j => {
                                if (j.success) {
                                    location.reload();
                                } else {
                                    alert(j.message || 'Failed to unlink Google');
                                    btn.disabled = false;
                                }
                            }).catch(e => { alert('Error unlinking provider'); btn.disabled = false; });
                    }
                };
                container.appendChild(btn);
            } else {
                var linkBtn = document.createElement('button');
                linkBtn.className = 'prof-btn prof-google-btn shadow-sm';
                linkBtn.innerHTML = '<i class="bi bi-google me-2" style="color:#db4437;"></i> Link Google';
                linkBtn.onclick = async function () {
                    if (await profConfirm({
                        title: 'Link Google Account',
                        text: 'You will be redirected to Google to authorize the link. This allows you to sign in with your Google account.',
                        confirmText: 'Link Account'
                    })) {
                        window.location = '/api/ProfileApi/external-link?provider=Google';
                    }
                };
                container.appendChild(linkBtn);
            }
        }

        // Fetch current external logins for the user and render buttons
        fetch('/api/ProfileApi/me', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(function (data) {
                // Render MFA status toggle
                try {
                    var mfaContainer = document.getElementById('mfaStatus');
                    if (mfaContainer) {
                        mfaContainer.innerHTML = '';
                        var enabled = !!data.twoFactorEnabled;
                        var mfaBtn = document.createElement('button');
                        mfaBtn.className = 'prof-btn prof-btn-outline shadow-sm';
                        mfaBtn.innerHTML = enabled ? '<i class="bi bi-shield-slash me-2"></i> Disable MFA' : '<i class="bi bi-shield-check me-2"></i> Enable MFA';
                        mfaBtn.onclick = async function () {
                            if (!enabled) {
                                if (await profConfirm({
                                    title: 'Enable Two-Factor Authentication',
                                    text: 'Strengthen your account security by adding a second layer of verification.',
                                    confirmText: 'Start Setup'
                                })) {
                                    mfaBtn.disabled = true;
                                    // Start enrollment flow (get QR + key)
                                    fetch('/api/ProfileApi/mfa/enroll', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                                        .then(r => r.json()).then(j => {
                                            if (!j) { alert('Failed to start enrollment'); mfaBtn.disabled = false; return; }
                                            document.getElementById('mfaQr').src = j.qrDataUrl || j.qrUrl || '';
                                            document.getElementById('mfaSharedKey').textContent = j.sharedKey || '';
                                            document.getElementById('mfaCode').value = '';
                                            document.getElementById('mfaRecovery').style.display = 'none';
                                            document.getElementById('mfaModal').style.display = 'flex';

                                            var verifyBtn = document.getElementById('verifyMfaBtn');
                                            verifyBtn.disabled = false;
                                            verifyBtn.onclick = function () {
                                                var code = (document.getElementById('mfaCode').value || '').trim();
                                                if (!code) { alert('Enter the 6-digit code'); return; }
                                                verifyBtn.disabled = true;
                                                fetch('/api/ProfileApi/mfa/verify', {
                                                    method: 'POST',
                                                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                                                    body: JSON.stringify({ code: code })
                                                }).then(r => r.json()).then(resp => {
                                                    if (resp && resp.success) {
                                                        if (resp.recoveryCodes) {
                                                            var codes = resp.recoveryCodes.join('\n');
                                                            document.getElementById('mfaRecoveryCodes').textContent = codes;
                                                            document.getElementById('mfaRecovery').style.display = 'block';

                                                            var copyBtn = document.getElementById('copyRecoveryBtn');
                                                            var dlBtn = document.getElementById('downloadRecoveryBtn');
                                                            var prBtn = document.getElementById('printRecoveryBtn');
                                                            [copyBtn, dlBtn, prBtn].forEach(function (b) { b.style.display = 'inline-block'; b.disabled = false; });

                                                            copyBtn.onclick = function () {
                                                                navigator.clipboard?.writeText(codes).then(function () {
                                                                    copyBtn.innerHTML = '<i class="bi bi-check2 me-1"></i>Copied';
                                                                    setTimeout(() => copyBtn.innerHTML = '<i class="bi bi-clipboard me-1"></i>Copy', 2000);
                                                                }).catch(function () { alert('Copy failed'); });
                                                            };

                                                            dlBtn.onclick = function () {
                                                                var blob = new Blob([codes], { type: 'text/plain;charset=utf-8' });
                                                                var url = URL.createObjectURL(blob);
                                                                var a = document.createElement('a');
                                                                a.href = url;
                                                                a.download = 'recovery-codes.txt';
                                                                document.body.appendChild(a);
                                                                a.click();
                                                                a.remove();
                                                                URL.revokeObjectURL(url);
                                                            };

                                                            prBtn.onclick = function () {
                                                                var w = window.open('', '_blank');
                                                                if (!w) { alert('Popup blocked - allow popups to print'); return; }
                                                                w.document.write('<pre style="font-family:monospace;white-space:pre-wrap">' + codes.replace(/</g,'&lt;') + '</pre>');
                                                                w.document.close();
                                                                w.focus();
                                                                w.print();
                                                            };

                                                            document.getElementById('closeMfaModal').onclick = function () { document.getElementById('mfaModal').style.display = 'none'; location.reload(); mfaBtn.disabled = false; };
                                                        }
                                                    } else {
                                                        alert(resp?.message || 'Verification failed');
                                                        verifyBtn.disabled = false;
                                                    }
                                                }).catch(() => { alert('Error verifying code'); verifyBtn.disabled = false; });
                                            };

                                            document.getElementById('closeMfaModal').onclick = function () { document.getElementById('mfaModal').style.display = 'none'; mfaBtn.disabled = false; };
                                            document.getElementById('closeMfaModalTop').onclick = function () { document.getElementById('mfaModal').style.display = 'none'; mfaBtn.disabled = false; };
                                        }).catch(() => { alert('Error starting enrollment'); mfaBtn.disabled = false; });
                                }
                            } else {
                                if (await profConfirm({
                                    title: 'Disable Two-Factor Authentication',
                                    text: 'Removing this second layer of security will make your account more vulnerable. Are you sure?',
                                    confirmText: 'Disable MFA',
                                    isDanger: true
                                })) {
                                    mfaBtn.disabled = true;
                                    fetch('/api/ProfileApi/mfa', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                                        body: JSON.stringify({ enabled: false })
                                    }).then(r => r.json()).then(j => {
                                        if (j && j.success) {
                                            location.reload();
                                        } else {
                                            alert('Failed to update MFA');
                                            mfaBtn.disabled = false;
                                        }
                                    }).catch(() => { alert('Error updating MFA'); mfaBtn.disabled = false; });
                                }
                            }
                        };
                        mfaContainer.appendChild(mfaBtn);
                    }
                } catch (e) { console.error(e); }

                fetch('/api/ProfileApi/logins', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(r => r.json()).then(j => {
                        if (j && Array.isArray(j)) updateExternalButtons(j);
                        else updateExternalButtons([]);
                    }).catch(() => updateExternalButtons([]));
            }).catch(() => updateExternalButtons([]));
    })();
</script>
