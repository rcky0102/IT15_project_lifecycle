@*
    Shared Profile partial — rendered by each area's Profile/Index.cshtml
    Data is fetched via AJAX from /api/ProfileApi/me
    Updates are POSTed to /api/ProfileApi/update
*@

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />

<div class="container-fluid px-4 py-3">

    <!-- ===== Page Hero ===== -->
    <div class="prof-hero">
        <div class="prof-hero-bg"></div>
        <div class="prof-hero-content">
            <div class="prof-hero-avatar-wrap">
                <div class="prof-hero-avatar" id="heroAvatar">
                    <span id="heroInitials">--</span>
                    <img id="heroImg" src="" alt="Profile" style="display:none" />
                </div>
                <label class="prof-hero-avatar-edit" id="avatarEditLabel" title="Change photo" style="display:none">
                    <i class="fas fa-camera"></i>
                    <input type="file" accept="image/*" id="avatarInput" style="display:none" />
                </label>
            </div>
            <div class="prof-hero-info">
                <h1 class="prof-hero-name" id="heroName">Loading...</h1>
                <div class="prof-hero-meta">
                    <span class="prof-hero-badge" id="heroBadge"><i class="fas fa-id-badge"></i> <span id="heroRole">--</span></span>
                    <span class="prof-hero-email"><i class="fas fa-envelope"></i> <span id="heroEmail">--</span></span>
                    <span class="prof-hero-emp-no"><i class="fas fa-hashtag"></i> <span id="heroEmpNo">--</span></span>
                </div>
            </div>
            <div class="prof-hero-actions">
                <button type="button" class="prof-btn prof-btn-edit" id="editToggleBtn">
                    <i class="fas fa-pen"></i> <span>Edit Profile</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ===== Alert ===== -->
    <div class="prof-alert prof-alert-success" id="profAlert" style="display:none">
        <div class="prof-alert-icon"><i class="fas fa-check-circle"></i></div>
        <span id="profAlertText"></span>
        <button class="prof-alert-close" onclick="this.parentElement.style.display='none'" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
    <div class="prof-alert prof-alert-error" id="profAlertError" style="display:none">
        <div class="prof-alert-icon"><i class="fas fa-exclamation-circle"></i></div>
        <span id="profAlertErrorText"></span>
        <button class="prof-alert-close" onclick="this.parentElement.style.display='none'" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>

    <!-- ===== VIEW MODE ===== -->
    <div id="viewMode">
        <div class="row g-3">
            <!-- Personal Info -->
            <div class="col-lg-6">
                <div class="prof-card">
                    <div class="prof-card-header">
                        <i class="fas fa-user"></i> Personal Information
                    </div>
                    <div class="prof-card-body">
                        <div class="prof-info-grid">
                            <div class="prof-info-item">
                                <span class="prof-info-label">First Name</span>
                                <span class="prof-info-value" id="vFirstName">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">Middle Name</span>
                                <span class="prof-info-value" id="vMiddleName">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">Last Name</span>
                                <span class="prof-info-value" id="vLastName">--</span>
                            </div>
                            <div class="prof-info-item" id="vContactRow">
                                <span class="prof-info-label">Contact</span>
                                <span class="prof-info-value" id="vContact">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">Email</span>
                                <span class="prof-info-value" id="vEmail">--</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Organization -->
            <div class="col-lg-6">
                <div class="prof-card">
                    <div class="prof-card-header">
                        <i class="fas fa-building"></i> Organization
                    </div>
                    <div class="prof-card-body">
                        <div class="prof-info-grid">
                            <div class="prof-info-item">
                                <span class="prof-info-label">Employee Number</span>
                                <span class="prof-info-value" id="vEmpNo">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">Department</span>
                                <span class="prof-info-value" id="vDepartment">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">Position</span>
                                <span class="prof-info-value" id="vPosition">--</span>
                            </div>
                            <div class="prof-info-item" id="vDateHiredRow">
                                <span class="prof-info-label">Date Hired</span>
                                <span class="prof-info-value" id="vDateHired">--</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Address -->
            <div class="col-12">
                <div class="prof-card">
                    <div class="prof-card-header">
                        <i class="fas fa-map-marker-alt"></i> Address
                    </div>
                    <div class="prof-card-body">
                        <div class="prof-info-grid prof-info-grid-5">
                            <div class="prof-info-item">
                                <span class="prof-info-label">Region</span>
                                <span class="prof-info-value" id="vRegion">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">Province</span>
                                <span class="prof-info-value" id="vProvince">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">City / Municipality</span>
                                <span class="prof-info-value" id="vCity">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">Barangay</span>
                                <span class="prof-info-value" id="vBarangay">--</span>
                            </div>
                            <div class="prof-info-item">
                                <span class="prof-info-label">Street / Address</span>
                                <span class="prof-info-value" id="vAddressLine">--</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== EDIT MODE ===== -->
    <div id="editMode" style="display:none">
        <div class="row g-3">
            <!-- Personal Info Edit -->
            <div class="col-lg-6">
                <div class="prof-card">
                    <div class="prof-card-header">
                        <i class="fas fa-user-pen"></i> Personal Information
                    </div>
                    <div class="prof-card-body">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="prof-form-label">First Name <span class="text-danger">*</span></label>
                                <input type="text" class="prof-form-input" id="eFirstName" required />
                            </div>
                            <div class="col-sm-6">
                                <label class="prof-form-label">Middle Name</label>
                                <input type="text" class="prof-form-input" id="eMiddleName" />
                            </div>
                            <div class="col-sm-6">
                                <label class="prof-form-label">Last Name <span class="text-danger">*</span></label>
                                <input type="text" class="prof-form-input" id="eLastName" required />
                            </div>
                            <div class="col-sm-6" id="eContactRow">
                                <label class="prof-form-label">Contact Number</label>
                                <input type="text" class="prof-form-input" id="eContact" placeholder="e.g. 09171234567" />
                            </div>
                            <div class="col-sm-12">
                                <label class="prof-form-label">Email</label>
                                <input type="email" class="prof-form-input" id="eEmail" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Password & Photo -->
            <div class="col-lg-6">
                <div class="prof-card">
                    <div class="prof-card-header">
                        <i class="fas fa-lock"></i> Change Password
                    </div>
                    <div class="prof-card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="prof-form-label">Current Password</label>
                                <div class="prof-password-wrap">
                                    <input type="password" class="prof-form-input" id="eCurrentPassword" placeholder="Enter current password" autocomplete="current-password" />
                                    <button type="button" class="prof-pw-toggle" tabindex="-1"><i class="fas fa-eye"></i></button>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="prof-form-label">New Password</label>
                                <div class="prof-password-wrap">
                                    <input type="password" class="prof-form-input" id="eNewPassword" placeholder="Enter new password" autocomplete="new-password" />
                                    <button type="button" class="prof-pw-toggle" tabindex="-1"><i class="fas fa-eye"></i></button>
                                </div>
                                <small class="text-muted" style="font-size:.78rem">Leave blank to keep current password</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="prof-card mt-3">
                    <div class="prof-card-header">
                        <i class="fas fa-camera"></i> Profile Picture
                    </div>
                    <div class="prof-card-body">
                        <div class="prof-img-upload">
                            <div class="prof-img-preview-wrap" id="editImgWrap">
                                <div class="prof-img-placeholder" id="editImgPlaceholder"><i class="fas fa-user"></i></div>
                                <img id="editImgPreview" src="" alt="" class="prof-img-preview" style="display:none" />
                            </div>
                            <div>
                                <input type="file" accept="image/*" id="editImageInput" class="prof-form-input" style="max-width:250px;font-size:.85rem" />
                                <small class="text-muted d-block" style="font-size:.78rem">JPG, PNG or GIF. Max 5MB.</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Address Edit with PSGC -->
            <div class="col-12">
                <div class="prof-card">
                    <div class="prof-card-header">
                        <i class="fas fa-map-marker-alt"></i> Address
                    </div>
                    <div class="prof-card-body">
                        <div class="row g-3">
                            <div class="col-md-6 col-lg-3">
                                <label class="prof-form-label">Region</label>
                                <select id="psgcRegion" class="prof-form-select"></select>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <label class="prof-form-label">Province</label>
                                <select id="psgcProvince" class="prof-form-select"></select>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <label class="prof-form-label">City / Municipality</label>
                                <select id="psgcCity" class="prof-form-select"></select>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <label class="prof-form-label">Barangay</label>
                                <select id="psgcBarangay" class="prof-form-select"></select>
                            </div>
                            <div class="col-12">
                                <label class="prof-form-label">Street / Address Line</label>
                                <input type="text" class="prof-form-input" id="eAddressLine" placeholder="House number, street, subdivision" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action buttons -->
            <div class="col-12">
                <div class="prof-edit-actions">
                    <button type="button" class="prof-btn prof-btn-save" id="saveProfileBtn">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                    <button type="button" class="prof-btn prof-btn-cancel" id="cancelEditBtn">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/psgc.js" asp-append-version="true"></script>
<script src="~/js/profile.js" asp-append-version="true"></script>
