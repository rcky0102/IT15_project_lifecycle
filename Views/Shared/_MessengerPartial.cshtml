<meta name="current-user-id" content="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />

<div class="messenger-container">

    <!-- ========== SIDEBAR ========== -->
    <div class="messenger-sidebar" id="messengerSidebar">
        <div class="messenger-sidebar-header">
            <h2><i class="fas fa-comment-dots" style="color:#0866ff;margin-right:8px;"></i>Chats</h2>
            <div class="messenger-search">
                <i class="fas fa-search"></i>
                <input type="text" id="messengerSearch" placeholder="Search conversations..." autocomplete="off" />
            </div>
            <div class="messenger-tabs">
                <button class="messenger-tab-btn active" id="tabChats">
                    <i class="fas fa-comments"></i> Chats
                </button>
                <button class="messenger-tab-btn" id="tabPeople">
                    <i class="fas fa-user-plus"></i> People
                </button>
                <button class="messenger-tab-btn" id="tabNewGroup" title="Create Group Chat">
                    <i class="fas fa-users"></i> Group
                </button>
            </div>
        </div>

        <!-- Conversation list -->
        <div class="messenger-conv-list" id="convList">
            <div class="messenger-loading">
                <div class="spinner"></div>
            </div>
        </div>

        <!-- People list -->
        <div class="messenger-people-list" id="peopleList">
            <div class="messenger-loading">
                <div class="spinner"></div>
            </div>
        </div>

        <!-- Group creation panel -->
        <div class="messenger-group-panel" id="groupPanel" style="display:none;">
            <div class="group-panel-section">
                <label class="group-panel-label">Group Name</label>
                <input type="text" id="groupNameInput" class="group-panel-input" placeholder="Enter group name..." maxlength="100" autocomplete="off" />
            </div>
            <div class="group-panel-section">
                <label class="group-panel-label">Add Members</label>
                <div class="group-panel-search">
                    <i class="fas fa-search"></i>
                    <input type="text" id="groupMemberSearch" placeholder="Search people..." autocomplete="off" />
                </div>
            </div>
            <div class="group-selected-members" id="groupSelectedMembers">
                <!-- Selected member chips appear here -->
            </div>
            <div class="group-members-list" id="groupMembersList">
                <div class="messenger-loading"><div class="spinner"></div></div>
            </div>
            <div class="group-panel-footer">
                <span class="group-member-count" id="groupMemberCount">0 members selected</span>
                <button class="group-create-btn" id="groupCreateBtn" disabled>
                    <i class="fas fa-plus-circle"></i> Create Group
                </button>
            </div>
        </div>
    </div>

    <!-- ========== CHAT AREA ========== -->
    <div class="messenger-chat" id="chatArea">

        <!-- Placeholder (no chat selected) -->
        <div class="messenger-placeholder" id="chatPlaceholder">
            <i class="fab fa-facebook-messenger"></i>
            <h3>Your Messages</h3>
            <p>Select a conversation or start a new one</p>
        </div>

        <!-- Active chat (hidden initially) -->
        <div id="chatActive" style="display:none; flex-direction:column; flex:1; min-height:0;">

            <!-- Chat Header -->
            <div class="messenger-chat-header">
                <button class="back-btn" id="chatBackBtn" title="Back">
                    <i class="fas fa-arrow-left"></i>
                </button>
                <div class="messenger-chat-header-avatar" id="chatHeaderAvatar">??</div>
                <div class="messenger-chat-header-info">
                    <div class="messenger-chat-header-name" id="chatHeaderName">Select a chat</div>
                    <div class="messenger-chat-header-status" id="chatHeaderStatus"></div>
                </div>
                <button class="group-settings-btn" id="groupSettingsBtn" title="Group Settings" style="display:none;">
                    <i class="fas fa-cog"></i>
                </button>
            </div>

            <!-- Group Settings Drawer (slides in from right) -->
            <div class="group-settings-drawer" id="groupSettingsDrawer" style="display:none;">
                <div class="group-settings-header">
                    <button class="group-settings-back-btn" id="groupSettingsBackBtn" title="Back to chat">
                        <i class="fas fa-arrow-left"></i>
                    </button>
                    <h3>Group Settings</h3>
                </div>
                <div class="group-settings-body">
                    <!-- Group Name Section -->
                    <div class="group-settings-section">
                        <label class="group-settings-label">Group Name</label>
                        <div class="group-rename-row">
                            <input type="text" id="groupRenameInput" class="group-rename-input" maxlength="200" autocomplete="off" />
                            <button class="group-rename-save-btn" id="groupRenameSaveBtn" title="Save">
                                <i class="fas fa-check"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Members Section -->
                    <div class="group-settings-section">
                        <label class="group-settings-label">Members <span id="groupSettingsMemberCount"></span></label>
                        <div class="group-settings-members" id="groupSettingsMembers">
                            <div class="messenger-loading"><div class="spinner"></div></div>
                        </div>
                    </div>

                    <!-- Leave Group -->
                    <div class="group-settings-section group-settings-danger">
                        <button class="group-leave-btn" id="groupLeaveBtn">
                            <i class="fas fa-sign-out-alt"></i> Leave Group
                        </button>
                    </div>
                </div>
            </div>

            <!-- Messages -->
            <div class="messenger-messages" id="messagesContainer"></div>

            <!-- Input -->
            <div class="messenger-input-area">
                <input type="text" id="msgInput" placeholder="Type a message..." autocomplete="off" />
                <button class="messenger-send-btn" id="sendBtn" title="Send">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>
</div>
