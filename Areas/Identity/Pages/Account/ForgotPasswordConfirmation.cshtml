@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Email Sent";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/home.css" />
<link rel="stylesheet" href="~/css/identity.css" />

<div class="animated-bg">
    <div class="floating-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
        <div class="shape shape-4"></div>
        <div class="shape shape-5"></div>
    </div>
</div>

<section class="identity-section">
    <div class="identity-card text-center">
        <div class="two-factor-icon text-success">
            <i class="bi bi-envelope-check"></i>
        </div>
        <h2 class="identity-title">Check Your Email</h2>
        <p class="identity-subtitle">
            We've sent a password reset link to your email address. Please follow the instructions to reset your password.
        </p>

        <div class="alert alert-info rounded-3 mb-4 text-start">
            <div class="d-flex gap-3">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    <p class="mb-0 small fw-semibold">Didn't receive an email?</p>
                    <p class="mb-0 small text-muted">Check your spam folder or try again in a few minutes.</p>
                </div>
            </div>
        </div>

        <div class="d-grid gap-2">
            <a asp-page="./Login" class="btn btn-primary justify-content-center py-3">
                Return to Sign In
            </a>
            <a asp-page="./ForgotPassword" class="btn btn-outline-light text-muted border-0 small">
                Try a different email
            </a>
        </div>
    </div>
</section>
