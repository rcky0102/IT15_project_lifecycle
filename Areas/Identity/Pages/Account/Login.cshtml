@page
@model LoginModel

@{
    ViewData["Title"] = "Welcome Back";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/home.css" />
<link rel="stylesheet" href="~/css/identity.css" />

<style>
    .login-card {
        width: 100%;
        max-width: 560px;
        margin: 0 auto;
    }

    .login-form,
    .external-login-form {
        width: 100%;
        max-width: 420px;
        margin: 0 auto;
    }

    .cooldown-timer {
        background: #dc3545;
        color: white;
        padding: 10px;
        border-radius: 5px;
        margin: 10px 0;
        text-align: center;
        font-weight: bold;
    }

    .login-button:disabled {
        background: #6c757d;
        cursor: not-allowed;
        opacity: 0.6;
    }
</style>

<div class="animated-bg">
    <div class="floating-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
        <div class="shape shape-4"></div>
        <div class="shape shape-5"></div>
    </div>
</div>

<section class="hero-section">
    <div class="hero-content">
        <div>
            <h1 class="hero-title">
                <span class="title-gradient">Welcome Back</span><br />
                <span class="title-highlight">Project Lifecycle</span>
            </h1>
            <p class="hero-subtitle">
                Sign in to continue managing your projects with the same modern experience as the home page.
            </p>
            <div class="hero-actions">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-lg">
                    Back to Home
                </a>
            </div>

            <!-- Cooldown Timer -->
            <div id="cooldownTimer" class="cooldown-timer" style="display: none;">
                <i class="fas fa-clock"></i>
                <span id="cooldownText">Please wait <span id="cooldownCount">30</span> seconds before next login attempt</span>
            </div>
        </div>

        <div class="feature-card login-card">
            <h2 class="feature-title text-center mb-4">Sign In</h2>

            @if (TempData.ContainsKey("ExternalLoginError"))
            {
                <div class="alert alert-danger rounded-3 mb-4 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-circle-fill me-3 fs-4"></i>
                        <div>
                            <p class="mb-0 fw-bold small">Login Failed</p>
                            <p class="mb-0 small opacity-75">@TempData["ExternalLoginError"]</p>
                        </div>
                    </div>
                </div>
            }

            <form id="account" method="post" class="login-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="mb-3 text-start">
                    <label asp-for="Input.Email" class="form-label fw-semibold">Email address</label>
                    <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" aria-required="true" placeholder="Enter your email" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="mb-3 text-start">
                    <label asp-for="Input.Password" class="form-label fw-semibold">Password</label>
                    <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="current-password" aria-required="true" placeholder="Enter your password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-4 text-start">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
                </div>

                <button id="login-submit" type="submit" class="btn btn-primary btn-lg w-100 justify-content-center">Sign In</button>

                <div class="mt-4 d-flex flex-column gap-2 text-center align-items-center">
                    <a id="forgot-password" asp-page="./ForgotPassword" class="feature-link">Forgot your password?</a>
                    @* <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="feature-link">Register as a new user</a> *@
                </div>
            </form>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="mt-4 position-relative">
                    <hr class="my-4" />
                    <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted" style="font-size: 0.85rem;">or continue with</span>
                </div>

                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-grid gap-2 external-login-form">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" class="google-btn w-100" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                            @if (provider.DisplayName == "Google")
                            {
                                <img src="https://www.gstatic.com/images/branding/product/1x/gsa_512dp.png" alt="Google" />
                            }
                            Continue with @provider.DisplayName
                        </button>
                    }
                </form>
            }
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('account');
    const submitBtn = document.getElementById('login-submit');
    const cooldownTimer = document.getElementById('cooldownTimer');
    
    // Check for cooldown state on page load
    const showCooldown = @(Model.ShowCooldown ? "true" : "false");
    const initialTime = @Model.CooldownSeconds;
    
    if (showCooldown) {
        startCooldown(initialTime);
    }
    
    if (form && submitBtn) {
        form.addEventListener('submit', function(e) {
            if (typeof $ !== 'undefined' && $(form).length > 0) {
                if (!$(form).valid()) return;
            }
            if (!form.checkValidity()) return;

            // Check if cooldown is active
            if (submitBtn.disabled && submitBtn.getAttribute('data-cooldown') === 'true') {
                e.preventDefault();
                return;
            }

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Signing in...';
        });
    }
    
    function startCooldown(seconds) {
        let timeLeft = seconds || 30;
        const externalBtns = document.querySelectorAll('.google-btn');
        
        submitBtn.disabled = true;
        submitBtn.setAttribute('data-cooldown', 'true');
        externalBtns.forEach(btn => btn.disabled = true);
        
        cooldownTimer.style.display = 'block';
        
        const updateBtnText = () => {
            submitBtn.innerHTML = `<i class="fas fa-lock me-2"></i> Wait ${timeLeft}s`;
            if (document.getElementById('cooldownCount')) {
                document.getElementById('cooldownCount').textContent = timeLeft;
            }
        };

        updateBtnText();
        
        const interval = setInterval(() => {
            timeLeft--;
            updateBtnText();
            
            if (timeLeft <= 0) {
                clearInterval(interval);
                cooldownTimer.style.display = 'none';
                submitBtn.disabled = false;
                submitBtn.removeAttribute('data-cooldown');
                submitBtn.innerHTML = 'Sign In';
                externalBtns.forEach(btn => btn.disabled = false);
            }
        }, 1000);
    }
});
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
