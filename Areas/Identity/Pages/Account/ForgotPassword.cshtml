@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/home.css" />
<link rel="stylesheet" href="~/css/identity.css" />

<div class="animated-bg">
    <div class="floating-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
        <div class="shape shape-4"></div>
        <div class="shape shape-5"></div>
    </div>
</div>

<section class="identity-section">
    <div class="identity-card">
        <h2 class="identity-title">Forgot Password</h2>
        <p class="identity-subtitle">
            @(Model.LinkedGoogleLogins != null && Model.LinkedGoogleLogins.Count > 0 
                ? "Select a Google account to receive the reset link." 
                : "Enter your email address to receive a password reset link.")
        </p>

        @if (TempData.ContainsKey("ForgotPasswordError"))
        {
            <div class="alert alert-danger rounded-3 mb-4 shadow-sm" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-circle-fill me-3 fs-4"></i>
                    <div>
                        <p class="mb-0 fw-bold small">Request Failed</p>
                        <p class="mb-0 small opacity-75">@TempData["ForgotPasswordError"]</p>
                    </div>
                </div>
            </div>
        }

        <div class="mb-4">
            <form method="post" asp-page="/Account/ExternalLogin">
                <input type="hidden" name="provider" value="Google" />
                <input type="hidden" name="returnUrl" value="/Identity/Account/ForgotPassword?forgotPassword=1" />
                <button type="submit" class="google-btn w-100">
                    <img src="https://www.gstatic.com/images/branding/product/1x/gsa_512dp.png" alt="Google" />
                    Select Google account
                </button>
            </form>
        </div>

        <div class="position-relative mb-4">
            <hr />
            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted" style="font-size: 0.85rem;">or reset via email</span>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            @if (Model.LinkedGoogleLogins != null && Model.LinkedGoogleLogins.Count > 0)
            {
                <div class="mb-4">
                    <label class="form-label fw-semibold text-muted small text-uppercase">Linked Google Accounts</label>
                    <div class="list-group rounded-3 shadow-sm border-0">
                        @foreach (var login in Model.LinkedGoogleLogins)
                        {
                            <label class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 border-bottom">
                                <input type="radio" name="Input.SelectedProviderKey" value="@login.ProviderKey" class="form-check-input" />
                                <div class="d-flex flex-column">
                                    <span class="fw-bold text-dark">@((!string.IsNullOrEmpty(login.ProviderDisplayName) ? login.ProviderDisplayName : login.ProviderKey))</span>
                                    <span class="text-muted small">Google Account</span>
                                </div>
                            </label>
                        }
                    </div>
                    <input asp-for="Input.Email" type="hidden" />
                </div>
                <button type="submit" class="btn btn-primary w-100 justify-content-center py-3">Send Reset Link</button>
            }
            else
            {
                <div class="form-floating mb-4">
                    <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email Address</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100 justify-content-center py-3">Reset Password</button>
            }
        </form>

        <div class="mt-4 text-center">
            <a asp-page="./Login" class="feature-link text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i> Back to Sign In
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
