@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<h1>@ViewData["Title"]</h1>
@if (Model.LinkedGoogleLogins != null && Model.LinkedGoogleLogins.Count > 0)
{
    <h2>Select a Google account to receive the reset link.</h2>
}
else
{
    <h2>Enter your email.</h2>
}
<hr />
<div class="row">
    <div class="col-md-4">
        <div class="mb-3">
            <form method="post" asp-page="/Account/ExternalLogin">
                <input type="hidden" name="provider" value="Google" />
                <input type="hidden" name="returnUrl" value="/Identity/Account/ForgotPassword?forgotPassword=1" />
                <button type="submit" class="w-100 btn btn-outline-secondary mb-2">Select Google account</button>
            </form>
        </div>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            @if (Model.LinkedGoogleLogins != null && Model.LinkedGoogleLogins.Count > 0)
            {
                <div class="mb-3">
                    <label class="form-label">Google accounts linked to this email</label>
                    <div class="list-group">
                        @foreach (var login in Model.LinkedGoogleLogins)
                        {
                            <label class="list-group-item">
                                <input type="radio" name="Input.SelectedProviderKey" value="@login.ProviderKey" />
                                @((!string.IsNullOrEmpty(login.ProviderDisplayName) ? login.ProviderDisplayName : login.ProviderKey))
                            </label>
                        }
                    </div>
                    <input asp-for="Input.Email" type="hidden" />
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">Send reset to selected Google account</button>
            }
            else
            {
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label"></label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">Reset Password</button>
            }
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
