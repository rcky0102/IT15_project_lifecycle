@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/HumanResource/Layout.cshtml";
}

<div class="dashboard-container">
    <!-- Dashboard Header -->
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="dashboard-title">Human Resource Dashboard</h1>
            <p class="dashboard-subtitle">Manage employee records and HR operations</p>
        </div>
        <div class="header-actions">
            <button class="btn btn-hr">
                <i class="fas fa-user-plus"></i>
                New Employee
            </button>
            <button class="btn btn-outline-hr">
                <i class="fas fa-sync"></i>
                Refresh
            </button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon primary">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number">42</div>
                <div class="stat-label">Total Employees</div>
                <div class="stat-change positive">
                    <i class="fas fa-arrow-up"></i> 3 this month
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon success">
                <i class="fas fa-id-card"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number">12</div>
                <div class="stat-label">New Hires</div>
                <div class="stat-change positive">
                    <i class="fas fa-arrow-up"></i> +4 this quarter
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon warning">
                <i class="fas fa-file-signature"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number">7</div>
                <div class="stat-label">Contracts Pending</div>
                <div class="stat-change negative">
                    <i class="fas fa-arrow-up"></i> Needs attention
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon danger">
                <i class="fas fa-calendar-xmark"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number">3</div>
                <div class="stat-label">Leave Requests</div>
                <div class="stat-change neutral">
                    <i class="fas fa-minus"></i> Pending approval
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="charts-row">
        <div class="chart-container">
            <div class="chart-header">
                <h3>Headcount Trend</h3>
                <div class="chart-actions">
                    <select id="headcountRangeSelect" class="form-select form-select-sm">
                        <option value="6" selected>Last 6 months</option>
                        <option value="12">Last 12 months</option>
                    </select>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="headcountChart" height="300"></canvas>
            </div>
        </div>

        <div class="chart-container">
            <div class="chart-header">
                <h3>Department Distribution</h3>
                <div class="chart-actions">
                    <button class="btn btn-sm btn-outline-hr">View All</button>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="departmentChart" height="300"></canvas>
            </div>
        </div>
    </div>

    <!-- Activity and Quick Actions -->
    <div class="content-row">
        <div class="activity-panel">
            <div class="panel-header">
                <h3>Recent Activity</h3>
                <button class="btn btn-sm btn-link">View All</button>
            </div>
            <div class="activity-list">
                <div class="activity-item">
                    <div class="activity-icon user">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-title">New employee onboarded</div>
                        <div class="activity-description">Maria Santos joined the Engineering department</div>
                        <div class="activity-time">30 minutes ago</div>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="activity-icon project">
                        <i class="fas fa-file-contract"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-title">Contract renewed</div>
                        <div class="activity-description">Juan Dela Cruz's contract extended to 2027</div>
                        <div class="activity-time">2 hours ago</div>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="activity-icon system">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-title">Leave approved</div>
                        <div class="activity-description">Ana Reyes — Vacation leave (Mar 5-7)</div>
                        <div class="activity-time">4 hours ago</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="quick-actions-panel">
            <div class="panel-header">
                <h3>Quick Actions</h3>
            </div>
            <div class="quick-actions-grid">
                <button class="quick-action-btn">
                    <i class="fas fa-user-plus"></i>
                    <span>Add Employee</span>
                </button>
                <button class="quick-action-btn">
                    <i class="fas fa-calendar-day"></i>
                    <span>Leave Requests</span>
                </button>
                <button class="quick-action-btn">
                    <i class="fas fa-file-alt"></i>
                    <span>Generate Report</span>
                </button>
                <button class="quick-action-btn">
                    <i class="fas fa-bullhorn"></i>
                    <span>Announcements</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Workforce Status -->
    <div class="system-status-panel">
        <div class="panel-header">
            <h3>Workforce Overview</h3>
            <div class="status-indicator online">
                <span class="status-dot"></span>
                Healthy
            </div>
        </div>
        <div class="status-grid">
            <div class="status-item">
                <div class="status-info">
                    <div class="status-name">Attendance</div>
                    <div class="status-value">92% Present Today</div>
                </div>
                <div class="status-bar">
                    <div class="status-progress" style="width: 92%"></div>
                </div>
            </div>

            <div class="status-item">
                <div class="status-info">
                    <div class="status-name">Onboarding</div>
                    <div class="status-value">4 In Progress</div>
                </div>
                <div class="status-bar">
                    <div class="status-progress" style="width: 65%"></div>
                </div>
            </div>

            <div class="status-item">
                <div class="status-info">
                    <div class="status-name">Compliance Training</div>
                    <div class="status-value">85% Completed</div>
                </div>
                <div class="status-bar">
                    <div class="status-progress" style="width: 85%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Headcount Trend Chart
        const headcountCtx = document.getElementById('headcountChart').getContext('2d');
        new Chart(headcountCtx, {
            type: 'line',
            data: {
                labels: ['Sep', 'Oct', 'Nov', 'Dec', 'Jan', 'Feb'],
                datasets: [{
                    label: 'Headcount',
                    data: [36, 37, 38, 39, 40, 42],
                    borderColor: '#4CA3DD',
                    backgroundColor: 'rgba(76,163,221,0.08)',
                    tension: 0.35,
                    fill: true,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false } },
                scales: {
                    y: {
                        beginAtZero: false,
                        grid: { color: 'rgba(0,0,0,0.05)' },
                        ticks: { precision: 0 },
                        title: { display: true, text: 'Employees', color: '#64748b', font: { weight: '600', size: 12 } }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { maxRotation: 0, autoSkip: true },
                        title: { display: true, text: 'Month', color: '#64748b', font: { weight: '600', size: 12 } }
                    }
                }
            }
        });

        // Department Distribution Chart
        const deptCtx = document.getElementById('departmentChart').getContext('2d');
        new Chart(deptCtx, {
            type: 'doughnut',
            data: {
                labels: ['Engineering', 'Marketing', 'Operations', 'Finance', 'HR'],
                datasets: [{
                    data: [15, 8, 10, 5, 4],
                    backgroundColor: ['#006994', '#4CA3DD', '#94D3FF', '#B8E4FF', '#E8F4F8'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });
    </script>
}
