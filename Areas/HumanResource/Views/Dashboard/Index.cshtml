@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/HumanResource/Layout.cshtml";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="dashboard-title">Human Resource Dashboard</h1>
            <p class="dashboard-subtitle">Manage employee records and HR operations</p>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card"><div class="stat-icon primary"><i class="fas fa-users"></i></div><div class="stat-content"><div class="stat-number">42</div><div class="stat-label">Employees</div></div></div>
        <div class="stat-card"><div class="stat-icon success"><i class="fas fa-id-card"></i></div><div class="stat-content"><div class="stat-number">12</div><div class="stat-label">New Hires</div></div></div>
        <div class="stat-card"><div class="stat-icon warning"><i class="fas fa-file-signature"></i></div><div class="stat-content"><div class="stat-number">7</div><div class="stat-label">Contracts Pending</div></div></div>
    </div>
</div>
