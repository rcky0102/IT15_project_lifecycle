@model IEnumerable<project_lifecycle.Models.Department>
@{
    ViewData["Title"] = "Department Management";
    Layout = "~/Areas/HumanResource/Layout.cshtml";
}

<!-- ===== Page Title Hero ===== -->
<div class="sa-page-hero">
    <div class="sa-page-hero-content">
        <div class="sa-page-hero-left">
            <h1 class="sa-page-title">
                <span class="sa-page-title-icon"><i class="fas fa-building"></i></span>
                Department Management
            </h1>
            <p class="sa-page-subtitle">Manage organizational departments</p>
        </div>
        <div class="sa-page-hero-right">
            <button type="button" class="sa-btn sa-btn-outline" data-bs-toggle="modal" data-bs-target="#createDepartmentModal">
                <i class="fas fa-plus"></i>
                <span>Add Department</span>
            </button>
        </div>
    </div>
</div>

<!-- ===== Alerts ===== -->
@if (TempData["Success"] != null)
{
    <div class="sa-alert sa-alert-success">
        <div class="sa-alert-icon"><i class="fas fa-check-circle"></i></div>
        <span>@TempData["Success"]</span>
        <button class="sa-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}

<!-- ===== Filters ===== -->
<div class="sa-filters-card">
    <div class="sa-filters-row">
        <div class="sa-search-group">
            <i class="fas fa-magnifying-glass sa-search-icon"></i>
            <input id="deptSearch" type="text" class="sa-search-input" placeholder="Search departments…" autocomplete="off" />
        </div>
        <div class="sa-select-group">
            <label for="pageSizeSelect" style="font-size:.82rem;color:var(--sa-muted);margin-right:.4rem;">Show</label>
            <select id="pageSizeSelect" class="sa-select" style="width:92px;">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
    </div>
</div>

<!-- ===== Table ===== -->
<div class="sa-table-section">
    <div class="sa-table-card">
        @if (Model.Any())
        {
            <div class="sa-table-responsive">
                <table class="sa-table" id="deptTable">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Date Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="deptBody">
                        @foreach (var item in Model)
                        {
                            <tr class="sa-row"
                                data-name="@item.Name.ToLower()"
                                data-desc="@(item.Description?.ToLower() ?? "")">
                                <td>
                                    <div class="sa-name-cell">
                                        <div class="sa-name-icon">
                                            <i class="fas fa-building"></i>
                                        </div>
                                        <div>
                                            <div class="sa-name-text">@item.Name</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="sa-desc">
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        @item.Description
                                    }
                                    else
                                    {
                                        <span style="color:#94a3b8;">No description</span>
                                    }
                                </td>
                                <td class="sa-date">@item.DateCreated.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="sa-action-group">
                                        <button type="button" class="sa-action-btn sa-action-edit" title="Edit department"
                                                onclick="editDepartment(@item.Id, '@Html.Raw(item.Name.Replace("'", "\\'"))', '@Html.Raw(item.Description?.Replace("'", "\\'") ?? "")')">
                                            <i class="fas fa-pen-to-square"></i>
                                        </button>
                                        <button type="button" class="sa-action-btn sa-action-delete" title="Delete department"
                                                onclick="confirmDelete(@item.Id, '@Html.Raw(item.Name.Replace("'", "\\'"))')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="noFilterResults" class="sa-empty-state" style="display:none;">
                <div class="sa-empty-icon"><i class="fas fa-magnifying-glass"></i></div>
                <div class="sa-empty-title">No matching departments</div>
                <div class="sa-empty-text">Try adjusting your search.</div>
            </div>

            <div class="sa-pagination" id="paginationContainer">
                <div class="sa-pagination-info" id="paginationInfo"></div>
                <div class="sa-pagination-controls" id="paginationControls"></div>
            </div>
        }
        else
        {
            <div class="sa-empty-state">
                <div class="sa-empty-icon"><i class="fas fa-building"></i></div>
                <div class="sa-empty-title">No departments found</div>
                <div class="sa-empty-text">Create your first department to get started.</div>
            </div>
        }
    </div>
</div>

<!-- Create Department Modal -->
<div class="modal fade" id="createDepartmentModal" tabindex="-1" aria-labelledby="createDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content cp-modal">
            <div class="cp-modal-header">
                <div>
                    <h5 class="cp-modal-title" id="createDepartmentModalLabel">
                        <i class="fas fa-building"></i> Create New Department
                    </h5>
                    <p class="cp-modal-subtitle">Add a new department to the organization</p>
                </div>
                <button type="button" class="btn-close btn-close-white mt-1" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body cp-modal-body">
                <form id="createDepartmentForm">
                    @Html.AntiForgeryToken()
                    <div class="modal-form-section">
                        <div class="modal-section-title">
                            <i class="fas fa-info-circle"></i> Department Details
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="departmentName" class="form-label">Department Name</label>
                                <input name="Name" class="form-control" id="departmentName" placeholder="Enter department name" />
                                <span class="text-danger" data-valmsg-for="Name"></span>
                            </div>
                            <div class="col-md-12">
                                <label for="departmentDescription" class="form-label">Description</label>
                                <textarea name="Description" class="form-control" id="departmentDescription" rows="4" placeholder="Enter department description (optional)"></textarea>
                                <span class="text-danger" data-valmsg-for="Description"></span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="cp-modal-footer">
                <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">Cancel</button>
                <div class="cp-step-nav">
                    <button type="button" class="btn-modal-submit" id="saveDepartmentBtn">
                        <i class="fas fa-save"></i> Create Department
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Department Modal -->
<div class="modal fade" id="editDepartmentModal" tabindex="-1" aria-labelledby="editDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content cp-modal">
            <div class="cp-modal-header">
                <div>
                    <h5 class="cp-modal-title" id="editDepartmentModalLabel">
                        <i class="fas fa-edit"></i> Edit Department
                    </h5>
                    <p class="cp-modal-subtitle">Update department information</p>
                </div>
                <button type="button" class="btn-close btn-close-white mt-1" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body cp-modal-body">
                <form id="editDepartmentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editDepartmentId" />
                    <input type="hidden" id="editDateCreated" />
                    <div class="modal-form-section">
                        <div class="modal-section-title">
                            <i class="fas fa-info-circle"></i> Department Details
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="editDepartmentName" class="form-label">Department Name</label>
                                <input name="Name" class="form-control" id="editDepartmentName" placeholder="Enter department name" />
                                <span class="text-danger" data-valmsg-for="Name"></span>
                            </div>
                            <div class="col-md-12">
                                <label for="editDepartmentDescription" class="form-label">Description</label>
                                <textarea name="Description" class="form-control" id="editDepartmentDescription" rows="4" placeholder="Enter department description (optional)"></textarea>
                                <span class="text-danger" data-valmsg-for="Description"></span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="cp-modal-footer">
                <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">Cancel</button>
                <div class="cp-step-nav">
                    <button type="button" class="btn-modal-submit" id="updateDepartmentBtn">
                        <i class="fas fa-save"></i> Update Department
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="emp-modal-backdrop" id="deleteDepartmentModal" style="display:none;">
    <div class="emp-modal">
        <div class="emp-modal-icon emp-modal-icon-danger">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h5 class="emp-modal-title">Confirm Deletion</h5>
        <p class="emp-modal-message">Are you sure you want to delete <strong><span id="deleteDepartmentName"></span></strong>? This action is permanent and cannot be reversed.</p>
        <form id="deleteDepartmentForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="deleteDepartmentId" />
        </form>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn-cancel" id="cancelDeleteBtn">Cancel</button>
            <button type="button" class="emp-btn-confirm emp-btn-danger" id="confirmDeleteBtn">
                <i class="fas fa-trash"></i> Delete Department
            </button>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/superadmin-management.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        /* ===== Client-side filter & pagination ===== */
        (function () {
            var searchInput  = document.getElementById('deptSearch');
            var pageSizeSel  = document.getElementById('pageSizeSelect');
            var tbody        = document.getElementById('deptBody');
            if (!tbody) return;

            var allRows      = Array.prototype.slice.call(tbody.querySelectorAll('tr.sa-row'));
            var filtered     = allRows.slice();
            var currentPage  = 1;

            function applyFilters() {
                var q = (searchInput.value || '').toLowerCase().trim();
                filtered = allRows.filter(function (r) {
                    if (q && r.dataset.name.indexOf(q) === -1 && r.dataset.desc.indexOf(q) === -1) return false;
                    return true;
                });
                currentPage = 1;
                render();
            }

            function render() {
                var size  = parseInt(pageSizeSel.value, 10) || 10;
                var pages = Math.ceil(filtered.length / size) || 1;
                if (currentPage > pages) currentPage = pages;
                var start = (currentPage - 1) * size;
                var end   = start + size;

                allRows.forEach(function (r) { r.style.display = 'none'; });
                filtered.slice(start, end).forEach(function (r) { r.style.display = ''; });

                var noRes = document.getElementById('noFilterResults');
                if (noRes) noRes.style.display = filtered.length === 0 ? '' : 'none';

                var info = document.getElementById('paginationInfo');
                var ctrl = document.getElementById('paginationControls');
                if (info) info.textContent = 'Showing ' + (filtered.length ? start + 1 : 0) + '\u2013' + Math.min(end, filtered.length) + ' of ' + filtered.length;
                if (ctrl) {
                    ctrl.innerHTML = '';
                    if (pages > 1) {
                        var prev = btn('\u2039', currentPage > 1, function () { currentPage--; render(); });
                        ctrl.appendChild(prev);
                        for (var i = 1; i <= pages; i++) (function (p) {
                            ctrl.appendChild(btn(p, true, function () { currentPage = p; render(); }, p === currentPage));
                        })(i);
                        var next = btn('\u203A', currentPage < pages, function () { currentPage++; render(); });
                        ctrl.appendChild(next);
                    }
                }
            }

            function btn(label, enabled, cb, active) {
                var b = document.createElement('button');
                b.className = 'sa-page-btn' + (active ? ' active' : '');
                b.textContent = label;
                b.disabled = !enabled;
                if (enabled) b.addEventListener('click', cb);
                return b;
            }

            searchInput.addEventListener('input', applyFilters);
            pageSizeSel.addEventListener('change', applyFilters);
            applyFilters();
        })();
    </script>

    <script>
        $(document).ready(function() {
            // Create department
            $('#saveDepartmentBtn').click(function() {
                var form = $('#createDepartmentForm');
                var formData = {
                    __RequestVerificationToken: form.find('input[name="__RequestVerificationToken"]').val(),
                    Name: $('#departmentName').val().trim(),
                    Description: $('#departmentDescription').val().trim()
                };

                $('.text-danger').text('');

                if (!formData.Name) {
                    $('#departmentName').siblings('.text-danger').text('The Name field is required.');
                    return;
                }

                $('#saveDepartmentBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Creating...');

                $.ajax({
                    url: '@Url.Action("Create", "Department", new { area = "HumanResource" })',
                    type: 'POST',
                    data: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function(response) {
                        if (response.success) {
                            $('#createDepartmentModal').modal('hide');
                            var alertHtml = '<div class="sa-alert sa-alert-success"><div class="sa-alert-icon"><i class="fas fa-check-circle"></i></div><span>' + response.message + '</span><button class="sa-alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button></div>';
                            $('.sa-page-hero').after(alertHtml);
                            form[0].reset();
                            setTimeout(function() { location.reload(); }, 1500);
                        } else {
                            if (response.errors) {
                                for (var key in response.errors) {
                                    $('#' + key.toLowerCase() + 'Error').text(response.errors[key][0]);
                                }
                            } else {
                                $('#departmentName').siblings('.text-danger').text(response.message || 'An error occurred.');
                            }
                        }
                    },
                    error: function() {
                        $('#departmentName').siblings('.text-danger').text('An error occurred. Please try again.');
                    },
                    complete: function() {
                        $('#saveDepartmentBtn').prop('disabled', false).html('<i class="fas fa-save"></i> Create Department');
                    }
                });
            });

            $('#createDepartmentModal').on('hidden.bs.modal', function () {
                $('#createDepartmentForm')[0].reset();
                $('.text-danger').text('');
            });

            // Edit department
            window.editDepartment = function(id, name, description) {
                $.ajax({
                    url: '@Url.Action("GetDepartmentById", "Department", new { area = "HumanResource" })',
                    type: 'GET',
                    data: { id: id },
                    success: function(dept) {
                        $('#editDepartmentId').val(dept.id);
                        $('#editDepartmentName').val(dept.name);
                        $('#editDepartmentDescription').val(dept.description || '');
                        $('#editDateCreated').val(dept.dateCreated);
                        $('#editDepartmentModal').modal('show');
                    },
                    error: function() {
                        $('#editDepartmentId').val(id);
                        $('#editDepartmentName').val(name);
                        $('#editDepartmentDescription').val(description);
                        $('#editDateCreated').val(new Date().toISOString());
                        $('#editDepartmentModal').modal('show');
                    }
                });
            };

            // Update department
            $('#updateDepartmentBtn').click(function() {
                var form = $('#editDepartmentForm');
                var formData = {
                    __RequestVerificationToken: form.find('input[name="__RequestVerificationToken"]').val(),
                    Id: $('#editDepartmentId').val(),
                    Name: $('#editDepartmentName').val().trim(),
                    Description: $('#editDepartmentDescription').val().trim(),
                    DateCreated: $('#editDateCreated').val()
                };

                $('#editDepartmentModal .text-danger').text('');

                if (!formData.Name) {
                    $('#editDepartmentName').siblings('.text-danger').text('The Name field is required.');
                    return;
                }

                $('#updateDepartmentBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Updating...');

                $.ajax({
                    url: '@Url.Action("Edit", "Department", new { area = "HumanResource" })',
                    type: 'POST',
                    data: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function(response) {
                        if (response.success) {
                            $('#editDepartmentModal').modal('hide');
                            var alertHtml = '<div class="sa-alert sa-alert-success"><div class="sa-alert-icon"><i class="fas fa-check-circle"></i></div><span>' + response.message + '</span><button class="sa-alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button></div>';
                            $('.sa-page-hero').after(alertHtml);
                            form[0].reset();
                            setTimeout(function() { location.reload(); }, 1500);
                        } else {
                            if (response.errors) {
                                for (var key in response.errors) {
                                    $('#editDepartmentModal #' + key.toLowerCase() + 'Error').text(response.errors[key][0]);
                                }
                            } else {
                                $('#editDepartmentName').siblings('.text-danger').text(response.message || 'An error occurred.');
                            }
                        }
                    },
                    error: function() {
                        $('#editDepartmentName').siblings('.text-danger').text('An error occurred. Please try again.');
                    },
                    complete: function() {
                        $('#updateDepartmentBtn').prop('disabled', false).html('<i class="fas fa-save"></i> Update Department');
                    }
                });
            });

            $('#editDepartmentModal').on('hidden.bs.modal', function () {
                $('#editDepartmentForm')[0].reset();
                $('#editDepartmentModal .text-danger').text('');
            });

            // Confirm delete
            function hideDeleteModal() {
                document.getElementById('deleteDepartmentModal').style.display = 'none';
                $('#deleteDepartmentForm')[0].reset();
            }

            window.confirmDelete = function(id, name) {
                $('#deleteDepartmentId').val(id);
                $('#deleteDepartmentName').text(name);
                document.getElementById('deleteDepartmentModal').style.display = 'flex';
            };

            $('#cancelDeleteBtn').click(hideDeleteModal);
            $('#deleteDepartmentModal').click(function(e) {
                if (e.target === this) hideDeleteModal();
            });

            // Delete department
            $('#confirmDeleteBtn').click(function() {
                var form = $('#deleteDepartmentForm');
                var formData = {
                    __RequestVerificationToken: form.find('input[name="__RequestVerificationToken"]').val(),
                    id: $('#deleteDepartmentId').val()
                };

                $('#confirmDeleteBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Deleting...');

                $.ajax({
                    url: '@Url.Action("Delete", "Department", new { area = "HumanResource" })',
                    type: 'POST',
                    data: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function(response) {
                        if (response.success) {
                            hideDeleteModal();
                            var alertHtml = '<div class="sa-alert sa-alert-success"><div class="sa-alert-icon"><i class="fas fa-check-circle"></i></div><span>' + response.message + '</span><button class="sa-alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button></div>';
                            $('.sa-page-hero').after(alertHtml);
                            setTimeout(function() { location.reload(); }, 1500);
                        } else {
                            var alertHtml = '<div class="sa-alert sa-alert-error"><div class="sa-alert-icon"><i class="fas fa-exclamation-circle"></i></div><span>' + (response.message || 'An error occurred.') + '</span><button class="sa-alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button></div>';
                            $('.sa-page-hero').after(alertHtml);
                            hideDeleteModal();
                        }
                    },
                    error: function() {
                        var alertHtml = '<div class="sa-alert sa-alert-error"><div class="sa-alert-icon"><i class="fas fa-exclamation-circle"></i></div><span>An error occurred. Please try again.</span><button class="sa-alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button></div>';
                        $('.sa-page-hero').after(alertHtml);
                        hideDeleteModal();
                    },
                    complete: function() {
                        $('#confirmDeleteBtn').prop('disabled', false).html('<i class="fas fa-trash"></i> Delete Department');
                    }
                });
            });
        });
    </script>
}
