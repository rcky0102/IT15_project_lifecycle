@{
    Layout = null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Department Head Dashboard</title>

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/proposal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/depthead-project.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/depthead-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employee-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employee-proposal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/messenger.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/project_lifecycle.styles.css" asp-append-version="true" />
</head>
<body class="dh-body">

    <!-- Mobile overlay -->
    <div class="dh-sidebar-overlay" id="sidebarOverlay"></div>

    <div class="dh-layout">

        <!-- ========== SIDEBAR ========== -->
        <aside class="dh-sidebar" id="dhSidebar">

            <!-- Brand -->
            <div class="dh-sidebar-header">
                <a href="@Url.Action("Index", "Dashboard", new { area = "DepartmentHead" })" class="dh-sidebar-brand">
                    <div class="dh-brand-icon">
                        <img src="~/css/Images/LOGO (final).png" asp-append-version="true" alt="Project Lifecycle Logo" class="brand-logo dh-brand-logo" />
                    </div>
                    <span class="dh-brand-text">
                        Project <br />
                        Lifecycle
                    </span>
                </a>
                <button class="dh-sidebar-toggle" id="sidebarToggle" title="Toggle Sidebar">
                    <i class="fas fa-bars fa-sm"></i>
                </button>
            </div>

            <!-- Navigation -->
            <nav class="dh-sidebar-nav">
                <span class="dh-nav-section-title">Menu</span>
                <ul class="dh-nav-list">
                    <li class="dh-nav-item">
                        <a href="@Url.Action("Index", "Dashboard", new { area = "DepartmentHead" })"
                           class="dh-nav-link @(currentController == "Dashboard" ? "active" : "")"
                           data-tooltip="Dashboard">
                            <i class="fas fa-th-large"></i>
                            <span class="dh-nav-text">Dashboard</span>
                        </a>
                    </li>
                    <li class="dh-nav-item">
                        <a href="@Url.Action("Index", "Proposal", new { area = "DepartmentHead" })"
                           class="dh-nav-link @(currentController == "Proposal" ? "active" : "")"
                           data-tooltip="Proposals">
                            <i class="fas fa-file-lines"></i>
                            <span class="dh-nav-text">Proposals</span>
                        </a>
                    </li>
                    <li class="dh-nav-item">
                        <a href="@Url.Action("Index", "Project", new { area = "DepartmentHead" })"
                           class="dh-nav-link @(currentController == "Project" ? "active" : "")"
                           data-tooltip="Projects">
                            <i class="fas fa-diagram-project"></i>
                            <span class="dh-nav-text">Projects</span>
                        </a>
                    </li>
                    <li class="dh-nav-item">
                        <a href="@Url.Action("Index", "Messages", new { area = "DepartmentHead" })"
                           class="dh-nav-link @(currentController == "Messages" ? "active" : "")"
                           data-tooltip="Messages">
                            <i class="fas fa-comment-dots"></i>
                            <span class="dh-nav-text">Messages</span>
                            <span class="msg-nav-badge" style="display:none"></span>
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- User footer -->
            <div class="dh-sidebar-footer">
                <div class="dh-user-card">
                    <div class="dh-user-avatar">DH</div>
                    <div class="dh-user-details">
                        <div class="dh-user-name">Department Head</div>
                        <div class="dh-user-role">Head of Department</div>
                    </div>
                    <form action="/Identity/Account/Logout" method="post" class="dh-logout-form" id="logoutForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="/" />
                        <button type="submit" class="dh-logout-btn" title="Sign out" onclick="return confirm('Are you sure you want to logout?');">
                            <i class="fas fa-arrow-right-from-bracket"></i>
                        </button>
                    </form>
                </div>
            </div>

        </aside>

        <!-- ========== MAIN ========== -->
        <div class="dh-main">

            <!-- Header -->
            <header class="dh-header" id="dhHeader">
                <div class="dh-header-left">
                    <button class="dh-mobile-toggle" id="mobileSidebarToggle" aria-label="Open menu">
                        <i class="fas fa-bars"></i>
                    </button>
                    <nav class="dh-breadcrumb" aria-label="Breadcrumb">
                        <a href="@Url.Action("Index", "Dashboard", new { area = "DepartmentHead" })" class="dh-breadcrumb-home">
                            <i class="fas fa-home"></i>
                        </a>
                        <span class="dh-breadcrumb-sep"><i class="fas fa-chevron-right"></i></span>
                        <span class="dh-breadcrumb-current">@(ViewData["Title"] ?? "Dashboard")</span>
                    </nav>
                </div>

                <div class="dh-header-right">
                    <div class="notif-wrapper">
                        <button class="dh-header-btn notif-bell-btn" id="notifBellBtn" title="Notifications" aria-expanded="false">
                            <i class="fas fa-bell"></i>
                            <span class="notif-badge" id="notifBadge">0</span>
                            <span class="dh-notif-dot" id="notifDot" style="display:none"></span>
                        </button>
                        <div class="notif-dropdown" id="notifDropdown">
                            <div class="notif-dropdown-header">
                                <h6><i class="fas fa-bell"></i> Notifications</h6>
                                <button class="notif-mark-all" id="notifMarkAllRead" style="display:none">Mark all read</button>
                            </div>
                            <div class="notif-list" id="notifList"></div>
                            <div class="notif-empty" id="notifEmpty">
                                <i class="fas fa-bell-slash"></i>
                                <span>No notifications yet</span>
                            </div>
                        </div>
                    </div>

                    <div class="dh-header-divider"></div>

                    <div class="dh-header-profile">
                        <div class="dh-header-avatar">DH</div>
                        <div class="dh-header-user-info">
                            <div class="dh-header-greeting" id="headerGreeting">Welcome back</div>
                            <div class="dh-header-name">Department Head</div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="dh-content">
                @RenderBody()
            </main>
        </div>

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    <script src="~/lib/microsoft-signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/messenger.js" asp-append-version="true"></script>

    <script>
    (function () {
        const sidebar  = document.getElementById('dhSidebar');
        const toggle   = document.getElementById('sidebarToggle');
        const mobile   = document.getElementById('mobileSidebarToggle');
        const overlay  = document.getElementById('sidebarOverlay');
        const header   = document.getElementById('dhHeader');
        const greeting = document.getElementById('headerGreeting');

        /* --- Time-based greeting --- */
        const hour = new Date().getHours();
        if (greeting) {
            greeting.textContent = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
        }

        /* --- Sidebar collapse toggle (desktop) --- */
        toggle?.addEventListener('click', function () {
            const icon = this.querySelector('i');
            const collapsed = sidebar.classList.toggle('collapsed');
            icon.className = collapsed ? 'fas fa-chevron-right fa-sm' : 'fas fa-bars fa-sm';
            this.setAttribute('title', collapsed ? 'Expand Sidebar' : 'Collapse Sidebar');
            localStorage.setItem('dhSidebarCollapsed', collapsed);
        });

        /* --- Restore collapsed state --- */
        if (localStorage.getItem('dhSidebarCollapsed') === 'true') {
            sidebar?.classList.add('collapsed');
            const icon = toggle?.querySelector('i');
            if (icon) {
                icon.className = 'fas fa-chevron-right fa-sm';
                toggle.setAttribute('title', 'Expand Sidebar');
            }
        }

        /* --- Mobile sidebar --- */
        function openMobile()  { sidebar?.classList.add('mobile-open');    overlay?.classList.add('active'); }
        function closeMobile() { sidebar?.classList.remove('mobile-open'); overlay?.classList.remove('active'); }

        mobile?.addEventListener('click', function () {
            sidebar?.classList.contains('mobile-open') ? closeMobile() : openMobile();
        });
        overlay?.addEventListener('click', closeMobile);

        document.addEventListener('click', function (e) {
            if (window.innerWidth <= 768 &&
                sidebar?.classList.contains('mobile-open') &&
                !sidebar.contains(e.target) &&
                !mobile?.contains(e.target)) {
                closeMobile();
            }
        });

        /* --- Sticky header shadow on scroll --- */
        window.addEventListener('scroll', function () {
            header?.classList.toggle('scrolled', window.scrollY > 8);
        }, { passive: true });

        /* --- Notifications --- */
        if (typeof initNotifications === 'function') initNotifications();
    })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
