@model project_lifecycle.ViewModels.DepartmentHead.DepartmentHeadProjectIndexViewModel
@{
    ViewData["Title"] = "Projects";
}

<!-- ===== Page Title Hero ===== -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-diagram-project"></i></span>
                Projects
            </h1>
            <p class="emp-page-subtitle">Create and manage projects for your department</p>
        </div>
        <div class="emp-page-hero-right">
            <a asp-area="DepartmentHead" asp-controller="Project" asp-action="Create" class="emp-btn emp-btn-outline">
                <i class="fas fa-plus"></i>
                <span>Create Project</span>
            </a>
        </div>
    </div>
</div>

<!-- ===== Alerts ===== -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="emp-alert emp-alert-success">
        <div class="emp-alert-icon"><i class="fas fa-check-circle"></i></div>
        <span>@TempData["SuccessMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="emp-alert emp-alert-error">
        <div class="emp-alert-icon"><i class="fas fa-exclamation-circle"></i></div>
        <span>@TempData["ErrorMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}
<!-- Stats bar removed -->

<!-- Confirmation modal for archive / unarchive -->
<div class="emp-modal-backdrop" id="confirmActionModal" role="dialog" aria-modal="true" aria-hidden="true" style="display:none;">
    <div class="emp-modal" role="document">
        <h4 id="confirmActionTitle"><i class="fas fa-exclamation-triangle"></i> Confirm</h4>
        <p id="confirmActionMessage">Are you sure?</p>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn emp-btn-cancel" id="confirmActionCancel">Cancel</button>
            <form id="confirmActionForm" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="confirmActionId" value="" />
                <button type="submit" class="emp-btn emp-btn-confirm" id="confirmActionConfirm">Confirm</button>
            </form>
        </div>
    </div>
</div>

<!-- ===== Filters ===== -->
<div class="emp-filters-card">
    <div class="emp-filters-row">
        <div class="emp-search-group">
            <i class="fas fa-magnifying-glass emp-search-icon"></i>
            <input id="projectSearch" type="text" class="emp-search-input" placeholder="Search projects…" autocomplete="off" />
        </div>
        <div class="emp-select-group">
            <select id="archiveFilter" class="emp-select">
                <option value="active" selected>Active</option>
                <option value="inactive">Archived</option>
                <option value="all">All</option>
            </select>
        </div>
        <div class="emp-select-group">
            <label for="pageSizeSelect" style="font-size:.82rem;color:#64748b;margin-right:.4rem;">Show</label>
            <select id="pageSizeSelect" class="emp-select" style="width:92px;">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
    </div>
</div>

<!-- ===== Table ===== -->
<div class="project-table-section">
    <div class="project-table-card">
        @if (Model.Projects.Any())
        {
            <div class="project-table-responsive">
                <table class="project-table" id="projectsTable">
                    <thead>
                        <tr>
                            <th>Project</th>
                            <th>Proposal</th>
                            <th>Manager</th>
                            <th>Timeline</th>
                            <th>Members</th>
                            <th>Progress</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="projectsBody">
                        @foreach (var project in Model.Projects.OrderBy(p => p.IsArchived))
                        {
                            var duration  = (project.EndDate - project.StartDate).Days;
                            var totalPMs  = project.Milestones?.Count ?? 0;
                            var donePMs   = project.Milestones?.Count(m => {
                                var s = (m.Status ?? "").ToLowerInvariant();
                                return s == "completed" || s == "checked" || s == "finished";
                            }) ?? 0;
                            var percent   = totalPMs > 0 ? (int)Math.Round((double)donePMs * 100 / totalPMs) : 0;
                            <tr class="emp-row" data-name="@project.Name.ToLower()" data-archived="@(project.IsArchived ? "true" : "false")">
                                <td>
                                    <div class="project-name-cell">
                                        <div class="project-name-icon">
                                            <i class="fas fa-folder"></i>
                                        </div>
                                        <div>
                                            <div class="project-name-text">@project.Name
                                                @if (project.IsArchived)
                                                {
                                                    <span style="display:inline-block;margin-left:.5rem;font-size:.72rem;color:#94a3b8;font-weight:700;">ARCHIVED</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="project-date">
                                    <div class="project-cell-truncate" style="font-weight:normal;">@project.ProposalTitle</div>
                                </td>
                                <td class="project-manager">
                                    @if (!string.IsNullOrWhiteSpace(project.ProjectManagerName))
                                    {
                                        <div style="font-size:.9rem;color:#64748b;">@StripMiddleName(project.ProjectManagerName)</div>
                                    }
                                    else
                                    {
                                        <span style="color:#94a3b8;">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="project-timeline">
                                        <span class="project-timeline-dates">
                                            @project.StartDate.ToString("MMM dd, yyyy") &rarr; @project.EndDate.ToString("MMM dd, yyyy")
                                        </span>
                                        <span class="project-timeline-duration">@duration days</span>
                                    </div>
                                </td>
                                <td>
                                    <div style="display:flex;align-items:center;gap:.35rem;flex-wrap:wrap;">
                                        @foreach (var m in project.Members.Take(4))
                                        {
                                            if (!string.IsNullOrWhiteSpace(m.ProfileImage))
                                            {
                                                <div class="emp-avatar-chip" title="@m.EmployeeName">
                                                    <img src="@Url.Content(m.ProfileImage)" alt="@m.EmployeeName" style="width:100%;height:100%;border-radius:50%;object-fit:cover;display:block;" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="emp-avatar-chip" title="@m.EmployeeName">@GetInitials(m.EmployeeName)</div>
                                            }
                                        }
                                        @if (project.Members.Count > 4)
                                        {
                                            <div class="emp-avatar-chip more">+@(project.Members.Count - 4)</div>
                                        }
                                    </div>
                                </td>
                                <td style="min-width:130px;">
                                    <div style="display:flex;flex-direction:column;gap:.25rem;">
                                        <div style="display:flex;justify-content:space-between;font-size:.72rem;color:#64748b;font-weight:600;">
                                            <span>@donePMs / @totalPMs milestones</span>
                                            <span>@percent%</span>
                                        </div>
                                        <div style="height:6px;background:#f1f5f9;border-radius:6px;overflow:hidden;">
                                            <div style="height:100%;width:@(percent)%;background:linear-gradient(90deg,#006994,#4CA3DD);border-radius:6px;transition:width .5s;"></div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div style="display:inline-flex;align-items:center;gap:.35rem;">
                                        <a asp-area="DepartmentHead" asp-controller="Project" asp-action="Show" asp-route-id="@project.Id"
                                           class="emp-action-btn emp-action-view" title="View project">
                                            <i class="fas fa-magnifying-glass"></i>
                                        </a>
                                        @if (!project.IsArchived)
                                        {
                                            <a asp-area="DepartmentHead" asp-controller="Project" asp-action="Edit" asp-route-id="@project.Id"
                                               class="emp-action-btn emp-action-edit" title="Edit project">
                                                <i class="fas fa-pen-to-square"></i>
                                            </a>

                                            <button type="button" class="emp-action-btn emp-action-archive" title="Archive"
                                                    data-action='@Url.Action("ArchiveProject", "Project", new { area = "DepartmentHead" })'
                                                    data-id="@project.Id"
                                                    data-message="Archive this project? It will be hidden from the Project Manager and employees.">
                                                <i class="fas fa-box-archive"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="emp-action-btn emp-action-unarchive" title="Unarchive"
                                                    data-action='@Url.Action("UnarchiveProject", "Project", new { area = "DepartmentHead" })'
                                                    data-id="@project.Id"
                                                    data-message="Unarchive this project? It will become visible again to the Project Manager and employees.">
                                                <i class="fas fa-box-open"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="noFilterResults" class="project-empty-state" style="display:none;">
                <div class="project-empty-icon"><i class="fas fa-magnifying-glass"></i></div>
                <div class="project-empty-title">No matching projects</div>
                <div class="project-empty-text">Try adjusting your search or filters.</div>
            </div>

            <div class="emp-pagination" id="paginationContainer" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem;padding:.75rem 1.25rem;box-sizing:border-box;">
                <div class="emp-pagination-info" id="paginationInfo"></div>
                <div class="emp-pagination-controls" id="paginationControls"></div>
            </div>
        }
        else
        {
            <div class="project-empty-state">
                <div class="project-empty-icon"><i class="fas fa-folder-open"></i></div>
                <div class="project-empty-title">No projects yet</div>
                <div class="project-empty-text">Create your first project using the button above to get started.</div>
            </div>
        }
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
(function () {
    let PAGE_SIZE = 10;
    let currentPage = 1;
    let filteredRows = [];

    const searchInput    = document.getElementById('projectSearch');
    const allRows        = Array.from(document.querySelectorAll('.emp-row'));
    const noResults      = document.getElementById('noFilterResults');
    const pageInfo       = document.getElementById('paginationInfo');
    const pageControls   = document.getElementById('paginationControls');
    const pageSizeSelect = document.getElementById('pageSizeSelect');
    const archiveSelect  = document.getElementById('archiveFilter');

    function applyFilters() {
        const query = (searchInput?.value ?? '').toLowerCase().trim();
        const archiveFilter = archiveSelect?.value ?? 'active';
        filteredRows = allRows.filter(row => {
            const nameMatch    = !query || (row.dataset.name || '').includes(query);
            const isArchived   = row.dataset.archived === 'true';
            const archiveMatch = archiveFilter === 'all' ? true
                : archiveFilter === 'inactive' ? isArchived : !isArchived;
            return nameMatch && archiveMatch;
        });
        currentPage = 1;
        render();
    }

    function render() {
        const total      = filteredRows.length;
        const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
        currentPage      = Math.min(currentPage, totalPages);
        const start = (currentPage - 1) * PAGE_SIZE;
        const end   = start + PAGE_SIZE;

        allRows.forEach(r => r.style.display = 'none');
        filteredRows.forEach((r, i) => {
            r.style.display = (i >= start && i < end) ? '' : 'none';
        });

        if (noResults)  noResults.style.display  = total === 0 ? '' : 'none';
        if (pageInfo)   pageInfo.textContent      = total === 0 ? '' : `Showing ${start + 1}\u2013${Math.min(end, total)} of ${total}`;

        if (pageControls) {
            pageControls.innerHTML = '';
            const makeBtn = (label, page, disabled, active) => {
                const btn = document.createElement('button');
                btn.className = 'emp-page-btn' + (active ? ' active' : '');
                btn.innerHTML = label;
                btn.disabled  = disabled;
                btn.addEventListener('click', () => { currentPage = page; render(); });
                return btn;
            };
            pageControls.appendChild(makeBtn('<i class="fas fa-chevron-left"></i>', currentPage - 1, currentPage === 1, false));
            const w = 2;
            for (let p = 1; p <= totalPages; p++) {
                if (p === 1 || p === totalPages || (p >= currentPage - w && p <= currentPage + w)) {
                    pageControls.appendChild(makeBtn(p, p, false, p === currentPage));
                } else if (p === currentPage - w - 1 || p === currentPage + w + 1) {
                    const el = document.createElement('span');
                    el.className = 'emp-page-ellipsis';
                    el.textContent = '\u2026';
                    pageControls.appendChild(el);
                }
            }
            pageControls.appendChild(makeBtn('<i class="fas fa-chevron-right"></i>', currentPage + 1, currentPage === totalPages, false));
        }
    }

    if (searchInput)  searchInput.addEventListener('input', applyFilters);
    if (archiveSelect) archiveSelect.addEventListener('change', applyFilters);
    if (pageSizeSelect) {
        pageSizeSelect.value = String(PAGE_SIZE);
        pageSizeSelect.addEventListener('change', function () {
            PAGE_SIZE = Math.max(5, parseInt(this.value, 10) || 10);
            currentPage = 1;
            render();
        });
    }

    filteredRows = allRows.slice();
    applyFilters();
})();
    </script>
    <script>
document.addEventListener('DOMContentLoaded', function () {
    const modal      = document.getElementById('confirmActionModal');
    const modalMsg   = document.getElementById('confirmActionMessage');
    const modalForm  = document.getElementById('confirmActionForm');
    const modalId    = document.getElementById('confirmActionId');
    const cancelBtn  = document.getElementById('confirmActionCancel');

    function showModal(actionUrl, id, message) {
        if (!modal || !modalForm || !modalId) return;
        modalForm.action     = actionUrl;
        modalId.value        = id;
        modalMsg.textContent = message || 'Are you sure?';
        modal.style.display  = 'flex';
        modal.setAttribute('aria-hidden', 'false');
    }

    function hideModal() {
        if (!modal) return;
        modal.style.display = 'none';
        modal.setAttribute('aria-hidden', 'true');
    }

    document.querySelectorAll('.emp-action-archive, .emp-action-unarchive').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const action  = btn.getAttribute('data-action');
            const id      = btn.getAttribute('data-id');
            const message = btn.getAttribute('data-message') || 'Are you sure?';
            if (!action || !id) return;
            showModal(action, id, message);
        });
    });

    cancelBtn?.addEventListener('click', hideModal);
    modal?.addEventListener('click', function (e) { if (e.target === modal) hideModal(); });
});
    </script>
}

@functions {
    private string GetStatusClass(string status) => status switch
    {
        "Unfinished" => "emp-status-pending",
        "Finished"   => "emp-status-approved",
        _             => "emp-status-default"
    };

    private string StripMiddleName(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return fullName;
        var parts = fullName.Trim().Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length <= 2) return fullName;
        return parts[0] + " " + parts[parts.Length - 1];
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
        {
            var s = parts[0];
            return s.Length >= 2 ? s.Substring(0, 2).ToUpperInvariant() : s.Substring(0, 1).ToUpperInvariant();
        }
        return char.ToUpperInvariant(parts[0][0]).ToString() + char.ToUpperInvariant(parts[1][0]).ToString();
    }
}
