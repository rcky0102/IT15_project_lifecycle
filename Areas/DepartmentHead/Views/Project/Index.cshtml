@model project_lifecycle.ViewModels.DepartmentHead.DepartmentHeadProjectIndexViewModel
@{
    ViewData["Title"] = "Projects";
    var hasValidationErrors = !ViewData.ModelState.IsValid;
    var totalMembers = Model.Projects.Sum(p => p.MemberCount);
}

<!-- ===== Page Title Hero ===== -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-diagram-project"></i></span>
                Projects
            </h1>
            <p class="emp-page-subtitle">Create and manage projects for your department</p>
        </div>
        <div class="emp-page-hero-right">
            <button type="button" class="emp-btn emp-btn-outline" data-bs-toggle="modal" data-bs-target="#createProjectModal">
                <i class="fas fa-plus"></i>
                <span>Create Project</span>
            </button>
        </div>
    </div>
</div>

<!-- ===== Alerts ===== -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="emp-alert emp-alert-success">
        <div class="emp-alert-icon"><i class="fas fa-check-circle"></i></div>
        <span>@TempData["SuccessMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="emp-alert emp-alert-error">
        <div class="emp-alert-icon"><i class="fas fa-exclamation-circle"></i></div>
        <span>@TempData["ErrorMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}
<!-- Stats bar removed -->

<!-- ===== Filters ===== -->
<div class="emp-filters-card">
    <div class="emp-filters-row">
        <div class="emp-search-group">
            <i class="fas fa-magnifying-glass emp-search-icon"></i>
            <input id="projectSearch" type="text" class="emp-search-input" placeholder="Search projects…" autocomplete="off" />
        </div>
        <div class="emp-select-group">
            <label for="pageSizeSelect" style="font-size:.82rem;color:#64748b;margin-right:.4rem;">Show</label>
            <select id="pageSizeSelect" class="emp-select" style="width:92px;">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
    </div>
</div>

<!-- ===== Table ===== -->
<div class="project-table-section">
    <div class="project-table-card">
        @if (Model.Projects.Any())
        {
            <div class="project-table-responsive">
                <table class="project-table" id="projectsTable">
                    <thead>
                        <tr>
                            <th>Project</th>
                            <th>Proposal</th>
                            <th>Project Manager</th>
                            <th>Timeline</th>
                            <th>Members</th>
                            <th>Status</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody id="projectsBody">
                        @foreach (var project in Model.Projects)
                        {
                            var duration = (project.EndDate - project.StartDate).Days;
                            <tr class="emp-row" data-name="@project.Name.ToLower()">
                                    <td>
                                        <div class="project-name-cell">
                                            <div class="project-name-icon">
                                                <i class="fas fa-folder"></i>
                                            </div>
                                            <div>
                                                <div class="project-name-text">@project.Name</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@project.ProposalTitle</td>
                                    <td>
                                        <span class="project-pm-badge">
                                            <i class="fas fa-user-tie"></i> @project.ProjectManagerName
                                        </span>
                                    </td>
                                    <td>
                                        <div class="project-timeline">
                                            <div class="project-timeline-dates">
                                                <span>@project.StartDate.ToString("MMM dd")</span>
                                                <i class="fas fa-arrow-right project-timeline-arrow"></i>
                                                <span>@project.EndDate.ToString("MMM dd, yyyy")</span>
                                            </div>
                                            <span class="project-timeline-duration">@duration days</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="project-member-count">
                                            <i class="fas fa-users"></i> @project.MemberCount
                                        </span>
                                    </td>
                                    <td>
                                        <span class="emp-badge-white" title="Status">
                                            <span class="emp-status-inline @GetStatusClass(project.Status)">
                                                <span class="emp-status-dot"></span>
                                                <span class="emp-status-text">@project.Status</span>
                                            </span>
                                        </span>
                                    </td>
                                    <td class="project-date">@project.DateCreated.ToString("MMM dd, yyyy")</td>
                                </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="noFilterResults" class="project-empty-state" style="display:none;">
                <div class="project-empty-icon"><i class="fas fa-magnifying-glass"></i></div>
                <div class="project-empty-title">No matching projects</div>
                <div class="project-empty-text">Try adjusting your search or filters.</div>
            </div>

            <div class="emp-pagination" id="paginationContainer" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem;padding:.75rem 1.25rem;box-sizing:border-box;">
                <div class="emp-pagination-info" id="paginationInfo"></div>
                <div class="emp-pagination-controls" id="paginationControls"></div>
            </div>
        }
        else
        {
            <div class="project-empty-state">
                <div class="project-empty-icon"><i class="fas fa-folder-open"></i></div>
                <div class="project-empty-title">No projects yet</div>
                <div class="project-empty-text">Create your first project using the button above to get started.</div>
            </div>
        }
    </div>
</div>

<!-- ========== Create Project Modal (Stepper) ========== -->
<div class="modal fade" id="createProjectModal" tabindex="-1" aria-labelledby="createProjectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content cp-modal">
            <form asp-area="DepartmentHead" asp-controller="Project" asp-action="Create" method="post" id="createProjectForm" novalidate>
                @Html.AntiForgeryToken()

                <!-- Gradient Header -->
                <div class="cp-modal-header">
                    <div>
                        <h5 class="cp-modal-title" id="createProjectModalLabel">
                            <i class="fas fa-plus-circle"></i> Create New Project
                        </h5>
                        <p class="cp-modal-subtitle" id="stepSubtitle">Step 1 of 3 &mdash; Project Details</p>
                    </div>
                    <button type="button" class="btn-close btn-close-white mt-1" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- Stepper Track -->
                <div class="cp-stepper">
                    <div class="cp-step active" data-step="1" role="button" tabindex="0" aria-label="Go to Details step">
                        <div class="cp-step-circle"><i class="fas fa-file-lines"></i></div>
                        <span class="cp-step-label">Details</span>
                    </div>
                    <div class="cp-step-line" id="stepLine1"></div>
                    <div class="cp-step" data-step="2" role="button" tabindex="0" aria-label="Go to Schedule step">
                        <div class="cp-step-circle"><i class="fas fa-calendar-check"></i></div>
                        <span class="cp-step-label">Schedule</span>
                    </div>
                    <div class="cp-step-line" id="stepLine2"></div>
                    <div class="cp-step" data-step="3" role="button" tabindex="0" aria-label="Go to Team step">
                        <div class="cp-step-circle"><i class="fas fa-users-gear"></i></div>
                        <span class="cp-step-label">Team</span>
                    </div>
                </div>

                <!-- Body -->
                <div class="modal-body cp-modal-body">
                    @if (hasValidationErrors)
                    {
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    }
                    @if (!Model.AvailableProposals.Any())
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            No approved proposals are currently available for project creation.
                        </div>
                    }

                    <!-- ===== Step 1: Project Details ===== -->
                    <div class="cp-step-panel" id="stepPanel1">
                        <div class="modal-form-section">
                            <div class="modal-section-title">
                                <i class="fas fa-info-circle"></i> Project Details
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="CreateProject.Name" class="form-label"></label>
                                    <input asp-for="CreateProject.Name" class="form-control" placeholder="Enter project name" />
                                    <span asp-validation-for="CreateProject.Name" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CreateProject.ProjectProposalId" class="form-label"></label>
                                    <select asp-for="CreateProject.ProjectProposalId" class="form-select" asp-items="Model.AvailableProposals">
                                        <option value="">-- Select Proposal --</option>
                                    </select>
                                    <span asp-validation-for="CreateProject.ProjectProposalId" class="text-danger"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="CreateProject.Description" class="form-label"></label>
                                    <textarea asp-for="CreateProject.Description" rows="3" class="form-control" placeholder="Describe the project scope and objectives..."></textarea>
                                    <span asp-validation-for="CreateProject.Description" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ===== Step 2: Schedule & Assignment ===== -->
                    <div class="cp-step-panel" id="stepPanel2" style="display:none;">
                        <div class="modal-form-section">
                            <div class="modal-section-title">
                                <i class="fas fa-user-check"></i> Assignment &amp; Schedule
                            </div>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label asp-for="CreateProject.ProjectManagerId" class="form-label"></label>
                                    <select asp-for="CreateProject.ProjectManagerId" class="form-select" asp-items="Model.AvailableProjectManagers">
                                        <option value="">-- Select Project Manager --</option>
                                    </select>
                                    <span asp-validation-for="CreateProject.ProjectManagerId" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CreateProject.StartDate" class="form-label"></label>
                                    <input asp-for="CreateProject.StartDate" class="form-control" type="date" />
                                    <span asp-validation-for="CreateProject.StartDate" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CreateProject.EndDate" class="form-label"></label>
                                    <input asp-for="CreateProject.EndDate" class="form-control" type="date" />
                                    <span asp-validation-for="CreateProject.EndDate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Holidays -->
                        <div id="holidaysSection" style="display: none;">
                            <div class="modal-form-section" style="padding: 0; overflow: hidden;">
                                <div class="card modal-holidays-card" style="border: none !important; box-shadow: none;">
                                    <div class="card-header d-flex align-items-center gap-2 py-2">
                                        <i class="fas fa-calendar-day text-warning"></i>
                                        <strong class="text-warning">Public Holidays (Philippines)</strong>
                                        <span id="holidayCount" class="badge bg-warning text-dark ms-auto">0</span>
                                    </div>
                                    <div class="card-body p-0">
                                        <div id="holidaysLoading" class="text-center py-3" style="display: none;">
                                            <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
                                            <span class="ms-2 text-muted">Loading holidays...</span>
                                        </div>
                                        <div id="holidaysError" class="text-center py-3 text-danger" style="display: none;">
                                            <i class="fas fa-exclamation-triangle"></i>
                                            <span class="ms-1">Could not load holidays. Please check your internet connection.</span>
                                        </div>
                                        <div id="holidaysEmpty" class="text-center py-3 text-muted" style="display: none;">
                                            <i class="fas fa-check-circle text-success"></i>
                                            <span class="ms-1">No public holidays in this date range.</span>
                                        </div>
                                        <table id="holidaysTable" class="table table-sm table-hover mb-0" style="display: none;">
                                            <thead>
                                                <tr>
                                                    <th style="width: 130px;">Date</th>
                                                    <th>Holiday</th>
                                                    <th>Local Name</th>
                                                    <th style="width: 80px;">Day</th>
                                                </tr>
                                            </thead>
                                            <tbody id="holidaysTableBody"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ===== Step 3: Team Members ===== -->
                    <div class="cp-step-panel" id="stepPanel3" style="display:none;">
                        <div class="modal-form-section">
                            <div class="modal-members-header">
                                <h6>
                                    <i class="fas fa-users-gear"></i> Team Members
                                    <span style="font-weight:400;font-size:.7rem;text-transform:none;letter-spacing:0;color:#94a3b8;">(Optional)</span>
                                </h6>
                                <button type="button" id="addMemberRowBtn" class="btn-add-member">
                                    <i class="fas fa-user-plus"></i> Add Member
                                </button>
                            </div>

                            <div id="memberRowsContainer">
                                @if (Model.CreateProject.MemberEmployeeIds.Count == Model.CreateProject.MemberProjectRoleIds.Count && Model.CreateProject.MemberEmployeeIds.Any())
                                {
                                    @for (var i = 0; i < Model.CreateProject.MemberEmployeeIds.Count; i++)
                                    {
                                        <div class="member-row-modern member-row">
                                            <div class="member-field">
                                                <select name="CreateProject.MemberEmployeeIds" class="form-select">
                                                    <option value="">-- Select Employee --</option>
                                                    @foreach (var employee in Model.AvailableEmployees)
                                                    {
                                                        if (employee.Value == Model.CreateProject.MemberEmployeeIds[i].ToString())
                                                        {
                                                            <option value="@employee.Value" selected>@employee.Text</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@employee.Value">@employee.Text</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="member-field">
                                                <select name="CreateProject.MemberProjectRoleIds" class="form-select">
                                                    <option value="">-- Select Role --</option>
                                                    @foreach (var role in Model.AvailableProjectRoles)
                                                    {
                                                        if (role.Value == Model.CreateProject.MemberProjectRoleIds[i].ToString())
                                                        {
                                                            <option value="@role.Value" selected>@role.Text</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@role.Value">@role.Text</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <button type="button" class="btn-remove-member remove-member-row" title="Remove member">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    }
                                }
                            </div>

                            <div id="membersEmptyHint" class="members-empty-hint" @(Model.CreateProject.MemberEmployeeIds.Any() ? "style=display:none" : "")>
                                <i class="fas fa-user-plus"></i>
                                Click "Add Member" to assign team members to this project
                            </div>

                            <template id="memberRowTemplate">
                                <div class="member-row-modern member-row">
                                    <div class="member-field">
                                        <select name="CreateProject.MemberEmployeeIds" class="form-select">
                                            <option value="">-- Select Employee --</option>
                                            @foreach (var employee in Model.AvailableEmployees)
                                            {
                                                <option value="@employee.Value">@employee.Text</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="member-field">
                                        <select name="CreateProject.MemberProjectRoleIds" class="form-select">
                                            <option value="">-- Select Role --</option>
                                            @foreach (var role in Model.AvailableProjectRoles)
                                            {
                                                <option value="@role.Value">@role.Text</option>
                                            }
                                        </select>
                                    </div>
                                    <button type="button" class="btn-remove-member remove-member-row" title="Remove member">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </template>
                        </div>
                    </div>
                </div>

                <!-- Stepper Footer -->
                <div class="cp-modal-footer">
                    <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">Cancel</button>
                    <div class="cp-step-nav">
                        <button type="button" class="btn-modal-prev" id="stepBtnPrev" style="display:none;">
                            <i class="fas fa-chevron-left"></i> Back
                        </button>
                        <button type="button" class="btn-modal-next" id="stepBtnNext">
                            Next <i class="fas fa-chevron-right"></i>
                        </button>
                        <button type="submit" class="btn-modal-submit" id="stepBtnSubmit" style="display:none;" @(Model.AvailableProposals.Any() ? "" : "disabled")>
                            <i class="fas fa-rocket"></i> Create Project
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
(function () {
    let PAGE_SIZE = 10;
    let currentPage = 1;
    let filteredRows = [];

    const searchInput    = document.getElementById('projectSearch');
    const allRows        = Array.from(document.querySelectorAll('.emp-row'));
    const noResults      = document.getElementById('noFilterResults');
    const pageInfo       = document.getElementById('paginationInfo');
    const pageControls   = document.getElementById('paginationControls');
    const pageSizeSelect = document.getElementById('pageSizeSelect');

    function applyFilters() {
        const query = (searchInput?.value ?? '').toLowerCase().trim();
        filteredRows = allRows.filter(row => {
            return !query || (row.dataset.name || '').includes(query);
        });
        currentPage = 1;
        render();
    }

    function render() {
        const total      = filteredRows.length;
        const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
        currentPage      = Math.min(currentPage, totalPages);
        const start = (currentPage - 1) * PAGE_SIZE;
        const end   = start + PAGE_SIZE;

        allRows.forEach(r => r.style.display = 'none');
        filteredRows.forEach((r, i) => {
            r.style.display = (i >= start && i < end) ? '' : 'none';
        });

        if (noResults)  noResults.style.display  = total === 0 ? '' : 'none';
        if (pageInfo)   pageInfo.textContent      = total === 0 ? '' : `Showing ${start + 1}\u2013${Math.min(end, total)} of ${total}`;

        if (pageControls) {
            pageControls.innerHTML = '';
            const makeBtn = (label, page, disabled, active) => {
                const btn = document.createElement('button');
                btn.className = 'emp-page-btn' + (active ? ' active' : '');
                btn.innerHTML = label;
                btn.disabled  = disabled;
                btn.addEventListener('click', () => { currentPage = page; render(); });
                return btn;
            };
            pageControls.appendChild(makeBtn('<i class="fas fa-chevron-left"></i>', currentPage - 1, currentPage === 1, false));
            const w = 2;
            for (let p = 1; p <= totalPages; p++) {
                if (p === 1 || p === totalPages || (p >= currentPage - w && p <= currentPage + w)) {
                    pageControls.appendChild(makeBtn(p, p, false, p === currentPage));
                } else if (p === currentPage - w - 1 || p === currentPage + w + 1) {
                    const el = document.createElement('span');
                    el.className = 'emp-page-ellipsis';
                    el.textContent = '\u2026';
                    pageControls.appendChild(el);
                }
            }
            pageControls.appendChild(makeBtn('<i class="fas fa-chevron-right"></i>', currentPage + 1, currentPage === totalPages, false));
        }
    }

    if (searchInput)  searchInput.addEventListener('input', applyFilters);
    if (pageSizeSelect) {
        pageSizeSelect.value = String(PAGE_SIZE);
        pageSizeSelect.addEventListener('change', function () {
            PAGE_SIZE = Math.max(5, parseInt(this.value, 10) || 10);
            currentPage = 1;
            render();
        });
    }

    filteredRows = allRows.slice();
    render();
})();
    </script>
    <script>
    // ── Stepper Logic ──
    (function () {
        const TOTAL = 3;
        let current = 1;

        const subtitles = [
            'Step 1 of 3 \u2014 Project Details',
            'Step 2 of 3 \u2014 Schedule & Assignment',
            'Step 3 of 3 \u2014 Team Members'
        ];

        const stepSubtitle = document.getElementById('stepSubtitle');
        const btnPrev      = document.getElementById('stepBtnPrev');
        const btnNext      = document.getElementById('stepBtnNext');
        const btnSubmit    = document.getElementById('stepBtnSubmit');
        const modalEl      = document.getElementById('createProjectModal');

        function goTo(step) {
            for (let i = 1; i <= TOTAL; i++) {
                document.getElementById('stepPanel' + i).style.display = i === step ? '' : 'none';
            }
            document.querySelectorAll('.cp-step').forEach(el => {
                const s = parseInt(el.dataset.step);
                el.classList.toggle('active', s === step);
                el.classList.toggle('completed', s < step);
            });
            for (let i = 1; i < TOTAL; i++) {
                const line = document.getElementById('stepLine' + i);
                if (line) line.classList.toggle('completed', i < step);
            }
            btnPrev.style.display   = step > 1 ? '' : 'none';
            btnNext.style.display   = step < TOTAL ? '' : 'none';
            btnSubmit.style.display = step === TOTAL ? '' : 'none';
            if (stepSubtitle) stepSubtitle.textContent = subtitles[step - 1];
            current = step;
        }

        function validateCurrent() {
            const panel = document.getElementById('stepPanel' + current);
            let valid = true;
            panel.querySelectorAll('input, select, textarea').forEach(el => {
                if (el.hasAttribute('required') || el.hasAttribute('data-val-required')) {
                    const empty = !el.value || !el.value.trim();
                    el.classList.toggle('is-invalid', empty);
                    if (empty) valid = false;
                }
            });
            return valid;
        }

        btnNext.addEventListener('click', () => {
            if (validateCurrent()) goTo(current + 1);
        });
        btnPrev.addEventListener('click', () => goTo(current - 1));

        // clickable and keyboard-accessible steps
        const stepEls = Array.from(document.querySelectorAll('.cp-step'));
        function attemptNavigate(target, skipValidation) {
            target = Number(target);
            if (!target || target === current) return;
            // when skipValidation is true (clicked step), allow jumping freely
            if (!skipValidation && target > current) {
                // ensure current is valid before moving forward
                if (!validateCurrent()) return;
            }
            goTo(target);
        }

        stepEls.forEach(el => {
            el.addEventListener('click', () => attemptNavigate(el.dataset.step, true));
            el.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    attemptNavigate(el.dataset.step, true);
                }
            });
        });

        if (modalEl) {
            modalEl.addEventListener('hidden.bs.modal', () => goTo(1));
        }

        goTo(1);
    })();
    </script>
    <script>
        (function () {
            var container = document.getElementById('memberRowsContainer');
            var addBtn = document.getElementById('addMemberRowBtn');
            var template = document.getElementById('memberRowTemplate');
            var modalElement = document.getElementById('createProjectModal');
            var emptyHint = document.getElementById('membersEmptyHint');

            function updateEmptyHint() {
                if (!emptyHint) return;
                var rows = container ? container.querySelectorAll('.member-row') : [];
                emptyHint.style.display = rows.length > 0 ? 'none' : '';
            }

            if (addBtn && container && template) {
                addBtn.addEventListener('click', function () {
                    container.insertAdjacentHTML('beforeend', template.innerHTML);
                    updateEmptyHint();
                });
            }

            if (container) {
                container.addEventListener('click', function (event) {
                    var target = event.target;
                    var button = target.closest('.remove-member-row');
                    if (!button) return;

                    var row = button.closest('.member-row');
                    if (row) {
                        row.style.opacity = '0';
                        row.style.transform = 'translateX(20px)';
                        row.style.transition = 'all 0.25s ease';
                        setTimeout(function () {
                            row.remove();
                            updateEmptyHint();
                        }, 250);
                    }
                });
            }

            var shouldOpenModal = '@((ViewData["OpenCreateModal"] as bool?) == true ? "true" : "false")' === 'true';
            if (shouldOpenModal && modalElement && window.bootstrap) {
                var modal = new bootstrap.Modal(modalElement);
                modal.show();
            }

            // --- Holiday Fetching Logic ---
            var startDateInput = document.getElementById('CreateProject_StartDate');
            var endDateInput = document.getElementById('CreateProject_EndDate');
            var holidaysSection = document.getElementById('holidaysSection');
            var holidaysLoading = document.getElementById('holidaysLoading');
            var holidaysError = document.getElementById('holidaysError');
            var holidaysEmpty = document.getElementById('holidaysEmpty');
            var holidaysTable = document.getElementById('holidaysTable');
            var holidaysTableBody = document.getElementById('holidaysTableBody');
            var holidayCount = document.getElementById('holidayCount');
            var holidayFetchTimer = null;

            var dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

            function fetchHolidays() {
                var startDate = startDateInput ? startDateInput.value : '';
                var endDate = endDateInput ? endDateInput.value : '';

                if (!startDate || !endDate) {
                    holidaysSection.style.display = 'none';
                    return;
                }

                if (new Date(endDate) < new Date(startDate)) {
                    holidaysSection.style.display = 'none';
                    return;
                }

                holidaysSection.style.display = '';
                holidaysLoading.style.display = '';
                holidaysError.style.display = 'none';
                holidaysEmpty.style.display = 'none';
                holidaysTable.style.display = 'none';
                holidaysTableBody.innerHTML = '';
                holidayCount.textContent = '...';

                var url = '@Url.Action("GetHolidays", "Project", new { area = "DepartmentHead" })'
                    + '?startDate=' + encodeURIComponent(startDate)
                    + '&endDate=' + encodeURIComponent(endDate);

                fetch(url)
                    .then(function (response) {
                        if (!response.ok) throw new Error('API error');
                        return response.json();
                    })
                    .then(function (holidays) {
                        holidaysLoading.style.display = 'none';

                        if (!holidays || holidays.length === 0) {
                            holidaysEmpty.style.display = '';
                            holidayCount.textContent = '0';
                            return;
                        }

                        holidayCount.textContent = holidays.length;
                        var html = '';
                        for (var i = 0; i < holidays.length; i++) {
                            var h = holidays[i];
                            var d = new Date(h.date + 'T00:00:00');
                            var dayName = dayNames[d.getDay()];
                            var isWeekend = d.getDay() === 0 || d.getDay() === 6;
                            var rowClass = isWeekend ? 'class="table-warning"' : '';
                            html += '<tr ' + rowClass + '>'
                                + '<td><i class="fas fa-star text-warning me-1" style="font-size:0.7em;"></i>' + h.date + '</td>'
                                + '<td>' + escapeHtml(h.name) + '</td>'
                                + '<td>' + escapeHtml(h.localName) + '</td>'
                                + '<td><span class="badge ' + (isWeekend ? 'bg-secondary' : 'bg-info text-dark') + '">' + dayName + '</span></td>'
                                + '</tr>';
                        }
                        holidaysTableBody.innerHTML = html;
                        holidaysTable.style.display = '';
                    })
                    .catch(function () {
                        holidaysLoading.style.display = 'none';
                        holidaysError.style.display = '';
                        holidayCount.textContent = '!';
                    });
            }

            function escapeHtml(str) {
                var div = document.createElement('div');
                div.appendChild(document.createTextNode(str));
                return div.innerHTML;
            }

            function debouncedFetchHolidays() {
                if (holidayFetchTimer) clearTimeout(holidayFetchTimer);
                holidayFetchTimer = setTimeout(fetchHolidays, 400);
            }

            if (startDateInput) startDateInput.addEventListener('change', debouncedFetchHolidays);
            if (endDateInput) endDateInput.addEventListener('change', debouncedFetchHolidays);

            // Auto-fetch if dates are already filled (e.g. validation error re-render)
            if (startDateInput && endDateInput && startDateInput.value && endDateInput.value) {
                fetchHolidays();
            }
        })();
    </script>
}

@functions {
    private string GetStatusClass(string status) => status switch
    {
        "Unfinished" => "emp-status-pending",
        "Finished"   => "emp-status-approved",
        _             => "emp-status-default"
    };
}
