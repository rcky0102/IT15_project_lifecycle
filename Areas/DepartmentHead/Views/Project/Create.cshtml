@model project_lifecycle.ViewModels.DepartmentHead.DepartmentHeadProjectIndexViewModel
@{
    ViewData["Title"] = "Create Project";
}

<!-- ===== Hero ===== -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-plus-circle"></i></span>
                Create Project
            </h1>
            <p class="emp-page-subtitle">Set up a new project for your department</p>
        </div>
        <div class="emp-page-hero-right">
            <a asp-area="DepartmentHead" asp-controller="Project" asp-action="Index" class="emp-btn emp-btn-outline">
                <i class="fas fa-arrow-left"></i>
                <span>Back to Projects</span>
            </a>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="emp-alert emp-alert-success">
        <div class="emp-alert-icon"><i class="fas fa-check-circle"></i></div>
        <span>@TempData["SuccessMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="emp-alert emp-alert-error">
        <div class="emp-alert-icon"><i class="fas fa-exclamation-circle"></i></div>
        <span>@TempData["ErrorMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}

@if (!Model.AvailableProposals.Any())
{
    <div class="emp-alert emp-alert-error" style="border-left-color:#f59e0b;background:#fffbeb;">
        <div class="emp-alert-icon" style="color:#f59e0b;"><i class="fas fa-exclamation-triangle"></i></div>
        <span>No approved proposals are currently available for project creation.</span>
    </div>
}

<!-- ===== Form Card ===== -->
<div class="emp-form-card">
    <form asp-area="DepartmentHead" asp-controller="Project" asp-action="Create" method="post" class="emp-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- ── Section 1: Project Details ── -->
        <div class="emp-form-section">
            <div class="emp-form-section-title"><i class="fas fa-file-lines"></i> Project Details</div>

            <div class="emp-form-row">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                    <div>
                        <label asp-for="CreateProject.Name" class="emp-form-label"></label>
                        <input asp-for="CreateProject.Name" class="emp-form-control" placeholder="Enter project name" />
                        <span asp-validation-for="CreateProject.Name" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="CreateProject.ProjectProposalId" class="emp-form-label"></label>
                        <select asp-for="CreateProject.ProjectProposalId" class="emp-form-control" asp-items="Model.AvailableProposals">
                            <option value="">-- Select Proposal --</option>
                        </select>
                        <span asp-validation-for="CreateProject.ProjectProposalId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="emp-form-row">
                <label asp-for="CreateProject.Description" class="emp-form-label"></label>
                <textarea asp-for="CreateProject.Description" rows="3" class="emp-form-control" placeholder="Describe the project scope and objectives..."></textarea>
                <span asp-validation-for="CreateProject.Description" class="text-danger"></span>
            </div>
        </div>

        <!-- ── Section 2: Schedule & Assignment ── -->
        <div class="emp-form-section">
            <div class="emp-form-section-title"><i class="fas fa-calendar-check"></i> Schedule &amp; Assignment</div>

            <div class="emp-form-row">
                <label asp-for="CreateProject.ProjectManagerId" class="emp-form-label"></label>
                <select asp-for="CreateProject.ProjectManagerId" class="emp-form-control" asp-items="Model.AvailableProjectManagers">
                    <option value="">-- Select Project Manager --</option>
                </select>
                <span asp-validation-for="CreateProject.ProjectManagerId" class="text-danger"></span>
            </div>

            <div class="emp-form-row">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                    <div>
                        <label asp-for="CreateProject.StartDate" class="emp-form-label"></label>
                        <input asp-for="CreateProject.StartDate" class="emp-form-control" type="date" />
                        <span asp-validation-for="CreateProject.StartDate" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="CreateProject.EndDate" class="emp-form-label"></label>
                        <input asp-for="CreateProject.EndDate" class="emp-form-control" type="date" />
                        <span asp-validation-for="CreateProject.EndDate" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Holidays -->
            <div id="holidaysSection" style="display: none;">
                <div class="emp-form-row" style="padding: 0; overflow: hidden;">
                    <div class="card" style="border: 1px solid #fde68a; box-shadow: none; border-radius: 10px; overflow: hidden;">
                        <div class="card-header d-flex align-items-center gap-2 py-2" style="background: #fffbeb;">
                            <i class="fas fa-calendar-day text-warning"></i>
                            <strong class="text-warning">Public Holidays (Philippines)</strong>
                            <span id="holidayCount" class="badge bg-warning text-dark ms-auto">0</span>
                        </div>
                        <div class="card-body p-0">
                            <div id="holidaysLoading" class="text-center py-3" style="display: none;">
                                <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
                                <span class="ms-2 text-muted">Loading holidays...</span>
                            </div>
                            <div id="holidaysError" class="text-center py-3 text-danger" style="display: none;">
                                <i class="fas fa-exclamation-triangle"></i>
                                <span class="ms-1">Could not load holidays. Please check your internet connection.</span>
                            </div>
                            <div id="holidaysEmpty" class="text-center py-3 text-muted" style="display: none;">
                                <i class="fas fa-check-circle text-success"></i>
                                <span class="ms-1">No public holidays in this date range.</span>
                            </div>
                            <table id="holidaysTable" class="table table-sm table-hover mb-0" style="display: none;">
                                <thead>
                                    <tr>
                                        <th style="width: 130px;">Date</th>
                                        <th>Holiday</th>
                                        <th>Local Name</th>
                                        <th style="width: 80px;">Day</th>
                                    </tr>
                                </thead>
                                <tbody id="holidaysTableBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Section 3: Team Members ── -->
        <div class="emp-form-section">
            <div class="emp-form-section-title" style="display:flex;align-items:center;justify-content:space-between;">
                <span>
                    <i class="fas fa-users-gear"></i> Team Members
                    <span style="font-weight:400;font-size:.75rem;color:#94a3b8;">(Optional)</span>
                </span>
                <button type="button" id="addMemberRowBtn" class="emp-btn emp-btn-outline" style="padding:.3rem .9rem;font-size:.85rem;">
                    <i class="fas fa-user-plus"></i> Add Member
                </button>
            </div>

            <div id="memberRowsContainer">
                @if (Model.CreateProject.MemberEmployeeIds.Count == Model.CreateProject.MemberProjectRoleIds.Count && Model.CreateProject.MemberEmployeeIds.Any())
                {
                    @for (var i = 0; i < Model.CreateProject.MemberEmployeeIds.Count; i++)
                    {
                        <div class="member-row-modern member-row">
                            <div class="member-field">
                                <select name="CreateProject.MemberEmployeeIds" class="form-select">
                                    <option value="">-- Select Employee --</option>
                                    @foreach (var employee in Model.AvailableEmployees)
                                    {
                                        if (employee.Value == Model.CreateProject.MemberEmployeeIds[i].ToString())
                                        {
                                            <option value="@employee.Value" selected>@employee.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@employee.Value">@employee.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="member-field">
                                <select name="CreateProject.MemberProjectRoleIds" class="form-select">
                                    <option value="">-- Select Role --</option>
                                    @foreach (var role in Model.AvailableProjectRoles)
                                    {
                                        if (role.Value == Model.CreateProject.MemberProjectRoleIds[i].ToString())
                                        {
                                            <option value="@role.Value" selected>@role.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@role.Value">@role.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                            <button type="button" class="btn-remove-member remove-member-row" title="Remove member">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    }
                }
            </div>

            <div id="membersEmptyHint" class="members-empty-hint" @(Model.CreateProject.MemberEmployeeIds.Any() ? "style=display:none" : "")>
                <i class="fas fa-user-plus"></i>
                Click "Add Member" to assign team members to this project
            </div>

            <template id="memberRowTemplate">
                <div class="member-row-modern member-row">
                    <div class="member-field">
                        <select name="CreateProject.MemberEmployeeIds" class="form-select">
                            <option value="">-- Select Employee --</option>
                            @foreach (var employee in Model.AvailableEmployees)
                            {
                                <option value="@employee.Value">@employee.Text</option>
                            }
                        </select>
                    </div>
                    <div class="member-field">
                        <select name="CreateProject.MemberProjectRoleIds" class="form-select">
                            <option value="">-- Select Role --</option>
                            @foreach (var role in Model.AvailableProjectRoles)
                            {
                                <option value="@role.Value">@role.Text</option>
                            }
                        </select>
                    </div>
                    <button type="button" class="btn-remove-member remove-member-row" title="Remove member">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </div>
            </template>
        </div>

        <!-- ── Form Actions ── -->
        <div class="emp-form-actions" style="justify-content:flex-end;">
            <a asp-area="DepartmentHead" asp-controller="Project" asp-action="Index" class="emp-btn emp-btn-secondary">
                <i class="fas fa-times"></i> Cancel
            </a>
            <button type="submit" class="emp-btn emp-btn-primary" @(Model.AvailableProposals.Any() ? "" : "disabled")>
                <i class="fas fa-rocket"></i> Create Project
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function () {
        var container = document.getElementById('memberRowsContainer');
        var addBtn    = document.getElementById('addMemberRowBtn');
        var template  = document.getElementById('memberRowTemplate');
        var emptyHint = document.getElementById('membersEmptyHint');

        function updateEmptyHint() {
            if (!emptyHint) return;
            var rows = container ? container.querySelectorAll('.member-row') : [];
            emptyHint.style.display = rows.length > 0 ? 'none' : '';
        }

        if (addBtn && container && template) {
            addBtn.addEventListener('click', function () {
                container.insertAdjacentHTML('beforeend', template.innerHTML);
                updateEmptyHint();
            });
        }

        if (container) {
            container.addEventListener('click', function (event) {
                var button = event.target.closest('.remove-member-row');
                if (!button) return;
                var row = button.closest('.member-row');
                if (row) {
                    row.style.opacity    = '0';
                    row.style.transform  = 'translateX(20px)';
                    row.style.transition = 'all 0.25s ease';
                    setTimeout(function () { row.remove(); updateEmptyHint(); }, 250);
                }
            });
        }
    })();
    </script>
    <script>
    (function () {
        var startDateInput   = document.getElementById('CreateProject_StartDate');
        var endDateInput     = document.getElementById('CreateProject_EndDate');
        var holidaysSection  = document.getElementById('holidaysSection');
        var holidaysLoading  = document.getElementById('holidaysLoading');
        var holidaysError    = document.getElementById('holidaysError');
        var holidaysEmpty    = document.getElementById('holidaysEmpty');
        var holidaysTable    = document.getElementById('holidaysTable');
        var holidaysTableBody = document.getElementById('holidaysTableBody');
        var holidayCount     = document.getElementById('holidayCount');
        var holidayFetchTimer = null;
        var dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

        function fetchHolidays() {
            var startDate = startDateInput ? startDateInput.value : '';
            var endDate   = endDateInput   ? endDateInput.value   : '';

            if (!startDate || !endDate || new Date(endDate) < new Date(startDate)) {
                holidaysSection.style.display = 'none';
                return;
            }

            holidaysSection.style.display  = '';
            holidaysLoading.style.display  = '';
            holidaysError.style.display    = 'none';
            holidaysEmpty.style.display    = 'none';
            holidaysTable.style.display    = 'none';
            holidaysTableBody.innerHTML    = '';
            holidayCount.textContent       = '...';

            var url = '@Url.Action("GetHolidays", "Project", new { area = "DepartmentHead" })'
                    + '?startDate=' + encodeURIComponent(startDate)
                    + '&endDate='   + encodeURIComponent(endDate);

            fetch(url)
                .then(function (r) { if (!r.ok) throw new Error('API error'); return r.json(); })
                .then(function (holidays) {
                    holidaysLoading.style.display = 'none';
                    if (!holidays || holidays.length === 0) {
                        holidaysEmpty.style.display  = '';
                        holidayCount.textContent     = '0';
                        return;
                    }
                    holidayCount.textContent = holidays.length;
                    var html = '';
                    for (var i = 0; i < holidays.length; i++) {
                        var h   = holidays[i];
                        var d   = new Date(h.date + 'T00:00:00');
                        var day = dayNames[d.getDay()];
                        var wkd = d.getDay() === 0 || d.getDay() === 6;
                        html += '<tr' + (wkd ? ' class="table-warning"' : '') + '>'
                              + '<td><i class="fas fa-star text-warning me-1" style="font-size:.7em;"></i>' + h.date + '</td>'
                              + '<td>' + escapeHtml(h.name) + '</td>'
                              + '<td>' + escapeHtml(h.localName) + '</td>'
                              + '<td><span class="badge ' + (wkd ? 'bg-secondary' : 'bg-info text-dark') + '">' + day + '</span></td>'
                              + '</tr>';
                    }
                    holidaysTableBody.innerHTML = html;
                    holidaysTable.style.display = '';
                })
                .catch(function () {
                    holidaysLoading.style.display = 'none';
                    holidaysError.style.display   = '';
                    holidayCount.textContent      = '!';
                });
        }

        function escapeHtml(str) {
            var d = document.createElement('div');
            d.appendChild(document.createTextNode(str));
            return d.innerHTML;
        }

        function debounced() {
            if (holidayFetchTimer) clearTimeout(holidayFetchTimer);
            holidayFetchTimer = setTimeout(fetchHolidays, 400);
        }

        if (startDateInput) startDateInput.addEventListener('change', debounced);
        if (endDateInput)   endDateInput.addEventListener('change', debounced);

        // Auto-fetch on validation error re-render
        if (startDateInput && endDateInput && startDateInput.value && endDateInput.value) {
            fetchHolidays();
        }
    })();
    </script>
}
