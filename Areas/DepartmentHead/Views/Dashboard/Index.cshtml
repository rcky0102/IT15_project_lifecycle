@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/DepartmentHead/Layout.cshtml";
}

<div class="dashboard-container">
    <!-- Dashboard Header -->
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="dashboard-title">Department Head Dashboard</h1>
            <p class="dashboard-subtitle">@ViewData["DepartmentName"] &mdash; Overview &amp; Team Performance</p>
        </div>
        <div class="header-actions">
            <a href="@Url.Action("Index", "Proposal", new { area = "DepartmentHead" })" class="btn btn-ocean">
                <i class="fas fa-file-lines"></i>
                View Proposals
            </a>
            <a href="@Url.Action("Index", "Project", new { area = "DepartmentHead" })" class="btn btn-outline-ocean">
                <i class="fas fa-diagram-project"></i>
                View Projects
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <style>
        .stat-card-link { display: block; color: inherit; text-decoration: none; }
        .stat-card-link:hover { text-decoration: none; }
        .stat-card-link .stat-card { transition: transform .12s ease, box-shadow .12s ease; }
        .stat-card-link:hover .stat-card { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(20,40,60,0.06); }
        .stat-card { display: flex; flex-direction: column; justify-content: space-between; align-items: stretch; min-height: 120px; padding: 1rem; }
        .stat-card-top { display: flex; align-items: center; gap: 1rem; }
        .stat-card .stat-icon { flex: 0 0 auto; }
        .stat-card .stat-content { flex: 1 1 auto; }
        .stat-card .stat-number { align-self: flex-end; margin: 0; margin-top: 0.5rem; font-size: 1.75rem; font-weight: 700; line-height: 1; padding-top: 0.5rem; border-top: 1px solid rgba(0,0,0,0.06); }
    </style>
    <div class="stats-grid">
        <a href="@Url.Action("Index", "Proposal", new { area = "DepartmentHead" })" class="stat-card-link">
            <div class="stat-card">
                <div class="stat-card-top">
                    <div class="stat-icon primary">
                        <i class="fas fa-file-lines"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Total Proposals</div>
                        <div class="stat-change neutral">
                            <i class="fas fa-building"></i> @ViewData["DepartmentName"]
                        </div>
                    </div>
                </div>
                <div class="stat-number">@ViewData["TotalProposals"]</div>
            </div>
        </a>

        <a href="@Url.Action("Index", "Proposal", new { area = "DepartmentHead", status = "Pending" })" class="stat-card-link">
            <div class="stat-card">
                <div class="stat-card-top">
                    <div class="stat-icon warning">
                        <i class="fas fa-file-circle-exclamation"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Pending Proposals</div>
                        <div class="stat-change @(((int)ViewData["PendingProposals"]!) > 0 ? "negative" : "positive")">
                            <i class="fas fa-@(((int)ViewData["PendingProposals"]!) > 0 ? "circle-exclamation" : "check")"></i>
                            @(((int)ViewData["PendingProposals"]!) > 0 ? "Needs review" : "All reviewed")
                        </div>
                    </div>
                </div>
                <div class="stat-number">@ViewData["PendingProposals"]</div>
            </div>
        </a>

        <a href="@Url.Action("Index", "Project", new { area = "DepartmentHead" })" class="stat-card-link">
            <div class="stat-card">
                <div class="stat-card-top">
                    <div class="stat-icon success">
                        <i class="fas fa-diagram-project"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Active Projects</div>
                        <div class="stat-change neutral">
                            <i class="fas fa-spinner"></i> Unfinished
                        </div>
                    </div>
                </div>
                <div class="stat-number">@ViewData["ActiveProjects"]</div>
            </div>
        </a>

        <a href="@Url.Action("Index", "Project", new { area = "DepartmentHead" })" class="stat-card-link">
            <div class="stat-card">
                <div class="stat-card-top">
                    <div class="stat-icon danger">
                        <i class="fas fa-flag-checkered"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Finished Projects</div>
                        <div class="stat-change positive">
                            <i class="fas fa-check-circle"></i> Completed
                        </div>
                    </div>
                </div>
                <div class="stat-number">@ViewData["FinishedProjects"]</div>
            </div>
        </a>
    </div>

    <!-- Charts Section -->
    <div class="charts-row">
        <div class="chart-container">
            <div class="chart-header">
                <h3 id="trendChartTitle">Tasks Completed</h3>
                <div class="chart-actions">
                    <select id="trendRangeSelect" class="form-select form-select-sm">
                        <option value="7" selected>Last 7 days</option>
                        <option value="30">Last 30 days</option>
                        <option value="90">Last 90 days</option>
                    </select>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="taskTrendChart" height="300"></canvas>
            </div>
        </div>

        <div class="chart-container">
            <div class="chart-header">
                <h3>Proposal Status</h3>
                <div class="chart-actions">
                    <a href="@Url.Action("Index", "Proposal", new { area = "DepartmentHead" })" class="btn btn-sm btn-outline-ocean">View All</a>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="proposalStatusChart" height="300"></canvas>
            </div>
        </div>
    </div>

    <!-- Activity and Quick Actions -->
    <div class="content-row">
        <div class="activity-panel">
            <div class="panel-header">
                <h3>Department Overview</h3>
            </div>
            <div class="activity-list">
                <div class="activity-item">
                    <div class="activity-icon user">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-title">Team Size</div>
                        <div class="activity-description">@ViewData["TotalEmployees"] employee(s) in @ViewData["DepartmentName"]</div>
                        <div class="activity-time">Current</div>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-icon project">
                        <i class="fas fa-diagram-project"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-title">Active Projects</div>
                        <div class="activity-description">@ViewData["ActiveProjects"] project(s) involving department members</div>
                        <div class="activity-time">Current</div>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-icon system">
                        <i class="fas fa-file-lines"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-title">Proposals</div>
                        <div class="activity-description">@ViewData["TotalProposals"] total &mdash; @ViewData["PendingProposals"] pending review</div>
                        <div class="activity-time">Current</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="quick-actions-panel">
            <div class="panel-header">
                <h3>Quick Actions</h3>
            </div>
            <div class="quick-actions-grid">
                <a href="@Url.Action("Index", "Proposal", new { area = "DepartmentHead" })" class="quick-action-btn">
                    <i class="fas fa-file-lines"></i>
                    <span>Proposals</span>
                </a>
                <a href="@Url.Action("Index", "Project", new { area = "DepartmentHead" })" class="quick-action-btn">
                    <i class="fas fa-diagram-project"></i>
                    <span>Projects</span>
                </a>
                <a href="@Url.Action("Index", "Proposal", new { area = "DepartmentHead" })?status=Pending" class="quick-action-btn">
                    <i class="fas fa-file-circle-exclamation"></i>
                    <span>Pending Review</span>
                </a>
                <a href="@Url.Action("Index", "Proposal", new { area = "DepartmentHead" })?status=Approved" class="quick-action-btn">
                    <i class="fas fa-file-circle-check"></i>
                    <span>Approved</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Workload Status -->
    <div class="system-status-panel">
        <div class="panel-header">
            <h3>Department Status</h3>
            <div class="status-indicator online">
                <span class="status-dot"></span>
                Active
            </div>
        </div>
        <div class="status-grid">
            @{
                int totalProposals = (int)(ViewData["TotalProposals"] ?? 0);
                int pendingProposals = (int)(ViewData["PendingProposals"] ?? 0);
                int openTasks = (int)(ViewData["OpenTasks"] ?? 0);
                int completedThisMonth = (int)(ViewData["CompletedTasksThisMonth"] ?? 0);
                int activeProjects = (int)(ViewData["ActiveProjects"] ?? 0);

                int proposalReviewPct = totalProposals > 0 ? (int)(((double)(totalProposals - pendingProposals) / totalProposals) * 100) : 100;
                int taskCompletionPct = (openTasks + completedThisMonth) > 0
                    ? (int)(((double)completedThisMonth / (openTasks + completedThisMonth)) * 100) : 0;
            }
            <div class="status-item">
                <div class="status-info">
                    <div class="status-name">Proposal Review Rate</div>
                    <div class="status-value">@proposalReviewPct% Reviewed</div>
                </div>
                <div class="status-bar">
                    <div class="status-progress" style="width: @proposalReviewPct%"></div>
                </div>
            </div>

            <div class="status-item">
                <div class="status-info">
                    <div class="status-name">Task Completion (This Month)</div>
                    <div class="status-value">@completedThisMonth Completed</div>
                </div>
                <div class="status-bar">
                    <div class="status-progress" style="width: @taskCompletionPct%"></div>
                </div>
            </div>

            <div class="status-item">
                <div class="status-info">
                    <div class="status-name">Active Projects</div>
                    <div class="status-value">@activeProjects Project(s)</div>
                </div>
                <div class="status-bar">
                    <div class="status-progress" style="width: @(Math.Min(activeProjects * 20, 100))%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // ── Task Completion Trend (Line) ──────────────────────────────────
        const trendCtx = document.getElementById('taskTrendChart').getContext('2d');
        let taskTrendChart = new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: 'Finished Projects',
                    data: [],
                    borderColor: '#006994',
                    backgroundColor: 'rgba(0,105,148,0.08)',
                    tension: 0.35,
                    fill: true,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(0,0,0,0.05)' },
                        ticks: { precision: 0 },
                        title: { display: true, text: 'Projects finished', color: '#64748b', font: { weight: '600', size: 12 } }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { maxRotation: 0, autoSkip: true },
                        title: { display: true, text: 'Date', color: '#64748b', font: { weight: '600', size: 12 } }
                    }
                }
            }
        });

        const trendRangeSelect = document.getElementById('trendRangeSelect');

        function fetchFinishedProjectsTrend(days = 7) {
            const url = '@Url.Action("FinishedProjectsTrend", "Dashboard", new { area = "DepartmentHead" })';
            const titleEl = document.getElementById('trendChartTitle');
            if (titleEl) titleEl.textContent = `Finished Projects — Last ${days} days`;
            fetch(url + '?days=' + encodeURIComponent(days))
                .then(r => r.json())
                .then(payload => {
                    taskTrendChart.data.labels = Array.from(payload.labels).map(l => {
                        const d = new Date(l);
                        return d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' });
                    });
                    taskTrendChart.data.datasets[0].data = Array.from(payload.data);
                    taskTrendChart.update();
                })
                .catch(err => console.error('Failed to load finished projects trend', err));
        }

        fetchFinishedProjectsTrend(parseInt(trendRangeSelect?.value || '7', 10));
        trendRangeSelect?.addEventListener('change', function () {
            fetchFinishedProjectsTrend(parseInt(this.value || '7', 10));
        });

        // ── Proposal Status Doughnut ──────────────────────────────────────
        const proposalCtx = document.getElementById('proposalStatusChart').getContext('2d');
        const proposalChart = new Chart(proposalCtx, {
            type: 'doughnut',
            data: {
                labels: ['Pending', 'Approved', 'Rejected', 'Requires Revision'],
                datasets: [{
                    data: [0, 0, 0, 0],
                    backgroundColor: ['#f59e0b', '#006994', '#ef4444', '#4CA3DD'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' },
                    tooltip: {
                        callbacks: {
                            label: function (ctx) {
                                const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                const pct = total > 0 ? Math.round(ctx.parsed / total * 100) : 0;
                                return ` ${ctx.label}: ${ctx.parsed} (${pct}%)`;
                            }
                        }
                    }
                }
            }
        });

        fetch('@Url.Action("ProposalStatusData", "Dashboard", new { area = "DepartmentHead" })')
            .then(r => r.json())
            .then(data => {
                const order = ['Pending', 'Approved', 'Rejected', 'Requires Revision'];
                proposalChart.data.datasets[0].data = order.map(s => {
                    const item = data.find(d => d.status === s);
                    return item ? item.count : 0;
                });
                proposalChart.update();
            })
            .catch(err => console.error('Failed to load proposal status data', err));
    </script>
}
