@model List<ProjectProposal>
@using project_lifecycle.Models
@{
    ViewData["Title"] = "Team Proposals";
    Layout = "~/Areas/DepartmentHead/Layout.cshtml";
}

<!-- ===== Page Title Hero ===== -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-file-lines"></i></span>
                Team Proposals
            </h1>
            <p class="emp-page-subtitle">Proposals submitted by members of your department</p>
        </div>
    </div>
</div>

<!-- ===== Alerts ===== -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="emp-alert emp-alert-success">
        <div class="emp-alert-icon"><i class="fas fa-check-circle"></i></div>
        <span>@TempData["SuccessMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="emp-alert emp-alert-error">
        <div class="emp-alert-icon"><i class="fas fa-exclamation-circle"></i></div>
        <span>@TempData["ErrorMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}
@if (ViewData["ErrorMessage"] != null)
{
    <div class="emp-alert emp-alert-error">
        <div class="emp-alert-icon"><i class="fas fa-exclamation-circle"></i></div>
        <span>@ViewData["ErrorMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}

<!-- ===== Filters ===== -->
<div class="emp-filters-card">
    <div class="emp-filters-row">
        <div class="emp-search-group">
            <i class="fas fa-magnifying-glass emp-search-icon"></i>
            <input id="proposalSearch" type="text" class="emp-search-input" placeholder="Search proposals…" autocomplete="off" />
        </div>
        <div class="emp-select-group">
            <select id="statusFilter" class="emp-select">
                <option value="">All Statuses</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
                <option value="Requires Revision">Requires Revision</option>
            </select>
        </div>
        <div class="emp-select-group">
            <select id="archiveFilter" class="emp-select">
                @{
                    var archiveFilter = ViewData["ArchiveFilter"]?.ToString() ?? "active";
                }
                @if (archiveFilter == "active") { <option value="active" selected>Active</option> } else { <option value="active">Active</option> }
                @if (archiveFilter == "inactive") { <option value="inactive" selected>Archived</option> } else { <option value="inactive">Archived</option> }
                @if (archiveFilter == "all") { <option value="all" selected>All</option> } else { <option value="all">All</option> }
            </select>
        </div>
        <div class="emp-select-group">
            <label for="pageSizeSelect" style="font-size:.82rem;color:#64748b;margin-right:.4rem;">Show</label>
            <select id="pageSizeSelect" class="emp-select" style="width:92px;">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
    </div>
</div>

<!-- ===== Table ===== -->
    <style>
        /* Scoped tweaks for DeptHead proposal badges: keep on one line and truncate if too long
           Exclude the status inline element so the status dot (and its glow/hover) are not clipped. */
        .project-table-card .project-badge-white { white-space: nowrap; }
        .project-table-card .project-badge-white > span:not(.emp-status-inline) {
            display: inline-block;
            max-width: 10.5rem;
            overflow: hidden;
            text-overflow: ellipsis;
            vertical-align: middle;
        }
    </style>
<div class="project-table-section">
    <div class="project-table-card">
        @if (Model.Any())
        {
            <div class="project-table-responsive">
                <table class="project-table" id="proposalsTable">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Submitted By</th>
                            <th>Submitted</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="proposalsBody">
                        @foreach (var proposal in Model)
                        {
                            <tr class="emp-row"
                                data-title="@proposal.Title.ToLower()"
                                data-status="@proposal.Status">
                                <td>
                                    <div class="project-name-cell">
                                        <div class="project-name-icon">
                                            <i class="fas fa-file-lines"></i>
                                        </div>
                                        <div>
                                            <div class="project-name-text">@proposal.Title</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="project-badge-white" title="Submitted by">
                                        <i class="fas fa-user"></i>
                                        <span style="margin-left:.35rem;">@(proposal.Employee != null ? $"{proposal.Employee.FirstName} {proposal.Employee.LastName}" : "—")</span>
                                    </span>
                                </td>
                                <td class="project-date">
                                    <span class="project-badge-white" title="Submitted">
                                        <i class="fas fa-calendar-day"></i>
                                        @proposal.DateCreated.ToString("MMM dd, yyyy h:mm tt")
                                    </span>
                                </td>
                                <td>
                                    <span class="project-badge-white" title="Status">
                                        <span class="emp-status-inline @GetStatusClass(proposal.Status)">
                                              <span class="emp-status-dot" aria-hidden="true"
                                                  style="width:7px;height:7px;border-radius:50%;display:inline-block;vertical-align:middle;background:@GetStatusColor(proposal.Status);transition:transform .18s cubic-bezier(.2,.9,.3,1),box-shadow .18s ease;animation:emp-dot-breath 3s ease-in-out infinite;"
                                                  onmouseenter="this.style.transform='scale(1.35)';this.style.boxShadow='0 6px 18px rgba(0,0,0,.06), 0 0 18px '+this.style.backgroundColor;"
                                                  onmouseleave="this.style.transform='scale(1)';this.style.boxShadow='none';"></span>
                                            <span class="emp-status-text">@proposal.Status</span>
                                        </span>
                                    </span>
                                </td>
                                <td>
                                    <div style="display:inline-flex;align-items:center;gap:.35rem;">
                                        <a asp-area="DepartmentHead" asp-controller="Proposal" asp-action="Details" asp-route-id="@proposal.Id"
                                           class="emp-action-btn emp-action-view" title="View details">
                                            <i class="fas fa-magnifying-glass"></i>
                                        </a>
                                        @if (!proposal.IsArchived)
                                        {
                                            <form asp-area="DepartmentHead" asp-controller="Proposal" asp-action="Archive" method="post" class="emp-action-form" onsubmit="return confirm('Archive this proposal?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@proposal.Id" />
                                                <button type="submit" class="emp-action-btn emp-action-archive" title="Archive">
                                                    <i class="fas fa-box-archive"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-area="DepartmentHead" asp-controller="Proposal" asp-action="Unarchive" method="post" class="emp-action-form" onsubmit="return confirm('Unarchive this proposal?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@proposal.Id" />
                                                <button type="submit" class="emp-action-btn emp-action-unarchive" title="Unarchive">
                                                    <i class="fas fa-box-open"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="noFilterResults" class="project-empty-state" style="display:none;">
                <div class="project-empty-icon"><i class="fas fa-magnifying-glass"></i></div>
                <div class="project-empty-title">No matching proposals</div>
                <div class="project-empty-text">Try adjusting your search or filters.</div>
            </div>

            <div class="emp-pagination" id="paginationContainer" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem;padding:.75rem 1.25rem;box-sizing:border-box;">
                <div class="emp-pagination-info" id="paginationInfo"></div>
                <div class="emp-pagination-controls" id="paginationControls"></div>
            </div>
        }
        else
        {
            <div class="project-empty-state">
                <div class="project-empty-icon"><i class="fas fa-inbox"></i></div>
                <div class="project-empty-title">No proposals yet</div>
                <div class="project-empty-text">No proposals have been submitted by your department yet.</div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
(function () {
    let PAGE_SIZE = 10;
    let currentPage = 1;
    let filteredRows = [];

    const searchInput    = document.getElementById('proposalSearch');
    const statusSelect   = document.getElementById('statusFilter');
    const allRows        = Array.from(document.querySelectorAll('.emp-row'));
    const noResults      = document.getElementById('noFilterResults');
    const countBadge     = document.getElementById('visibleCount');
    const pageInfo       = document.getElementById('paginationInfo');
    const pageControls   = document.getElementById('paginationControls');
    const pageSizeSelect = document.getElementById('pageSizeSelect');
    const archiveSelect  = document.getElementById('archiveFilter');

    function applyFilters() {
        const query  = (searchInput?.value ?? '').toLowerCase().trim();
        const status = statusSelect?.value ?? '';
        filteredRows = allRows.filter(row => {
            const titleMatch  = !query  || (row.dataset.title || '').includes(query);
            const statusMatch = !status || row.dataset.status === status;
            return titleMatch && statusMatch;
        });
        currentPage = 1;
        render();
    }

    function render() {
        const total      = filteredRows.length;
        const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
        currentPage      = Math.min(currentPage, totalPages);
        const start = (currentPage - 1) * PAGE_SIZE;
        const end   = start + PAGE_SIZE;

        allRows.forEach(r => r.style.display = 'none');
        filteredRows.forEach((r, i) => {
            r.style.display = (i >= start && i < end) ? '' : 'none';
        });

        if (noResults)  noResults.style.display  = total === 0 ? '' : 'none';
        if (countBadge) countBadge.textContent    = total;
        if (pageInfo)   pageInfo.textContent      = total === 0 ? '' : `Showing ${start + 1}–${Math.min(end, total)} of ${total}`;

        if (pageControls) {
            pageControls.innerHTML = '';
            const makeBtn = (label, page, disabled, active) => {
                const btn = document.createElement('button');
                btn.className = 'emp-page-btn' + (active ? ' active' : '');
                btn.innerHTML = label;
                btn.disabled  = disabled;
                btn.addEventListener('click', () => { currentPage = page; render(); });
                return btn;
            };
            pageControls.appendChild(makeBtn('<i class="fas fa-chevron-left"></i>', currentPage - 1, currentPage === 1, false));
            const w = 2;
            for (let p = 1; p <= totalPages; p++) {
                if (p === 1 || p === totalPages || (p >= currentPage - w && p <= currentPage + w)) {
                    pageControls.appendChild(makeBtn(p, p, false, p === currentPage));
                } else if (p === currentPage - w - 1 || p === currentPage + w + 1) {
                    const el = document.createElement('span');
                    el.className = 'emp-page-ellipsis';
                    el.textContent = '…';
                    pageControls.appendChild(el);
                }
            }
            pageControls.appendChild(makeBtn('<i class="fas fa-chevron-right"></i>', currentPage + 1, currentPage === totalPages, false));
        }
    }

    if (searchInput)  searchInput.addEventListener('input', applyFilters);
    if (statusSelect) statusSelect.addEventListener('change', applyFilters);
    if (pageSizeSelect) {
        pageSizeSelect.value = String(PAGE_SIZE);
        pageSizeSelect.addEventListener('change', function () {
            PAGE_SIZE = Math.max(5, parseInt(this.value, 10) || 10);
            currentPage = 1;
            render();
        });
    }

    if (archiveSelect) archiveSelect.addEventListener('change', () => {
        const url = new URL(window.location.href);
        if (archiveSelect.value === 'active') url.searchParams.delete('archiveFilter');
        else url.searchParams.set('archiveFilter', archiveSelect.value);
        window.location.href = url.toString();
    });

    filteredRows = allRows.slice();
    render();
})();
    </script>
}

@functions {
    private string GetInputPreview(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "—";
        var withoutTags = System.Text.RegularExpressions.Regex.Replace(html, "<.*?>", " ");
        var normalized  = System.Text.RegularExpressions.Regex.Replace(withoutTags, "\\s+", " ").Trim();
        if (string.IsNullOrWhiteSpace(normalized)) return "—";
        const int maxLength = 100;
        return normalized.Length <= maxLength ? normalized : normalized.Substring(0, maxLength) + "…";
    }

    private string GetStatusClass(string status) => status switch
    {
        "Pending"           => "emp-status-pending",
        "Approved"          => "emp-status-approved",
        "Rejected"          => "emp-status-rejected",
        "Requires Revision" => "emp-status-revision",
        _                   => "emp-status-default"
    };

    private string GetStatusColor(string status) => status switch
    {
        "Pending" => "#f59e0b",
        "Approved" => "#10b981",
        "Rejected" => "#ef4444",
        "Requires Revision" => "#f97316",
        _ => "#94a3b8"
    };
}

