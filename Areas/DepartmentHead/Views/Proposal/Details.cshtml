@model ProjectProposal
@using project_lifecycle.Models
@{
    ViewData["Title"] = Model?.Title ?? "Proposal";
}

<div class="dashboard-container py-4">
    <div class="proposal-page-header">
        <h1><i class="fas fa-lightbulb"></i>&nbsp; @ViewData["Title"]</h1>
        <p class="proposal-subtitle">Submitted @Model.DateCreated.ToString("yyyy-MM-dd") — Status: @Model.Status</p>
    </div>

    <div class="proposal-detail-card">
        <div class="proposal-detail-body">
            @Html.Raw(Model.Input)
        </div>

        <div style="margin-top:1rem">
            <form asp-action="Review" asp-controller="Proposal" asp-area="DepartmentHead" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label for="note" class="form-label">Feedback / Note</label>
                    <textarea id="note" name="note" class="form-control" rows="5">@Model.Note</textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" name="actionType" value="Approve" class="btn btn-success" onclick="return confirm('Approve this proposal?');">Approve</button>
                    <button type="submit" name="actionType" value="Reject" class="btn btn-danger" onclick="return confirm('Reject this proposal?');">Reject</button>
                    <button type="submit" name="actionType" value="ReturnForRevision" class="btn btn-warning">Return for Revision</button>
                    <button type="submit" name="actionType" value="SendFeedback" class="btn btn-primary">Send Feedback</button>
                    <a asp-area="DepartmentHead" asp-controller="Proposal" asp-action="Index" class="btn btn-secondary ms-auto">Back</a>
                </div>
            </form>
        </div>
    </div>
    
    <div class="proposal-versions mt-4">
        <h5>Versions <a asp-area="DepartmentHead" asp-controller="Proposal" asp-action="Notes" asp-route-id="@Model.Id" class="ms-2">View All Notes</a></h5>
        @{ var versions = ViewBag.ProjectProposalVersions as List<project_lifecycle.Models.ProjectProposalVersion> ?? new List<project_lifecycle.Models.ProjectProposalVersion>(); }
        <div class="mt-2">
            <div class="p-2 border rounded bg-light mb-2">
                <strong>Current</strong> — @Model.Title
                <div class="small text-muted">Updated @Model.DateCreated.ToString("yyyy-MM-dd HH:mm")</div>
            </div>

            @if (versions.Any())
            {
                @foreach (var v in versions)
                {
                    <div class="p-2 border rounded mb-2">
                        <a asp-area="DepartmentHead" asp-controller="Proposal" asp-action="Version" asp-route-id="@v.Id"><strong>Version @v.VersionNumber</strong></a>
                        &nbsp;&mdash;&nbsp;@v.Title
                        <div class="small text-muted">Saved @v.DateCreated.ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                }
            }
            else
            {
                <div class="small text-muted">No previous versions.</div>
            }
        </div>
    </div>

    <div class="proposal-notes mt-4">
        <h5>Notes</h5>
        @{ var notes = ViewBag.ProposalNoteVersions as List<project_lifecycle.Models.ProposalNoteVersion> ?? new List<project_lifecycle.Models.ProposalNoteVersion>(); }
        <div class="mt-2">
            @if (notes.Any())
            {
                var ordered = notes.OrderByDescending(n => n.VersionNumber).ToList();
                var current = ordered.First();

                <div class="p-2 border rounded bg-light mb-2">
                    <strong><a asp-area="DepartmentHead" asp-controller="Proposal" asp-action="Note" asp-route-id="@current.Id">Current version</a></strong>@(current.VersionNumber > 0 ? (" (v" + current.VersionNumber + ")") : "")
                    <div class="small text-muted">Saved @current.DateCreated.ToString("yyyy-MM-dd HH:mm")</div>
                    <div class="mt-2">@Html.Raw(current.Note)</div>
                </div>

                @foreach (var n in ordered.Skip(1))
                {
                    <div class="p-2 border rounded mb-2">
                        <strong><a asp-area="DepartmentHead" asp-controller="Proposal" asp-action="Note" asp-route-id="@n.Id">Version @n.VersionNumber</a></strong>
                        <div class="small text-muted">Saved @n.DateCreated.ToString("yyyy-MM-dd HH:mm")</div>
                        <div class="mt-2">@Html.Raw(n.Note)</div>
                    </div>
                }
            }
            else if (!string.IsNullOrWhiteSpace(Model.Note))
            {
                <div class="p-2 border rounded bg-light mb-2">
                    <strong>Current version</strong>
                    <div class="mt-2">@Html.Raw(Model.Note)</div>
                </div>
            }
            else
            {
                <div class="small text-muted">No notes available.</div>
            }
        </div>
    </div>
</div>
