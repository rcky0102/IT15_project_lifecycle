@model List<project_lifecycle.Models.ProposalNoteVersion>
@using project_lifecycle.Models
@{
    ViewData["Title"] = "Proposal Notes";
}

<div class="dashboard-container py-4">
    <div class="proposal-page-header">
        <h1><i class="fas fa-sticky-note"></i>&nbsp; Proposal Notes</h1>
    </div>

    <div class="mt-3">
        @if (Model != null && Model.Any())
        {
            foreach (var n in Model.OrderByDescending(x => x.DateCreated))
            {
                <div class="p-3 border rounded mb-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong>Version @n.VersionNumber</strong>
                            <div class="small text-muted">Saved @n.DateCreated.ToString("yyyy-MM-dd HH:mm")</div>
                        </div>
                        <div class="small text-muted">DepartmentHead Id: @n.DepartmentHeadId</div>
                    </div>

                    <div class="mt-2">@Html.Raw(n.Note)</div>
                </div>
            }
        }
        else
        {
            <div class="small text-muted">No notes available.</div>
        }
    </div>

    <div class="mt-3">
        @{ var proposalId = Model?.FirstOrDefault()?.ProjectProposalId ?? 0; }
        <a asp-area="DepartmentHead" asp-controller="Proposal" asp-action="Details" asp-route-id="@proposalId" class="btn btn-secondary">Back to Proposal</a>
    </div>
</div>
