@model List<project_lifecycle.Models.ProposalNoteVersion>
@using project_lifecycle.Models
@{
    ViewData["Title"] = "Proposal Notes";
    var proposalId = Model?.FirstOrDefault()?.ProjectProposalId ?? 0;
    var proposalTitle = Model?.FirstOrDefault()?.ProjectProposal?.Title ?? "Proposal";
    var ordered = Model?.OrderByDescending(n => n.VersionNumber).ToList() ?? new List<project_lifecycle.Models.ProposalNoteVersion>();
}

<!-- ===== Page Hero ===== -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-note-sticky"></i></span>
                All Notes
            </h1>
            <p class="emp-page-subtitle">@proposalTitle — @ordered.Count note version(s)</p>
        </div>
        <div class="emp-page-hero-right">
            <a asp-area="DepartmentHead" asp-controller="Proposal" asp-action="Details"
               asp-route-id="@proposalId" class="emp-btn emp-btn-outline">
                <i class="fas fa-arrow-left"></i>
                <span>Back to Proposal</span>
            </a>
        </div>
    </div>
</div>

<!-- ===== Notes list ===== -->
@if (ordered.Any())
{
    @foreach (var n in ordered)
    {
        <div class="emp-detail-card" style="margin-bottom:1rem;">
            <div class="emp-detail-card-header">
                <span class="emp-status-badge emp-status-default">
                    <span class="emp-status-dot"></span>
                    <a asp-area="DepartmentHead" asp-controller="Proposal" asp-action="Note" asp-route-id="@n.Id"
                       style="color:inherit;text-decoration:none;">Version @n.VersionNumber</a>
                </span>
                <span class="emp-modal-meta" style="font-size:.78rem;color:#64748b;">
                    <i class="far fa-calendar"></i> Saved @n.DateCreated.ToString("MMM dd, yyyy h:mm tt")
                </span>
            </div>
            <div class="emp-detail-body">
                @Html.Raw(n.Note)
            </div>
        </div>
    }
}
else
{
    <div class="emp-table-card">
        <div class="emp-empty-state">
            <div class="emp-empty-icon"><i class="fas fa-note-sticky"></i></div>
            <h4 class="emp-empty-title">No notes available</h4>
            <p class="emp-empty-text">No feedback notes have been submitted for this proposal yet.</p>
        </div>
    </div>
}
