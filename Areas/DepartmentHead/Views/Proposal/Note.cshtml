@model project_lifecycle.Models.ProposalNoteVersion
@{
    ViewData["Title"] = $"Note v{Model?.VersionNumber} - {Model?.ProjectProposal?.Title}";
}

<div class="dashboard-container py-4">
    <div class="proposal-page-header">
        <h1><i class="fas fa-sticky-note"></i>&nbsp; Note @if(Model != null){<text>(v@Model.VersionNumber)</text>}</h1>
        <p class="proposal-subtitle">@Model?.ProjectProposal?.Title — Saved @Model.DateCreated.ToString("yyyy-MM-dd HH:mm")</p>
    </div>

    <div class="proposal-detail-card">
        <div class="proposal-detail-body">
            @Html.Raw(Model?.Note ?? string.Empty)
        </div>

        <div style="margin-top:1rem">
            <a asp-area="DepartmentHead" asp-controller="Proposal" asp-action="Details" asp-route-id="@Model?.ProjectProposalId" class="btn btn-secondary">Back to Proposal</a>
        </div>
    </div>
</div>
