@{
    ViewData["Title"] = "Reports";
    Layout = "~/Areas/Executive/Layout.cshtml";
}

<div class="dashboard-container">
    <!-- Page Header -->
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="dashboard-title">Reports</h1>
            <p class="dashboard-subtitle">Generate, preview, and export organization reports</p>
        </div>
    </div>

    <!-- Report Configuration Panel -->
    <div class="report-config-panel">
        <div class="panel-header">
            <h3><i class="fas fa-sliders"></i> Report Configuration</h3>
        </div>
        <div class="report-config-body">
            <div class="config-row">
                <!-- Report Type -->
                <div class="config-group">
                    <label class="config-label" for="reportType">
                        <i class="fas fa-file-alt"></i> Report Type
                    </label>
                    <select id="reportType" class="config-select">
                        <option value="summary" selected>Executive Summary</option>
                        <option value="projects">Projects Report</option>
                        <option value="tasks">Tasks Report</option>
                        <option value="proposals">Proposals Report</option>
                        <option value="employees">Employees Report</option>
                    </select>
                </div>

                <!-- Date From -->
                <div class="config-group">
                    <label class="config-label" for="dateFrom">
                        <i class="fas fa-calendar-day"></i> Date From
                    </label>
                    <input type="date" id="dateFrom" class="config-input" />
                </div>

                <!-- Date To -->
                <div class="config-group">
                    <label class="config-label" for="dateTo">
                        <i class="fas fa-calendar-check"></i> Date To
                    </label>
                    <input type="date" id="dateTo" class="config-input" />
                </div>

                <!-- Quick Range -->
                <div class="config-group">
                    <label class="config-label">
                        <i class="fas fa-clock-rotate-left"></i> Quick Range
                    </label>
                    <div class="quick-range-btns">
                        <button class="quick-range-btn" data-days="7">7d</button>
                        <button class="quick-range-btn active" data-days="30">30d</button>
                        <button class="quick-range-btn" data-days="90">90d</button>
                        <button class="quick-range-btn" data-days="365">1y</button>
                    </div>
                </div>
            </div>

            <div class="config-actions">
                <button class="btn-generate" id="btnGenerate">
                    <i class="fas fa-chart-bar"></i> Generate Report
                </button>
                <button class="btn-export" id="btnExportPdf" disabled>
                    <i class="fas fa-file-pdf"></i> Export PDF
                </button>
            </div>
        </div>
    </div>

    <!-- Loading State -->
    <div class="report-loading" id="reportLoading" style="display:none;">
        <div class="loading-spinner"></div>
        <p>Generating report&hellip;</p>
    </div>

    <!-- Empty State -->
    <div class="report-empty" id="reportEmpty">
        <div class="empty-icon">
            <i class="fas fa-chart-pie"></i>
        </div>
        <h3>No Report Generated</h3>
        <p>Choose a report type and date range, then click <strong>Generate Report</strong> to get started.</p>
    </div>

    <!-- Report Output -->
    <div id="reportOutput" style="display:none;">
        <!-- Report Title Bar -->
        <div class="report-title-bar" id="reportTitleBar">
            <div class="report-title-info">
                <h2 id="reportMainTitle">Report</h2>
                <span class="report-date-range" id="reportDateRange"></span>
            </div>
            <span class="report-badge" id="reportRecordCount"></span>
        </div>

        <!-- Summary Cards (for summary report) -->
        <div class="report-summary-grid" id="reportSummaryGrid" style="display:none;"></div>

        <!-- Data Table -->
        <div class="report-table-panel" id="reportTablePanel" style="display:none;">
            <div class="panel-header">
                <h3 id="reportTableTitle">Details</h3>
                <div class="table-search-wrap">
                    <i class="fas fa-search"></i>
                    <input type="text" id="tableSearch" class="table-search" placeholder="Search rows..." />
                </div>
            </div>
            <div class="report-table-wrap">
                <table class="report-table" id="reportTable">
                    <thead id="reportTableHead"></thead>
                    <tbody id="reportTableBody"></tbody>
                </table>
            </div>
            <div class="table-footer" id="tableFooter">
                <span class="table-count" id="tableRowCount"></span>
            </div>
        </div>

        <!-- Report Interpretation / Insights -->
        <div class="report-interpretation" id="reportInterpretation" style="display:none;">
            <div class="interpretation-header">
                <i class="fas fa-lightbulb"></i>
                <h3>Key Insights &amp; Interpretation</h3>
            </div>
            <div class="interpretation-body" id="interpretationBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- jsPDF + autoTable for text-based PDF export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

    <script>
        (function () {
            // ── Elements ──
            const reportType = document.getElementById('reportType');
            const dateFrom = document.getElementById('dateFrom');
            const dateTo = document.getElementById('dateTo');
            const btnGenerate = document.getElementById('btnGenerate');
            const btnExport = document.getElementById('btnExportPdf');
            const quickBtns = document.querySelectorAll('.quick-range-btn');
            const loadingEl = document.getElementById('reportLoading');
            const emptyEl = document.getElementById('reportEmpty');
            const outputEl = document.getElementById('reportOutput');
            const summaryGrid = document.getElementById('reportSummaryGrid');
            const tablePanel = document.getElementById('reportTablePanel');
            const tableHead = document.getElementById('reportTableHead');
            const tableBody = document.getElementById('reportTableBody');
            const tableSearch = document.getElementById('tableSearch');
            const tableRowCount = document.getElementById('tableRowCount');
            const reportMainTitle = document.getElementById('reportMainTitle');
            const reportDateRange = document.getElementById('reportDateRange');
            const reportRecordCount = document.getElementById('reportRecordCount');
            const reportTableTitle = document.getElementById('reportTableTitle');
            const interpretationEl = document.getElementById('reportInterpretation');
            const interpretationBody = document.getElementById('interpretationBody');

            let currentReport = null;

            // ── Set initial dates (last 30 days) ──
            function setDateRange(days) {
                const now = new Date();
                const from = new Date();
                from.setDate(now.getDate() - days);
                dateFrom.value = from.toISOString().split('T')[0];
                dateTo.value = now.toISOString().split('T')[0];
            }
            setDateRange(30);

            // ── Quick range buttons ──
            quickBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    quickBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    setDateRange(parseInt(this.dataset.days));
                });
            });

            // ── Generate ──
            btnGenerate.addEventListener('click', async function () {
                const type = reportType.value;
                const from = dateFrom.value;
                const to = dateTo.value;

                if (!from || !to) {
                    alert('Please select both From and To dates.');
                    return;
                }
                if (new Date(from) > new Date(to)) {
                    alert('From date must be before To date.');
                    return;
                }

                // Show loading
                emptyEl.style.display = 'none';
                outputEl.style.display = 'none';
                loadingEl.style.display = 'flex';
                btnExport.disabled = true;

                try {
                    const url = '@Url.Action("Generate", "Reports", new { area = "Executive" })';
                    const resp = await fetch(`${url}?type=${encodeURIComponent(type)}&from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`);
                    if (!resp.ok) throw new Error('Server error');
                    const report = await resp.json();
                    currentReport = report;
                    renderReport(report);
                    loadingEl.style.display = 'none';
                    outputEl.style.display = 'block';
                    btnExport.disabled = false;
                } catch (err) {
                    console.error('Report generation failed', err);
                    loadingEl.style.display = 'none';
                    emptyEl.style.display = 'flex';
                    alert('Failed to generate report. Please try again.');
                }
            });

            // ── Render ──
            function renderReport(report) {
                const titles = {
                    summary: 'Executive Summary',
                    projects: 'Projects Report',
                    tasks: 'Tasks Report',
                    proposals: 'Proposals Report',
                    employees: 'Employees Report'
                };

                reportMainTitle.textContent = titles[report.type] || 'Report';
                reportDateRange.textContent = `${report.from} — ${report.to}`;

                if (report.type === 'summary') {
                    renderSummary(report);
                } else {
                    renderTable(report);
                }

                // Always render interpretation
                renderInterpretation(report);
            }

            // ── Summary Report ──
            function renderSummary(report) {
                summaryGrid.style.display = 'grid';
                tablePanel.style.display = 'none';
                const d = report.data;

                reportRecordCount.textContent = 'Executive Summary';

                summaryGrid.innerHTML = `
                    <div class="summary-section">
                        <h4 class="summary-section-title"><i class="fas fa-diagram-project"></i> Projects</h4>
                        <div class="summary-cards">
                            ${summaryCard('Projects Created', d.projectsCreated, 'primary')}
                            ${summaryCard('Active Projects', d.activeProjects, 'success')}
                            ${summaryCard('Archived', d.archivedProjects, 'neutral')}
                        </div>
                    </div>
                    <div class="summary-section">
                        <h4 class="summary-section-title"><i class="fas fa-list-check"></i> Tasks</h4>
                        <div class="summary-cards">
                            ${summaryCard('Total Tasks', d.totalTasks, 'primary')}
                            ${summaryCard('Completed', d.completedTasks, 'success')}
                            ${summaryCard('Pending', d.pendingTasks, 'warning')}
                            ${summaryCard('Require Revision', d.revisionTasks, 'danger')}
                            ${summaryCard('Completion Rate', d.taskCompletionRate + '%', 'info')}
                        </div>
                    </div>
                    <div class="summary-section">
                        <h4 class="summary-section-title"><i class="fas fa-file-lines"></i> Proposals</h4>
                        <div class="summary-cards">
                            ${summaryCard('Total Proposals', d.totalProposals, 'primary')}
                            ${summaryCard('Approved', d.approvedProposals, 'success')}
                            ${summaryCard('Pending', d.pendingProposals, 'warning')}
                            ${summaryCard('Rejected', d.rejectedProposals, 'danger')}
                            ${summaryCard('Approval Rate', d.proposalApprovalRate + '%', 'info')}
                        </div>
                    </div>
                    <div class="summary-section">
                        <h4 class="summary-section-title"><i class="fas fa-users"></i> People & Milestones</h4>
                        <div class="summary-cards">
                            ${summaryCard('New Employees', d.newEmployees, 'primary')}
                            ${summaryCard('Total Employees', d.totalEmployees, 'neutral')}
                            ${summaryCard('Departments', d.totalDepartments, 'neutral')}
                            ${summaryCard('Milestones Done', d.milestonesFinished, 'success')}
                            ${summaryCard('Milestone Rate', d.milestoneCompletionRate + '%', 'info')}
                        </div>
                    </div>
                `;
            }

            function summaryCard(label, value, color) {
                return `<div class="summary-card ${color}"><div class="summary-card-value">${value}</div><div class="summary-card-label">${label}</div></div>`;
            }

            // ── Table Reports ──
            function renderTable(report) {
                summaryGrid.style.display = 'none';
                tablePanel.style.display = 'block';
                reportRecordCount.textContent = `${report.totalCount} records`;
                tableSearch.value = '';

                const columns = getColumns(report.type);
                reportTableTitle.textContent = `${report.type.charAt(0).toUpperCase() + report.type.slice(1)} Details`;

                // Head
                tableHead.innerHTML = '<tr>' + columns.map(c => `<th>${c.label}</th>`).join('') + '</tr>';

                // Body
                renderRows(report.rows, columns);
            }

            function renderRows(rows, columns, filter = '') {
                const lf = filter.toLowerCase();
                const filtered = lf
                    ? rows.filter(r => columns.some(c => String(r[c.key] ?? '').toLowerCase().includes(lf)))
                    : rows;

                tableBody.innerHTML = filtered.length === 0
                    ? `<tr><td colspan="${columns.length}" class="table-empty">No matching records</td></tr>`
                    : filtered.map(r =>
                        '<tr>' + columns.map(c => {
                            let val = r[c.key] ?? '—';
                            if (c.key === 'status' || c.key === 'Status') val = statusBadge(val);
                            return `<td>${val}</td>`;
                        }).join('') + '</tr>'
                    ).join('');

                tableRowCount.textContent = `Showing ${filtered.length} of ${rows.length} records`;
            }

            function statusBadge(status) {
                const cls = {
                    'Checked': 'approved', 'Approved': 'approved', 'Active': 'approved',
                    'Pending': 'pending',
                    'Rejected': 'rejected', 'Archived': 'rejected',
                    'Require Revision': 'revision', 'Requires Revision': 'revision'
                };
                return `<span class="badge-status ${cls[status] || 'neutral'}">${status}</span>`;
            }

            function getColumns(type) {
                switch (type) {
                    case 'projects': return [
                        { key: 'name', label: 'Project Name' },
                        { key: 'manager', label: 'Manager' },
                        { key: 'status', label: 'Status' },
                        { key: 'startDate', label: 'Start' },
                        { key: 'endDate', label: 'End' },
                        { key: 'memberCount', label: 'Members' },
                        { key: 'taskCount', label: 'Tasks' },
                        { key: 'completedTaskCount', label: 'Done' },
                        { key: 'dateCreated', label: 'Created' },
                    ];
                    case 'tasks': return [
                        { key: 'name', label: 'Task Name' },
                        { key: 'project', label: 'Project' },
                        { key: 'milestone', label: 'Milestone' },
                        { key: 'status', label: 'Status' },
                        { key: 'startDate', label: 'Start' },
                        { key: 'endDate', label: 'Due' },
                        { key: 'completedAt', label: 'Completed' },
                        { key: 'assigneeCount', label: 'Assignees' },
                    ];
                    case 'proposals': return [
                        { key: 'title', label: 'Title' },
                        { key: 'employee', label: 'Submitted By' },
                        { key: 'department', label: 'Department' },
                        { key: 'status', label: 'Status' },
                        { key: 'dateCreated', label: 'Date' },
                    ];
                    case 'employees': return [
                        { key: 'name', label: 'Name' },
                        { key: 'employeeNumber', label: 'Emp #' },
                        { key: 'department', label: 'Department' },
                        { key: 'position', label: 'Position' },
                        { key: 'dateHired', label: 'Hired' },
                        { key: 'projectCount', label: 'Projects' },
                        { key: 'taskCount', label: 'Tasks' },
                    ];
                    default: return [];
                }
            }

            // ── Interpretation / Insights ──
            function renderInterpretation(report) {
                const insights = [];

                switch (report.type) {
                    case 'summary':
                        insights.push(...interpretSummary(report.data));
                        break;
                    case 'projects':
                        insights.push(...interpretProjects(report));
                        break;
                    case 'tasks':
                        insights.push(...interpretTasks(report));
                        break;
                    case 'proposals':
                        insights.push(...interpretProposals(report));
                        break;
                    case 'employees':
                        insights.push(...interpretEmployees(report));
                        break;
                }

                if (insights.length === 0) {
                    interpretationEl.style.display = 'none';
                    return;
                }

                interpretationBody.innerHTML =
                    insights.map(i =>
                        `<div class="insight-block ${i.tone}">
                            <div class="insight-icon"><i class="fas ${i.icon}"></i></div>
                            <div class="insight-text">${i.text}</div>
                        </div>`
                    ).join('') +
                    `<div class="interpretation-footer">Auto-generated insights based on data for the selected period (${report.from} — ${report.to}).</div>`;

                interpretationEl.style.display = 'block';
            }

            // ── Summary Insights ──
            function interpretSummary(d) {
                const ins = [];

                // Project activity
                if (d.projectsCreated > 0) {
                    const archiveRatio = d.projectsCreated > 0 ? Math.round(d.archivedProjects / d.projectsCreated * 100) : 0;
                    ins.push({
                        icon: 'fa-diagram-project',
                        tone: d.activeProjects > d.archivedProjects ? 'positive' : 'neutral',
                        text: `<strong>${d.projectsCreated}</strong> project(s) were created during this period, with <strong>${d.activeProjects}</strong> currently active and <strong>${d.archivedProjects}</strong> archived. ${archiveRatio > 50 ? 'A high archive rate may indicate rapid project turnover or effective project closure.' : 'The majority of projects remain active, suggesting ongoing organizational investment.'}`
                    });
                } else {
                    ins.push({
                        icon: 'fa-diagram-project',
                        tone: 'caution',
                        text: 'No new projects were created during this period. Consider reviewing whether project initiation is progressing as planned or if there are pipeline bottlenecks.'
                    });
                }

                // Task completion
                if (d.totalTasks > 0) {
                    const rate = d.taskCompletionRate;
                    let tone = rate >= 75 ? 'positive' : rate >= 40 ? 'caution' : 'negative';
                    let commentary = rate >= 75
                        ? 'This is a strong completion rate, reflecting healthy team productivity and effective task management.'
                        : rate >= 40
                            ? 'The completion rate is moderate. Consider investigating potential blockers or resource allocation issues that may be slowing progress.'
                            : 'The completion rate is low, which may signal overcommitment, unclear task definitions, or insufficient resources. Immediate attention is recommended.';
                    ins.push({
                        icon: 'fa-list-check',
                        tone,
                        text: `Out of <strong>${d.totalTasks}</strong> tasks created, <strong>${d.completedTasks}</strong> were completed (<strong>${rate}%</strong> completion rate). <strong>${d.pendingTasks}</strong> remain pending and <strong>${d.revisionTasks}</strong> require revision. ${commentary}`
                    });
                }

                if (d.revisionTasks > 0 && d.totalTasks > 0) {
                    const revPct = Math.round(d.revisionTasks / d.totalTasks * 100);
                    if (revPct >= 20) {
                        ins.push({
                            icon: 'fa-rotate-left',
                            tone: 'negative',
                            text: `<strong>${revPct}%</strong> of tasks require revision, which is notably high. This could indicate quality concerns, miscommunication on task requirements, or insufficient review before submission. Consider implementing clearer task guidelines or additional checkpoints.`
                        });
                    }
                }

                // Proposal pipeline
                if (d.totalProposals > 0) {
                    const approvalRate = d.proposalApprovalRate;
                    let tone = approvalRate >= 60 ? 'positive' : approvalRate >= 30 ? 'caution' : 'negative';
                    let commentary = approvalRate >= 60
                        ? 'The approval rate is healthy, suggesting proposals are well-aligned with organizational goals.'
                        : approvalRate >= 30
                            ? 'The approval rate is moderate. It may be worth examining whether proposal guidelines need refinement or if reviewers and submitters are aligned on expectations.'
                            : 'The approval rate is low, indicating a potential disconnect between proposal quality and organizational criteria. Review feedback loops and proposal preparation processes.';
                    ins.push({
                        icon: 'fa-file-lines',
                        tone,
                        text: `<strong>${d.totalProposals}</strong> proposal(s) were submitted—<strong>${d.approvedProposals}</strong> approved, <strong>${d.pendingProposals}</strong> pending, and <strong>${d.rejectedProposals}</strong> rejected (<strong>${approvalRate}%</strong> approval rate). ${commentary}`
                    });
                }

                // People
                if (d.newEmployees > 0) {
                    const growthPct = d.totalEmployees > 0 ? Math.round(d.newEmployees / d.totalEmployees * 100) : 0;
                    ins.push({
                        icon: 'fa-users',
                        tone: 'positive',
                        text: `<strong>${d.newEmployees}</strong> new employee(s) joined the organization during this period, representing a <strong>${growthPct}%</strong> workforce growth relative to the current total of <strong>${d.totalEmployees}</strong>. The organization is distributed across <strong>${d.totalDepartments}</strong> department(s).`
                    });
                } else {
                    ins.push({
                        icon: 'fa-users',
                        tone: 'neutral',
                        text: `No new hires during this period. The organization currently has <strong>${d.totalEmployees}</strong> employee(s) across <strong>${d.totalDepartments}</strong> department(s).`
                    });
                }

                // Milestones
                if (d.totalMilestones > 0) {
                    const mRate = d.milestoneCompletionRate;
                    let tone = mRate >= 70 ? 'positive' : mRate >= 40 ? 'caution' : 'negative';
                    ins.push({
                        icon: 'fa-flag-checkered',
                        tone,
                        text: `<strong>${d.milestonesFinished}</strong> out of <strong>${d.totalMilestones}</strong> milestones were completed (<strong>${mRate}%</strong>). ${mRate >= 70 ? 'Milestone delivery is on track, demonstrating solid project scheduling and execution.' : mRate >= 40 ? 'Milestone progress is moderate—some projects may be falling behind schedule.' : 'Milestone completion is low, suggesting projects may face significant delays. A review of timelines and resource allocation is advisable.'}`
                    });
                }

                return ins;
            }

            // ── Projects Insights ──
            function interpretProjects(report) {
                const ins = [];
                const rows = report.rows || [];
                if (rows.length === 0) {
                    ins.push({ icon: 'fa-info-circle', tone: 'neutral', text: 'No projects were created in the selected period.' });
                    return ins;
                }

                const active = rows.filter(r => r.status === 'Active').length;
                const archived = rows.filter(r => r.status === 'Archived').length;
                const totalTasks = rows.reduce((s, r) => s + (r.taskCount || 0), 0);
                const completedTasks = rows.reduce((s, r) => s + (r.completedTaskCount || 0), 0);
                const avgMembers = rows.length > 0 ? (rows.reduce((s, r) => s + (r.memberCount || 0), 0) / rows.length).toFixed(1) : 0;
                const taskRate = totalTasks > 0 ? Math.round(completedTasks / totalTasks * 100) : 0;

                ins.push({
                    icon: 'fa-chart-bar',
                    tone: 'neutral',
                    text: `<strong>${rows.length}</strong> project(s) were created in this period—<strong>${active}</strong> active and <strong>${archived}</strong> archived. On average, each project has <strong>${avgMembers}</strong> member(s).`
                });

                if (totalTasks > 0) {
                    ins.push({
                        icon: 'fa-tasks',
                        tone: taskRate >= 60 ? 'positive' : taskRate >= 30 ? 'caution' : 'negative',
                        text: `Across all listed projects, <strong>${completedTasks}</strong> of <strong>${totalTasks}</strong> tasks are completed (<strong>${taskRate}%</strong>). ${taskRate >= 60 ? 'Overall project task completion is healthy.' : 'Several projects may need attention to improve task throughput.'}`
                    });
                }

                // Identify projects with 0 completed tasks
                const stalled = rows.filter(r => r.taskCount > 0 && r.completedTaskCount === 0);
                if (stalled.length > 0) {
                    ins.push({
                        icon: 'fa-triangle-exclamation',
                        tone: 'caution',
                        text: `<strong>${stalled.length}</strong> project(s) have tasks assigned but none completed yet: <strong>${stalled.map(r => r.name).join(', ')}</strong>. These may be newly started or could need follow-up.`
                    });
                }

                // Identify projects with no members
                const unmanned = rows.filter(r => r.memberCount === 0);
                if (unmanned.length > 0) {
                    ins.push({
                        icon: 'fa-user-slash',
                        tone: 'negative',
                        text: `<strong>${unmanned.length}</strong> project(s) currently have no members assigned: <strong>${unmanned.map(r => r.name).join(', ')}</strong>. Assign team members to keep these projects moving.`
                    });
                }

                return ins;
            }

            // ── Tasks Insights ──
            function interpretTasks(report) {
                const ins = [];
                const rows = report.rows || [];
                if (rows.length === 0) {
                    ins.push({ icon: 'fa-info-circle', tone: 'neutral', text: 'No tasks were created in the selected period.' });
                    return ins;
                }

                const completed = report.completed || 0;
                const pending = report.pending || 0;
                const revision = report.revision || 0;
                const total = rows.length;
                const compRate = total > 0 ? Math.round(completed / total * 100) : 0;

                ins.push({
                    icon: 'fa-chart-pie',
                    tone: compRate >= 60 ? 'positive' : compRate >= 30 ? 'caution' : 'negative',
                    text: `Of <strong>${total}</strong> tasks, <strong>${completed}</strong> are completed (<strong>${compRate}%</strong>), <strong>${pending}</strong> are pending, and <strong>${revision}</strong> require revision. ${compRate >= 60 ? 'Task execution is progressing well.' : 'A significant portion of tasks remain incomplete—consider reviewing workload distribution and deadlines.'}`
                });

                // Unassigned tasks
                const unassigned = rows.filter(r => (r.assigneeCount || 0) === 0);
                if (unassigned.length > 0) {
                    ins.push({
                        icon: 'fa-user-slash',
                        tone: 'caution',
                        text: `<strong>${unassigned.length}</strong> task(s) have no assignees. Unassigned tasks risk being overlooked—ensure all tasks are allocated to responsible team members.`
                    });
                }

                // Tasks across projects
                const projectGroups = {};
                rows.forEach(r => { projectGroups[r.project] = (projectGroups[r.project] || 0) + 1; });
                const projectNames = Object.keys(projectGroups);
                if (projectNames.length > 1) {
                    const sorted = Object.entries(projectGroups).sort((a, b) => b[1] - a[1]);
                    ins.push({
                        icon: 'fa-layer-group',
                        tone: 'neutral',
                        text: `Tasks span <strong>${projectNames.length}</strong> projects. The most task-heavy project is <strong>${sorted[0][0]}</strong> with <strong>${sorted[0][1]}</strong> task(s), followed by <strong>${sorted[1] ? sorted[1][0] : '—'}</strong> with <strong>${sorted[1] ? sorted[1][1] : 0}</strong>.`
                    });
                }

                if (revision > 0) {
                    const revPct = Math.round(revision / total * 100);
                    ins.push({
                        icon: 'fa-rotate-left',
                        tone: revPct >= 15 ? 'negative' : 'caution',
                        text: `<strong>${revision}</strong> task(s) (<strong>${revPct}%</strong>) require revision. ${revPct >= 15 ? 'This is a high revision rate—review submission quality standards and provide clearer task specifications.' : 'A small number of revisions is normal; continue monitoring for trends.'}`
                    });
                }

                return ins;
            }

            // ── Proposals Insights ──
            function interpretProposals(report) {
                const ins = [];
                const rows = report.rows || [];
                if (rows.length === 0) {
                    ins.push({ icon: 'fa-info-circle', tone: 'neutral', text: 'No proposals were submitted in the selected period.' });
                    return ins;
                }

                const approved = report.approved || 0;
                const pending = report.pending || 0;
                const rejected = report.rejected || 0;
                const total = rows.length;
                const approvalRate = total > 0 ? Math.round(approved / total * 100) : 0;

                ins.push({
                    icon: 'fa-chart-bar',
                    tone: approvalRate >= 50 ? 'positive' : approvalRate >= 25 ? 'caution' : 'negative',
                    text: `<strong>${total}</strong> proposal(s) were submitted—<strong>${approved}</strong> approved (<strong>${approvalRate}%</strong>), <strong>${pending}</strong> pending review, and <strong>${rejected}</strong> rejected. ${approvalRate >= 50 ? 'The approval rate reflects strong alignment between proposals and organizational objectives.' : 'Consider reviewing the proposal preparation and feedback process to improve acceptance rates.'}`
                });

                if (pending > 0) {
                    const pendingPct = Math.round(pending / total * 100);
                    ins.push({
                        icon: 'fa-hourglass-half',
                        tone: pendingPct >= 50 ? 'caution' : 'neutral',
                        text: `<strong>${pending}</strong> proposal(s) (<strong>${pendingPct}%</strong>) are still pending review. ${pendingPct >= 50 ? 'A high pending ratio may indicate review bottlenecks—ensure reviewers have adequate bandwidth.' : 'Pending proposals are within a normal range.'}`
                    });
                }

                // Department distribution
                const deptGroups = {};
                rows.forEach(r => { deptGroups[r.department] = (deptGroups[r.department] || 0) + 1; });
                const depts = Object.entries(deptGroups).sort((a, b) => b[1] - a[1]);
                if (depts.length > 1) {
                    ins.push({
                        icon: 'fa-building',
                        tone: 'neutral',
                        text: `Proposals came from <strong>${depts.length}</strong> department(s). The most active is <strong>${depts[0][0]}</strong> with <strong>${depts[0][1]}</strong> submission(s), indicating strong initiative from that area.`
                    });
                }

                if (rejected > 0 && total > 0) {
                    const rejRate = Math.round(rejected / total * 100);
                    if (rejRate >= 40) {
                        ins.push({
                            icon: 'fa-circle-xmark',
                            tone: 'negative',
                            text: `The rejection rate is <strong>${rejRate}%</strong>, which is high. Investigate whether submission guidelines are clear, and consider offering proposal workshops or templates to improve quality.`
                        });
                    }
                }

                return ins;
            }

            // ── Employees Insights ──
            function interpretEmployees(report) {
                const ins = [];
                const rows = report.rows || [];
                if (rows.length === 0) {
                    ins.push({ icon: 'fa-info-circle', tone: 'neutral', text: 'No employees were hired in the selected period.' });
                    return ins;
                }

                const total = rows.length;
                const avgProjects = (rows.reduce((s, r) => s + (r.projectCount || 0), 0) / total).toFixed(1);
                const avgTasks = (rows.reduce((s, r) => s + (r.taskCount || 0), 0) / total).toFixed(1);

                ins.push({
                    icon: 'fa-user-plus',
                    tone: 'positive',
                    text: `<strong>${total}</strong> employee(s) were hired during this period. On average, each new hire is assigned to <strong>${avgProjects}</strong> project(s) and <strong>${avgTasks}</strong> task(s), indicating ${parseFloat(avgProjects) > 0 ? 'active onboarding and integration into the workforce' : 'new hires are still being onboarded—ensure timely project and task assignment'}.`
                });

                // Department distribution
                const deptDistrib = report.deptDistribution || [];
                if (deptDistrib.length > 1) {
                    const topDept = deptDistrib[0];
                    ins.push({
                        icon: 'fa-building',
                        tone: 'neutral',
                        text: `New hires are distributed across <strong>${deptDistrib.length}</strong> department(s). <strong>${topDept.department}</strong> received the most new hires (<strong>${topDept.count}</strong>), suggesting active expansion or higher staffing needs in that area.`
                    });
                }

                // Employees with no projects
                const idle = rows.filter(r => (r.projectCount || 0) === 0);
                if (idle.length > 0) {
                    ins.push({
                        icon: 'fa-user-clock',
                        tone: 'caution',
                        text: `<strong>${idle.length}</strong> new hire(s) have not been assigned to any project yet: <strong>${idle.slice(0, 5).map(r => r.name).join(', ')}${idle.length > 5 ? ', ...' : ''}</strong>. Quick project assignment can accelerate integration and productivity.`
                    });
                }

                // Employees with high task count
                const highTask = rows.filter(r => (r.taskCount || 0) >= 10);
                if (highTask.length > 0) {
                    ins.push({
                        icon: 'fa-fire',
                        tone: 'caution',
                        text: `<strong>${highTask.length}</strong> new hire(s) already have 10 or more tasks assigned. While this shows rapid integration, monitor for potential overloading during the onboarding period.`
                    });
                }

                return ins;
            }

            // ── Search filter ──
            tableSearch.addEventListener('input', function () {
                if (!currentReport || !currentReport.rows) return;
                const columns = getColumns(currentReport.type);
                renderRows(currentReport.rows, columns, this.value);
            });

            // ══════════════════════════════════════════════════════
            // ── PDF Export (text-based using jsPDF + autoTable) ──
            // ══════════════════════════════════════════════════════

            function stripHtml(html) {
                const tmp = document.createElement('span');
                tmp.innerHTML = html;
                return tmp.textContent || tmp.innerText || '';
            }

            function pdfAddHeader(doc, title, dateRange) {
                const pageW = doc.internal.pageSize.getWidth();
                const primaryColor = [0, 105, 148];

                // Title
                doc.setFontSize(20);
                doc.setFont('helvetica', 'bold');
                doc.setTextColor(...primaryColor);
                doc.text(title, pageW / 2, 20, { align: 'center' });

                // Date range
                doc.setFontSize(10);
                doc.setFont('helvetica', 'normal');
                doc.setTextColor(100, 116, 139);
                doc.text(`Report Period: ${dateRange}`, pageW / 2, 27, { align: 'center' });

                // Generated date
                doc.setFontSize(8);
                doc.text(`Generated on ${new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}`, pageW / 2, 32, { align: 'center' });

                // Horizontal rule
                doc.setDrawColor(...primaryColor);
                doc.setLineWidth(0.5);
                doc.line(14, 35, pageW - 14, 35);

                return 42;
            }

            function pdfAddFooter(doc) {
                const pageCount = doc.internal.getNumberOfPages();
                const pageW = doc.internal.pageSize.getWidth();
                const pageH = doc.internal.pageSize.getHeight();
                for (let i = 1; i <= pageCount; i++) {
                    doc.setPage(i);
                    doc.setFontSize(8);
                    doc.setTextColor(150);
                    doc.setFont('helvetica', 'normal');
                    doc.text(`Page ${i} of ${pageCount}`, pageW / 2, pageH - 8, { align: 'center' });
                    doc.text('Confidential — For Internal Use Only', 14, pageH - 8);
                }
            }

            function pdfAddSectionTitle(doc, y, title) {
                const pageH = doc.internal.pageSize.getHeight();
                if (y + 14 > pageH - 20) {
                    doc.addPage();
                    y = 16;
                }
                doc.setFontSize(13);
                doc.setFont('helvetica', 'bold');
                doc.setTextColor(0, 105, 148);
                doc.text(title, 14, y);
                doc.setDrawColor(0, 105, 148);
                doc.setLineWidth(0.3);
                doc.line(14, y + 2, doc.internal.pageSize.getWidth() - 14, y + 2);
                return y + 8;
            }

            function pdfAddKeyValueTable(doc, y, items) {
                const pageW = doc.internal.pageSize.getWidth();
                const pageH = doc.internal.pageSize.getHeight();
                const colWidth = (pageW - 28) / 2;

                doc.setFontSize(10);
                for (let i = 0; i < items.length; i += 2) {
                    if (y + 8 > pageH - 20) {
                        doc.addPage();
                        y = 16;
                    }

                    // Left column
                    doc.setFont('helvetica', 'normal');
                    doc.setTextColor(100, 116, 139);
                    doc.text(items[i].label + ':', 18, y);
                    doc.setFont('helvetica', 'bold');
                    doc.setTextColor(30, 41, 59);
                    doc.text(String(items[i].value), 18 + 55, y);

                    // Right column (if exists)
                    if (items[i + 1]) {
                        doc.setFont('helvetica', 'normal');
                        doc.setTextColor(100, 116, 139);
                        doc.text(items[i + 1].label + ':', 14 + colWidth + 4, y);
                        doc.setFont('helvetica', 'bold');
                        doc.setTextColor(30, 41, 59);
                        doc.text(String(items[i + 1].value), 14 + colWidth + 4 + 55, y);
                    }

                    y += 7;
                }
                return y + 2;
            }

            function pdfAddParagraph(doc, y, text, maxWidth) {
                const pageH = doc.internal.pageSize.getHeight();
                doc.setFontSize(9.5);
                doc.setFont('helvetica', 'normal');
                doc.setTextColor(51, 65, 85);
                const lines = doc.splitTextToSize(text, maxWidth || (doc.internal.pageSize.getWidth() - 32));
                for (const line of lines) {
                    if (y + 5 > pageH - 20) {
                        doc.addPage();
                        y = 16;
                    }
                    doc.text(line, 18, y);
                    y += 5;
                }
                return y + 2;
            }

            function pdfAddBulletList(doc, y, items) {
                const pageW = doc.internal.pageSize.getWidth();
                const pageH = doc.internal.pageSize.getHeight();
                const maxW = pageW - 38;
                doc.setFontSize(9.5);
                doc.setFont('helvetica', 'normal');
                doc.setTextColor(51, 65, 85);

                for (const item of items) {
                    const plainText = stripHtml(item);
                    const lines = doc.splitTextToSize(plainText, maxW);
                    for (let j = 0; j < lines.length; j++) {
                        if (y + 5 > pageH - 20) {
                            doc.addPage();
                            y = 16;
                        }
                        if (j === 0) {
                            doc.setFont('helvetica', 'bold');
                            doc.text('\u2022', 18, y);
                            doc.setFont('helvetica', 'normal');
                        }
                        doc.text(lines[j], 24, y);
                        y += 5;
                    }
                    y += 1;
                }
                return y + 2;
            }

            function pdfBuildSummary(doc, report) {
                const d = report.data;
                let y = pdfAddHeader(doc, 'Executive Summary', `${report.from} — ${report.to}`);

                // Projects Section
                y = pdfAddSectionTitle(doc, y, 'Projects Overview');
                y = pdfAddKeyValueTable(doc, y, [
                    { label: 'Projects Created', value: d.projectsCreated },
                    { label: 'Active Projects', value: d.activeProjects },
                    { label: 'Archived Projects', value: d.archivedProjects },
                ]);

                // Tasks Section
                y = pdfAddSectionTitle(doc, y + 2, 'Tasks Overview');
                y = pdfAddKeyValueTable(doc, y, [
                    { label: 'Total Tasks', value: d.totalTasks },
                    { label: 'Completed', value: d.completedTasks },
                    { label: 'Pending', value: d.pendingTasks },
                    { label: 'Require Revision', value: d.revisionTasks },
                    { label: 'Completion Rate', value: d.taskCompletionRate + '%' },
                ]);

                // Proposals Section
                y = pdfAddSectionTitle(doc, y + 2, 'Proposals Overview');
                y = pdfAddKeyValueTable(doc, y, [
                    { label: 'Total Proposals', value: d.totalProposals },
                    { label: 'Approved', value: d.approvedProposals },
                    { label: 'Pending', value: d.pendingProposals },
                    { label: 'Rejected', value: d.rejectedProposals },
                    { label: 'Approval Rate', value: d.proposalApprovalRate + '%' },
                ]);

                // People & Milestones Section
                y = pdfAddSectionTitle(doc, y + 2, 'People & Milestones');
                y = pdfAddKeyValueTable(doc, y, [
                    { label: 'New Employees', value: d.newEmployees },
                    { label: 'Total Employees', value: d.totalEmployees },
                    { label: 'Departments', value: d.totalDepartments },
                    { label: 'Milestones Done', value: d.milestonesFinished },
                    { label: 'Total Milestones', value: d.totalMilestones },
                    { label: 'Milestone Rate', value: d.milestoneCompletionRate + '%' },
                ]);

                return y;
            }

            function pdfBuildTable(doc, report) {
                const titles = {
                    projects: 'Projects Report',
                    tasks: 'Tasks Report',
                    proposals: 'Proposals Report',
                    employees: 'Employees Report'
                };
                let y = pdfAddHeader(doc, titles[report.type] || 'Report', `${report.from} — ${report.to}`);

                // Overview stats
                y = pdfAddSectionTitle(doc, y, 'Overview');
                const overviewItems = [{ label: 'Total Records', value: report.totalCount }];

                if (report.type === 'tasks') {
                    overviewItems.push({ label: 'Completed', value: report.completed || 0 });
                    overviewItems.push({ label: 'Pending', value: report.pending || 0 });
                    overviewItems.push({ label: 'Require Revision', value: report.revision || 0 });
                } else if (report.type === 'proposals') {
                    overviewItems.push({ label: 'Approved', value: report.approved || 0 });
                    overviewItems.push({ label: 'Pending', value: report.pending || 0 });
                    overviewItems.push({ label: 'Rejected', value: report.rejected || 0 });
                } else if (report.type === 'employees' && report.deptDistribution && report.deptDistribution.length > 0) {
                    overviewItems.push({ label: 'Top Department', value: `${report.deptDistribution[0].department} (${report.deptDistribution[0].count})` });
                }
                y = pdfAddKeyValueTable(doc, y, overviewItems);

                // Data table
                y = pdfAddSectionTitle(doc, y + 2, 'Detailed Records');
                const columns = getColumns(report.type);
                const head = [columns.map(c => c.label)];
                const body = (report.rows || []).map(r =>
                    columns.map(c => String(r[c.key] ?? '\u2014'))
                );

                doc.autoTable({
                    startY: y,
                    head: head,
                    body: body,
                    margin: { left: 14, right: 14 },
                    styles: {
                        fontSize: 8,
                        cellPadding: 3,
                        textColor: [51, 65, 85],
                        lineColor: [226, 232, 240],
                        lineWidth: 0.2,
                    },
                    headStyles: {
                        fillColor: [0, 105, 148],
                        textColor: [255, 255, 255],
                        fontStyle: 'bold',
                        fontSize: 8.5,
                    },
                    alternateRowStyles: {
                        fillColor: [248, 250, 252],
                    },
                    didDrawPage: function () {
                        // footer will be added at end
                    }
                });

                return doc.lastAutoTable.finalY + 4;
            }

            function pdfAddInsights(doc, y, report) {
                const insights = [];
                switch (report.type) {
                    case 'summary': insights.push(...interpretSummary(report.data)); break;
                    case 'projects': insights.push(...interpretProjects(report)); break;
                    case 'tasks': insights.push(...interpretTasks(report)); break;
                    case 'proposals': insights.push(...interpretProposals(report)); break;
                    case 'employees': insights.push(...interpretEmployees(report)); break;
                }

                if (insights.length === 0) return y;

                y = pdfAddSectionTitle(doc, y + 2, 'Key Insights & Interpretation');

                const bulletItems = insights.map(i => stripHtml(i.text));
                y = pdfAddBulletList(doc, y, bulletItems);

                // Footer note
                const pageH = doc.internal.pageSize.getHeight();
                if (y + 8 > pageH - 20) {
                    doc.addPage();
                    y = 16;
                }
                doc.setFontSize(8);
                doc.setFont('helvetica', 'italic');
                doc.setTextColor(150);
                doc.text(`Auto-generated insights based on data for the selected period (${report.from} — ${report.to}).`, 18, y);
                return y + 6;
            }

            btnExport.addEventListener('click', function () {
                if (!currentReport) return;

                const { jsPDF } = window.jspdf;
                const doc = new jsPDF({
                    orientation: 'portrait',
                    unit: 'mm',
                    format: 'a4'
                });

                let finalY;

                if (currentReport.type === 'summary') {
                    finalY = pdfBuildSummary(doc, currentReport);
                } else {
                    finalY = pdfBuildTable(doc, currentReport);
                }

                // Add insights section
                pdfAddInsights(doc, finalY, currentReport);

                // Add page footers
                pdfAddFooter(doc);

                // Save
                const titles = {
                    summary: 'Executive_Summary',
                    projects: 'Projects_Report',
                    tasks: 'Tasks_Report',
                    proposals: 'Proposals_Report',
                    employees: 'Employees_Report'
                };
                const dateStr = new Date().toISOString().split('T')[0];
                doc.save(`${titles[currentReport.type] || 'Report'}_${dateStr}.pdf`);
            });
        })();
    </script>
}
