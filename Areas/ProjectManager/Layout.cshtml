@{
    Layout = null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Project Manager Dashboard</title>

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/proposal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/depthead-project.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employee-proposal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employee-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employee-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employee-news.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employee-project.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employee-document.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/messenger.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/project_lifecycle.styles.css" asp-append-version="true" />
</head>
<body class="employee-body">

    <!-- Mobile overlay -->
    <div class="emp-sidebar-overlay" id="sidebarOverlay"></div>

    <div class="emp-layout">

        <!-- ========== SIDEBAR ========== -->
        <aside class="emp-sidebar" id="empSidebar">

            <!-- Brand -->
            <div class="emp-sidebar-header">
                <a href="@Url.Action("Index", "Dashboard", new { area = "ProjectManager" })" class="emp-sidebar-brand">
                    <div class="emp-brand-icon">
                        <img src="~/css/Images/LOGO (final).png" asp-append-version="true" alt="Project Lifecycle Logo" class="brand-logo emp-brand-logo" />
                    </div>
                    <span class="emp-brand-text">
                        Project <br />
                        Lifecycle
                    </span>
                </a>
                <button class="emp-sidebar-toggle" id="sidebarToggle" title="Toggle Sidebar">
                    <i class="fas fa-bars fa-sm"></i>
                </button>
            </div>

            <!-- Navigation -->
            <nav class="emp-sidebar-nav">
                <span class="emp-nav-section-title">Menu</span>
                <ul class="emp-nav-list">
                    <li class="emp-nav-item">
                        <a href="@Url.Action("Index", "Dashboard", new { area = "ProjectManager" })"
                           class="emp-nav-link @(currentController == "Dashboard" ? "active" : "")"
                           data-tooltip="Dashboard">
                            <i class="fas fa-th-large"></i>
                            <span class="emp-nav-text">Dashboard</span>
                        </a>
                    </li>
                    <li class="emp-nav-item">
                        <a href="@Url.Action("Index", "Project", new { area = "ProjectManager" })"
                           class="emp-nav-link @(currentController == "Project" ? "active" : "")"
                           data-tooltip="Projects">
                            <i class="fas fa-diagram-project"></i>
                            <span class="emp-nav-text">Projects</span>
                        </a>
                    </li>
                    <li class="emp-nav-item emp-nav-collapsible @( (currentController == "Management" && (currentAction == "Milestone" || currentAction == "ProjectRole")) || currentController == "ProjectRole" ? "expanded" : "")" id="managementNav">
                        <button type="button" class="emp-nav-link emp-nav-toggle @(currentController == "Management" ? "active" : "")" aria-expanded="@( (currentController == "Management" && (currentAction == "Milestone" || currentAction == "ProjectRole")) || currentController == "ProjectRole" ? "true" : "false")" id="managementToggle">
                            <i class="fas fa-layer-group"></i>
                            <span class="emp-nav-text">Management</span>
                            <i class="emp-nav-caret fas fa-chevron-down" style="margin-left:auto;font-size:.85rem"></i>
                        </button>
                        <ul class="emp-nav-sublist" id="managementSublist" aria-hidden="true">
                            <li class="emp-nav-item">
                                <a href="@Url.Action("Milestone", "Management", new { area = "ProjectManager" })"
                                   class="emp-nav-link @(currentController == "Management" && currentAction == "Milestone" ? "active" : "")">
                                    <i class="fas fa-clock-rotate-left"></i>
                                    <span class="emp-nav-text">Milestones</span>
                                </a>
                            </li>
                            <li class="emp-nav-item">
                                          <a href="@Url.Action("ProjectRole", "Management", new { area = "ProjectManager" })"
                                              class="emp-nav-link @(currentController == "ProjectRole" || (currentController == "Management" && currentAction == "ProjectRole") ? "active" : "")">
                                    <i class="fas fa-user-gear"></i>
                                    <span class="emp-nav-text">Project Roles</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="emp-nav-item">
                        <a href="@Url.Action("Index", "News", new { area = "ProjectManager" })"
                           class="emp-nav-link @(currentController == "News" ? "active" : "")"
                           data-tooltip="News">
                            <i class="fas fa-newspaper"></i>
                            <span class="emp-nav-text">News</span>
                        </a>
                    </li>
                    <li class="emp-nav-item">
                        <a href="@Url.Action("Index", "Messages", new { area = "ProjectManager" })"
                           class="emp-nav-link @(currentController == "Messages" ? "active" : "")"
                           data-tooltip="Messages">
                            <i class="fas fa-comment-dots"></i>
                            <span class="emp-nav-text">Messages</span>
                            <span class="msg-nav-badge" style="display:none"></span>
                        </a>
                    </li>
                </ul>
            </nav>

        </aside>

        <!-- ========== MAIN ========== -->
        <div class="emp-main">

            <!-- Header -->
            <header class="emp-header" id="empHeader">
                <div class="emp-header-left">
                    <button class="emp-mobile-toggle" id="mobileSidebarToggle" aria-label="Open menu">
                        <i class="fas fa-bars"></i>
                    </button>
                    <nav class="emp-breadcrumb" aria-label="Breadcrumb">
                        <a href="@Url.Action("Index", "Dashboard", new { area = "ProjectManager" })" class="emp-breadcrumb-home">
                            <i class="fas fa-home"></i>
                        </a>
                        <span class="emp-breadcrumb-sep"><i class="fas fa-chevron-right"></i></span>
                        <span class="emp-breadcrumb-current">@(ViewData["Title"] ?? "Dashboard")</span>
                    </nav>
                </div>

                <div class="emp-header-right">
                    <div class="notif-wrapper">
                        <button class="emp-header-btn notif-bell-btn" id="notifBellBtn" title="Notifications" aria-expanded="false">
                            <i class="fas fa-bell"></i>
                            <span class="notif-badge" id="notifBadge">0</span>
                            <span class="emp-notif-dot" id="notifDot" style="display:none"></span>
                        </button>
                        <div class="notif-dropdown" id="notifDropdown">
                            <div class="notif-dropdown-header">
                                <h6><i class="fas fa-bell"></i> Notifications</h6>
                                <button class="notif-mark-all" id="notifMarkAllRead" style="display:none">Mark all read</button>
                            </div>
                            <div class="notif-list" id="notifList"></div>
                            <div class="notif-empty" id="notifEmpty">
                                <i class="fas fa-bell-slash"></i>
                                <span>No notifications yet</span>
                            </div>
                        </div>
                    </div>

                    <div class="emp-header-divider"></div>

                    <div class="emp-header-profile" id="userDropdownToggle" style="cursor:pointer;position:relative;">
                        <div class="emp-header-avatar" id="headerUserAvatar">PM</div>
                        <div class="emp-header-user-info">
                            <div class="emp-header-greeting" id="headerGreeting">Welcome back</div>
                            <div class="emp-header-name" id="headerUserName">Project Manager</div>
                        </div>
                        <i class="fas fa-chevron-down" style="font-size:.7rem;color:#64748b;margin-left:.25rem"></i>
                        <div class="emp-user-dropdown" id="userDropdown">
                            <a href="@Url.Action("Index", "Profile", new { area = "ProjectManager" })" class="emp-user-dropdown-item">
                                <i class="fas fa-user"></i>
                                <span>Profile</span>
                            </a>
                            <div class="emp-user-dropdown-divider"></div>
                            <button type="button" class="emp-user-dropdown-item emp-user-dropdown-logout" id="logoutBtn">
                                <i class="fas fa-arrow-right-from-bracket"></i>
                                <span>Logout</span>
                            </button>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="emp-content">
                @RenderBody()
            </main>
        </div>

    </div>

    <!-- Logout confirmation modal + Scripts -->

    <!-- Hidden logout form -->
    <form action="/Identity/Account/Logout" method="post" id="logoutForm" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="/" />
    </form>

    <style>
    /* User dropdown */
    .emp-user-dropdown { position:absolute; top:calc(100% + 4px); right:0; background:#fff; border-radius:8px; box-shadow:0 2px 12px rgba(0,0,0,.10); min-width:150px; padding:.3rem 0; display:none; z-index:1500; }
    .emp-user-dropdown.active { display:block; }
    .emp-user-dropdown-item { display:flex; align-items:center; gap:.45rem; padding:.35rem .75rem; font-size:.8rem; color:#334155; text-decoration:none; cursor:pointer; border:none; background:transparent; width:100%; text-align:left; }
    .emp-user-dropdown-item:hover { background:#f1f5f9; color:#0f172a; }
    .emp-user-dropdown-item i { width:15px; text-align:center; font-size:.78rem; }
    .emp-user-dropdown-divider { height:1px; background:#e2e8f0; margin:.15rem 0; }
    .emp-user-dropdown-logout { color:#ef4444; }
    .emp-user-dropdown-logout:hover { background:#fef2f2; color:#dc2626; }
    .emp-modal-backdrop { position: fixed; inset: 0; background: rgba(3,7,18,0.6); display: none; align-items: center; justify-content: center; z-index: 2000; }
    .emp-modal-backdrop.active { display: flex; }
    .emp-modal { background: #fff; border-radius: 12px; width: 94%; max-width: 420px; padding: 1.25rem; box-shadow: 0 10px 30px rgba(2,6,23,0.35); }
    .emp-modal h4 { margin: 0 0 .5rem; font-size: 1.05rem; color: #0f172a; }
    .emp-modal p { margin: 0 0 1rem; color: #64748b; font-size: .92rem; }
    .emp-modal .emp-modal-actions { display:flex; gap:.5rem; justify-content:flex-end; }
    .emp-modal .emp-btn { border-radius: 8px; padding: .5rem .85rem; font-weight:600; }
    .emp-modal .emp-btn-cancel { background: transparent; border:1px solid #e6eef6; color:#475569; }
    .emp-modal .emp-btn-confirm { background: linear-gradient(90deg,#006994,#4CA3DD); color:#fff; border:none; }
    /* Management collapsible nav */
    .emp-nav-collapsible { position: relative; }
    .emp-nav-collapsible .emp-nav-sublist { display: none; list-style: none; margin: .5rem 0 0; padding: .25rem 0 0 0; }
    .emp-nav-collapsible .emp-nav-sublist .emp-nav-item { padding-left: 1.1rem; }
    .emp-nav-collapsible .emp-nav-sublist .emp-nav-link { display:flex; align-items:center; gap:.6rem; padding:.45rem .8rem; border-radius:8px; }
    .emp-nav-collapsible.expanded .emp-nav-sublist { display: block; }
    .emp-nav-toggle { display:flex; align-items:center; gap:.6rem; width:100%; background:transparent; border:none; padding:.45rem .75rem; text-align:left; cursor:pointer; border-radius:8px; }
    .emp-nav-toggle:focus { outline: none; box-shadow: 0 0 0 3px rgba(76,163,221,.08); }
    </style>

    <div class="emp-modal-backdrop" id="logoutModal" role="dialog" aria-modal="true" aria-hidden="true">
        <div class="emp-modal" role="document">
            <h4>Sign out</h4>
            <p>Are you sure you want to sign out of your account?</p>
            <div class="emp-modal-actions">
                <button type="button" class="emp-btn emp-btn-cancel" id="cancelLogoutBtn">Cancel</button>
                <button type="button" class="emp-btn emp-btn-confirm" id="confirmLogoutBtn">Sign out</button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    <script src="~/js/header-user.js" asp-append-version="true"></script>
    <script src="~/lib/microsoft-signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/messenger.js" asp-append-version="true"></script>

    <script>
    (function () {
        const sidebar  = document.getElementById('empSidebar');
        const toggle   = document.getElementById('sidebarToggle');
        const mobile   = document.getElementById('mobileSidebarToggle');
        const overlay  = document.getElementById('sidebarOverlay');
        const header   = document.getElementById('empHeader');
        const greeting = document.getElementById('headerGreeting');

        /* --- Time-based greeting --- */
        const hour = new Date().getHours();
        if (greeting) {
            greeting.textContent = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
        }

        /* --- Sidebar collapse toggle (desktop) --- */
        toggle?.addEventListener('click', function () {
            const icon = this.querySelector('i');
            const collapsed = sidebar.classList.toggle('collapsed');
            icon.className = collapsed ? 'fas fa-chevron-right fa-sm' : 'fas fa-bars fa-sm';
            this.setAttribute('title', collapsed ? 'Expand Sidebar' : 'Collapse Sidebar');
            localStorage.setItem('empSidebarCollapsed', collapsed);
        });

        /* --- Restore collapsed state --- */
        if (localStorage.getItem('empSidebarCollapsed') === 'true') {
            sidebar?.classList.add('collapsed');
            const icon = toggle?.querySelector('i');
            if (icon) {
                icon.className = 'fas fa-chevron-right fa-sm';
                toggle.setAttribute('title', 'Expand Sidebar');
            }
        }

        /* --- Mobile sidebar --- */
        function openMobile()  { sidebar?.classList.add('mobile-open');    overlay?.classList.add('active'); }
        function closeMobile() { sidebar?.classList.remove('mobile-open'); overlay?.classList.remove('active'); }

        mobile?.addEventListener('click', function () {
            sidebar?.classList.contains('mobile-open') ? closeMobile() : openMobile();
        });
        overlay?.addEventListener('click', closeMobile);

        document.addEventListener('click', function (e) {
            if (window.innerWidth <= 768 &&
                sidebar?.classList.contains('mobile-open') &&
                !sidebar.contains(e.target) &&
                !mobile?.contains(e.target)) {
                closeMobile();
            }
        });

        /* --- Management collapsible --- */
        (function () {
            const mgToggle = document.getElementById('managementToggle');
            const mgNav = document.getElementById('managementNav');
            const mgSub = document.getElementById('managementSublist');
            const storageKey = 'empManagementOpen';
            function setExpanded(exp) {
                if (!mgNav || !mgToggle || !mgSub) return;
                mgNav.classList.toggle('expanded', exp);
                mgToggle.setAttribute('aria-expanded', exp ? 'true' : 'false');
                mgSub.setAttribute('aria-hidden', exp ? 'false' : 'true');
                // persist user's choice for future sessions, but do not auto-apply on load
                try { localStorage.setItem(storageKey, exp ? 'true' : 'false'); } catch { }
            }

            // Do not auto-restore expanded state from localStorage on page load.
            // Keep the server-rendered state (server may set expanded when on Management pages).

            mgToggle?.addEventListener('click', function () {
                setExpanded(!mgNav.classList.contains('expanded'));
            });
        })();

        /* --- Sticky header shadow on scroll --- */
        window.addEventListener('scroll', function () {
            header?.classList.toggle('scrolled', window.scrollY > 8);
        }, { passive: true });

        /* --- Notifications --- */
        if (typeof initNotifications === 'function') initNotifications();

        /* --- User dropdown --- */
        const userDropdownToggle = document.getElementById('userDropdownToggle');
        const userDropdown = document.getElementById('userDropdown');
        userDropdownToggle?.addEventListener('click', function (e) {
            e.stopPropagation();
            userDropdown?.classList.toggle('active');
        });
        document.addEventListener('click', function (e) {
            if (!userDropdownToggle?.contains(e.target)) {
                userDropdown?.classList.remove('active');
            }
        });

        /* --- Logout confirmation modal --- */
        const logoutForm = document.getElementById('logoutForm');
        const logoutBtn = document.getElementById('logoutBtn');
        const logoutModal = document.getElementById('logoutModal');
        const confirmLogoutBtn = document.getElementById('confirmLogoutBtn');
        const cancelLogoutBtn = document.getElementById('cancelLogoutBtn');

        function showLogoutModal() {
            if (!logoutModal) return;
            logoutModal.classList.add('active');
            logoutModal.setAttribute('aria-hidden', 'false');
        }
        function hideLogoutModal() {
            if (!logoutModal) return;
            logoutModal.classList.remove('active');
            logoutModal.setAttribute('aria-hidden', 'true');
        }

        logoutBtn?.addEventListener('click', function (e) {
            e.preventDefault();
            showLogoutModal();
        });

        cancelLogoutBtn?.addEventListener('click', function () { hideLogoutModal(); });

        // Close modal when clicking backdrop
        logoutModal?.addEventListener('click', function (e) {
            if (e.target === logoutModal) hideLogoutModal();
        });

        confirmLogoutBtn?.addEventListener('click', function () {
            if (logoutForm) logoutForm.submit();
        });
    })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
