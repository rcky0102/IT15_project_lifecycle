@model project_lifecycle.ViewModels.ProjectManager.ProjectTaskEditViewModel
@{
    ViewData["Title"] = "Edit Task";
    var projectStart = ViewData["ProjectStart"] as string ?? string.Empty;
    var projectEnd = ViewData["ProjectEnd"] as string ?? string.Empty;
}

<style>
    .tm-member-card { display:flex; align-items:center; justify-content:space-between; gap:.75rem; padding:.65rem .85rem; border-radius:10px; background:#f8fafc; border:1px solid #e2e8f0; margin-bottom:.5rem; }
    .tm-member-card.archived { background:#fff1f2; border-color:#fecdd3; opacity:.85; }
    .tm-member-left { display:flex; align-items:center; gap:.7rem; min-width:0; }
    .tm-member-avatar { width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:.78rem; flex-shrink:0; background:linear-gradient(135deg,#eef2ff,#e0e7ff); color:#3730a3; overflow:hidden; border:2px solid #fff; box-shadow:0 2px 8px rgba(0,0,0,.07); }
    .tm-member-avatar img { width:100%; height:100%; object-fit:cover; display:block; }
    .tm-member-name { font-weight:600; font-size:.87rem; color:#1e293b; }
    .tm-member-role { font-size:.76rem; color:#64748b; }
    .tm-member-badge { display:inline-flex; align-items:center; gap:.3rem; font-size:.72rem; font-weight:700; padding:.18rem .55rem; border-radius:20px; }
    .tm-member-badge.active { background:#dcfce7; color:#16a34a; }
    .tm-member-badge.archived { background:#fee2e2; color:#dc2626; }
    .tm-add-section { margin-top:.75rem; padding-top:.75rem; border-top:1px dashed #cbd5e1; }
</style>

<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title"><span class="emp-page-title-icon"><i class="fas fa-pen"></i></span> Edit Task</h1>
            <p class="emp-page-subtitle">Project: @Model.ProjectName</p>
        </div>
        <div class="emp-page-hero-right">
            <a asp-area="ProjectManager" asp-controller="Project" asp-action="Milestone" asp-route-projectMilestoneId="@Model.ProjectMilestoneId" class="emp-btn emp-btn-outline">
                <i class="fas fa-arrow-left"></i> Back to Milestone
            </a>
        </div>
    </div>
</div>

<div class="emp-form-card">
    <div class="emp-form-section">
        <div class="emp-form-section-title"><i class="fas fa-list-check"></i> Task Details</div>

        <form asp-area="ProjectManager" asp-controller="Project" asp-action="EditTask" method="post" class="emp-form emp-edit-task-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="emp-form-row">
                <label class="emp-form-label">Task Name</label>
                <input name="Name" id="taskName" class="emp-form-control" value="@Model.Name" required />
            </div>

            <!-- ===== Assigned Members (redesigned with archive/unarchive) ===== -->
            <div class="emp-form-row">
                <label class="emp-form-label">Assigned Members</label>

                @if (!Model.CurrentTaskMembers.Any() && !Model.AvailableMembers.Any())
                {
                    <div class="emp-form-control" style="color:#94a3b8;cursor:default;">No project members yet.</div>
                }
                else
                {
                    @if (Model.CurrentTaskMembers.Any())
                    {
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.6rem;">
                            <span style="font-size:.8rem;color:#64748b;">@Model.CurrentTaskMembers.Count member(s)</span>
                            <select id="taskMemberFilter" class="emp-form-control" style="width:auto;padding:.25rem .65rem;font-size:.8rem;height:auto;">
                                <option value="all">All</option>
                                <option value="active" selected>Active only</option>
                                <option value="archived">Removed only</option>
                            </select>
                        </div>
                    }
                <div id="currentMembersContainer">
                        @foreach (var tm in Model.CurrentTaskMembers)
                        {
                            var initials = string.Concat((tm.EmployeeName ?? "").Split(' ').Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s[0])).ToUpper();
                            if (initials.Length > 2) { initials = initials.Substring(0, 2); }
                            <div class="tm-member-card @(tm.IsArchived ? "archived" : "")">
                                <div class="tm-member-left">
                                    <div class="tm-member-avatar">
                                        @if (!string.IsNullOrWhiteSpace(tm.ProfileImage))
                                        {
                                            <img src="@tm.ProfileImage" alt="@tm.EmployeeName" />
                                        }
                                        else
                                        {
                                            @initials
                                        }
                                    </div>
                                    <div>
                                        <div class="tm-member-name">@tm.EmployeeName</div>
                                        <div class="tm-member-role">@tm.ProjectRoleName</div>
                                    </div>
                                    @if (tm.IsArchived)
                                    {
                                        <span class="tm-member-badge archived"><i class="fas fa-lock" style="font-size:.65rem;"></i> Removed</span>
                                    }
                                    else
                                    {
                                        <span class="tm-member-badge active"><i class="fas fa-check" style="font-size:.65rem;"></i> Active</span>
                                    }
                                </div>
                                <div>
                                    @if (tm.IsArchived)
                                    {
                                        <button type="button" class="emp-action-btn emp-action-unarchive" title="Restore to task"
                                                data-member-name="@tm.EmployeeName"
                                                data-tm-id="@tm.TaskMemberId"
                                                data-tm-action="@Url.Action("UnarchiveTaskMember", "Project", new { area = "ProjectManager" })"
                                                onclick="openTmUnarchiveModal(this.dataset.tmId, this.dataset.tmAction, this.dataset.memberName)">
                                            <i class="fas fa-box-open"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="emp-action-btn emp-action-archive" title="Remove from task"
                                                data-member-name="@tm.EmployeeName"
                                                data-tm-id="@tm.TaskMemberId"
                                                data-tm-action="@Url.Action("ArchiveTaskMember", "Project", new { area = "ProjectManager" })"
                                                onclick="openTmArchiveModal(this.dataset.tmId, this.dataset.tmAction, this.dataset.memberName)">
                                            <i class="fas fa-archive"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @if (Model.AvailableMembers.Any())
                    {
                        <div class="tm-add-section">
                            <label class="emp-form-label" style="margin-bottom:.4rem;font-size:.83rem;">Add Members</label>
                            <input type="text" id="assignMemberInput" class="emp-form-control" placeholder="Click to add project members…" autocomplete="off" readonly style="cursor:pointer;" />
                            <div id="assignedMemberChips" style="display:flex; flex-wrap:wrap; gap:.4rem; margin-top:.5rem;"></div>
                            <div id="assignedMemberHiddenInputs"></div>
                        </div>
                    }
                }
            </div>

            <div class="emp-form-row">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                    <div>
                        <label class="emp-form-label">Start Date</label>
                        <input name="StartDate" id="taskStartDate" type="date" class="emp-form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" required min="@projectStart" max="@projectEnd" />
                    </div>
                    <div>
                        <label class="emp-form-label">End Date</label>
                        <input name="EndDate" id="taskEndDate" type="date" class="emp-form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" required min="@projectStart" max="@projectEnd" />
                    </div>
                </div>
            </div>

            <!-- Holidays -->
            <div id="holidaysSection" style="display: none;">
                <div class="emp-form-row" style="padding: 0; overflow: hidden;">
                    <div style="border-radius:14px;overflow:hidden;box-shadow:0 4px 20px rgba(0,105,148,.14);">
                        <div style="background:linear-gradient(135deg,#006994 0%,#4CA3DD 100%);padding:.7rem 1.1rem;display:flex;align-items:center;gap:.65rem;">
                            <i class="fas fa-calendar-check" style="color:rgba(255,255,255,.9);font-size:1rem;"></i>
                            <strong style="color:#fff;font-size:.88rem;font-weight:700;letter-spacing:.01em;">Public Holidays &mdash; Philippines</strong>
                            <span id="holidayCount" style="background:rgba(255,255,255,.2);color:#fff;font-size:.72rem;font-weight:700;padding:.15rem .6rem;border-radius:20px;margin-left:auto;border:1px solid rgba(255,255,255,.3);">0</span>
                        </div>
                        <div style="background:#fff;">
                            <div id="holidaysLoading" class="text-center py-3" style="display: none;">
                                <div class="spinner-border spinner-border-sm" style="color:#006994;" role="status"></div>
                                <span class="ms-2" style="color:#64748b;font-size:.85rem;">Loading holidays&hellip;</span>
                            </div>
                            <div id="holidaysError" class="text-center py-3" style="display:none;color:#dc2626;font-size:.85rem;">
                                <i class="fas fa-exclamation-circle"></i>
                                <span class="ms-1">Could not load holidays. Please check your connection.</span>
                            </div>
                            <div id="holidaysEmpty" class="text-center py-3" style="display:none;color:#64748b;font-size:.85rem;">
                                <i class="fas fa-check-circle" style="color:#22c55e;"></i>
                                <span class="ms-1">No public holidays in this date range.</span>
                            </div>
                            <table id="holidaysTable" class="table mb-0" style="display:none;border-collapse:collapse;">
                                <thead>
                                    <tr style="background:linear-gradient(135deg,#e0f2fe,#dbeafe);">
                                        <th style="width:130px;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#0c4a6e;padding:.5rem .85rem;border-bottom:2px solid #bae6fd;border-top:none;">Date</th>
                                        <th style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#0c4a6e;padding:.5rem .85rem;border-bottom:2px solid #bae6fd;border-top:none;">Holiday</th>
                                        <th style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#0c4a6e;padding:.5rem .85rem;border-bottom:2px solid #bae6fd;border-top:none;">Local Name</th>
                                        <th style="width:90px;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#0c4a6e;padding:.5rem .85rem;border-bottom:2px solid #bae6fd;border-top:none;">Day</th>
                                    </tr>
                                </thead>
                                <tbody id="holidaysTableBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="emp-form-row">
                <label class="emp-form-label">Instructions</label>
                <textarea id="EditTaskInstructions" name="Instructions" class="emp-form-control">@Model.Instructions</textarea>
                <div style="margin-top:10px; display:flex; gap:8px; align-items:center;">
                    <button type="button" id="insertEditTaskFileBtn" class="emp-btn emp-btn-outline" style="padding:6px 12px;">
                        <i class="fas fa-paperclip"></i> Add file/image
                    </button>
                    <span style="font-size:12px;opacity:.8;">Max 10 MB (images, PDF, DOCX, XLSX, etc.)</span>
                </div>
            </div>

            <div class="emp-form-actions" style="justify-content:flex-end;">
                <a asp-area="ProjectManager" asp-controller="Project" asp-action="Milestone" asp-route-projectMilestoneId="@Model.ProjectMilestoneId" class="emp-btn emp-btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
                <button id="submitEditTaskBtn" type="submit" class="emp-btn emp-btn-primary">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Archive task member confirmation modal -->
<div class="emp-modal-backdrop" id="tmArchiveModal" role="dialog" aria-modal="true" aria-hidden="true" onclick="if(event.target===this)closeTmArchiveModal()">
    <div class="emp-modal" role="document">
        <h4><i class="fas fa-archive"></i> Remove from Task</h4>
        <p id="tmArchiveMessage">Remove this member from the task?</p>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn emp-btn-cancel" onclick="closeTmArchiveModal()">Cancel</button>
            <button type="button" class="emp-btn emp-btn-confirm emp-btn-danger" onclick="confirmTmArchive()">Remove</button>
        </div>
    </div>
</div>

<!-- Unarchive task member confirmation modal -->
<div class="emp-modal-backdrop" id="tmUnarchiveModal" role="dialog" aria-modal="true" aria-hidden="true" onclick="if(event.target===this)closeTmUnarchiveModal()">
    <div class="emp-modal" role="document">
        <h4><i class="fas fa-box-open"></i> Restore to Task</h4>
        <p id="tmUnarchiveMessage">Restore this member to the task?</p>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn emp-btn-cancel" onclick="closeTmUnarchiveModal()">Cancel</button>
            <button type="button" class="emp-btn emp-btn-confirm emp-btn-primary" onclick="confirmTmUnarchive()">Restore</button>
        </div>
    </div>
</div>

<!-- Submit confirmation modal -->
<div class="emp-modal-backdrop" id="submitConfirmModal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="emp-modal" role="document">
        <h4 id="submitConfirmTitle"><i class="fas fa-check-circle"></i> Confirm</h4>
        <p id="submitConfirmMessage">Are you sure?</p>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn emp-btn-cancel" id="submitCancelBtn">Cancel</button>
            <button type="button" class="emp-btn emp-btn-confirm emp-btn-primary" id="submitConfirmBtn">Save</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    // ??????? Member Picker Modal (same as Create page) ??????????????????????????????????
    const projectMembers = [
        @foreach (var m in Model.AvailableMembers)
        {
            @Html.Raw("{id:" + m.Value + ",name:'" + m.Text.Replace("'","\\'") + "',role:''},")
        }
    ];

    const selectedMemberIds = new Set();

    const chipsContainer = document.getElementById('assignedMemberChips');
    const hiddenContainer = document.getElementById('assignedMemberHiddenInputs');
    const assignInputEl = document.getElementById('assignMemberInput');

    // Inject modal HTML
    if (projectMembers.length > 0) {
        const memberModalHtml = `
<div class="modal fade" id="memberPickerModal" tabindex="-1" aria-labelledby="memberPickerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content em-picker-modal">
            <div class="em-picker-header">
                <div>
                    <h5 class="em-picker-title" id="memberPickerModalLabel"><i class="fas fa-user-plus"></i> Assign Members</h5>
                    <p class="em-picker-subtitle">Select project members to assign to this task</p>
                </div>
                <button type="button" class="btn-close btn-close-white" id="memberPickerCloseBtn" aria-label="Close"></button>
            </div>

            <div class="em-picker-filters">
                <div class="em-picker-filters-row">
                    <div class="em-picker-search-group">
                        <i class="fas fa-magnifying-glass em-picker-search-icon"></i>
                        <input type="text" id="memberPickerFilter" class="em-picker-search-input" placeholder="Search members\u2026" autocomplete="off" />
                    </div>
                </div>
            </div>

            <div class="modal-body em-picker-body">
                <div class="em-picker-table-card">
                    <div class="em-picker-table-responsive">
                        <table class="em-picker-table" id="memberPickerTable">
                            <thead>
                                <tr>
                                    <th style="width:44px;text-align:center;"><input type="checkbox" id="memberPickerSelectAll" class="em-picker-checkbox" /></th>
                                    <th>Member</th>
                                    <th>Project Role</th>
                                    <th style="width:100px;text-align:center;">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <div id="memberPickerEmpty" class="em-picker-empty" style="display:none;">
                        <div class="em-picker-empty-icon"><i class="fas fa-user-group"></i></div>
                        <div class="em-picker-empty-title">No members found</div>
                        <div class="em-picker-empty-text">No matching project members.</div>
                    </div>

                    <div class="em-picker-pagination" id="memberPickerPagination">
                        <div class="em-picker-pagination-info" id="memberPickerPaginationInfo"></div>
                    </div>
                </div>
            </div>

            <div class="em-picker-footer">
                <button type="button" class="em-picker-btn-cancel" id="memberPickerCancelBtn">Cancel</button>
                <button type="button" id="memberPickerAddBtn" class="em-picker-btn-add" disabled>
                    <i class="fas fa-plus"></i> Add Selected
                </button>
            </div>
        </div>
    </div>
</div>`;
        document.body.insertAdjacentHTML('beforeend', memberModalHtml);
    }

    const memberModalEl = document.getElementById('memberPickerModal');
    const memberModalTable = document.getElementById('memberPickerTable');
    const memberModalEmpty = document.getElementById('memberPickerEmpty');
    const memberModalFilter = document.getElementById('memberPickerFilter');
    const memberModalAddBtn = document.getElementById('memberPickerAddBtn');
    const memberModalCloseBtn = document.getElementById('memberPickerCloseBtn');
    const memberModalCancelBtn = document.getElementById('memberPickerCancelBtn');
    const memberModalSelectAll = document.getElementById('memberPickerSelectAll');

    function renderChips() {
        if (!chipsContainer || !hiddenContainer) return;
        chipsContainer.innerHTML = '';
        hiddenContainer.innerHTML = '';
        selectedMemberIds.forEach(id => {
            const m = projectMembers.find(x => parseInt(x.id) === parseInt(id));
            if (!m) return;
            const initials = (m.name || '').split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
            const chip = document.createElement('span');
            chip.className = 'em-picker-chip';
            chip.style.cssText = 'display:inline-flex;align-items:center;gap:.35rem;padding:.25rem .6rem .25rem .4rem;border-radius:20px;background:linear-gradient(135deg,#e0f2fe,#dbeafe);color:#1e40af;font-size:.82rem;font-weight:600;border:1px solid rgba(30,64,175,.12);';
            chip.innerHTML = '<span style="width:22px;height:22px;border-radius:50%;background:#3b82f6;color:#fff;display:flex;align-items:center;justify-content:center;font-size:.6rem;font-weight:700;">' + initials + '</span>' +
                '<span>' + m.name + '</span>' +
                '<button type="button" style="background:none;border:none;color:#64748b;cursor:pointer;font-size:.75rem;padding:0 0 0 .2rem;line-height:1;" data-remove-id="' + id + '" title="Remove"><i class="fas fa-times"></i></button>';
            chip.querySelector('button').addEventListener('click', function () {
                selectedMemberIds.delete(id);
                renderChips();
            });
            chipsContainer.appendChild(chip);
            const inp = document.createElement('input'); inp.type = 'hidden'; inp.name = 'assignedMemberIds'; inp.value = id; hiddenContainer.appendChild(inp);
        });
        if (assignInputEl) {
            assignInputEl.placeholder = selectedMemberIds.size > 0
                ? selectedMemberIds.size + ' member' + (selectedMemberIds.size !== 1 ? 's' : '') + ' selected � click to change'
                : 'Click to pick from project members\u2026';
        }
    }

    function openMemberModal() {
        if (!memberModalEl) return;
        const tbody = memberModalTable.querySelector('tbody');
        tbody.innerHTML = '';
        memberModalEmpty.style.display = 'none';
        if (memberModalFilter) memberModalFilter.value = '';
        if (memberModalSelectAll) memberModalSelectAll.checked = false;

        if (!projectMembers.length) {
            memberModalEmpty.style.display = 'block';
        } else {
            projectMembers.forEach(m => {
                const initials = (m.name || '').split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
                const isSelected = selectedMemberIds.has(parseInt(m.id));
                const tr = document.createElement('tr');
                tr.className = 'em-picker-row';
                tr.innerHTML =
                    '<td style="text-align:center;"><input type="checkbox" class="member-select-checkbox em-picker-checkbox" data-id="' + m.id + '"' + (isSelected ? ' checked' : '') + ' /></td>' +
                    '<td><div class="em-picker-name-cell"><div class="em-picker-avatar">' + initials + '</div><div class="em-picker-name-text">' + (m.name || '') + '</div></div></td>' +
                    '<td><span style="color:#6366f1;font-size:.82rem;font-weight:500;">' + (m.role || '') + '</span></td>' +
                    '<td style="text-align:center;"><button type="button" class="em-picker-select-btn member-quick-add" data-id="' + m.id + '" title="Quick add"><i class="fas fa-' + (isSelected ? 'check' : 'plus') + '"></i></button></td>';
                tbody.appendChild(tr);
            });
        }

        function updateModalAddState() {
            const any = memberModalTable.querySelectorAll('.member-select-checkbox:checked').length > 0;
            if (memberModalAddBtn) memberModalAddBtn.disabled = !any;
        }
        tbody.querySelectorAll('.member-select-checkbox').forEach(cb => cb.addEventListener('change', updateModalAddState));
        if (memberModalSelectAll) {
            memberModalSelectAll.addEventListener('change', function () {
                const checked = !!this.checked;
                tbody.querySelectorAll('tr').forEach(tr => {
                    if (tr.style.display === 'none') return;
                    const cb = tr.querySelector('.member-select-checkbox');
                    if (cb) cb.checked = checked;
                });
                updateModalAddState();
            });
        }
        updateModalAddState();

        const pInfo = document.getElementById('memberPickerPaginationInfo');
        if (pInfo) pInfo.textContent = 'Showing ' + projectMembers.length + ' member' + (projectMembers.length !== 1 ? 's' : '');

        tbody.querySelectorAll('.member-quick-add').forEach(btn => btn.addEventListener('click', function () {
            const mId = parseInt(this.dataset.id);
            if (selectedMemberIds.has(mId)) {
                selectedMemberIds.delete(mId);
                this.querySelector('i').className = 'fas fa-plus';
                const cb = tbody.querySelector('.member-select-checkbox[data-id="' + mId + '"]');
                if (cb) cb.checked = false;
            } else {
                selectedMemberIds.add(mId);
                this.querySelector('i').className = 'fas fa-check';
                const cb = tbody.querySelector('.member-select-checkbox[data-id="' + mId + '"]');
                if (cb) cb.checked = true;
            }
            renderChips();
            updateModalAddState();
        }));

        if (window.bootstrap && window.bootstrap.Modal) {
            const modalInstance = new bootstrap.Modal(memberModalEl);
            modalInstance.show();
        } else if (window.jQuery && typeof $().modal === 'function') {
            $('#memberPickerModal').modal('show');
        } else {
            memberModalEl.style.display = 'block';
            memberModalEl.style.position = 'fixed';
            memberModalEl.style.left = '0';
            memberModalEl.style.top = '0';
            memberModalEl.style.width = '100%';
            memberModalEl.style.height = '100%';
            memberModalEl.style.zIndex = '2060';
            memberModalEl.classList.add('show');
            document.body.style.overflow = 'hidden';
        }
    }

    function closeMemberModal() {
        if (!memberModalEl) return;
        if (window.bootstrap && window.bootstrap.Modal) {
            const inst = bootstrap.Modal.getInstance(memberModalEl);
            if (inst) inst.hide();
        } else if (window.jQuery && typeof $().modal === 'function') {
            $('#memberPickerModal').modal('hide');
        } else {
            memberModalEl.style.display = 'none';
            memberModalEl.classList.remove('show');
            memberModalEl.style.zIndex = '';
            document.body.style.overflow = '';
        }
    }

    // Wire open/close
    if (assignInputEl) assignInputEl.addEventListener('click', openMemberModal);
    if (memberModalCloseBtn) memberModalCloseBtn.addEventListener('click', closeMemberModal);
    if (memberModalCancelBtn) memberModalCancelBtn.addEventListener('click', closeMemberModal);
    if (memberModalEl) memberModalEl.addEventListener('click', function (e) { if (e.target === memberModalEl) closeMemberModal(); });

    if (memberModalAddBtn) {
        memberModalAddBtn.addEventListener('click', function () {
            const checked = memberModalTable.querySelectorAll('.member-select-checkbox:checked');
            checked.forEach(cb => {
                selectedMemberIds.add(parseInt(cb.dataset.id));
            });
            const unchecked = memberModalTable.querySelectorAll('.member-select-checkbox:not(:checked)');
            unchecked.forEach(cb => {
                selectedMemberIds.delete(parseInt(cb.dataset.id));
            });
            renderChips();
            closeMemberModal();
        });
    }

    if (memberModalFilter) {
        memberModalFilter.addEventListener('input', function () {
            const q = this.value.trim().toLowerCase();
            let visible = 0;
            memberModalTable.querySelectorAll('tbody tr').forEach(tr => {
                const name = (tr.querySelector('.em-picker-name-text')?.textContent || '').toLowerCase();
                const role = (tr.cells[2]?.textContent || '').toLowerCase();
                const show = !q || name.includes(q) || role.includes(q);
                tr.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            const pInfo = document.getElementById('memberPickerPaginationInfo');
            if (pInfo) pInfo.textContent = visible === 0 ? 'No matches' : 'Showing ' + visible + ' member' + (visible !== 1 ? 's' : '');
        });
    }

    renderChips();

    // ===== Task member filter dropdown =====
    const memberFilterSelect = document.getElementById('taskMemberFilter');
    if (memberFilterSelect) {
        memberFilterSelect.addEventListener('change', function () {
            const val = this.value;
            document.querySelectorAll('#currentMembersContainer .tm-member-card').forEach(function (card) {
                const isArchived = card.classList.contains('archived');
                if (val === 'all') card.style.display = '';
                else if (val === 'active') card.style.display = isArchived ? 'none' : '';
                else if (val === 'archived') card.style.display = isArchived ? '' : 'none';
            });
        });
        // default to active and apply filter immediately
        memberFilterSelect.value = 'active';
        memberFilterSelect.dispatchEvent(new Event('change'));
    }

    // ===== Archive / Unarchive Task Member modal wiring =====
    // Cannot use nested <form> inside the main EditTask form (HTML forbids it),
    // so we dynamically create + submit a form outside the main form on confirm.
    const __antiForgeryToken = document.querySelector('form.emp-edit-task-form input[name="__RequestVerificationToken"]')?.value || '';

    function __submitTmAction(actionUrl, taskMemberId) {
        const f = document.createElement('form');
        f.method = 'POST';
        f.action = actionUrl;
        f.style.display = 'none';
        const tokenInput = document.createElement('input');
        tokenInput.type = 'hidden'; tokenInput.name = '__RequestVerificationToken'; tokenInput.value = __antiForgeryToken;
        f.appendChild(tokenInput);
        const idInput = document.createElement('input');
        idInput.type = 'hidden'; idInput.name = 'taskMemberId'; idInput.value = taskMemberId;
        f.appendChild(idInput);
        document.body.appendChild(f);
        f.submit();
    }

    let __tmArchiveId = null, __tmArchiveUrl = null;
    window.openTmArchiveModal = function (tmId, actionUrl, name) {
        __tmArchiveId = tmId; __tmArchiveUrl = actionUrl;
        const msg = document.getElementById('tmArchiveMessage');
        if (msg) msg.textContent = `Remove "${name}" from this task?`;
        const modal = document.getElementById('tmArchiveModal');
        if (modal) { modal.classList.add('active'); modal.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; }
    };
    window.closeTmArchiveModal = function () {
        __tmArchiveId = null; __tmArchiveUrl = null;
        const modal = document.getElementById('tmArchiveModal');
        if (modal) { modal.classList.remove('active'); modal.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; }
    };
    window.confirmTmArchive = function () { if (__tmArchiveId && __tmArchiveUrl) __submitTmAction(__tmArchiveUrl, __tmArchiveId); else window.closeTmArchiveModal(); };

    let __tmUnarchiveId = null, __tmUnarchiveUrl = null;
    window.openTmUnarchiveModal = function (tmId, actionUrl, name) {
        __tmUnarchiveId = tmId; __tmUnarchiveUrl = actionUrl;
        const msg = document.getElementById('tmUnarchiveMessage');
        if (msg) msg.textContent = `Restore "${name}" to this task?`;
        const modal = document.getElementById('tmUnarchiveModal');
        if (modal) { modal.classList.add('active'); modal.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; }
    };
    window.closeTmUnarchiveModal = function () {
        __tmUnarchiveId = null; __tmUnarchiveUrl = null;
        const modal = document.getElementById('tmUnarchiveModal');
        if (modal) { modal.classList.remove('active'); modal.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; }
    };
    window.confirmTmUnarchive = function () { if (__tmUnarchiveId && __tmUnarchiveUrl) __submitTmAction(__tmUnarchiveUrl, __tmUnarchiveId); else window.closeTmUnarchiveModal(); };

    // Wire backdrop-click close for tm modals
    const tmArchiveModal = document.getElementById('tmArchiveModal');
    const tmUnarchiveModal = document.getElementById('tmUnarchiveModal');
    if (tmArchiveModal) tmArchiveModal.addEventListener('click', function (e) { if (e.target === tmArchiveModal) window.closeTmArchiveModal(); });
    if (tmUnarchiveModal) tmUnarchiveModal.addEventListener('click', function (e) { if (e.target === tmUnarchiveModal) window.closeTmUnarchiveModal(); });

    // ===== Submit confirmation modal wiring =====
    const formElement = document.querySelector('form.emp-form');
    const submitButton = document.getElementById('submitEditTaskBtn');
    if (formElement) {
        let __submitFormToSubmit = null;
        const submitModal = document.getElementById('submitConfirmModal');
        const submitCancelBtn = document.getElementById('submitCancelBtn');
        const submitConfirmBtn = document.getElementById('submitConfirmBtn');

        if (submitButton) {
            submitButton.addEventListener('click', function (e) {
                e.preventDefault();
                __submitFormToSubmit = formElement;
                const titleEl = document.getElementById('submitConfirmTitle');
                const msgEl = document.getElementById('submitConfirmMessage');
                if (titleEl) titleEl.textContent = 'Confirm Save';
                if (msgEl) msgEl.textContent = 'Save changes to this task?';
                if (submitModal) { submitModal.classList.add('active'); submitModal.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; }
            });
        }

        if (submitCancelBtn) submitCancelBtn.addEventListener('click', function () { __submitFormToSubmit = null; if (submitModal) { submitModal.classList.remove('active'); submitModal.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; } });
        if (submitConfirmBtn) submitConfirmBtn.addEventListener('click', function () {
            if (!__submitFormToSubmit) { if (submitModal) { submitModal.classList.remove('active'); submitModal.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; } return; }
            if (pendingUploads > 0) { alert('Please wait for file upload to finish.'); return; }
            __submitFormToSubmit.submit();
        });

        if (submitModal) submitModal.addEventListener('click', function (e) { if (e.target === submitModal) { __submitFormToSubmit = null; submitModal.classList.remove('active'); submitModal.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; } });
    }

    // Simple file upload + CKEditor similar to Create
    const editorSelector = '#EditTaskInstructions';
    const uploadEndpoint = '@Url.Action("UploadRichText","Project", new { area = "ProjectManager" })';
    let editorInstance = null, pendingUploads = 0;
    function beginUpload(){ pendingUploads++; document.getElementById('submitEditTaskBtn').disabled = true; }
    function endUpload(){ pendingUploads = Math.max(0,pendingUploads-1); document.getElementById('submitEditTaskBtn').disabled = pendingUploads>0; }
    class CTUploadAdapter{ constructor(l){ this.loader=l; this.ctrl=new AbortController(); } async upload(){ const f=await this.loader.file; const r=await uploadFile(f,this.ctrl.signal); return {default:r.url}; } abort(){ this.ctrl.abort(); } }
    function CTUploadAdapterPlugin(ed){ ed.plugins.get('FileRepository').createUploadAdapter=(l)=>new CTUploadAdapter(l); }
    async function uploadFile(file, signal){ beginUpload(); try{ const fd=new FormData(); fd.append('upload',file); const resp=await fetch(uploadEndpoint,{method:'POST',body:fd,signal}); const p=await resp.json(); if(!resp.ok) throw new Error(p?.error?.message||'Upload failed'); return p; } finally { endUpload(); } }
    function wireFileInsertButton(){ const btn=document.getElementById('insertEditTaskFileBtn'); if(!btn) return; btn.addEventListener('click', function(){ if(!editorInstance) return; const inp=document.createElement('input'); inp.type='file'; inp.style.display='none'; inp.addEventListener('change', async function(){ if(!inp.files||!inp.files.length){ document.body.removeChild(inp); return; } const file=inp.files[0]; document.body.removeChild(inp); btn.disabled=true; try{ const r=await uploadFile(file); if(file.type.startsWith('image/')){ editorInstance.model.change(w=>{ const img=w.createElement('imageBlock',{src:r.url}); editorInstance.model.insertContent(img, editorInstance.model.document.selection); }); } else { editorInstance.model.change(w=>{ const t=w.createText(r.fileName||file.name, { linkHref: r.url }); editorInstance.model.insertContent(t, editorInstance.model.document.selection); }); } } catch(e){ alert('Upload failed.'); } finally { btn.disabled=false; } }); document.body.appendChild(inp); inp.click(); }); }
    function initEditor(){ if(!window.CKEDITOR||!window.CKEDITOR.ClassicEditor) return; const {ClassicEditor,Essentials,Paragraph,Heading,Bold,Italic,Link,List,Indent,BlockQuote,Table,TableToolbar,Image,ImageCaption,ImageStyle,ImageToolbar,ImageUpload,ImageResize,ImageResizeEditing,ImageResizeHandles,MediaEmbed,Alignment} = window.CKEDITOR; ClassicEditor.create(document.querySelector(editorSelector),{ licenseKey:'GPL', plugins:[Essentials,Paragraph,Heading,Bold,Italic,Link,List,Indent,BlockQuote,Table,TableToolbar,Image,ImageCaption,ImageStyle,ImageToolbar,ImageUpload,ImageResize,ImageResizeEditing,ImageResizeHandles,MediaEmbed,Alignment], extraPlugins:[CTUploadAdapterPlugin], toolbar:{ items:['undo','redo','|','heading','|','bold','italic','link','|','alignment','|','bulletedList','numberedList','|','outdent','indent','|','imageUpload','insertTable','mediaEmbed','blockQuote'], shouldNotGroupWhenFull:true }, image:{ toolbar:['imageTextAlternative','toggleImageCaption','|','imageStyle:inline','imageStyle:block','imageStyle:side','|','resizeImage'], resizeOptions:[{name:'resizeImage:original',value:null,label:'Original'},{name:'resizeImage:50',value:'50',label:'50%'},{name:'resizeImage:75',value:'75',label:'75%'}], resizeUnit:'%' }, alignment:{ options:['left','center','right','justify'] }, table:{ contentToolbar:['tableColumn','tableRow','mergeTableCells'] } }).then(ed=>{ editorInstance=ed; wireFileInsertButton(); }).catch(e=>console.error(e)); }
    // --- Holiday Fetching Logic ---
    (function () {
        var startDateInput = document.getElementById('taskStartDate');
        var endDateInput = document.getElementById('taskEndDate');
        var holidaysSection = document.getElementById('holidaysSection');
        var holidaysLoading = document.getElementById('holidaysLoading');
        var holidaysError = document.getElementById('holidaysError');
        var holidaysEmpty = document.getElementById('holidaysEmpty');
        var holidaysTable = document.getElementById('holidaysTable');
        var holidaysTableBody = document.getElementById('holidaysTableBody');
        var holidayCount = document.getElementById('holidayCount');
        var holidayFetchTimer = null;

        var dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

        function fetchHolidays() {
            var startDate = startDateInput ? startDateInput.value : '';
            var endDate = endDateInput ? endDateInput.value : '';

            if (!startDate || !endDate) {
                if (holidaysSection) holidaysSection.style.display = 'none';
                return;
            }

            if (new Date(endDate) < new Date(startDate)) {
                if (holidaysSection) holidaysSection.style.display = 'none';
                return;
            }

            holidaysSection.style.display = '';
            holidaysLoading.style.display = '';
            holidaysError.style.display = 'none';
            holidaysEmpty.style.display = 'none';
            holidaysTable.style.display = 'none';
            holidaysTableBody.innerHTML = '';
            holidayCount.textContent = '...';

            var url = '@Url.Action("GetHolidays", "Project", new { area = "ProjectManager" })'
                + '?startDate=' + encodeURIComponent(startDate)
                + '&endDate=' + encodeURIComponent(endDate);

            fetch(url)
                .then(function (response) {
                    if (!response.ok) throw new Error('API error');
                    return response.json();
                })
                .then(function (holidays) {
                    holidaysLoading.style.display = 'none';

                    if (!holidays || holidays.length === 0) {
                        holidaysEmpty.style.display = '';
                        holidayCount.textContent = '0';
                        return;
                    }

                    holidayCount.textContent = holidays.length;
                    var html = '';
                    for (var i = 0; i < holidays.length; i++) {
                        var h = holidays[i];
                        var d = new Date(h.date + 'T00:00:00');
                        var dayName = dayNames[d.getDay()];
                        var isWeekend = d.getDay() === 0 || d.getDay() === 6;
                        html += '<tr style="border-bottom:1px solid #f1f5f9;' + (isWeekend ? 'background:#fff7ed;' : '') + '">'
                            + '<td style="font-size:.83rem;padding:.5rem .85rem;vertical-align:middle;"><i class="fas fa-circle" style="font-size:.38rem;color:' + (isWeekend ? '#f97316' : '#0ea5e9') + ';vertical-align:middle;margin-right:.45rem;"></i>' + h.date + '</td>'
                            + '<td style="font-size:.83rem;padding:.5rem .85rem;vertical-align:middle;color:#1e293b;">' + escapeHolidayHtml(h.name) + '</td>'
                            + '<td style="font-size:.83rem;padding:.5rem .85rem;vertical-align:middle;color:#475569;">' + escapeHolidayHtml(h.localName) + '</td>'
                            + '<td style="padding:.5rem .85rem;vertical-align:middle;"><span style="display:inline-flex;align-items:center;font-size:.72rem;font-weight:700;padding:.18rem .6rem;border-radius:20px;background:' + (isWeekend ? '#fee2e2' : '#e0f2fe') + ';color:' + (isWeekend ? '#b91c1c' : '#0369a1') + ';">' + dayName + '</span></td>'
                            + '</tr>';
                    }
                    holidaysTableBody.innerHTML = html;
                    holidaysTable.style.display = '';
                })
                .catch(function () {
                    holidaysLoading.style.display = 'none';
                    holidaysError.style.display = '';
                    holidayCount.textContent = '!';
                });
        }

        function escapeHolidayHtml(str) {
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(str));
            return div.innerHTML;
        }

        function debouncedFetchHolidays() {
            if (holidayFetchTimer) clearTimeout(holidayFetchTimer);
            holidayFetchTimer = setTimeout(fetchHolidays, 400);
        }

        if (startDateInput) startDateInput.addEventListener('change', debouncedFetchHolidays);
        if (endDateInput) endDateInput.addEventListener('change', debouncedFetchHolidays);

        if (startDateInput && endDateInput && startDateInput.value && endDateInput.value) {
            fetchHolidays();
        }
    })();

    function loadScript(i){ if(window.CKEDITOR&&window.CKEDITOR.ClassicEditor){ initEditor(); return; } if(i>=2){ initEditor(); return; } const s=document.createElement('script'); s.src=['https://cdn.jsdelivr.net/npm/ckeditor5@47.1.0/dist/browser/ckeditor5.umd.js','https://unpkg.com/ckeditor5@47.1.0/dist/browser/ckeditor5.umd.js'][i]; s.async=true; s.onload=initEditor; s.onerror=()=>loadScript(i+1); document.head.appendChild(s); }
    function loadStyle(i){ if(document.querySelector('link[data-ckeditor-style]')){ loadScript(0); return; } if(i>=2){ loadScript(0); return; } const l=document.createElement('link'); l.rel='stylesheet'; l.href=['https://cdn.jsdelivr.net/npm/ckeditor5@47.1.0/dist/ckeditor5.css','https://unpkg.com/ckeditor5@47.1.0/dist/ckeditor5.css'][i]; l.setAttribute('data-ckeditor-style','true'); l.onload=()=>loadScript(0); l.onerror=()=>{ l.remove(); loadStyle(i+1); }; document.head.appendChild(l); }
    loadStyle(0);
});
</script>
}
