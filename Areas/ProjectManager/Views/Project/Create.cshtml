@model project_lifecycle.ViewModels.ProjectManager.ProjectManageViewModel
@{
    ViewData["Title"] = "Create Task — " + Model.Project.Name;
    var _milestonesTyped = Model.Project.Milestones.Cast<project_lifecycle.ViewModels.ProjectManager.ProjectMilestoneViewModel>().ToList();
}

<style>
    .milestone-member-check { display:flex; align-items:center; gap:.6rem; padding:.3rem 0; border-bottom:1px solid #f1f5f9; }
    .milestone-member-check:last-child { border-bottom:none; }
    .milestone-member-check input[type="checkbox"] { width:15px; height:15px; accent-color:#6366f1; cursor:pointer; flex-shrink:0; }
    .milestone-member-check label { font-size:.9rem; color:#374151; cursor:pointer; margin:0; }
</style>

<!-- ===== Hero ===== -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-plus-circle"></i></span>
                Create Task
            </h1>
            <p class="emp-page-subtitle">Project: @Model.Project.Name</p>
        </div>
        <div class="emp-page-hero-right">
            <a asp-area="ProjectManager" asp-controller="Project" asp-action="Details"
               asp-route-id="@Model.Project.Id" class="emp-btn emp-btn-outline">
                <i class="fas fa-arrow-left"></i>
                <span>Back to Project</span>
            </a>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="emp-alert emp-alert-success">
        <i class="fas fa-check-circle emp-alert-icon"></i>
        <span>@TempData["SuccessMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="emp-alert emp-alert-error">
        <i class="fas fa-exclamation-circle emp-alert-icon"></i>
        <span>@TempData["ErrorMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}

<!-- ===== Form Card ===== -->
<div class="emp-form-card">
    <div class="emp-form-section">
        <div class="emp-form-section-title"><i class="fas fa-list-check"></i> Task Details</div>

        <form asp-area="ProjectManager" asp-controller="Project" asp-action="AddTask" method="post" class="emp-form emp-create-task-form">
            @Html.AntiForgeryToken()

            @{
                var _preselectedMilestoneId = ViewData["PreselectedMilestoneId"] as int?;
                var _preselectedMilestone = _preselectedMilestoneId.HasValue
                    ? _milestonesTyped.FirstOrDefault(m => m.Id == _preselectedMilestoneId.Value)
                    : null;
            }
            <div class="emp-form-row">
                <label class="emp-form-label">Milestone</label>
                @if (_preselectedMilestone != null)
                {
                    <input type="hidden" name="projectMilestoneId" value="@_preselectedMilestone.Id" />
                    <div class="emp-form-control" style="background:#f8fafc;color:#374151;cursor:default;">
                        <i class="fas fa-flag" style="color:#6366f1;margin-right:.4rem;"></i>
                        @_preselectedMilestone.SequenceOrder — @_preselectedMilestone.MilestoneName
                    </div>
                }
                else
                {
                    <select name="projectMilestoneId" class="emp-form-control" required>
                        <option value="">-- Select Milestone --</option>
                        @foreach (var ms in _milestonesTyped.OrderBy(m => m.SequenceOrder))
                        {
                            <option value="@ms.Id">@ms.SequenceOrder — @ms.MilestoneName</option>
                        }
                    </select>
                }
            </div>

            <div class="emp-form-row">
                <label class="emp-form-label">Task Name</label>
                <input name="Name" id="taskName" class="emp-form-control" placeholder="Enter a descriptive task name…" required />
            </div>

            <div class="emp-form-row">
                <label class="emp-form-label">Assign To</label>
                @if (!Model.Project.Members.Any())
                {
                    <div class="emp-form-control" style="color:#94a3b8;cursor:default;">No project members yet. Add members from the project details page first.</div>
                }
                else
                {
                    <div class="emp-form-control" style="padding:.6rem .85rem;height:auto;">
                        @foreach (var m in Model.Project.Members)
                        {
                            <div class="milestone-member-check">
                                <input type="checkbox" name="assignedMemberIds" id="ctmember_@m.Id" value="@m.Id" />
                                <label for="ctmember_@m.Id">@m.EmployeeName <span style="color:#6366f1;font-size:.8rem;">(@m.ProjectRoleName)</span></label>
                            </div>
                        }
                    </div>
                }
                <span class="emp-form-hint">Selected members will share the same task submission.</span>
            </div>

            <div class="emp-form-row">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                    <div>
                        <label class="emp-form-label">Start Date</label>
                        <input name="StartDate" id="taskStartDate" type="date" class="emp-form-control" required />
                    </div>
                    <div>
                        <label class="emp-form-label">End Date</label>
                        <input name="EndDate" id="taskEndDate" type="date" class="emp-form-control" required />
                    </div>
                </div>
            </div>

            <div class="emp-form-row">
                <label class="emp-form-label">Instructions</label>
                <textarea id="CreateTaskInstructions" name="Instructions" class="emp-form-control" placeholder="Enter task instructions…"></textarea>
                <div style="margin-top:10px; display:flex; gap:8px; align-items:center;">
                    <button type="button" id="insertCreateTaskFileBtn" class="emp-btn emp-btn-outline" style="padding:6px 12px;">
                        <i class="fas fa-paperclip"></i> Add file/image
                    </button>
                    <span style="font-size:12px;opacity:.8;">Max 10 MB (images, PDF, DOCX, XLSX, etc.)</span>
                </div>
            </div>

            <div class="emp-form-actions" style="justify-content:flex-end;">
                <a asp-area="ProjectManager" asp-controller="Project" asp-action="Details"
                   asp-route-id="@Model.Project.Id" class="emp-btn emp-btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
                <button id="submitCreateTaskBtn" type="submit" class="emp-btn emp-btn-primary">
                    <i class="fas fa-plus"></i> Create Task
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    const editorSelector = '#CreateTaskInstructions';
    const uploadEndpoint = '@Url.Action("UploadRichText", "Project", new { area = "ProjectManager" })';
    const formElement = document.querySelector('form.emp-create-task-form');
    const submitButton = document.getElementById('submitCreateTaskBtn');
    const taskNameInput = document.getElementById('taskName');
    let editorInstance = null, pendingUploads = 0, explicitSubmitRequested = false, isSubmitting = false;
    const draftStorageKey = 'pm-create-task-draft';

    function saveDraft() {
        if (isSubmitting) return;
        const el = document.querySelector(editorSelector);
        const startDateInput = document.getElementById('taskStartDate');
        const endDateInput = document.getElementById('taskEndDate');
        const checkedIds = Array.from(document.querySelectorAll('input[name="assignedMemberIds"]:checked')).map(cb => cb.value);
        try {
            sessionStorage.setItem(draftStorageKey, JSON.stringify({
                name: taskNameInput ? taskNameInput.value : '',
                inputHtml: editorInstance ? editorInstance.getData() : (el ? el.value : ''),
                assignedMemberIds: checkedIds,
                startDate: startDateInput ? startDateInput.value : '',
                endDate: endDateInput ? endDateInput.value : ''
            }));
        } catch {}
    }
    function restoreDraft() { try { const r = sessionStorage.getItem(draftStorageKey); return r ? JSON.parse(r) : null; } catch { return null; } }
    function clearDraft() { try { sessionStorage.removeItem(draftStorageKey); } catch {} }
    function beginUpload() { pendingUploads += 1; if (submitButton) submitButton.disabled = true; }
    function endUpload() { pendingUploads = Math.max(0, pendingUploads - 1); if (submitButton) submitButton.disabled = pendingUploads > 0; }

    const scriptCdn = ['https://cdn.jsdelivr.net/npm/ckeditor5@47.1.0/dist/browser/ckeditor5.umd.js','https://unpkg.com/ckeditor5@47.1.0/dist/browser/ckeditor5.umd.js'];
    const styleCdn  = ['https://cdn.jsdelivr.net/npm/ckeditor5@47.1.0/dist/ckeditor5.css','https://unpkg.com/ckeditor5@47.1.0/dist/ckeditor5.css'];

    class CTUploadAdapter { constructor(l){ this.loader=l; this.ctrl=new AbortController(); } async upload(){ const f=await this.loader.file; const r=await uploadFile(f,this.ctrl.signal); return {default:r.url}; } abort(){ this.ctrl.abort(); } }
    function CTUploadAdapterPlugin(ed){ ed.plugins.get('FileRepository').createUploadAdapter=(l)=>new CTUploadAdapter(l); }

    async function uploadFile(file, signal) {
        beginUpload();
        try { const fd=new FormData(); fd.append('upload',file); const resp=await fetch(uploadEndpoint,{method:'POST',body:fd,signal}); const p=await resp.json(); if(!resp.ok) throw new Error(p?.error?.message||'Upload failed.'); return p; }
        finally { endUpload(); }
    }

    function wireFileInsertButton() {
        const btn=document.getElementById('insertCreateTaskFileBtn');
        if(!btn) return;
        btn.addEventListener('click', function(e) {
            e.preventDefault(); e.stopPropagation();
            if(!editorInstance) return;
            // Create a fresh disposable file input each time — never reuse, never clear .value
            const inp = document.createElement('input');
            inp.type = 'file';
            inp.style.display = 'none';
            inp.addEventListener('change', async function() {
                if(!inp.files||!inp.files.length){ document.body.removeChild(inp); return; }
                const file = inp.files[0];
                document.body.removeChild(inp); // remove immediately before any async work
                btn.disabled = true;
                try {
                    const r = await uploadFile(file);
                    if(file.type.startsWith('image/')){
                        editorInstance.model.change(w=>{const img=w.createElement('imageBlock',{src:r.url});editorInstance.model.insertContent(img,editorInstance.model.document.selection);});
                    } else {
                        editorInstance.model.change(w=>{const t=w.createText(r.fileName||file.name,{linkHref:r.url});editorInstance.model.insertContent(t,editorInstance.model.document.selection);});
                    }
                } catch(err){ alert(err.message||'Upload failed.'); }
                finally{ btn.disabled=false; }
            });
            document.body.appendChild(inp);
            inp.click();
        });
    }

    function initEditor() {
        if(!window.CKEDITOR||!window.CKEDITOR.ClassicEditor) return;
        const {ClassicEditor,Essentials,Paragraph,Heading,Bold,Italic,Link,List,Indent,BlockQuote,Table,TableToolbar,Image,ImageCaption,ImageStyle,ImageToolbar,ImageUpload,ImageResize,ImageResizeEditing,ImageResizeHandles,MediaEmbed,Alignment}=window.CKEDITOR;
        ClassicEditor.create(document.querySelector(editorSelector),{
            licenseKey:'GPL',
            plugins:[Essentials,Paragraph,Heading,Bold,Italic,Link,List,Indent,BlockQuote,Table,TableToolbar,Image,ImageCaption,ImageStyle,ImageToolbar,ImageUpload,ImageResize,ImageResizeEditing,ImageResizeHandles,MediaEmbed,Alignment],
            extraPlugins:[CTUploadAdapterPlugin],
            toolbar:{items:['undo','redo','|','heading','|','bold','italic','link','|','alignment','|','bulletedList','numberedList','|','outdent','indent','|','imageUpload','insertTable','mediaEmbed','blockQuote'],shouldNotGroupWhenFull:true},
            image:{toolbar:['imageTextAlternative','toggleImageCaption','|','imageStyle:inline','imageStyle:block','imageStyle:side','|','resizeImage'],resizeOptions:[{name:'resizeImage:original',value:null,label:'Original'},{name:'resizeImage:50',value:'50',label:'50%'},{name:'resizeImage:75',value:'75',label:'75%'}],resizeUnit:'%'},
            alignment:{options:['left','center','right','justify']},
            table:{contentToolbar:['tableColumn','tableRow','mergeTableCells']}
        }).then(ed=>{
            editorInstance=ed;
            const draft=restoreDraft();
            if(draft&&typeof draft.inputHtml==='string'&&draft.inputHtml.length>0) ed.setData(draft.inputHtml);
            if(draft&&taskNameInput&&draft.name&&taskNameInput.value.trim()==='') taskNameInput.value=draft.name;
            // Restore assigned members
            if(draft&&draft.assignedMemberIds&&draft.assignedMemberIds.length>0){
                document.querySelectorAll('input[name="assignedMemberIds"]').forEach(cb=>{
                    if(draft.assignedMemberIds.includes(cb.value)) cb.checked=true;
                });
            }
            // Restore start/end dates
            const startDateInput=document.getElementById('taskStartDate');
            const endDateInput=document.getElementById('taskEndDate');
            if(draft&&draft.startDate&&startDateInput&&!startDateInput.value) startDateInput.value=draft.startDate;
            if(draft&&draft.endDate&&endDateInput&&!endDateInput.value) endDateInput.value=draft.endDate;
            ed.model.document.on('change:data',saveDraft);
            wireFileInsertButton();
        }).catch(err=>console.error('CKEditor init error:',err));
    }

    function hasMeaningfulContent(html) { if(!html) return false; const doc=new DOMParser().parseFromString(html,'text/html'); return (doc.body.textContent||'').replace(/\u00A0/g,' ').trim().length>0||!!doc.body.querySelector('img,table,video,audio,iframe'); }

    if(formElement){
        if(submitButton) submitButton.addEventListener('click',()=>explicitSubmitRequested=true);
        formElement.addEventListener('submit',function(e){
            const isPrimary=e.submitter?e.submitter===submitButton:explicitSubmitRequested;
            if(!isPrimary){e.preventDefault();return;}
            if(pendingUploads>0){e.preventDefault();explicitSubmitRequested=false;alert('Please wait for file upload to finish.');return;}
            const el=document.querySelector(editorSelector); const html=editorInstance?editorInstance.getData():(el?el.value:''); if(el) el.value=html;
            if(!hasMeaningfulContent(html)){e.preventDefault();explicitSubmitRequested=false;alert('Instructions are required before creating the task.');if(editorInstance) editorInstance.editing.view.focus();return;}
            isSubmitting=true; clearDraft();
        });
        formElement.querySelectorAll('button').forEach(b=>{ if(b===submitButton) return; const t=(b.getAttribute('type')||'').toLowerCase(); if(t==='reset'||t==='button') return; b.setAttribute('type','button'); });
    }

    if(taskNameInput) taskNameInput.addEventListener('input',saveDraft);
    // Save draft when assign-to checkboxes or date fields change
    document.querySelectorAll('input[name="assignedMemberIds"]').forEach(cb=>cb.addEventListener('change',saveDraft));
    const _sd=document.getElementById('taskStartDate'); if(_sd) _sd.addEventListener('change',saveDraft);
    const _ed=document.getElementById('taskEndDate'); if(_ed) _ed.addEventListener('change',saveDraft);

    function loadScript(i){ if(window.CKEDITOR&&window.CKEDITOR.ClassicEditor){initEditor();return;} if(i>=scriptCdn.length){initEditor();return;} const s=document.createElement('script');s.src=scriptCdn[i];s.async=true;s.onload=()=>initEditor();s.onerror=()=>loadScript(i+1);document.head.appendChild(s); }
    function loadStyle(i){ if(document.querySelector('link[data-ckeditor-style="true"]')){loadScript(0);return;} if(i>=styleCdn.length){loadScript(0);return;} const l=document.createElement('link');l.rel='stylesheet';l.href=styleCdn[i];l.setAttribute('data-ckeditor-style','true');l.onload=()=>loadScript(0);l.onerror=()=>{l.remove();loadStyle(i+1);};document.head.appendChild(l); }
    loadStyle(0);
});
</script>
}
