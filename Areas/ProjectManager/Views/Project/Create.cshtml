@model project_lifecycle.ViewModels.ProjectManager.ProjectManageViewModel
@{
    ViewData["Title"] = "Create Task — " + Model.Project.Name;
    var _milestonesTyped = Model.Project.Milestones.Cast<project_lifecycle.ViewModels.ProjectManager.ProjectMilestoneViewModel>().ToList();
    var projectStart = Model.Project.StartDate.ToString("yyyy-MM-dd");
    var projectEnd = Model.Project.EndDate.ToString("yyyy-MM-dd");
}

<style>
    .milestone-member-check { display:flex; align-items:center; gap:.6rem; padding:.3rem 0; border-bottom:1px solid #f1f5f9; }
    .milestone-member-check:last-child { border-bottom:none; }
    .milestone-member-check input[type="checkbox"] { width:15px; height:15px; accent-color:#6366f1; cursor:pointer; flex-shrink:0; }
    .milestone-member-check label { font-size:.9rem; color:#374151; cursor:pointer; margin:0; }
</style>

<!-- ===== Hero ===== -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-plus-circle"></i></span>
                Create Task
            </h1>
            <p class="emp-page-subtitle">Project: @Model.Project.Name</p>
        </div>
        <div class="emp-page-hero-right">
            <a asp-area="ProjectManager" asp-controller="Project" asp-action="Milestone"
               asp-route-projectMilestoneId="@(ViewData["PreselectedMilestoneId"] as int? ?? Model.Project.Milestones.FirstOrDefault()?.Id)" class="emp-btn emp-btn-outline">
                <i class="fas fa-arrow-left"></i>
                <span>Back to Tasks</span>
            </a>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="emp-alert emp-alert-success">
        <i class="fas fa-check-circle emp-alert-icon"></i>
        <span>@TempData["SuccessMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="emp-alert emp-alert-error">
        <i class="fas fa-exclamation-circle emp-alert-icon"></i>
        <span>@TempData["ErrorMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}

<!-- ===== Form Card ===== -->
<div class="emp-form-card">
    <div class="emp-form-section">
        <div class="emp-form-section-title"><i class="fas fa-list-check"></i> Task Details</div>

        <form asp-area="ProjectManager" asp-controller="Project" asp-action="AddTask" method="post" class="emp-form emp-create-task-form">
            @Html.AntiForgeryToken()

            @{
                var _preselectedMilestoneId = ViewData["PreselectedMilestoneId"] as int?;
                var _preselectedMilestone = _preselectedMilestoneId.HasValue
                    ? _milestonesTyped.FirstOrDefault(m => m.Id == _preselectedMilestoneId.Value)
                    : null;
            }
            <div class="emp-form-row">
                <label class="emp-form-label">Milestone</label>
                @if (_preselectedMilestone != null)
                {
                    <input type="hidden" name="projectMilestoneId" value="@_preselectedMilestone.Id" />
                    <div class="emp-form-control" style="background:#f8fafc;color:#374151;cursor:default;">
                        <i class="fas fa-flag" style="color:#6366f1;margin-right:.4rem;"></i>
                        @_preselectedMilestone.SequenceOrder — @_preselectedMilestone.MilestoneName
                    </div>
                }
                else
                {
                    <select name="projectMilestoneId" class="emp-form-control" required>
                        <option value="">-- Select Milestone --</option>
                        @foreach (var ms in _milestonesTyped.OrderBy(m => m.SequenceOrder))
                        {
                            <option value="@ms.Id">@ms.SequenceOrder — @ms.MilestoneName</option>
                        }
                    </select>
                }
            </div>

            <div class="emp-form-row">
                <label class="emp-form-label">Task Name</label>
                <input name="Name" id="taskName" class="emp-form-control" placeholder="Enter a descriptive task name…" required />
            </div>

            <div class="emp-form-row">
                <label class="emp-form-label">Assign To</label>
                @if (!Model.Project.Members.Any())
                {
                    <div class="emp-form-control" style="color:#94a3b8;cursor:default;">No project members yet. Add members from the project details page first.</div>
                }
                else
                {
                    <input type="text" id="assignMemberInput" class="emp-form-control" placeholder="Click to pick from project members…" autocomplete="off" readonly style="cursor:pointer;" />
                    <div id="assignedMemberChips" style="display:flex; flex-wrap:wrap; gap:.4rem; margin-top:.5rem;"></div>
                    <div id="assignedMemberHiddenInputs"></div>
                }
                <span class="emp-form-hint">Selected members will share the same task submission.</span>
            </div>

            <div class="emp-form-row">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                    <div>
                        <label class="emp-form-label">Start Date</label>
                           <input name="StartDate" id="taskStartDate" type="date" class="emp-form-control" required
                               min='@projectStart'
                               max='@projectEnd' />
                    </div>
                    <div>
                        <label class="emp-form-label">End Date</label>
                           <input name="EndDate" id="taskEndDate" type="date" class="emp-form-control" required
                               min='@projectStart'
                               max='@projectEnd' />
                    </div>
                </div>
            </div>

            <!-- Holidays -->
            <div id="holidaysSection" style="display: none;">
                <div class="emp-form-row" style="padding: 0; overflow: hidden;">
                    <div class="card" style="border: 1px solid #fde68a; box-shadow: none; border-radius: 10px; overflow: hidden;">
                        <div class="card-header d-flex align-items-center gap-2 py-2" style="background: #fffbeb;">
                            <i class="fas fa-calendar-day text-warning"></i>
                            <strong class="text-warning">Public Holidays (Philippines)</strong>
                            <span id="holidayCount" class="badge bg-warning text-dark ms-auto">0</span>
                        </div>
                        <div class="card-body p-0">
                            <div id="holidaysLoading" class="text-center py-3" style="display: none;">
                                <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
                                <span class="ms-2 text-muted">Loading holidays...</span>
                            </div>
                            <div id="holidaysError" class="text-center py-3 text-danger" style="display: none;">
                                <i class="fas fa-exclamation-triangle"></i>
                                <span class="ms-1">Could not load holidays. Please check your internet connection.</span>
                            </div>
                            <div id="holidaysEmpty" class="text-center py-3 text-muted" style="display: none;">
                                <i class="fas fa-check-circle text-success"></i>
                                <span class="ms-1">No public holidays in this date range.</span>
                            </div>
                            <table id="holidaysTable" class="table table-sm table-hover mb-0" style="display: none;">
                                <thead>
                                    <tr>
                                        <th style="width: 130px;">Date</th>
                                        <th>Holiday</th>
                                        <th>Local Name</th>
                                        <th style="width: 80px;">Day</th>
                                    </tr>
                                </thead>
                                <tbody id="holidaysTableBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="emp-form-row">
                <label class="emp-form-label">Instructions</label>
                <textarea id="CreateTaskInstructions" name="Instructions" class="emp-form-control" placeholder="Enter task instructions…"></textarea>
                <div style="margin-top:10px; display:flex; gap:8px; align-items:center;">
                    <button type="button" id="insertCreateTaskFileBtn" class="emp-btn emp-btn-outline" style="padding:6px 12px;">
                        <i class="fas fa-paperclip"></i> Add file/image
                    </button>
                    <span style="font-size:12px;opacity:.8;">Max 10 MB (images, PDF, DOCX, XLSX, etc.)</span>
                </div>
            </div>

            <div class="emp-form-actions" style="justify-content:flex-end;">
                <a asp-area="ProjectManager" asp-controller="Project" asp-action="Details"
                   asp-route-id="@Model.Project.Id" class="emp-btn emp-btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
                <button id="submitCreateTaskBtn" type="submit" class="emp-btn emp-btn-primary">
                    <i class="fas fa-plus"></i> Create Task
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Submit confirmation modal -->
<div class="emp-modal-backdrop" id="submitConfirmModal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="emp-modal" role="document">
        <h4 id="submitConfirmTitle"><i class="fas fa-check-circle"></i> Confirm</h4>
        <p id="submitConfirmMessage">Are you sure?</p>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn emp-btn-cancel" id="submitCancelBtn">Cancel</button>
            <button type="button" class="emp-btn emp-btn-confirm emp-btn-primary" id="submitConfirmBtn">Create</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    const editorSelector = '#CreateTaskInstructions';
    const uploadEndpoint = '@Url.Action("UploadRichText", "Project", new { area = "ProjectManager" })';
    const formElement = document.querySelector('form.emp-create-task-form');
    const submitButton = document.getElementById('submitCreateTaskBtn');
    const taskNameInput = document.getElementById('taskName');
    let editorInstance = null, pendingUploads = 0, explicitSubmitRequested = false, isSubmitting = false;
    const draftStorageKey = 'pm-create-task-draft';

    // ═══════ Member Picker Modal ══════════════════════════════════
    const projectMembers = [
        @foreach (var m in Model.Project.Members)
        {
            @Html.Raw("{id:" + m.Id + ",name:'" + m.EmployeeName.Replace("'", "\\'") + "',role:'" + m.ProjectRoleName.Replace("'", "\\'") + "',profileImage:'" + (m.ProfileImage ?? "").Replace("'", "\\'") + "'},")
        }
    ];
    const selectedMemberIds = new Set();
    const chipsContainer = document.getElementById('assignedMemberChips');
    const hiddenContainer = document.getElementById('assignedMemberHiddenInputs');
    const assignInput = document.getElementById('assignMemberInput');

    // Inject modal HTML
    if (projectMembers.length > 0) {
        const memberModalHtml = `
<div class="modal fade" id="memberPickerModal" tabindex="-1" aria-labelledby="memberPickerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content em-picker-modal">
            <div class="em-picker-header">
                <div>
                    <h5 class="em-picker-title" id="memberPickerModalLabel"><i class="fas fa-user-plus"></i> Assign Members</h5>
                    <p class="em-picker-subtitle">Select project members to assign to this task</p>
                </div>
                <button type="button" class="btn-close btn-close-white" id="memberPickerCloseBtn" aria-label="Close"></button>
            </div>
            <div class="em-picker-filters">
                <div class="em-picker-filters-row">
                    <div class="em-picker-search-group">
                        <i class="fas fa-magnifying-glass em-picker-search-icon"></i>
                        <input type="text" id="memberPickerFilter" class="em-picker-search-input" placeholder="Search members\u2026" autocomplete="off" />
                    </div>
                </div>
            </div>
            <div class="modal-body em-picker-body">
                <div class="em-picker-table-card">
                    <div class="em-picker-table-responsive">
                        <table class="em-picker-table" id="memberPickerTable">
                            <thead>
                                <tr>
                                    <th style="width:44px;text-align:center;"><input type="checkbox" id="memberPickerSelectAll" class="em-picker-checkbox" /></th>
                                    <th>Member</th>
                                    <th>Project Role</th>
                                    <th style="width:100px;text-align:center;">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <div id="memberPickerEmpty" class="em-picker-empty" style="display:none;">
                        <div class="em-picker-empty-icon"><i class="fas fa-user-group"></i></div>
                        <div class="em-picker-empty-title">No members found</div>
                        <div class="em-picker-empty-text">No matching project members.</div>
                    </div>
                    <div class="em-picker-pagination" id="memberPickerPagination">
                        <div class="em-picker-pagination-info" id="memberPickerPaginationInfo"></div>
                    </div>
                </div>
            </div>
            <div class="em-picker-footer">
                <button type="button" class="em-picker-btn-cancel" id="memberPickerCancelBtn">Cancel</button>
                <button type="button" id="memberPickerAddBtn" class="em-picker-btn-add" disabled>
                    <i class="fas fa-plus"></i> Add Selected
                </button>
            </div>
        </div>
    </div>
</div>`;
        document.body.insertAdjacentHTML('beforeend', memberModalHtml);
    }

    const memberModalEl = document.getElementById('memberPickerModal');
    const memberModalTable = document.getElementById('memberPickerTable');
    const memberModalEmpty = document.getElementById('memberPickerEmpty');
    const memberModalFilter = document.getElementById('memberPickerFilter');
    const memberModalAddBtn = document.getElementById('memberPickerAddBtn');
    const memberModalCloseBtn = document.getElementById('memberPickerCloseBtn');
    const memberModalCancelBtn = document.getElementById('memberPickerCancelBtn');
    const memberModalSelectAll = document.getElementById('memberPickerSelectAll');

    function renderChips() {
        if (!chipsContainer || !hiddenContainer) return;
        chipsContainer.innerHTML = '';
        hiddenContainer.innerHTML = '';
        selectedMemberIds.forEach(id => {
            const m = projectMembers.find(x => x.id === id);
            if (!m) return;
            const initials = (m.name || '').split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
            // Chip
            const chip = document.createElement('span');
            chip.className = 'em-picker-chip';
            chip.style.cssText = 'display:inline-flex;align-items:center;gap:.35rem;padding:.25rem .6rem .25rem .4rem;border-radius:20px;background:linear-gradient(135deg,#e0f2fe,#dbeafe);color:#1e40af;font-size:.82rem;font-weight:600;border:1px solid rgba(30,64,175,.12);';
            chip.innerHTML = '<span style="width:22px;height:22px;border-radius:50%;background:#3b82f6;color:#fff;display:flex;align-items:center;justify-content:center;font-size:.6rem;font-weight:700;">' + initials + '</span>' +
                '<span>' + m.name + '</span>' +
                '<button type="button" style="background:none;border:none;color:#64748b;cursor:pointer;font-size:.75rem;padding:0 0 0 .2rem;line-height:1;" data-remove-id="' + id + '" title="Remove"><i class="fas fa-times"></i></button>';
            chip.querySelector('button').addEventListener('click', function () {
                selectedMemberIds.delete(id);
                renderChips();
                saveDraft();
            });
            chipsContainer.appendChild(chip);
            // Hidden input
            const inp = document.createElement('input');
            inp.type = 'hidden';
            inp.name = 'assignedMemberIds';
            inp.value = id;
            hiddenContainer.appendChild(inp);
        });
        // Update input placeholder
        if (assignInput) {
            assignInput.placeholder = selectedMemberIds.size > 0
                ? selectedMemberIds.size + ' member' + (selectedMemberIds.size !== 1 ? 's' : '') + ' selected — click to change'
                : 'Click to pick from project members\u2026';
        }
    }

    function openMemberModal() {
        if (!memberModalEl) return;
        const tbody = memberModalTable.querySelector('tbody');
        tbody.innerHTML = '';
        memberModalEmpty.style.display = 'none';
        if (memberModalFilter) memberModalFilter.value = '';
        if (memberModalSelectAll) memberModalSelectAll.checked = false;

        if (!projectMembers.length) {
            memberModalEmpty.style.display = 'block';
        } else {
            projectMembers.forEach(m => {
                const initials = (m.name || '').split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
                const isSelected = selectedMemberIds.has(m.id);
                const tr = document.createElement('tr');
                tr.className = 'em-picker-row';
                tr.innerHTML =
                    '<td style="text-align:center;"><input type="checkbox" class="member-select-checkbox em-picker-checkbox" data-id="' + m.id + '"' + (isSelected ? ' checked' : '') + ' /></td>' +
                    '<td><div class="em-picker-name-cell"><div class="em-picker-avatar">' + initials + '</div><div class="em-picker-name-text">' + (m.name || '') + '</div></div></td>' +
                    '<td><span style="color:#6366f1;font-size:.82rem;font-weight:500;">' + (m.role || '') + '</span></td>' +
                    '<td style="text-align:center;"><button type="button" class="em-picker-select-btn member-quick-add" data-id="' + m.id + '" title="Quick add"><i class="fas fa-' + (isSelected ? 'check' : 'plus') + '"></i></button></td>';
                tbody.appendChild(tr);
            });
        }

        // Wire checkbox change
        function updateModalAddState() {
            const any = memberModalTable.querySelectorAll('.member-select-checkbox:checked').length > 0;
            if (memberModalAddBtn) memberModalAddBtn.disabled = !any;
        }
        tbody.querySelectorAll('.member-select-checkbox').forEach(cb => cb.addEventListener('change', updateModalAddState));
        if (memberModalSelectAll) {
            memberModalSelectAll.addEventListener('change', function () {
                const checked = !!this.checked;
                // Only toggle visible rows
                tbody.querySelectorAll('tr').forEach(tr => {
                    if (tr.style.display === 'none') return;
                    const cb = tr.querySelector('.member-select-checkbox');
                    if (cb) cb.checked = checked;
                });
                updateModalAddState();
            });
        }
        updateModalAddState();

        // Pagination info
        const pInfo = document.getElementById('memberPickerPaginationInfo');
        if (pInfo) pInfo.textContent = 'Showing ' + projectMembers.length + ' member' + (projectMembers.length !== 1 ? 's' : '');

        // Quick add buttons
        tbody.querySelectorAll('.member-quick-add').forEach(btn => btn.addEventListener('click', function () {
            const mId = parseInt(this.dataset.id);
            if (selectedMemberIds.has(mId)) {
                selectedMemberIds.delete(mId);
                this.querySelector('i').className = 'fas fa-plus';
                const cb = tbody.querySelector('.member-select-checkbox[data-id="' + mId + '"]');
                if (cb) cb.checked = false;
            } else {
                selectedMemberIds.add(mId);
                this.querySelector('i').className = 'fas fa-check';
                const cb = tbody.querySelector('.member-select-checkbox[data-id="' + mId + '"]');
                if (cb) cb.checked = true;
            }
            renderChips();
            saveDraft();
            updateModalAddState();
        }));

        // Show modal
        if (window.bootstrap && window.bootstrap.Modal) {
            const modalInstance = new bootstrap.Modal(memberModalEl);
            modalInstance.show();
        } else if (window.jQuery && typeof $().modal === 'function') {
            $('#memberPickerModal').modal('show');
        } else {
            memberModalEl.style.display = 'block';
            memberModalEl.style.position = 'fixed';
            memberModalEl.style.left = '0';
            memberModalEl.style.top = '0';
            memberModalEl.style.width = '100%';
            memberModalEl.style.height = '100%';
            memberModalEl.style.zIndex = '2060';
            memberModalEl.classList.add('show');
            document.body.style.overflow = 'hidden';
        }
    }

    function closeMemberModal() {
        if (!memberModalEl) return;
        if (window.bootstrap && window.bootstrap.Modal) {
            const inst = bootstrap.Modal.getInstance(memberModalEl);
            if (inst) inst.hide();
        } else if (window.jQuery && typeof $().modal === 'function') {
            $('#memberPickerModal').modal('hide');
        } else {
            memberModalEl.style.display = 'none';
            memberModalEl.classList.remove('show');
            memberModalEl.style.zIndex = '';
            document.body.style.overflow = '';
        }
    }

    // Wire open/close
    if (assignInput) assignInput.addEventListener('click', openMemberModal);
    if (memberModalCloseBtn) memberModalCloseBtn.addEventListener('click', closeMemberModal);
    if (memberModalCancelBtn) memberModalCancelBtn.addEventListener('click', closeMemberModal);
    if (memberModalEl) memberModalEl.addEventListener('click', function (e) { if (e.target === memberModalEl) closeMemberModal(); });

    // Add Selected button
    if (memberModalAddBtn) {
        memberModalAddBtn.addEventListener('click', function () {
            const checked = memberModalTable.querySelectorAll('.member-select-checkbox:checked');
            checked.forEach(cb => {
                selectedMemberIds.add(parseInt(cb.dataset.id));
            });
            // Also remove unchecked ones (so the modal acts as the source of truth)
            const unchecked = memberModalTable.querySelectorAll('.member-select-checkbox:not(:checked)');
            unchecked.forEach(cb => {
                selectedMemberIds.delete(parseInt(cb.dataset.id));
            });
            renderChips();
            saveDraft();
            closeMemberModal();
        });
    }

    // Client-side filter
    if (memberModalFilter) {
        memberModalFilter.addEventListener('input', function () {
            const q = this.value.trim().toLowerCase();
            let visible = 0;
            memberModalTable.querySelectorAll('tbody tr').forEach(tr => {
                const name = (tr.querySelector('.em-picker-name-text')?.textContent || '').toLowerCase();
                const role = (tr.cells[2]?.textContent || '').toLowerCase();
                const show = !q || name.includes(q) || role.includes(q);
                tr.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            const pInfo = document.getElementById('memberPickerPaginationInfo');
            if (pInfo) pInfo.textContent = visible === 0 ? 'No matches' : 'Showing ' + visible + ' member' + (visible !== 1 ? 's' : '');
        });
    }

    // Project date range (server-rendered). Enforce on the date inputs.
    const projectStart = '@projectStart';
    const projectEnd = '@projectEnd';
    // Apply min/max client-side as a safety net for browsers that respect it, and clamp on change.
    (function enforceProjectDateRange(){
        const sd = document.getElementById('taskStartDate');
        const ed = document.getElementById('taskEndDate');
        if(sd){ sd.min = projectStart; sd.max = projectEnd; sd.addEventListener('change', function(){ if(!sd.value) return; if(sd.value < projectStart){ alert('Start date must be on or after project start date.'); sd.value = projectStart; } else if(sd.value > projectEnd){ alert('Start date must be on or before project end date.'); sd.value = projectEnd; } }); }
        if(ed){ ed.min = projectStart; ed.max = projectEnd; ed.addEventListener('change', function(){ if(!ed.value) return; if(ed.value < projectStart){ alert('End date must be on or after project start date.'); ed.value = projectStart; } else if(ed.value > projectEnd){ alert('End date must be on or before project end date.'); ed.value = projectEnd; } }); }
    })();

    function saveDraft() {
        if (isSubmitting) return;
        const el = document.querySelector(editorSelector);
        const startDateInput = document.getElementById('taskStartDate');
        const endDateInput = document.getElementById('taskEndDate');
        const checkedIds = Array.from(selectedMemberIds);
        try {
            sessionStorage.setItem(draftStorageKey, JSON.stringify({
                name: taskNameInput ? taskNameInput.value : '',
                inputHtml: editorInstance ? editorInstance.getData() : (el ? el.value : ''),
                assignedMemberIds: checkedIds,
                startDate: startDateInput ? startDateInput.value : '',
                endDate: endDateInput ? endDateInput.value : ''
            }));
        } catch {}
    }
    function restoreDraft() { try { const r = sessionStorage.getItem(draftStorageKey); return r ? JSON.parse(r) : null; } catch { return null; } }
    function clearDraft() { try { sessionStorage.removeItem(draftStorageKey); } catch {} }
    function beginUpload() { pendingUploads += 1; if (submitButton) submitButton.disabled = true; }
    function endUpload() { pendingUploads = Math.max(0, pendingUploads - 1); if (submitButton) submitButton.disabled = pendingUploads > 0; }

    const scriptCdn = ['https://cdn.jsdelivr.net/npm/ckeditor5@47.1.0/dist/browser/ckeditor5.umd.js','https://unpkg.com/ckeditor5@47.1.0/dist/browser/ckeditor5.umd.js'];
    const styleCdn  = ['https://cdn.jsdelivr.net/npm/ckeditor5@47.1.0/dist/ckeditor5.css','https://unpkg.com/ckeditor5@47.1.0/dist/ckeditor5.css'];

    class CTUploadAdapter { constructor(l){ this.loader=l; this.ctrl=new AbortController(); } async upload(){ const f=await this.loader.file; const r=await uploadFile(f,this.ctrl.signal); return {default:r.url}; } abort(){ this.ctrl.abort(); } }
    function CTUploadAdapterPlugin(ed){ ed.plugins.get('FileRepository').createUploadAdapter=(l)=>new CTUploadAdapter(l); }

    async function uploadFile(file, signal) {
        beginUpload();
        try { const fd=new FormData(); fd.append('upload',file); const resp=await fetch(uploadEndpoint,{method:'POST',body:fd,signal}); const p=await resp.json(); if(!resp.ok) throw new Error(p?.error?.message||'Upload failed.'); return p; }
        finally { endUpload(); }
    }

    function wireFileInsertButton() {
        const btn=document.getElementById('insertCreateTaskFileBtn');
        if(!btn) return;
        btn.addEventListener('click', function(e) {
            e.preventDefault(); e.stopPropagation();
            if(!editorInstance) return;
            // Create a fresh disposable file input each time — never reuse, never clear .value
            const inp = document.createElement('input');
            inp.type = 'file';
            inp.style.display = 'none';
            inp.addEventListener('change', async function() {
                if(!inp.files||!inp.files.length){ document.body.removeChild(inp); return; }
                const file = inp.files[0];
                document.body.removeChild(inp); // remove immediately before any async work
                btn.disabled = true;
                try {
                    const r = await uploadFile(file);
                    if(file.type.startsWith('image/')){
                        editorInstance.model.change(w=>{const img=w.createElement('imageBlock',{src:r.url});editorInstance.model.insertContent(img,editorInstance.model.document.selection);});
                    } else {
                        editorInstance.model.change(w=>{const t=w.createText(r.fileName||file.name,{linkHref:r.url});editorInstance.model.insertContent(t,editorInstance.model.document.selection);});
                    }
                } catch(err){ alert(err.message||'Upload failed.'); }
                finally{ btn.disabled=false; }
            });
            document.body.appendChild(inp);
            inp.click();
        });
    }

    function initEditor() {
        if(!window.CKEDITOR||!window.CKEDITOR.ClassicEditor) return;
        const {ClassicEditor,Essentials,Paragraph,Heading,Bold,Italic,Link,List,Indent,BlockQuote,Table,TableToolbar,Image,ImageCaption,ImageStyle,ImageToolbar,ImageUpload,ImageResize,ImageResizeEditing,ImageResizeHandles,MediaEmbed,Alignment}=window.CKEDITOR;
        ClassicEditor.create(document.querySelector(editorSelector),{
            licenseKey:'GPL',
            plugins:[Essentials,Paragraph,Heading,Bold,Italic,Link,List,Indent,BlockQuote,Table,TableToolbar,Image,ImageCaption,ImageStyle,ImageToolbar,ImageUpload,ImageResize,ImageResizeEditing,ImageResizeHandles,MediaEmbed,Alignment],
            extraPlugins:[CTUploadAdapterPlugin],
            toolbar:{items:['undo','redo','|','heading','|','bold','italic','link','|','alignment','|','bulletedList','numberedList','|','outdent','indent','|','imageUpload','insertTable','mediaEmbed','blockQuote'],shouldNotGroupWhenFull:true},
            image:{toolbar:['imageTextAlternative','toggleImageCaption','|','imageStyle:inline','imageStyle:block','imageStyle:side','|','resizeImage'],resizeOptions:[{name:'resizeImage:original',value:null,label:'Original'},{name:'resizeImage:50',value:'50',label:'50%'},{name:'resizeImage:75',value:'75',label:'75%'}],resizeUnit:'%'},
            alignment:{options:['left','center','right','justify']},
            table:{contentToolbar:['tableColumn','tableRow','mergeTableCells']}
        }).then(ed=>{
            editorInstance=ed;
            const draft=restoreDraft();
            if(draft&&typeof draft.inputHtml==='string'&&draft.inputHtml.length>0) ed.setData(draft.inputHtml);
            if(draft&&taskNameInput&&draft.name&&taskNameInput.value.trim()==='') taskNameInput.value=draft.name;
            // Restore assigned members
            if(draft&&draft.assignedMemberIds&&draft.assignedMemberIds.length>0){
                draft.assignedMemberIds.forEach(id => {
                    const numId = parseInt(id);
                    if (projectMembers.find(m => m.id === numId)) selectedMemberIds.add(numId);
                });
                renderChips();
            }
            // Restore start/end dates
            const startDateInput=document.getElementById('taskStartDate');
            const endDateInput=document.getElementById('taskEndDate');
            if(draft&&draft.startDate&&startDateInput&&!startDateInput.value) startDateInput.value=draft.startDate;
            if(draft&&draft.endDate&&endDateInput&&!endDateInput.value) endDateInput.value=draft.endDate;
            ed.model.document.on('change:data',saveDraft);
            wireFileInsertButton();
        }).catch(err=>console.error('CKEditor init error:',err));
    }

    function hasMeaningfulContent(html) { if(!html) return false; const doc=new DOMParser().parseFromString(html,'text/html'); return (doc.body.textContent||'').replace(/\u00A0/g,' ').trim().length>0||!!doc.body.querySelector('img,table,video,audio,iframe'); }

    if (formElement) {
        // Confirmation modal flow: open a confirm dialog on primary submit
        let __submitFormToSubmit = null;
        const submitModal = document.getElementById('submitConfirmModal');
        const submitCancelBtn = document.getElementById('submitCancelBtn');
        const submitConfirmBtn = document.getElementById('submitConfirmBtn');

        if (submitButton) {
            submitButton.addEventListener('click', function (e) {
                e.preventDefault();
                __submitFormToSubmit = formElement;
                const titleEl = document.getElementById('submitConfirmTitle');
                const msgEl = document.getElementById('submitConfirmMessage');
                if (titleEl) titleEl.textContent = 'Confirm Create';
                if (msgEl) msgEl.textContent = 'Create this task?';
                if (submitModal) { submitModal.classList.add('active'); submitModal.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; }
            });
        }

        if (submitCancelBtn) submitCancelBtn.addEventListener('click', function () { __submitFormToSubmit = null; if (submitModal) { submitModal.classList.remove('active'); submitModal.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; } });
        if (submitConfirmBtn) submitConfirmBtn.addEventListener('click', function () {
            if (!__submitFormToSubmit) { if (submitModal) { submitModal.classList.remove('active'); submitModal.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; } return; }
            if (pendingUploads > 0) { alert('Please wait for file upload to finish.'); return; }
            explicitSubmitRequested = true;
            __submitFormToSubmit.submit();
        });

        if (submitModal) submitModal.addEventListener('click', function (e) { if (e.target === submitModal) { __submitFormToSubmit = null; submitModal.classList.remove('active'); submitModal.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; } });

        formElement.addEventListener('submit', function (e) {
            const isPrimary = e.submitter ? e.submitter === submitButton : explicitSubmitRequested;
            if (!isPrimary) { e.preventDefault(); return; }
            if (pendingUploads > 0) { e.preventDefault(); explicitSubmitRequested = false; alert('Please wait for file upload to finish.'); return; }
            const el = document.querySelector(editorSelector); const html = editorInstance ? editorInstance.getData() : (el ? el.value : ''); if (el) el.value = html;
            if (!hasMeaningfulContent(html)) { e.preventDefault(); explicitSubmitRequested = false; alert('Instructions are required before creating the task.'); if (editorInstance) editorInstance.editing.view.focus(); return; }
            isSubmitting = true; clearDraft();
        });

        formElement.querySelectorAll('button').forEach(b => { if (b === submitButton) return; const t = (b.getAttribute('type') || '').toLowerCase(); if (t === 'reset' || t === 'button') return; b.setAttribute('type', 'button'); });
    }

    if(taskNameInput) taskNameInput.addEventListener('input',saveDraft);
    // Save draft when date fields change
    const _sd=document.getElementById('taskStartDate'); if(_sd) _sd.addEventListener('change',saveDraft);
    const _ed=document.getElementById('taskEndDate'); if(_ed) _ed.addEventListener('change',saveDraft);

    // --- Holiday Fetching Logic ---
    (function () {
        var startDateInput = document.getElementById('taskStartDate');
        var endDateInput = document.getElementById('taskEndDate');
        var holidaysSection = document.getElementById('holidaysSection');
        var holidaysLoading = document.getElementById('holidaysLoading');
        var holidaysError = document.getElementById('holidaysError');
        var holidaysEmpty = document.getElementById('holidaysEmpty');
        var holidaysTable = document.getElementById('holidaysTable');
        var holidaysTableBody = document.getElementById('holidaysTableBody');
        var holidayCount = document.getElementById('holidayCount');
        var holidayFetchTimer = null;

        var dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

        function fetchHolidays() {
            var startDate = startDateInput ? startDateInput.value : '';
            var endDate = endDateInput ? endDateInput.value : '';

            if (!startDate || !endDate) {
                if (holidaysSection) holidaysSection.style.display = 'none';
                return;
            }

            if (new Date(endDate) < new Date(startDate)) {
                if (holidaysSection) holidaysSection.style.display = 'none';
                return;
            }

            holidaysSection.style.display = '';
            holidaysLoading.style.display = '';
            holidaysError.style.display = 'none';
            holidaysEmpty.style.display = 'none';
            holidaysTable.style.display = 'none';
            holidaysTableBody.innerHTML = '';
            holidayCount.textContent = '...';

            var url = '@Url.Action("GetHolidays", "Project", new { area = "ProjectManager" })'
                + '?startDate=' + encodeURIComponent(startDate)
                + '&endDate=' + encodeURIComponent(endDate);

            fetch(url)
                .then(function (response) {
                    if (!response.ok) throw new Error('API error');
                    return response.json();
                })
                .then(function (holidays) {
                    holidaysLoading.style.display = 'none';

                    if (!holidays || holidays.length === 0) {
                        holidaysEmpty.style.display = '';
                        holidayCount.textContent = '0';
                        return;
                    }

                    holidayCount.textContent = holidays.length;
                    var html = '';
                    for (var i = 0; i < holidays.length; i++) {
                        var h = holidays[i];
                        var d = new Date(h.date + 'T00:00:00');
                        var dayName = dayNames[d.getDay()];
                        var isWeekend = d.getDay() === 0 || d.getDay() === 6;
                        var rowClass = isWeekend ? 'class="table-warning"' : '';
                        html += '<tr ' + rowClass + '>'
                            + '<td><i class="fas fa-star text-warning me-1" style="font-size:0.7em;"></i>' + h.date + '</td>'
                            + '<td>' + escapeHolidayHtml(h.name) + '</td>'
                            + '<td>' + escapeHolidayHtml(h.localName) + '</td>'
                            + '<td><span class="badge ' + (isWeekend ? 'bg-secondary' : 'bg-info text-dark') + '">' + dayName + '</span></td>'
                            + '</tr>';
                    }
                    holidaysTableBody.innerHTML = html;
                    holidaysTable.style.display = '';
                })
                .catch(function () {
                    holidaysLoading.style.display = 'none';
                    holidaysError.style.display = '';
                    holidayCount.textContent = '!';
                });
        }

        function escapeHolidayHtml(str) {
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(str));
            return div.innerHTML;
        }

        function debouncedFetchHolidays() {
            if (holidayFetchTimer) clearTimeout(holidayFetchTimer);
            holidayFetchTimer = setTimeout(fetchHolidays, 400);
        }

        if (startDateInput) startDateInput.addEventListener('change', debouncedFetchHolidays);
        if (endDateInput) endDateInput.addEventListener('change', debouncedFetchHolidays);

        // Auto-fetch if dates are already filled (e.g. draft restore)
        if (startDateInput && endDateInput && startDateInput.value && endDateInput.value) {
            fetchHolidays();
        }
    })();

    function loadScript(i){ if(window.CKEDITOR&&window.CKEDITOR.ClassicEditor){initEditor();return;} if(i>=scriptCdn.length){initEditor();return;} const s=document.createElement('script');s.src=scriptCdn[i];s.async=true;s.onload=()=>initEditor();s.onerror=()=>loadScript(i+1);document.head.appendChild(s); }
    function loadStyle(i){ if(document.querySelector('link[data-ckeditor-style="true"]')){loadScript(0);return;} if(i>=styleCdn.length){loadScript(0);return;} const l=document.createElement('link');l.rel='stylesheet';l.href=styleCdn[i];l.setAttribute('data-ckeditor-style','true');l.onload=()=>loadScript(0);l.onerror=()=>{l.remove();loadStyle(i+1);};document.head.appendChild(l); }
    loadStyle(0);
});
</script>
}
