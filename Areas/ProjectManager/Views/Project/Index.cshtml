@model project_lifecycle.ViewModels.ProjectManager.ProjectIndexViewModel
@{
    ViewData["Title"] = "My Projects";
}

<!-- ===== Page Title Hero ===== -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-diagram-project"></i></span>
                My Projects
            </h1>
            <p class="emp-page-subtitle">Projects assigned to you by the department head</p>
        </div>
    </div>
</div>

<!-- ===== Alerts ===== -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="emp-alert emp-alert-success">
        <div class="emp-alert-icon"><i class="fas fa-check-circle"></i></div>
        <span>@TempData["SuccessMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="emp-alert emp-alert-error">
        <div class="emp-alert-icon"><i class="fas fa-exclamation-circle"></i></div>
        <span>@TempData["ErrorMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}

<!-- ===== Filters ===== -->
<div class="emp-filters-card">
    <div class="emp-filters-row">
        <div class="emp-search-group">
            <i class="fas fa-magnifying-glass emp-search-icon"></i>
            <input id="projectSearch" type="text" class="emp-search-input" placeholder="Search projects…" autocomplete="off" />
        </div>
        <div class="emp-select-group">
            <select id="archiveFilter" class="emp-select">
                <option value="active" selected>Active</option>
                <option value="inactive">Archived</option>
                <option value="all">All</option>
            </select>
        </div>
        <div class="emp-select-group">
            <label for="pageSizeSelect" style="font-size:.82rem;color:#64748b;margin-right:.4rem;">Show</label>
            <select id="pageSizeSelect" class="emp-select" style="width:92px;">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
    </div>
</div>

<!-- ===== Table ===== -->
<div class="project-table-section">
    <div class="project-table-card">
        @if (Model.Projects.Any())
        {
            <div class="project-table-responsive">
                <table class="project-table" id="projectsTable">
                    <thead>
                        <tr>
                            <th>Project</th>
                            <th>Proposal</th>
                            <th>Timeline</th>
                            <th>Members</th>
                            <th>Milestones</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="projectsBody">
                        @foreach (var project in Model.Projects)
                        {
                            var duration = (project.EndDate - project.StartDate).Days;
                            var activeProjMilestones = project.Milestones.Count(m => m.Status == "In Progress");
                            <tr class="emp-row" data-name="@project.Name.ToLower()" data-archived="@(project.IsArchived ? "true" : "false")">
                                <td>
                                    <div class="project-name-cell">
                                        <div class="project-name-icon">
                                            <i class="fas fa-diagram-project"></i>
                                        </div>
                                        <div>
                                            <div class="project-name-text">@project.Name</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="project-date">@project.ProposalTitle</td>
                                <td>
                                    <div class="project-timeline">
                                        <span class="project-timeline-dates">
                                            @project.StartDate.ToString("MMM dd, yyyy") &rarr; @project.EndDate.ToString("MMM dd, yyyy")
                                        </span>
                                        <span class="project-timeline-duration">@duration days</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="project-member-count">
                                        <i class="fas fa-users"></i> @project.Members.Count
                                    </span>
                                </td>
                                <td>
                                    <div style="display:flex;flex-direction:column;gap:.2rem;width:fit-content;">
                                        <span class="project-member-count">
                                            <i class="fas fa-flag-checkered"></i> @project.Milestones.Count total
                                        </span>
                                        @if (activeProjMilestones > 0)
                                        {
                                            <span style="font-size:.72rem;color:#f59e0b;font-weight:600;">
                                                <i class="fas fa-spinner"></i> @activeProjMilestones active
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div style="display:inline-flex;align-items:center;gap:.35rem;">
                                        <a asp-area="ProjectManager" asp-controller="Project" asp-action="Details" asp-route-id="@project.Id"
                                           class="emp-action-btn emp-action-view" title="View details"
                                           style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:6px;background:#f1f5f9;color:#3b82f6;text-decoration:none;cursor:pointer;transition:all 0.2s ease;">
                                            <i class="fas fa-magnifying-glass"></i>
                                        </a>
                                        @if (!project.IsArchived)
                                        {
                                            <form asp-area="ProjectManager" asp-controller="Project" asp-action="Archive" method="post" class="emp-action-form" onclick="return confirm('Archive this project?');" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@project.Id" />
                                                <button type="submit" class="emp-action-btn emp-action-archive" title="Archive"
                                                        style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:6px;background:#f1f5f9;color:#ea580c;border:none;cursor:pointer;transition:all 0.2s ease;">
                                                    <i class="fas fa-box-archive"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-area="ProjectManager" asp-controller="Project" asp-action="Unarchive" method="post" class="emp-action-form" onclick="return confirm('Unarchive this project?');" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@project.Id" />
                                                <button type="submit" class="emp-action-btn emp-action-unarchive" title="Unarchive"
                                                        style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:6px;background:#f1f5f9;color:#059669;border:none;cursor:pointer;transition:all 0.2s ease;">
                                                    <i class="fas fa-box-open"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="noFilterResults" class="project-empty-state" style="display:none;">
                <div class="project-empty-icon"><i class="fas fa-magnifying-glass"></i></div>
                <div class="project-empty-title">No matching projects</div>
                <div class="project-empty-text">Try adjusting your search or filters.</div>
            </div>

            <div class="emp-pagination" id="paginationContainer">
                <div class="emp-pagination-info" id="paginationInfo"></div>
                <div class="emp-pagination-controls" id="paginationControls"></div>
            </div>
        }
        else
        {
            <div class="project-empty-state">
                <div class="project-empty-icon"><i class="fas fa-folder-open"></i></div>
                <div class="project-empty-title">No assigned projects</div>
                <div class="project-empty-text">Projects assigned to you by the department head will appear here.</div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
(function () {
    let PAGE_SIZE = 10;
    let currentPage = 1;
    let filteredRows = [];

    const searchInput    = document.getElementById('projectSearch');
    const allRows        = Array.from(document.querySelectorAll('.emp-row'));
    const noResults      = document.getElementById('noFilterResults');
    const pageInfo       = document.getElementById('paginationInfo');
    const pageControls   = document.getElementById('paginationControls');
    const pageSizeSelect = document.getElementById('pageSizeSelect');
    const archiveSelect  = document.getElementById('archiveFilter');

    function applyFilters() {
        const query = (searchInput?.value ?? '').toLowerCase().trim();
        const archiveFilter = archiveSelect?.value ?? 'active';
        filteredRows = allRows.filter(row => {
            const nameMatch = !query || (row.dataset.name || '').includes(query);
            const isArchived = row.dataset.archived === 'true';
            let archiveMatch = true;
            if (archiveFilter === 'active') archiveMatch = !isArchived;
            else if (archiveFilter === 'inactive') archiveMatch = isArchived;
            return nameMatch && archiveMatch;
        });
        currentPage = 1;
        render();
    }

    function render() {
        const total      = filteredRows.length;
        const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
        currentPage      = Math.min(currentPage, totalPages);
        const start = (currentPage - 1) * PAGE_SIZE;
        const end   = start + PAGE_SIZE;

        allRows.forEach(r => r.style.display = 'none');
        filteredRows.forEach((r, i) => { r.style.display = (i >= start && i < end) ? '' : 'none'; });

        if (noResults)  noResults.style.display  = total === 0 ? '' : 'none';
        if (pageInfo)   pageInfo.textContent      = total === 0 ? '' : `Showing ${start + 1}\u2013${Math.min(end, total)} of ${total}`;

        if (pageControls) {
            pageControls.innerHTML = '';
            const makeBtn = (label, page, disabled, active) => {
                const btn = document.createElement('button');
                btn.className = 'emp-page-btn' + (active ? ' active' : '');
                btn.innerHTML = label;
                btn.disabled  = disabled;
                btn.addEventListener('click', () => { currentPage = page; render(); });
                return btn;
            };
            pageControls.appendChild(makeBtn('<i class="fas fa-chevron-left"></i>', currentPage - 1, currentPage === 1, false));
            const w = 2;
            for (let p = 1; p <= totalPages; p++) {
                if (p === 1 || p === totalPages || (p >= currentPage - w && p <= currentPage + w)) {
                    pageControls.appendChild(makeBtn(p, p, false, p === currentPage));
                } else if (p === currentPage - w - 1 || p === currentPage + w + 1) {
                    const el = document.createElement('span');
                    el.className = 'emp-page-ellipsis';
                    el.textContent = '\u2026';
                    pageControls.appendChild(el);
                }
            }
            pageControls.appendChild(makeBtn('<i class="fas fa-chevron-right"></i>', currentPage + 1, currentPage === totalPages, false));
        }
    }

    if (searchInput)    searchInput.addEventListener('input', applyFilters);
    if (archiveSelect)  archiveSelect.addEventListener('change', applyFilters);
    if (pageSizeSelect) {
        pageSizeSelect.value = String(PAGE_SIZE);
        pageSizeSelect.addEventListener('change', function () {
            PAGE_SIZE = Math.max(5, parseInt(this.value, 10) || 10);
            currentPage = 1;
            render();
        });
    }

    filteredRows = allRows.slice();
    applyFilters();  // Apply default "Active" filter on page load
})();
</script>
}

