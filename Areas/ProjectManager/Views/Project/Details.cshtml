@model project_lifecycle.ViewModels.ProjectManager.ProjectManageViewModel
@{
    ViewData["Title"] = Model.Project.Name;
    var duration    = (Model.Project.EndDate - Model.Project.StartDate).Days;
    // Exclude archived milestones from counts and progress calculation
    var totalMs     = Model.Project.Milestones.Count(m => !m.IsArchived);
    var finishedMs  = Model.Project.Milestones.Count(m => !m.IsArchived && m.Status == "Finished");
    var pct         = totalMs > 0 ? (int)Math.Round((double)finishedMs / totalMs * 100) : 0;
    var nextOrder   = Model.Project.Milestones.Any(m => !m.IsArchived) ? Model.Project.Milestones.Where(m => !m.IsArchived).Max(m => m.SequenceOrder) + 1 : 1;
}

<style>
    /* Page-specific: modal + delete action + step chip (not in shared CSS) */
    .pm-modal-backdrop { display:none; position:fixed; inset:0; background:rgba(0,105,148,.25); backdrop-filter:blur(4px); z-index:1040; align-items:center; justify-content:center; }
    .pm-modal-backdrop.open { display:flex; }
    .pm-modal { background:#fff; border-radius:16px; width:100%; max-width:480px; box-shadow:0 25px 60px rgba(0,105,148,.15); overflow:hidden; animation:pmModalIn .25s ease; }
    @@keyframes pmModalIn { from{opacity:0;transform:translateY(-16px) scale(.97)} to{opacity:1;transform:translateY(0) scale(1)} }
    .pm-modal-header { display:flex; align-items:center; justify-content:space-between; padding:1rem 1.5rem; background:linear-gradient(135deg,#f0f7fc,#e8f4fb); border-bottom:1px solid rgba(0,105,148,.08); }
    .pm-modal-title { font-weight:700; font-size:.95rem; color:var(--emp-ocean); display:flex; align-items:center; gap:.5rem; }
    .pm-modal-close { background:none; border:none; font-size:1.1rem; color:#94a3b8; cursor:pointer; padding:.3rem .45rem; border-radius:8px; transition:all .2s; }
    .pm-modal-close:hover { background:rgba(0,105,148,.06); color:var(--emp-ocean); }
    .pm-modal-body { padding:1.5rem; }
    .pm-modal-footer { padding:.75rem 1.5rem 1.25rem; display:flex; gap:.6rem; justify-content:flex-end; }
    .emp-action-delete { color:#ef4444; border-color:rgba(239,68,68,.15); }
    .emp-action-delete:hover { background:linear-gradient(135deg,#ef4444,#f87171); color:#fff; border-color:transparent; box-shadow:0 4px 14px rgba(239,68,68,.25); }
    .pm-step-chip { font-size:.65rem; font-weight:800; color:var(--emp-ocean); background:rgba(0,105,148,.06); padding:.2rem .5rem; border-radius:5px; letter-spacing:.4px; white-space:nowrap; }
    .pm-member-actions { display:flex; gap:.25rem; flex-shrink:0; margin-left:auto; }
    /* Use milestone card action button design for team member actions */
    .emp-member-stack .pm-member-actions .emp-action-btn {
        width:36px;
        height:36px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        border-radius:10px;
        border:1px solid rgba(14,165,233,0.08);
        background:#fff;
        box-shadow:none;
        padding:0;
        transition:all .15s ease;
        color:inherit;
        margin-left:.4rem;
    }
    .emp-member-stack .pm-member-actions .emp-action-btn i { font-size:0.95rem; }
    .emp-member-stack .pm-member-actions .emp-action-btn:hover { transform:translateY(-1px); box-shadow:0 6px 18px rgba(3,102,214,0.06); }
    .emp-member-stack .pm-member-actions .emp-action-edit i { color:#2563eb; }
    .emp-member-stack .pm-member-actions .emp-action-delete i { color:#ef4444; }
    /* Compact member row adjustments */
    .emp-member-stack { padding: .25rem 0; }
    .emp-member-row { display:flex; align-items:center; gap:.6rem; padding:.45rem .6rem; border-radius:10px; }
    .emp-member-row + .emp-member-row { margin-top:.35rem; }
    .emp-member-avatar { width:40px; height:40px; flex:0 0 40px; border-radius:8px; overflow:hidden; }
    .emp-member-avatar img { width:100%; height:100%; object-fit:cover; display:block; }
    .emp-member-info { min-width:0; }
    .emp-member-name { display:block; font-size:.95rem; font-weight:700; line-height:1.05; color:#0f172a; }
    .emp-member-name { display:block; font-size:.88rem; font-weight:500; line-height:1.05; color:#0f172a; }
    .emp-member-role { display:block; font-size:.76rem; color:#64748b; margin-top:2px; }
    .pm-member-actions { gap:.25rem; }
    .emp-member-stack .pm-member-actions .emp-action-btn { width:32px; height:32px; border-radius:8px; }
    .emp-member-stack .pm-member-actions .emp-action-btn i{ font-size:0.85rem; }
</style>

<!-- ===== Page Hero ===== -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-diagram-project"></i></span>
                @Model.Project.Name
            </h1>
            <p class="emp-page-subtitle">Proposal: @Model.Project.ProposalTitle</p>
        </div>

<!-- Confirmation modal for remove member -->
<div class="emp-modal-backdrop" id="confirmRemoveModal" role="dialog" aria-modal="true" aria-hidden="true" style="display:none;">
    <div class="emp-modal" role="document">
        <h4 id="confirmRemoveTitle"><i class="fas fa-exclamation-triangle"></i> Confirm</h4>
        <p id="confirmRemoveMessage">Are you sure?</p>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn emp-btn-cancel" id="confirmRemoveCancel">Cancel</button>
            <button type="button" class="emp-btn emp-btn-confirm" id="confirmRemoveConfirm">Remove</button>
        </div>
    </div>
</div>

<!-- Archive confirmation modal for milestones -->
<div class="emp-modal-backdrop" id="archiveConfirmModal" role="dialog" aria-modal="true" aria-hidden="true" style="display:none;" onclick="if(event.target === this) closeArchiveModal()">
    <div class="emp-modal" role="document">
        <h4 id="archiveConfirmTitle"><i class="fas fa-archive"></i> Confirm Archive</h4>
        <p id="archiveConfirmMessage">Archive this milestone?</p>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn emp-btn-cancel" id="archiveCancelBtn" onclick="closeArchiveModal()">Cancel</button>
            <button type="button" class="emp-btn emp-btn-confirm emp-btn-danger" id="archiveConfirmBtn" onclick="confirmArchive()">Archive</button>
        </div>
    </div>
</div>

<!-- Unarchive confirmation modal for milestones -->
<div class="emp-modal-backdrop" id="unarchiveConfirmModal" role="dialog" aria-modal="true" aria-hidden="true" style="display:none;" onclick="if(event.target === this) closeUnarchiveModal()">
    <div class="emp-modal" role="document">
        <h4 id="unarchiveConfirmTitle"><i class="fas fa-box-open"></i> Confirm Unarchive</h4>
        <p id="unarchiveConfirmMessage">Unarchive this milestone?</p>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn emp-btn-cancel" id="unarchiveCancelBtn" onclick="closeUnarchiveModal()">Cancel</button>
            <button type="button" class="emp-btn emp-btn-confirm emp-btn-primary" id="unarchiveConfirmBtn" onclick="confirmUnarchive()">Unarchive</button>
        </div>
    </div>
</div>
        <div class="emp-page-hero-right" style="display:flex;gap:.6rem;flex-wrap:wrap;">
            <button type="button" class="emp-btn emp-btn-outline" onclick="openModal('membersModal')">
                <i class="fas fa-user-plus"></i>
                <span>Add Member</span>
            </button>
            <button type="button" class="emp-btn emp-btn-outline" onclick="openModal('milestonesModal')">
                <i class="fas fa-flag-checkered"></i>
                <span>Add Milestone</span>
            </button>
            <a asp-area="ProjectManager" asp-controller="Project" asp-action="Index" class="emp-btn emp-btn-outline">
                <i class="fas fa-arrow-left"></i>
                <span>Back to Projects</span>
            </a>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="emp-alert emp-alert-success">
        <i class="fas fa-check-circle emp-alert-icon"></i>
        <span>@TempData["SuccessMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="emp-alert emp-alert-error">
        <i class="fas fa-exclamation-circle emp-alert-icon"></i>
        <span>@TempData["ErrorMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}

<!-- ===== Info strip ===== -->
<div class="emp-info-strip">
    <div class="emp-info-item">
        <i class="fas fa-calendar-days"></i>
        <span>@Model.Project.StartDate.ToString("MMM dd, yyyy") &ndash; @Model.Project.EndDate.ToString("MMM dd, yyyy")</span>
    </div>
    <div class="emp-info-item">
        <i class="fas fa-clock"></i>
        <span>@duration days</span>
    </div>
    <div class="emp-info-item">
        <i class="fas fa-users"></i>
        <span>@Model.Project.Members.Count member@(Model.Project.Members.Count == 1 ? "" : "s")</span>
    </div>
    <div class="emp-info-item">
        <i class="fas fa-flag-checkered"></i>
        <span>@finishedMs / @totalMs milestones completed</span>
    </div>
    @if (totalMs > 0)
    {
        <div class="emp-info-progress">
            <div class="emp-info-progress-bar">
                <div class="emp-info-progress-fill" style="width:@pct%"></div>
            </div>
            <span class="emp-info-progress-label">@pct%</span>
        </div>
    }
</div>

<div class="emp-show-grid">

    <!-- ===== Milestones card ===== -->
    <div class="emp-show-tasks-card">
        <div class="emp-table-toolbar">
            <div class="emp-table-toolbar-left">
                <h3 class="emp-table-title"><i class="fas fa-flag-checkered"></i> Project Milestones</h3>
                <span class="emp-count-chip">@totalMs</span>
            </div>
            <div style="display:flex;align-items:center;gap:.6rem;">
                <div style="display:flex;align-items:center;gap:.4rem;">
                    <select id="milestoneArchiveFilter" class="emp-select">
                        <option value="active" selected>Active</option>
                        <option value="archived">Archived</option>
                        <option value="all">All</option>
                    </select>
                </div>
            </div>
        </div>

        @if (Model.Project.Milestones.Any())
        {
            <div class="emp-task-list" id="milestonesList">
                @foreach (var ms in Model.Project.Milestones.OrderBy(m => m.IsArchived).ThenBy(m => m.SequenceOrder))
                {
                    <div class="emp-task-row emp-milestone-row" data-archived="@(ms.IsArchived ? "true" : "false")">
                        <div class="emp-task-row-left">
                            <span class="emp-task-status-dot @MsDotClass(ms.Status)"></span>
                            <div class="emp-task-info">
                                <span class="emp-task-name">@ms.MilestoneName</span>
                                <span class="emp-task-dates">
                                    @if (ms.SequenceOrder > 0)
                                    {
                                        <span class="pm-step-chip">STEP @ms.SequenceOrder</span>
                                    }
                                    else
                                    {
                                        <span class="pm-step-chip" style="opacity:.7;background:rgba(120,120,120,.06);">ARCHIVED</span>
                                    }
                                </span>
                            </div>
                        </div>
                        <div class="emp-task-row-right">
                            <span class="emp-badge-white" title="Status">
                                <span class="emp-status-inline @MsBadgeClass(ms.Status)">
                                    <span class="emp-status-dot"></span>
                                    <span class="emp-status-text">@ms.Status</span>
                                </span>
                            </span>
                            <a asp-area="ProjectManager" asp-controller="Project" asp-action="Milestone"
                               asp-route-projectMilestoneId="@ms.Id"
                               class="emp-action-btn emp-action-view" title="View Milestone">
                                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                            </a>
                            <button type="button" class="emp-action-btn emp-action-edit" title="Edit"
                                    onclick="editMilestone(@ms.Id, '@ms.MilestoneId', '@ms.SequenceOrder', 'milestonesModal')">
                                <i class="fas fa-pen-to-square"></i>
                            </button>
                            @if (!ms.IsArchived)
                            {
                                <form asp-area="ProjectManager" asp-controller="Project" asp-action="ArchiveProjectMilestone" method="post" style="margin:0;display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="projectMilestoneId" value="@ms.Id" />
                                    <button type="button" class="emp-action-btn emp-action-archive" title="Archive"
                                            data-ms-name="@ms.MilestoneName"
                                            onclick="openArchiveModal(this.form, this.getAttribute('data-ms-name'))">
                                        <i class="fas fa-archive"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-area="ProjectManager" asp-controller="Project" asp-action="UnarchiveProjectMilestone" method="post" style="margin:0;display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="projectMilestoneId" value="@ms.Id" />
                                    <button type="button" class="emp-action-btn emp-action-unarchive" title="Unarchive"
                                            data-ms-name="@ms.MilestoneName"
                                            onclick="openUnarchiveModal(this.form, this.getAttribute('data-ms-name'))">
                                        <i class="fas fa-box-open"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="emp-empty-state">
                <div class="emp-empty-icon"><i class="fas fa-flag-checkered"></i></div>
                <h4 class="emp-empty-title">No milestones yet</h4>
                <p class="emp-empty-text">Start building your project timeline by adding milestones.</p>
            </div>
        }
    </div>

    <!-- ===== Side panel ===== -->
    <div class="emp-show-side">

        <!-- Team Members -->
        <div class="emp-side-card">
            <div class="emp-side-card-title">
                <i class="fas fa-users"></i> Team Members
                <span class="emp-count-chip" style="margin-left:auto;">@Model.Project.Members.Count</span>
            </div>
            <div style="margin-top:.6rem;">
                <input id="memberSearch" type="text" class="emp-search-input" placeholder="Search members…" style="width:100%;padding:.45rem .6rem;font-size:.88rem;" />
            </div>
            @if (Model.Project.Members.Any())
            {
                <div class="emp-member-stack">
                    @foreach (var m in Model.Project.Members)
                    {
                        <div class="emp-member-row" data-name="@((m.EmployeeName ?? "").ToLower())">
                            <div class="emp-member-avatar">
                                @if (!string.IsNullOrWhiteSpace(m.ProfileImage))
                                {
                                    <img src="@Url.Content(m.ProfileImage)" alt="@m.EmployeeName" style="width:100%;height:100%;border-radius:8px;object-fit:cover;display:block;" />
                                }
                                else
                                {
                                    @m.EmployeeName.Substring(0, 1).ToUpper()
                                }
                            </div>
                            <div class="emp-member-info">
                                <span class="emp-member-name">@m.EmployeeName</span>
                                <span class="emp-member-role">@m.ProjectRoleName</span>
                            </div>
                            <div class="pm-member-actions">
                                <button type="button" class="emp-action-btn emp-action-edit" title="Edit" onclick="editMember(@m.Id, '@m.EmployeeId', '@m.ProjectRoleId', 'membersModal')">
                                    <i class="fas fa-pen-to-square"></i>
                                </button>
                                <form asp-area="ProjectManager" asp-controller="Project" asp-action="RemoveMember" method="post" style="margin:0;" class="remove-member-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="memberId" value="@m.Id" />
                                    <button type="button" class="emp-action-btn emp-action-delete remove-member-btn" title="Remove"
                                            data-member-name="@m.EmployeeName">
                                        <i class="fas fa-xmark" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="emp-empty-state" style="padding:1.5rem;">
                    <div class="emp-empty-icon"><i class="fas fa-user-plus"></i></div>
                    <h4 class="emp-empty-title">No team members</h4>
                    <p class="emp-empty-text">Add people to get started.</p>
                </div>
            }
        </div>

        
    </div>

</div>

<!-- ===== Members Modal ===== -->
<div class="pm-modal-backdrop" id="membersModal" onclick="closeOnBackdrop(event,'membersModal')">
    <div class="pm-modal">
        <div class="pm-modal-header">
            <div class="pm-modal-title"><i class="fas fa-user-plus"></i> <span id="memberModalTitle">Add Team Member</span></div>
            <button class="pm-modal-close" onclick="closeModal('membersModal')">&times;</button>
        </div>
        <form asp-area="ProjectManager" asp-controller="Project" asp-action="AddMember" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ProjectId" value="@Model.Project.Id" />
            <input type="hidden" id="editMemberId" name="MemberId" value="" />
            <div class="pm-modal-body">
                <div class="emp-form-row">
                    <label class="emp-form-label">Employee</label>
                    <input type="hidden" id="memberEmployeeSelect" name="EmployeeId" value="" />
                    <input type="text" id="memberEmployeeDisplay" class="emp-form-control" placeholder="Click to select an employee\u2026" readonly style="cursor:pointer;" />
                </div>
                <div class="emp-form-row">
                    <label class="emp-form-label">Project Role</label>
                    <input type="hidden" id="memberRoleSelect" name="ProjectRoleId" value="" />
                    <input type="text" id="memberRoleDisplay" class="emp-form-control" placeholder="Click to select a role\u2026" readonly style="cursor:pointer;" />
                </div>
            </div>
            <div class="pm-modal-footer">
                <button type="button" class="emp-btn emp-btn-secondary" onclick="closeModal('membersModal')">Cancel</button>
                <button type="submit" id="memberSubmitBtn" class="emp-btn emp-btn-primary"><i class="fas fa-plus"></i> <span id="memberSubmitText">Add Member</span></button>
            </div>
        </form>
    </div>
</div>

<!-- ===== Milestones Modal ===== -->
<div class="pm-modal-backdrop" id="milestonesModal" onclick="closeOnBackdrop(event,'milestonesModal')">
    <div class="pm-modal">
        <div class="pm-modal-header">
            <div class="pm-modal-title"><i class="fas fa-flag-checkered"></i> <span id="milestoneModalTitle">Add Milestone</span></div>
            <button class="pm-modal-close" onclick="closeModal('milestonesModal')">&times;</button>
        </div>
        <form asp-area="ProjectManager" asp-controller="Project" asp-action="AddMilestone" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ProjectId" value="@Model.Project.Id" />
            <input type="hidden" id="editProjectMilestoneId" name="ProjectMilestoneId" value="" />
            <div class="pm-modal-body">
                <div class="emp-form-row">
                    <label class="emp-form-label">Milestone Template</label>
                    <input type="hidden" id="milestoneSelect" name="MilestoneId" value="" />
                    <input type="text" id="milestoneDisplay" class="emp-form-control" placeholder="Click to select a milestone template\u2026" readonly style="cursor:pointer;" />
                </div>
                <div class="emp-form-row">
                    <label class="emp-form-label">Sequence Order</label>
                    <input id="sequenceOrderInput" name="SequenceOrder" type="number" min="1" class="emp-form-control"
                           value="@nextOrder" required />
                    <span style="font-size:.75rem;color:#64748b;margin-top:.15rem;">Order determines the milestone's position in the timeline.</span>
                </div>
            </div>
            <div class="pm-modal-footer">
                <button type="button" class="emp-btn emp-btn-secondary" onclick="closeModal('milestonesModal')">Cancel</button>
                <button type="submit" id="milestoneSubmitBtn" class="emp-btn emp-btn-primary"><i class="fas fa-plus"></i> <span id="milestoneSubmitText">Add Milestone</span></button>
            </div>
        </form>
    </div>
</div>

@functions {
    private string MsBadgeClass(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "emp-status-default";
        var key = s.Trim().ToLowerInvariant();
        return key switch
        {
            "completed"         => "emp-status-approved",
            "checked"           => "emp-status-approved",
            "finished"          => "emp-status-approved",
            "in progress"       => "emp-status-revision",
            "requires revision" => "emp-status-revision",
            "require revision"  => "emp-status-revision",
            "pending"           => "emp-status-pending",
            _                   => "emp-status-default"
        };
    }

    private string MsDotClass(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "emp-dot-gray";
        var key = s.Trim().ToLowerInvariant();
        return key switch
        {
            "completed"         => "emp-dot-green",
            "checked"           => "emp-dot-green",
            "finished"          => "emp-dot-green",
            "in progress"       => "emp-dot-orange",
            "requires revision" => "emp-dot-orange",
            "require revision"  => "emp-dot-orange",
            _                   => "emp-dot-gray"
        };
    }

    private string MsSideDotClass(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "emp-ms-dot-idle";
        var key = s.Trim().ToLowerInvariant();
        return key switch
        {
            "completed"         => "emp-ms-dot-done",
            "checked"           => "emp-ms-dot-done",
            "finished"          => "emp-ms-dot-done",
            "in progress"       => "emp-ms-dot-active",
            "requires revision" => "emp-ms-dot-active",
            "require revision"  => "emp-ms-dot-active",
            _                   => "emp-ms-dot-idle"
        };
    }
}

@section Scripts {
<script>
function openModal(id) {
    document.getElementById(id).classList.add('open');
    document.body.style.overflow = 'hidden';
}

function closeModal(id) {
    document.getElementById(id).classList.remove('open');
    document.body.style.overflow = '';
    resetModals();
}

function closeOnBackdrop(e, id) {
    if (e.target === document.getElementById(id)) closeModal(id);
}

function resetModals() {
    document.getElementById('editMemberId').value = '';
    document.getElementById('memberEmployeeSelect').value = '';
    var empDisp = document.getElementById('memberEmployeeDisplay'); if (empDisp) empDisp.value = '';
    document.getElementById('memberRoleSelect').value = '';
    var roleDisp = document.getElementById('memberRoleDisplay'); if (roleDisp) roleDisp.value = '';
    document.getElementById('memberSubmitText').textContent = 'Add Member';
    document.getElementById('memberModalTitle').textContent = 'Add Team Member';
    document.getElementById('memberSubmitBtn').innerHTML = '<i class="fas fa-plus"></i> <span id="memberSubmitText">Add Member</span>';

    document.getElementById('editProjectMilestoneId').value = '';
    document.getElementById('milestoneSelect').value = '';
    var msDisp = document.getElementById('milestoneDisplay'); if (msDisp) msDisp.value = '';
    document.getElementById('sequenceOrderInput').value = '@nextOrder';
    document.getElementById('milestoneSubmitText').textContent = 'Add Milestone';
    document.getElementById('milestoneModalTitle').textContent = 'Add Milestone';
    document.getElementById('milestoneSubmitBtn').innerHTML = '<i class="fas fa-plus"></i> <span id="milestoneSubmitText">Add Milestone</span>';
}

function editMember(memberId, employeeId, projectRoleId, modalId) {
    document.getElementById('editMemberId').value = memberId;
    // set hidden values and update display text from pre-built data arrays
    var empHid = document.getElementById('memberEmployeeSelect');
    var empDisp = document.getElementById('memberEmployeeDisplay');
    if (empHid) empHid.value = employeeId;
    if (empDisp && window._pmEmployees) {
        var found = window._pmEmployees.find(function(e){ return String(e.id) === String(employeeId); });
        empDisp.value = found ? found.name : '';
    }
    var roleHid = document.getElementById('memberRoleSelect');
    var roleDisp = document.getElementById('memberRoleDisplay');
    if (roleHid) roleHid.value = projectRoleId;
    if (roleDisp && window._pmRoles) {
        var found2 = window._pmRoles.find(function(r){ return String(r.id) === String(projectRoleId); });
        roleDisp.value = found2 ? found2.name : '';
    }
    document.getElementById('memberSubmitText').textContent = 'Update Member';
    document.getElementById('memberModalTitle').textContent = 'Edit Team Member';
    document.getElementById('memberSubmitBtn').innerHTML = '<i class="fas fa-check"></i> <span id="memberSubmitText">Update Member</span>';
    openModal(modalId);
}

function editMilestone(projectMilestoneId, milestoneId, sequenceOrder, modalId) {
    document.getElementById('editProjectMilestoneId').value = projectMilestoneId;
    var msHid = document.getElementById('milestoneSelect');
    var msDisp = document.getElementById('milestoneDisplay');
    if (msHid) msHid.value = milestoneId;
    if (msDisp && window._pmMilestones) {
        var found = window._pmMilestones.find(function(m){ return String(m.id) === String(milestoneId); });
        msDisp.value = found ? found.name : '';
    }
    document.getElementById('sequenceOrderInput').value = sequenceOrder;
    document.getElementById('milestoneSubmitText').textContent = 'Update Milestone';
    document.getElementById('milestoneModalTitle').textContent = 'Edit Milestone';
    document.getElementById('milestoneSubmitBtn').innerHTML = '<i class="fas fa-check"></i> <span id="milestoneSubmitText">Update Milestone</span>';
    openModal(modalId);
}

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        document.querySelectorAll('.pm-modal-backdrop.open').forEach(m => {
            m.classList.remove('open');
        });
        document.body.style.overflow = '';
        resetModals();
    }
});
</script>

<script>
// ── Table-picker modals for Members & Milestone forms ──────────────────
(function () {
    window._pmEmployees = [
        @foreach (var e in Model.AvailableEmployeePicker) {
            @Html.Raw("{id:" + e.Id + ",name:'" + e.Name.Replace("\\", "\\\\").Replace("'", "\\'") + "',deptId:" + e.DeptId + ",deptName:'" + e.DeptName.Replace("\\", "\\\\").Replace("'", "\\'") + "'},")
        }
    ];
    window._pmEmployeeDepts = (function(){
        var seen = {}, list = [];
        window._pmEmployees.forEach(function(e){ if (e.deptId && !seen[e.deptId]) { seen[e.deptId] = true; list.push({id: e.deptId, name: e.deptName}); } });
        list.sort(function(a,b){ return a.name.localeCompare(b.name); });
        return list;
    })();
    window._pmRoles = [
        @foreach (var r in Model.AvailableProjectRoles) {
            @Html.Raw("{id:" + r.Value + ",name:'" + r.Text.Replace("\\", "\\\\").Replace("'", "\\'") + "'},")
        }
    ];
    window._pmMilestones = [
        @foreach (var t in Model.AvailableMilestones) {
            @Html.Raw("{id:" + t.Value + ",name:'" + t.Text.Replace("\\", "\\\\").Replace("'", "\\'") + "'},")
        }
    ];

    function escH(str) {
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(str || ''));
        return d.innerHTML;
    }

    function buildPickerModal(cfg) {
        // cfg: { modalId, title, subtitle, colHeader, data, key, hiddenId, displayId }
        document.body.insertAdjacentHTML('beforeend',
            '<div class="modal fade" id="' + cfg.modalId + '" tabindex="-1" aria-hidden="true" style="z-index:1060;">'
            + '<div class="modal-dialog modal-dialog-centered modal-lg">'
            + '<div class="modal-content em-picker-modal">'
            + '<div class="em-picker-header">'
            + '<div><h5 class="em-picker-title"><i class="fas fa-table-list"></i> ' + cfg.title + '</h5>'
            + '<p class="em-picker-subtitle">' + cfg.subtitle + '</p></div>'
            + '<button type="button" class="btn-close btn-close-white" id="' + cfg.modalId + 'Close" aria-label="Close"></button>'
            + '</div>'
            + '<div class="em-picker-filters"><div class="em-picker-filters-row">'
            + '<div class="em-picker-search-group"><i class="fas fa-magnifying-glass em-picker-search-icon"></i>'
            + '<input type="text" id="' + cfg.modalId + 'Filter" class="em-picker-search-input" placeholder="Search\u2026" autocomplete="off" />'
            + '</div>'
            + (cfg.depts && cfg.depts.length ? '<div class="em-picker-search-group" style="max-width:220px;margin-left:auto;"><select id="' + cfg.modalId + 'DeptFilter" class="em-picker-search-input" style="cursor:pointer;padding-left:.6rem;"></select></div>' : '')
            + '</div></div>'
            + '<div class="modal-body em-picker-body"><div class="em-picker-table-card">'
            + '<div class="em-picker-table-responsive">'
            + '<table class="em-picker-table" id="' + cfg.modalId + 'Table">'
            + '<thead><tr><th>' + cfg.colHeader + '</th><th style="width:100px;text-align:center;">Action</th></tr></thead>'
            + '<tbody></tbody></table></div>'
            + '<div id="' + cfg.modalId + 'Empty" class="em-picker-empty" style="display:none;">'
            + '<div class="em-picker-empty-icon"><i class="fas fa-magnifying-glass"></i></div>'
            + '<div class="em-picker-empty-title">No matches</div></div>'
            + '<div class="em-picker-pagination"><div class="em-picker-pagination-info" id="' + cfg.modalId + 'Info"></div></div>'
            + '</div></div>'
            + '<div class="em-picker-footer">'
            + '<button type="button" class="em-picker-btn-cancel" id="' + cfg.modalId + 'Cancel">Cancel</button>'
            + '</div>'
            + '</div></div></div>'
        );

        var modalEl   = document.getElementById(cfg.modalId);
        var tableEl   = document.getElementById(cfg.modalId + 'Table');
        var emptyEl   = document.getElementById(cfg.modalId + 'Empty');
        var filterEl  = document.getElementById(cfg.modalId + 'Filter');
        var infoEl    = document.getElementById(cfg.modalId + 'Info');
        var closeBtn  = document.getElementById(cfg.modalId + 'Close');
        var cancelBtn = document.getElementById(cfg.modalId + 'Cancel');
        var deptFilterEl = (cfg.depts && cfg.depts.length) ? document.getElementById(cfg.modalId + 'DeptFilter') : null;
        if (deptFilterEl) {
            var allOpt = document.createElement('option'); allOpt.value = ''; allOpt.textContent = 'All Departments'; deptFilterEl.appendChild(allOpt);
            cfg.depts.forEach(function(d) { var o = document.createElement('option'); o.value = String(d.id); o.textContent = d.name; deptFilterEl.appendChild(o); });
        }

        function showPicker() {
            // Use Bootstrap if available, else manual approach
            if (window.bootstrap && window.bootstrap.Modal) {
                new window.bootstrap.Modal(modalEl).show();
            } else {
                modalEl.style.cssText = 'display:block;position:fixed;left:0;top:0;width:100%;height:100%;z-index:1060;';
                modalEl.classList.add('show');
                document.body.style.overflow = 'hidden';
            }
        }

        function hidePicker() {
            if (window.bootstrap && window.bootstrap.Modal) {
                var inst = window.bootstrap.Modal.getInstance(modalEl);
                if (inst) inst.hide(); else { modalEl.style.display = 'none'; modalEl.classList.remove('show'); }
            } else {
                modalEl.style.display = 'none';
                modalEl.classList.remove('show');
                modalEl.style.zIndex = '';
                document.body.style.overflow = '';
            }
        }

        function renderRows(q, deptId) {
            var tbody = tableEl.querySelector('tbody');
            tbody.innerHTML = '';
            q = (q || '').toLowerCase().trim();
            deptId = deptId ? String(deptId) : '';
            var hidEl = document.getElementById(cfg.hiddenId);
            var currentId = hidEl && hidEl.value && hidEl.value !== '0' ? parseInt(hidEl.value) : null;
            var visible = 0;
            cfg.data.forEach(function (item) {
                var text = item[cfg.key] || '';
                if (q && text.toLowerCase().indexOf(q) === -1) return;
                if (deptId && String(item.deptId) !== deptId) return;
                visible++;
                var isSelected = currentId !== null && currentId === item.id;
                var tr = document.createElement('tr');
                tr.className = 'em-picker-row' + (isSelected ? ' table-active' : '');
                tr.innerHTML =
                    '<td><div class="em-picker-name-text" style="font-size:.9rem;color:#1e293b;">'
                    + escH(text)
                    + (isSelected ? ' <span class="badge bg-primary ms-1" style="font-size:.65rem;">Selected</span>' : '')
                    + '</div></td>'
                    + '<td style="text-align:center;"><button type="button" class="em-picker-select-btn picker-row-btn" data-id="' + item.id + '" data-text="' + escH(text) + '"><i class="fas fa-' + (isSelected ? 'check' : 'plus') + '"></i></button></td>';
                tbody.appendChild(tr);
            });
            emptyEl.style.display = visible === 0 ? '' : 'none';
            if (infoEl) infoEl.textContent = visible === 0 ? 'No matches' : 'Showing ' + visible + ' item' + (visible !== 1 ? 's' : '');
            tbody.querySelectorAll('.picker-row-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var hidElInner = document.getElementById(cfg.hiddenId);
                    var dispEl = document.getElementById(cfg.displayId);
                    if (hidElInner) hidElInner.value = this.dataset.id;
                    if (dispEl) dispEl.value = this.dataset.text;
                    hidePicker();
                });
            });
        }

        // Wire display input to open picker
        var dispEl = document.getElementById(cfg.displayId);
        if (dispEl) dispEl.addEventListener('click', function () {
            if (filterEl) filterEl.value = '';
            if (deptFilterEl) deptFilterEl.value = '';
            renderRows('', '');
            showPicker();
        });

        if (closeBtn)  closeBtn.addEventListener('click',  hidePicker);
        if (cancelBtn) cancelBtn.addEventListener('click', hidePicker);
        if (modalEl)   modalEl.addEventListener('click', function (e) { if (e.target === modalEl) hidePicker(); });
        if (filterEl)  filterEl.addEventListener('input',  function ()  { renderRows(this.value, deptFilterEl ? deptFilterEl.value : ''); });
        if (deptFilterEl) deptFilterEl.addEventListener('change', function() { renderRows(filterEl ? filterEl.value : '', this.value); });
    }

    buildPickerModal({
        modalId: 'empPickerModal', title: 'Select Employee', subtitle: 'Choose a project member to add',
        colHeader: 'Employee', data: window._pmEmployees, key: 'name',
        hiddenId: 'memberEmployeeSelect', displayId: 'memberEmployeeDisplay',
        depts: window._pmEmployeeDepts
    });
    buildPickerModal({
        modalId: 'rolePickerModal', title: 'Select Project Role', subtitle: 'Choose a role for this member',
        colHeader: 'Role', data: window._pmRoles, key: 'name',
        hiddenId: 'memberRoleSelect', displayId: 'memberRoleDisplay'
    });
    buildPickerModal({
        modalId: 'msPickerModal', title: 'Select Milestone Template', subtitle: 'Choose a milestone template',
        colHeader: 'Milestone', data: window._pmMilestones, key: 'name',
        hiddenId: 'milestoneSelect', displayId: 'milestoneDisplay'
    });
})();

// Member search filtering
(function(){
    const input = document.getElementById('memberSearch');
    if (!input) return;
    const rows = Array.from(document.querySelectorAll('.emp-member-stack .emp-member-row'));
    function apply(){
        const q = (input.value || '').toLowerCase().trim();
        rows.forEach(r => {
            const name = (r.dataset.name || '').toLowerCase();
            r.style.display = (!q || name.includes(q)) ? '' : 'none';
        });
    }
    input.addEventListener('input', apply);
})();
</script>

<script>
    let __archiveFormToSubmit = null;
    function openArchiveModal(form, name) {
        __archiveFormToSubmit = form;
        const msg = document.getElementById('archiveConfirmMessage');
        if (msg) msg.textContent = `Archive milestone "${name}"?`;
        const modal = document.getElementById('archiveConfirmModal');
        if (modal) { modal.classList.add('open'); modal.style.display = 'flex'; modal.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; }
    }
    function closeArchiveModal() {
        __archiveFormToSubmit = null;
        const modal = document.getElementById('archiveConfirmModal');
        if (modal) { modal.classList.remove('open'); modal.style.display = 'none'; modal.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; }
    }
    function confirmArchive() {
        if (!__archiveFormToSubmit) return closeArchiveModal();
        __archiveFormToSubmit.submit();
    }
</script>

<script>
    let __unarchiveFormToSubmit = null;
    function openUnarchiveModal(form, name) {
        __unarchiveFormToSubmit = form;
        const msg = document.getElementById('unarchiveConfirmMessage');
        if (msg) msg.textContent = `Unarchive milestone "${name}"?`;
        const modal = document.getElementById('unarchiveConfirmModal');
        if (modal) { modal.classList.add('open'); modal.style.display = 'flex'; modal.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; }
    }
    function closeUnarchiveModal() {
        __unarchiveFormToSubmit = null;
        const modal = document.getElementById('unarchiveConfirmModal');
        if (modal) { modal.classList.remove('open'); modal.style.display = 'none'; modal.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; }
    }
    function confirmUnarchive() {
        if (!__unarchiveFormToSubmit) return closeUnarchiveModal();
        __unarchiveFormToSubmit.submit();
    }
</script>
<script>
(function(){
    const milestoneFilter = document.getElementById('milestoneArchiveFilter');
    if (!milestoneFilter) return;
    const rows = Array.from(document.querySelectorAll('.emp-milestone-row'));
    function applyMilestoneFilter(){
        const v = (milestoneFilter.value || 'active').toLowerCase();
        rows.forEach(r => {
            const isArchived = (r.dataset.archived || 'false') === 'true';
            let show = true;
            if (v === 'active') show = !isArchived;
            else if (v === 'archived') show = isArchived;
            r.style.display = show ? '' : 'none';
        });
    }
    milestoneFilter.addEventListener('change', applyMilestoneFilter);
    // initialize
    applyMilestoneFilter();
})();
</script>
<script>
(function() {
    const modal = document.getElementById('confirmRemoveModal');
    const modalMsg = document.getElementById('confirmRemoveMessage');
    const cancelBtn = document.getElementById('confirmRemoveCancel');
    const confirmBtn = document.getElementById('confirmRemoveConfirm');
    let formToSubmit = null;

    function showModal(form, name) {
        if (!modal) { form.submit(); return; }
        formToSubmit = form;
        if (modalMsg) modalMsg.textContent = 'Remove ' + name + ' from this project?';
        modal.style.display = 'flex';
        modal.setAttribute('aria-hidden', 'false');
    }

    function hideModal() {
        if (!modal) return;
        formToSubmit = null;
        modal.style.display = 'none';
        modal.setAttribute('aria-hidden', 'true');
    }

    document.querySelectorAll('.remove-member-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const form = btn.closest('.remove-member-form');
            const name = btn.getAttribute('data-member-name') || '';
            if (form) showModal(form, name);
        });
    });

    cancelBtn?.addEventListener('click', hideModal);
    modal?.addEventListener('click', function(e) { if (e.target === modal) hideModal(); });
    confirmBtn?.addEventListener('click', function() {
        if (formToSubmit) formToSubmit.submit();
        hideModal();
    });
})();
</script>
}
