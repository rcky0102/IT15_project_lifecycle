@model project_lifecycle.ViewModels.ProjectManager.ProjectManageViewModel
@{
    ViewData["Title"] = Model.Project.Name;
    var duration    = (Model.Project.EndDate - Model.Project.StartDate).Days;
    // Exclude archived milestones from counts and progress calculation
    var totalMs     = Model.Project.Milestones.Count(m => !m.IsArchived);
    var finishedMs  = Model.Project.Milestones.Count(m => !m.IsArchived && m.Status == "Finished");
    var pct         = totalMs > 0 ? (int)Math.Round((double)finishedMs / totalMs * 100) : 0;
    var nextOrder   = Model.Project.Milestones.Any(m => !m.IsArchived) ? Model.Project.Milestones.Where(m => !m.IsArchived).Max(m => m.SequenceOrder) + 1 : 1;
}

<style>
    /* Page-specific: modal + delete action + step chip (not in shared CSS) */
    .pm-modal-backdrop { display:none; position:fixed; inset:0; background:rgba(0,105,148,.25); backdrop-filter:blur(4px); z-index:1040; align-items:center; justify-content:center; }
    .pm-modal-backdrop.open { display:flex; }
    .pm-modal { background:#fff; border-radius:16px; width:100%; max-width:480px; box-shadow:0 25px 60px rgba(0,105,148,.15); overflow:hidden; animation:pmModalIn .25s ease; }
    @@keyframes pmModalIn { from{opacity:0;transform:translateY(-16px) scale(.97)} to{opacity:1;transform:translateY(0) scale(1)} }
    .pm-modal-header { display:flex; align-items:center; justify-content:space-between; padding:1rem 1.5rem; background:linear-gradient(135deg,#f0f7fc,#e8f4fb); border-bottom:1px solid rgba(0,105,148,.08); }
    .pm-modal-title { font-weight:700; font-size:.95rem; color:var(--emp-ocean); display:flex; align-items:center; gap:.5rem; }
    .pm-modal-close { background:none; border:none; font-size:1.1rem; color:#94a3b8; cursor:pointer; padding:.3rem .45rem; border-radius:8px; transition:all .2s; }
    .pm-modal-close:hover { background:rgba(0,105,148,.06); color:var(--emp-ocean); }
    .pm-modal-body { padding:1.5rem; }
    .pm-modal-footer { padding:.75rem 1.5rem 1.25rem; display:flex; gap:.6rem; justify-content:flex-end; }
    .emp-action-delete { color:#ef4444; border-color:rgba(239,68,68,.15); }
    .emp-action-delete:hover { background:linear-gradient(135deg,#ef4444,#f87171); color:#fff; border-color:transparent; box-shadow:0 4px 14px rgba(239,68,68,.25); }
    .pm-step-chip { font-size:.65rem; font-weight:800; color:var(--emp-ocean); background:rgba(0,105,148,.06); padding:.2rem .5rem; border-radius:5px; letter-spacing:.4px; white-space:nowrap; }
    .pm-member-actions { display:flex; gap:.25rem; flex-shrink:0; margin-left:auto; }
    /* Use milestone card action button design for team member actions */
    .emp-member-stack .pm-member-actions .emp-action-btn {
        width:36px;
        height:36px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        border-radius:10px;
        border:1px solid rgba(14,165,233,0.08);
        background:#fff;
        box-shadow:none;
        padding:0;
        transition:all .15s ease;
        color:inherit;
        margin-left:.4rem;
    }
    .emp-member-stack .pm-member-actions .emp-action-btn i { font-size:0.95rem; }
    .emp-member-stack .pm-member-actions .emp-action-btn:hover { transform:translateY(-1px); box-shadow:0 6px 18px rgba(3,102,214,0.06); }
    .emp-member-stack .pm-member-actions .emp-action-edit i { color:#2563eb; }
    .emp-member-stack .pm-member-actions .emp-action-delete i { color:#ef4444; }
    /* Compact member row adjustments */
    .emp-member-stack { padding: .25rem 0; }
    .emp-member-row { display:flex; align-items:center; gap:.6rem; padding:.45rem .6rem; border-radius:10px; }
    .emp-member-row + .emp-member-row { margin-top:.35rem; }
    .emp-member-avatar { width:40px; height:40px; flex:0 0 40px; border-radius:8px; overflow:hidden; }
    .emp-member-avatar img { width:100%; height:100%; object-fit:cover; display:block; }
    .emp-member-info { min-width:0; }
    .emp-member-name { display:block; font-size:.95rem; font-weight:700; line-height:1.05; color:#0f172a; }
    .emp-member-name { display:block; font-size:.88rem; font-weight:500; line-height:1.05; color:#0f172a; }
    .emp-member-role { display:block; font-size:.76rem; color:#64748b; margin-top:2px; }
    .pm-member-actions { gap:.25rem; }
    .emp-member-stack .pm-member-actions .emp-action-btn { width:32px; height:32px; border-radius:8px; }
    .emp-member-stack .pm-member-actions .emp-action-btn i{ font-size:0.85rem; }
    /* ── Batch add members modal ────────────────────────────────── */
    .pm-batch-modal { background:#fff; border-radius:16px; width:100%; max-width:1120px; height:82vh; display:flex; flex-direction:column; box-shadow:0 25px 60px rgba(0,105,148,.22); overflow:hidden; animation:pmModalIn .25s ease; }
    .pm-batch-header { display:flex; align-items:center; justify-content:space-between; padding:1rem 1.5rem; background:linear-gradient(135deg,#006994,#0092c8); border-bottom:1px solid rgba(0,105,148,.18); flex-shrink:0; }
    .pm-batch-header-title { font-weight:700; font-size:1rem; color:#fff; display:flex; align-items:center; gap:.55rem; }
    .pm-batch-header-close { background:none; border:none; font-size:1.15rem; color:rgba(255,255,255,.75); cursor:pointer; padding:.3rem .45rem; border-radius:8px; transition:all .2s; line-height:1; }
    .pm-batch-header-close:hover { background:rgba(255,255,255,.15); color:#fff; }
    .pm-batch-body { flex:1; display:flex; flex-direction:row; overflow:hidden; min-height:0; }
    .pm-batch-picker { flex:1 1 0; min-width:0; display:flex; flex-direction:column; border-right:1px solid rgba(0,105,148,.12); }
    .pm-batch-staged { flex:0 0 340px; display:flex; flex-direction:column; background:#f8faff; }
    .pm-batch-section-header { padding:.55rem 1.1rem; background:#edf4fb; border-bottom:1px solid rgba(0,105,148,.1); display:flex; align-items:center; justify-content:space-between; gap:.5rem; flex-shrink:0; }
    .pm-batch-section-label { font-weight:700; font-size:.75rem; color:#006994; text-transform:uppercase; letter-spacing:.5px; display:flex; align-items:center; gap:.4rem; }
    .pm-batch-filter-bar { padding:.5rem 1.1rem; display:flex; gap:.5rem; align-items:center; border-bottom:1px solid rgba(0,0,0,.05); flex-shrink:0; }
    .pm-batch-table-wrap { flex:1; overflow-y:auto; min-height:0; }
    .pm-batch-table { width:100%; border-collapse:collapse; font-size:.87rem; }
    .pm-batch-table thead th { position:sticky; top:0; background:#f8faff; padding:.4rem .8rem; font-weight:700; font-size:.72rem; text-transform:uppercase; letter-spacing:.4px; color:#475569; border-bottom:1px solid rgba(0,105,148,.1); }
    .pm-batch-table tbody tr:hover:not(.pm-batch-row-added) { background:#f0f7fc; }
    .pm-batch-table tbody tr.pm-batch-row-added { background:#f0fdf4; }
    .pm-batch-table tbody td { padding:.38rem .8rem; border-bottom:1px solid rgba(0,0,0,.04); vertical-align:middle; }
    .pm-batch-add-btn { border:1px solid rgba(0,105,148,.3); background:#fff; color:#006994; border-radius:7px; padding:.22rem .62rem; font-size:.78rem; cursor:pointer; transition:all .15s; white-space:nowrap; }
    .pm-batch-add-btn:hover:not(:disabled) { background:#006994; color:#fff; }
    .pm-batch-add-btn:disabled { background:#dcfce7; border-color:#86efac; color:#16a34a; cursor:default; }
    .pm-batch-staged-wrap { flex:1; overflow-y:auto; min-height:0; }
    .pm-batch-staged-table { width:100%; border-collapse:collapse; font-size:.86rem; }
    .pm-batch-staged-table td { padding:.38rem .7rem; border-bottom:1px solid rgba(0,0,0,.05); vertical-align:middle; }
    .pm-batch-role-select { border:1px solid #e2e8f0; border-radius:7px; padding:.25rem .45rem; font-size:.82rem; color:#1e293b; background:#fff; width:100%; }
    .pm-batch-role-select:focus { outline:none; border-color:#0ea5e9; }
    .pm-batch-role-select.invalid { border-color:#ef4444; }
    .pm-batch-remove-btn { border:none; background:none; color:#ef4444; cursor:pointer; padding:.22rem .45rem; border-radius:6px; transition:background .15s; }
    .pm-batch-remove-btn:hover { background:rgba(239,68,68,.08); }
    .pm-batch-empty { padding:1.6rem 1rem; text-align:center; color:#94a3b8; font-size:.84rem; display:flex; flex-direction:column; align-items:center; gap:.45rem; }
    .pm-batch-search { border:1px solid #e2e8f0; border-radius:9px; padding:.38rem .75rem .38rem 2rem; font-size:.86rem; width:100%; outline:none; transition:border-color .2s; background:#fff; }
    .pm-batch-search:focus { border-color:#0ea5e9; }
    .pm-batch-search-wrap { position:relative; flex:1; }
    .pm-batch-search-wrap i { position:absolute; left:.65rem; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:.8rem; pointer-events:none; }
    .pm-batch-dept-select { border:1px solid #e2e8f0; border-radius:9px; padding:.38rem .65rem; font-size:.83rem; color:#1e293b; background:#fff; min-width:150px; cursor:pointer; }
    .pm-batch-dept-select:focus { outline:none; border-color:#0ea5e9; }
    .pm-batch-count-badge { display:inline-flex; align-items:center; justify-content:center; min-width:18px; height:18px; border-radius:9px; background:#006994; color:#fff; font-size:.7rem; font-weight:700; padding:0 5px; margin-left:.3rem; }
    .pm-batch-footer { padding:.75rem 1.25rem; display:flex; gap:.6rem; justify-content:flex-end; border-top:1px solid rgba(0,105,148,.1); flex-shrink:0; background:#fff; }
</style>

<!-- ===== Page Hero ===== -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-diagram-project"></i></span>
                @Model.Project.Name
            </h1>
            <p class="emp-page-subtitle">Proposal: @Model.Project.ProposalTitle</p>
        </div>

<!-- Confirmation modal for remove member -->
<div class="emp-modal-backdrop" id="confirmRemoveModal" role="dialog" aria-modal="true" aria-hidden="true" style="display:none;">
    <div class="emp-modal" role="document">
        <h4 id="confirmRemoveTitle"><i class="fas fa-exclamation-triangle"></i> Confirm</h4>
        <p id="confirmRemoveMessage">Are you sure?</p>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn emp-btn-cancel" id="confirmRemoveCancel">Cancel</button>
            <button type="button" class="emp-btn emp-btn-confirm" id="confirmRemoveConfirm">Remove</button>
        </div>
    </div>
</div>

<!-- Archive confirmation modal for milestones -->
<div class="emp-modal-backdrop" id="archiveConfirmModal" role="dialog" aria-modal="true" aria-hidden="true" style="display:none;" onclick="if(event.target === this) closeArchiveModal()">
    <div class="emp-modal" role="document">
        <h4 id="archiveConfirmTitle"><i class="fas fa-archive"></i> Confirm Archive</h4>
        <p id="archiveConfirmMessage">Archive this milestone?</p>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn emp-btn-cancel" id="archiveCancelBtn" onclick="closeArchiveModal()">Cancel</button>
            <button type="button" class="emp-btn emp-btn-confirm emp-btn-danger" id="archiveConfirmBtn" onclick="confirmArchive()">Archive</button>
        </div>
    </div>
</div>

<!-- Unarchive confirmation modal for milestones -->
<div class="emp-modal-backdrop" id="unarchiveConfirmModal" role="dialog" aria-modal="true" aria-hidden="true" style="display:none;" onclick="if(event.target === this) closeUnarchiveModal()">
    <div class="emp-modal" role="document">
        <h4 id="unarchiveConfirmTitle"><i class="fas fa-box-open"></i> Confirm Unarchive</h4>
        <p id="unarchiveConfirmMessage">Unarchive this milestone?</p>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn emp-btn-cancel" id="unarchiveCancelBtn" onclick="closeUnarchiveModal()">Cancel</button>
            <button type="button" class="emp-btn emp-btn-confirm emp-btn-primary" id="unarchiveConfirmBtn" onclick="confirmUnarchive()">Unarchive</button>
        </div>
    </div>
</div>
        <div class="emp-page-hero-right" style="display:flex;gap:.6rem;flex-wrap:wrap;">
            <button type="button" class="emp-btn emp-btn-outline" onclick="openModal('membersModal')">
                <i class="fas fa-user-plus"></i>
                <span>Add Member</span>
            </button>
            <button type="button" class="emp-btn emp-btn-outline" onclick="openModal('milestonesModal')">
                <i class="fas fa-flag-checkered"></i>
                <span>Add Milestone</span>
            </button>
            <a asp-area="ProjectManager" asp-controller="Project" asp-action="Index" class="emp-btn emp-btn-outline">
                <i class="fas fa-arrow-left"></i>
                <span>Back to Projects</span>
            </a>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="emp-alert emp-alert-success">
        <i class="fas fa-check-circle emp-alert-icon"></i>
        <span>@TempData["SuccessMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="emp-alert emp-alert-error">
        <i class="fas fa-exclamation-circle emp-alert-icon"></i>
        <span>@TempData["ErrorMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}

<!-- ===== Info strip ===== -->
<div class="emp-info-strip">
    <div class="emp-info-item">
        <i class="fas fa-calendar-days"></i>
        <span>@Model.Project.StartDate.ToString("MMM dd, yyyy") &ndash; @Model.Project.EndDate.ToString("MMM dd, yyyy")</span>
    </div>
    <div class="emp-info-item">
        <i class="fas fa-clock"></i>
        <span>@duration days</span>
    </div>
    <div class="emp-info-item">
        <i class="fas fa-users"></i>
        <span>@Model.Project.Members.Count member@(Model.Project.Members.Count == 1 ? "" : "s")</span>
    </div>
    <div class="emp-info-item">
        <i class="fas fa-flag-checkered"></i>
        <span>@finishedMs / @totalMs milestones completed</span>
    </div>
    @if (totalMs > 0)
    {
        <div class="emp-info-progress">
            <div class="emp-info-progress-bar">
                <div class="emp-info-progress-fill" style="width:@pct%"></div>
            </div>
            <span class="emp-info-progress-label">@pct%</span>
        </div>
    }
</div>

<div class="emp-show-grid">

    <!-- ===== Milestones card ===== -->
    <div class="emp-show-tasks-card">
        <div class="emp-table-toolbar">
            <div class="emp-table-toolbar-left">
                <h3 class="emp-table-title"><i class="fas fa-flag-checkered"></i> Project Milestones</h3>
                <span class="emp-count-chip">@totalMs</span>
            </div>
            <div style="display:flex;align-items:center;gap:.6rem;">
                <div style="display:flex;align-items:center;gap:.4rem;">
                    <select id="milestoneArchiveFilter" class="emp-select">
                        <option value="active" selected>Active</option>
                        <option value="archived">Archived</option>
                        <option value="all">All</option>
                    </select>
                </div>
            </div>
        </div>

        @if (Model.Project.Milestones.Any())
        {
            <div class="emp-task-list" id="milestonesList">
                @foreach (var ms in Model.Project.Milestones.OrderBy(m => m.IsArchived).ThenBy(m => m.SequenceOrder))
                {
                    <div class="emp-task-row emp-milestone-row" data-archived="@(ms.IsArchived ? "true" : "false")">
                        <div class="emp-task-row-left">
                            <span class="emp-task-status-dot @MsDotClass(ms.Status)"></span>
                            <div class="emp-task-info">
                                <span class="emp-task-name">@ms.MilestoneName</span>
                                <span class="emp-task-dates">
                                    @if (ms.SequenceOrder > 0)
                                    {
                                        <span class="pm-step-chip">STEP @ms.SequenceOrder</span>
                                    }
                                    else
                                    {
                                        <span class="pm-step-chip" style="opacity:.7;background:rgba(120,120,120,.06);">ARCHIVED</span>
                                    }
                                </span>
                            </div>
                        </div>
                        <div class="emp-task-row-right">
                            <span class="emp-badge-white" title="Status">
                                <span class="emp-status-inline @MsBadgeClass(ms.Status)">
                                    <span class="emp-status-dot"></span>
                                    <span class="emp-status-text">@ms.Status</span>
                                </span>
                            </span>
                            <a asp-area="ProjectManager" asp-controller="Project" asp-action="Milestone"
                               asp-route-projectMilestoneId="@ms.Id"
                               class="emp-action-btn emp-action-view" title="View Milestone">
                                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                            </a>
                            <button type="button" class="emp-action-btn emp-action-edit" title="Edit"
                                    onclick="editMilestone(@ms.Id, '@ms.MilestoneId', '@ms.SequenceOrder', 'milestonesModal')">
                                <i class="fas fa-pen-to-square"></i>
                            </button>
                            @if (!ms.IsArchived)
                            {
                                <form asp-area="ProjectManager" asp-controller="Project" asp-action="ArchiveProjectMilestone" method="post" style="margin:0;display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="projectMilestoneId" value="@ms.Id" />
                                    <button type="button" class="emp-action-btn emp-action-archive" title="Archive"
                                            data-ms-name="@ms.MilestoneName"
                                            onclick="openArchiveModal(this.form, this.getAttribute('data-ms-name'))">
                                        <i class="fas fa-archive"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-area="ProjectManager" asp-controller="Project" asp-action="UnarchiveProjectMilestone" method="post" style="margin:0;display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="projectMilestoneId" value="@ms.Id" />
                                    <button type="button" class="emp-action-btn emp-action-unarchive" title="Unarchive"
                                            data-ms-name="@ms.MilestoneName"
                                            onclick="openUnarchiveModal(this.form, this.getAttribute('data-ms-name'))">
                                        <i class="fas fa-box-open"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="emp-empty-state">
                <div class="emp-empty-icon"><i class="fas fa-flag-checkered"></i></div>
                <h4 class="emp-empty-title">No milestones yet</h4>
                <p class="emp-empty-text">Start building your project timeline by adding milestones.</p>
            </div>
        }
    </div>

    <!-- ===== Side panel ===== -->
    <div class="emp-show-side">

        <!-- Team Members -->
        <div class="emp-side-card">
            <div class="emp-side-card-title">
                <i class="fas fa-users"></i> Team Members
                <span class="emp-count-chip" style="margin-left:auto;">@Model.Project.Members.Count</span>
            </div>
            <div style="margin-top:.6rem;">
                <input id="memberSearch" type="text" class="emp-search-input" placeholder="Search members…" style="width:100%;padding:.45rem .6rem;font-size:.88rem;" />
            </div>
            @if (Model.Project.Members.Any())
            {
                <div class="emp-member-stack">
                    @foreach (var m in Model.Project.Members)
                    {
                        <div class="emp-member-row" data-name="@((m.EmployeeName ?? "").ToLower())">
                            <div class="emp-member-avatar">
                                @if (!string.IsNullOrWhiteSpace(m.ProfileImage))
                                {
                                    <img src="@Url.Content(m.ProfileImage)" alt="@m.EmployeeName" style="width:100%;height:100%;border-radius:8px;object-fit:cover;display:block;" />
                                }
                                else
                                {
                                    @m.EmployeeName.Substring(0, 1).ToUpper()
                                }
                            </div>
                            <div class="emp-member-info">
                                <span class="emp-member-name">@m.EmployeeName</span>
                                <span class="emp-member-role">@m.ProjectRoleName</span>
                            </div>
                            <div class="pm-member-actions">
                                <button type="button" class="emp-action-btn emp-action-edit" title="Edit" onclick="editMember(@m.Id, '@m.EmployeeId', '@m.ProjectRoleId')">  
                                    <i class="fas fa-pen-to-square"></i>
                                </button>
                                <form asp-area="ProjectManager" asp-controller="Project" asp-action="RemoveMember" method="post" style="margin:0;" class="remove-member-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="memberId" value="@m.Id" />
                                    <button type="button" class="emp-action-btn emp-action-delete remove-member-btn" title="Remove"
                                            data-member-name="@m.EmployeeName">
                                        <i class="fas fa-xmark" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="emp-empty-state" style="padding:1.5rem;">
                    <div class="emp-empty-icon"><i class="fas fa-user-plus"></i></div>
                    <h4 class="emp-empty-title">No team members</h4>
                    <p class="emp-empty-text">Add people to get started.</p>
                </div>
            }
        </div>

        
    </div>

</div>

<!-- ===== Batch Add Members Modal ===== -->
<div class="pm-modal-backdrop" id="membersModal" onclick="closeOnBackdrop(event,'membersModal')">
    <div class="pm-batch-modal">
        <!-- Ocean blue gradient header -->
        <div class="pm-batch-header">
            <div class="pm-batch-header-title"><i class="fas fa-users"></i> Add Team Members</div>
            <button class="pm-batch-header-close" onclick="closeModal('membersModal')">&times;</button>
        </div>
        <div class="pm-batch-body">
            <!-- LEFT: Employee picker -->
            <div class="pm-batch-picker">
                <div class="pm-batch-section-header">
                    <span class="pm-batch-section-label"><i class="fas fa-users"></i> Available Employees</span>
                    <span id="batchPickerInfo" style="font-size:.76rem;color:#64748b;"></span>
                </div>
                <div class="pm-batch-filter-bar">
                    <div class="pm-batch-search-wrap">
                        <i class="fas fa-magnifying-glass"></i>
                        <input type="text" id="batchEmpSearch" class="pm-batch-search" placeholder="Search employees…" autocomplete="off" />
                    </div>
                    <select id="batchDeptFilter" class="pm-batch-dept-select">
                        <option value="">All Departments</option>
                    </select>
                </div>
                <div class="pm-batch-table-wrap">
                    <table class="pm-batch-table">
                        <thead><tr><th>Name</th><th>Department</th><th style="width:90px;text-align:center;">Action</th></tr></thead>
                        <tbody id="batchEmpTbody"></tbody>
                    </table>
                    <div id="batchPickerEmpty" class="pm-batch-empty" style="display:none;">
                        <i class="fas fa-magnifying-glass" style="font-size:1.2rem;opacity:.4;"></i>
                        <span>No matches found</span>
                    </div>
                </div>
            </div>
            <!-- RIGHT: Staged members -->
            <div class="pm-batch-staged">
                <div class="pm-batch-section-header">
                    <span class="pm-batch-section-label"><i class="fas fa-list-check"></i> Selected <span class="pm-batch-count-badge" id="batchStagedBadge">0</span></span>
                    <span style="font-size:.72rem;color:#64748b;">Assign each a role</span>
                </div>
