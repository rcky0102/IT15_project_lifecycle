@model project_lifecycle.ViewModels.ProjectManager.ProjectManageViewModel
@{
    ViewData["Title"] = Model.Project.Name;
    var duration = (Model.Project.EndDate - Model.Project.StartDate).Days;
    var finishedMs = Model.Project.Milestones.Count(m => m.Status == "Finished");
    var nextOrder  = Model.Project.Milestones.Any() ? Model.Project.Milestones.Max(m => m.SequenceOrder) + 1 : 1;
}

<style>
    /* ---- detail info strip ---- */
    .det-info-strip { display:flex; flex-wrap:wrap; gap:.6rem 1.5rem; padding:1rem 1.5rem; background:#fff; border-radius:12px; border:1px solid #e2e8f0; margin-bottom:1.5rem; }
    .det-info-item  { display:flex; align-items:center; gap:.45rem; font-size:.82rem; color:#475569; }
    .det-info-item i { color:#6366f1; width:14px; text-align:center; }
    .det-info-item strong { color:#1e293b; }
    /* ---- two-col grid ---- */
    .det-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; }
    @@media(max-width:800px){ .det-grid{grid-template-columns:1fr;} }
    /* ---- panel card ---- */
    .det-panel { background:#fff; border-radius:14px; border:1px solid #e2e8f0; overflow:hidden; }
    .det-panel-head { display:flex; align-items:center; justify-content:space-between; padding:1rem 1.25rem; border-bottom:1px solid #f1f5f9; }
    .det-panel-title { font-weight:700; font-size:.95rem; color:#1e293b; display:flex; align-items:center; gap:.5rem; }
    .det-panel-body  { padding:1rem 1.25rem; }
    /* ---- member row ---- */
    .det-member-row { display:flex; align-items:center; gap:.75rem; padding:.65rem 0; border-bottom:1px solid #f8fafc; }
    .det-member-row:last-child { border-bottom:none; }
    .det-member-avatar { width:36px; height:36px; border-radius:50%; background:linear-gradient(135deg,#6366f1,#8b5cf6); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:700; font-size:.82rem; flex-shrink:0; }
    .det-member-info { flex:1; min-width:0; }
    .det-member-name { font-weight:600; font-size:.85rem; color:#1e293b; }
    .det-member-role { font-size:.73rem; color:#6366f1; font-weight:600; }
    /* ---- milestone row ---- */
    .det-ms-row { display:flex; align-items:flex-start; gap:.75rem; padding:.75rem 0; border-bottom:1px solid #f8fafc; }
    .det-ms-row:last-child { border-bottom:none; }
    .det-ms-num { width:24px; height:24px; border-radius:50%; background:#f1f5f9; color:#6366f1; font-weight:700; font-size:.72rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:.1rem; }
    .det-ms-body { flex:1; min-width:0; }
    .det-ms-name { font-weight:600; font-size:.87rem; color:#1e293b; }
    .det-ms-status { display:inline-block; font-size:.68rem; font-weight:700; text-transform:uppercase; padding:.15rem .5rem; border-radius:20px; margin-top:.2rem; background:#f1f5f9; color:#64748b; }
    .det-ms-status.finished { background:#dcfce7; color:#16a34a; }
    .det-ms-status.unfinished { background:#fef3c7; color:#d97706; }
    .det-ms-status.in_progress { background:#ede9fe; color:#7c3aed; }
    .det-empty { text-align:center; padding:2rem 1rem; color:#94a3b8; }
    .det-empty i { font-size:1.8rem; display:block; margin-bottom:.4rem; }
    /* ---- modal ---- */
    .det-modal-backdrop { display:none; position:fixed; inset:0; background:rgba(15,23,42,.45); z-index:1040; align-items:center; justify-content:center; }
    .det-modal-backdrop.open { display:flex; }
    .det-modal { background:#fff; border-radius:16px; width:100%; max-width:480px; box-shadow:0 20px 60px rgba(0,0,0,.18); overflow:hidden; animation:detModalIn .2s ease; }
    @@keyframes detModalIn { from{opacity:0;transform:translateY(-18px)} to{opacity:1;transform:translateY(0)} }
    .det-modal-header { display:flex; align-items:center; justify-content:space-between; padding:1.1rem 1.5rem; border-bottom:1px solid #f1f5f9; }
    .det-modal-title { font-weight:700; font-size:1rem; color:#1e293b; display:flex; align-items:center; gap:.5rem; }
    .det-modal-close { background:none; border:none; font-size:1.15rem; color:#94a3b8; cursor:pointer; line-height:1; padding:.2rem .4rem; border-radius:6px; }
    .det-modal-close:hover { background:#f1f5f9; color:#64748b; }
    .det-modal-body { padding:1.5rem; }
    .det-modal-footer { padding:.75rem 1.5rem 1.25rem; display:flex; gap:.6rem; justify-content:flex-end; }
</style>

<!-- ===== Hero ===== -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <div class="emp-page-title-icon"><i class="fas fa-diagram-project"></i></div>
            <div>
                <h1 class="emp-page-title">@Model.Project.Name</h1>
                <p class="emp-page-subtitle">@Model.Project.ProposalTitle</p>
            </div>
        </div>
        <div class="emp-page-hero-right" style="display:flex;gap:.6rem;flex-wrap:wrap;">
            <button type="button" class="emp-btn emp-btn-outline" onclick="openModal('membersModal')">
                <i class="fas fa-users me-1"></i>Members
            </button>
            <button type="button" class="emp-btn emp-btn-outline" onclick="openModal('milestonesModal')">
                <i class="fas fa-flag-checkered me-1"></i>Milestones
            </button>
            <a asp-area="ProjectManager" asp-controller="Project" asp-action="Index" class="emp-btn emp-btn-secondary">
                <i class="fas fa-arrow-left me-1"></i>Back to Projects
            </a>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="emp-alert emp-alert-success">
        <i class="fas fa-check-circle emp-alert-icon"></i>
        <span>@TempData["SuccessMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="emp-alert emp-alert-error">
        <i class="fas fa-exclamation-circle emp-alert-icon"></i>
        <span>@TempData["ErrorMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}

<!-- ===== Info Strip ===== -->
<div class="det-info-strip">
    <div class="det-info-item">
        <i class="fas fa-calendar-alt"></i>
        <span><strong>Start:</strong> @Model.Project.StartDate.ToString("MMM d, yyyy")</span>
    </div>
    <div class="det-info-item">
        <i class="fas fa-calendar-check"></i>
        <span><strong>End:</strong> @Model.Project.EndDate.ToString("MMM d, yyyy")</span>
    </div>
    <div class="det-info-item">
        <i class="fas fa-clock"></i>
        <span><strong>Duration:</strong> @duration days</span>
    </div>
    <div class="det-info-item">
        <i class="fas fa-users"></i>
        <span><strong>Members:</strong> @Model.Project.Members.Count</span>
    </div>
    <div class="det-info-item">
        <i class="fas fa-flag-checkered"></i>
        <span><strong>Milestones:</strong> @Model.Project.Milestones.Count (@finishedMs finished)</span>
    </div>
</div>

<!-- ===== Two-Column Grid ===== -->
<div class="det-grid">
    <!-- Members Panel -->
    <div class="det-panel">
        <div class="det-panel-head">
            <div class="det-panel-title">
                <i class="fas fa-users" style="color:#6366f1;"></i>Team Members
                <span class="emp-count-chip">@Model.Project.Members.Count</span>
            </div>
        </div>
        <div class="det-panel-body">
            @if (!Model.Project.Members.Any())
            {
                <div class="det-empty">
                    <i class="fas fa-user-slash"></i>
                    <span>No members yet. Add team members using the button above.</span>
                </div>
            }
            else
            {
                foreach (var m in Model.Project.Members)
                {
                    var initials = string.Concat(m.EmployeeName.Split(' ').Take(2).Select(s => s.Length > 0 ? s[0].ToString() : ""));
                    <div class="det-member-row">
                        <div class="det-member-avatar">@initials</div>
                        <div class="det-member-info">
                            <div class="det-member-name">@m.EmployeeName</div>
                            <div class="det-member-role">@m.ProjectRoleName</div>
                        </div>
                        <form asp-area="ProjectManager" asp-controller="Project" asp-action="RemoveMember" method="post" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="memberId" value="@m.Id" />
                            <button type="submit" class="emp-btn-xs" style="background:#fee2e2;color:#dc2626;border:none;"
                                    onclick="return confirm('Remove @m.EmployeeName from this project?')">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Milestones Panel -->
    <div class="det-panel">
        <div class="det-panel-head">
            <div class="det-panel-title">
                <i class="fas fa-flag-checkered" style="color:#6366f1;"></i>Milestones
                <span class="emp-count-chip">@Model.Project.Milestones.Count</span>
            </div>
        </div>
        <div class="det-panel-body">
            @if (!Model.Project.Milestones.Any())
            {
                <div class="det-empty">
                    <i class="fas fa-inbox"></i>
                    <span>No milestones yet. Add milestones using the button above.</span>
                </div>
            }
            else
            {
                foreach (var ms in Model.Project.Milestones.OrderBy(m => m.SequenceOrder))
                {
                    var statusClass = ms.Status?.ToLower().Replace(" ", "_") ?? "unfinished";
                    <div class="det-ms-row">
                        <div class="det-ms-num">@ms.SequenceOrder</div>
                        <div class="det-ms-body">
                            <div class="det-ms-name">@ms.MilestoneName</div>
                            <span class="det-ms-status @statusClass">@ms.Status</span>
                        </div>
                        <div style="display:flex;gap:.4rem;align-items:center;">
                            <a asp-area="ProjectManager"
                               asp-controller="Project"
                               asp-action="Milestone"
                               asp-route-projectMilestoneId="@ms.Id"
                               class="emp-btn-xs" title="View Milestone">
                                <i class="fas fa-eye"></i>
                            </a>
                            <form asp-area="ProjectManager" asp-controller="Project" asp-action="RemoveProjectMilestone" method="post" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="projectMilestoneId" value="@ms.Id" />
                                <button type="submit" class="emp-btn-xs" style="background:#fee2e2;color:#dc2626;border:none;"
                                        onclick="return confirm('Remove @ms.MilestoneName from this project?')">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- ===== Members Modal ===== -->
<div class="det-modal-backdrop" id="membersModal" onclick="closeOnBackdrop(event,'membersModal')">
    <div class="det-modal">
        <div class="det-modal-header">
            <div class="det-modal-title"><i class="fas fa-user-plus" style="color:#6366f1;"></i>Add Team Member</div>
            <button class="det-modal-close" onclick="closeModal('membersModal')">×</button>
        </div>
        <form asp-area="ProjectManager" asp-controller="Project" asp-action="AddMember" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ProjectId" value="@Model.Project.Id" />
            <div class="det-modal-body">
                <div class="emp-form-row">
                    <div class="emp-form-group" style="flex:1">
                        <label class="emp-form-label">Employee</label>
                        <select name="EmployeeId" class="emp-form-control" required>
                            <option value="">-- Select Employee --</option>
                            @foreach (var e in Model.AvailableEmployees)
                            {
                                <option value="@e.Value">@e.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="emp-form-row" style="margin-top:.85rem;">
                    <div class="emp-form-group" style="flex:1">
                        <label class="emp-form-label">Project Role</label>
                        <select name="ProjectRoleId" class="emp-form-control" required>
                            <option value="">-- Select Role --</option>
                            @foreach (var r in Model.AvailableProjectRoles)
                            {
                                <option value="@r.Value">@r.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="det-modal-footer">
                <button type="button" class="emp-btn emp-btn-outline" onclick="closeModal('membersModal')">Cancel</button>
                <button type="submit" class="emp-btn emp-btn-primary"><i class="fas fa-plus me-1"></i>Add Member</button>
            </div>
        </form>
    </div>
</div>

<!-- ===== Milestones Modal ===== -->
<div class="det-modal-backdrop" id="milestonesModal" onclick="closeOnBackdrop(event,'milestonesModal')">
    <div class="det-modal">
        <div class="det-modal-header">
            <div class="det-modal-title"><i class="fas fa-flag-checkered" style="color:#6366f1;"></i>Add Milestone</div>
            <button class="det-modal-close" onclick="closeModal('milestonesModal')">×</button>
        </div>
        <form asp-area="ProjectManager" asp-controller="Project" asp-action="AddMilestone" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ProjectId" value="@Model.Project.Id" />
            <div class="det-modal-body">
                <div class="emp-form-row">
                    <div class="emp-form-group" style="flex:1">
                        <label class="emp-form-label">Milestone Template</label>
                        <select name="MilestoneId" class="emp-form-control" required>
                            <option value="">-- Select Milestone --</option>
                            @foreach (var t in Model.AvailableMilestones)
                            {
                                <option value="@t.Value">@t.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="emp-form-row" style="margin-top:.85rem;">
                    <div class="emp-form-group" style="flex:1">
                        <label class="emp-form-label">Sequence Order</label>
                        <input name="SequenceOrder" type="number" min="1" class="emp-form-control"
                               value="@nextOrder" required />
                        <span style="font-size:.75rem;color:#64748b;margin-top:.3rem;display:block;">Order determines the milestone's position in the project timeline.</span>
                    </div>
                </div>
            </div>
            <div class="det-modal-footer">
                <button type="button" class="emp-btn emp-btn-outline" onclick="closeModal('milestonesModal')">Cancel</button>
                <button type="submit" class="emp-btn emp-btn-primary"><i class="fas fa-plus me-1"></i>Add Milestone</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function openModal(id) {
    document.getElementById(id).classList.add('open');
    document.body.style.overflow = 'hidden';
}
function closeModal(id) {
    document.getElementById(id).classList.remove('open');
    document.body.style.overflow = '';
}
function closeOnBackdrop(e, id) {
    if (e.target === document.getElementById(id)) closeModal(id);
}
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        document.querySelectorAll('.det-modal-backdrop.open').forEach(m => {
            m.classList.remove('open');
        });
        document.body.style.overflow = '';
    }
});
</script>
}
