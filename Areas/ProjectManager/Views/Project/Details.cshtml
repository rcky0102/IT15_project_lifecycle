                        <span>No employees selected yet.</span>
                        <span style="font-size:.78rem;color:#b0b8c9;">Click &ldquo;Add&rdquo; on any row to&nbsp;stage them here.</span>
                    </div>
                    <table class="pm-batch-staged-table" id="batchStagedTable" style="display:none;">
