@functions {
    private string MsBadgeClass(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "emp-status-default";
        var key = s.Trim().ToLowerInvariant();
        return key switch
        {
            "completed"         => "emp-status-approved",
            "checked"           => "emp-status-approved",
            "finished"          => "emp-status-approved",
            "in progress"       => "emp-status-revision",
            "requires revision" => "emp-status-revision",
            "require revision"  => "emp-status-revision",
            "pending"           => "emp-status-pending",
            _                   => "emp-status-default"
        };
    }

    private string MsDotClass(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "emp-dot-gray";
        var key = s.Trim().ToLowerInvariant();
        return key switch
        {
            "completed"         => "emp-dot-green",
            "checked"           => "emp-dot-green",
            "finished"          => "emp-dot-green",
            "in progress"       => "emp-dot-orange",
            "requires revision" => "emp-dot-orange",
            "require revision"  => "emp-dot-orange",
            _                   => "emp-dot-gray"
        };
    }

    private string MsSideDotClass(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "emp-ms-dot-idle";
        var key = s.Trim().ToLowerInvariant();
        return key switch
        {
            "completed"         => "emp-ms-dot-done",
            "checked"           => "emp-ms-dot-done",
            "finished"          => "emp-ms-dot-done",
            "in progress"       => "emp-ms-dot-active",
            "requires revision" => "emp-ms-dot-active",
            "require revision"  => "emp-ms-dot-active",
            _                   => "emp-ms-dot-idle"
        };
    }
}

@section Scripts {
<script>
function openModal(id) {
    document.getElementById(id).classList.add('open');
    document.body.style.overflow = 'hidden';
}

function closeModal(id) {
    document.getElementById(id).classList.remove('open');
    document.body.style.overflow = '';
    resetModals();
}

function closeOnBackdrop(e, id) {
    if (e.target === document.getElementById(id)) closeModal(id);
}

function resetModals() {
    var editId = document.getElementById('editMemberId'); if (editId) editId.value = '';
    var empSel = document.getElementById('memberEmployeeSelect'); if (empSel) empSel.value = '';
    var empDisp = document.getElementById('memberEmployeeDisplay'); if (empDisp) empDisp.value = '';
    var roleSel = document.getElementById('memberRoleSelect'); if (roleSel) roleSel.value = '';
    var roleDisp = document.getElementById('memberRoleDisplay'); if (roleDisp) roleDisp.value = '';

    document.getElementById('editProjectMilestoneId').value = '';
    document.getElementById('milestoneSelect').value = '';
    var msDisp = document.getElementById('milestoneDisplay'); if (msDisp) msDisp.value = '';
    document.getElementById('sequenceOrderInput').value = '@nextOrder';
    document.getElementById('milestoneSubmitText').textContent = 'Add Milestone';
    document.getElementById('milestoneModalTitle').textContent = 'Add Milestone';
    document.getElementById('milestoneSubmitBtn').innerHTML = '<i class="fas fa-plus"></i> <span id="milestoneSubmitText">Add Milestone</span>';
}

function editMember(memberId, employeeId, projectRoleId) {
    document.getElementById('editMemberId').value = memberId;
    var empHid = document.getElementById('memberEmployeeSelect');
    var empDisp = document.getElementById('memberEmployeeDisplay');
    if (empHid) empHid.value = employeeId;
    if (empDisp && window._pmEmployees) {
        var found = window._pmEmployees.find(function(e){ return String(e.id) === String(employeeId); });
        empDisp.value = found ? found.name : '';
    }
    var roleHid = document.getElementById('memberRoleSelect');
    var roleDisp = document.getElementById('memberRoleDisplay');
    if (roleHid) roleHid.value = projectRoleId;
    if (roleDisp && window._pmRoles) {
        var found2 = window._pmRoles.find(function(r){ return String(r.id) === String(projectRoleId); });
        roleDisp.value = found2 ? found2.name : '';
    }
    openModal('editMemberModal');
}

function editMilestone(projectMilestoneId, milestoneId, sequenceOrder, modalId) {
    document.getElementById('editProjectMilestoneId').value = projectMilestoneId;
    var msHid = document.getElementById('milestoneSelect');
    var msDisp = document.getElementById('milestoneDisplay');
    if (msHid) msHid.value = milestoneId;
    if (msDisp && window._pmMilestones) {
        var found = window._pmMilestones.find(function(m){ return String(m.id) === String(milestoneId); });
        msDisp.value = found ? found.name : '';
    }
    document.getElementById('sequenceOrderInput').value = sequenceOrder;
    document.getElementById('milestoneSubmitText').textContent = 'Update Milestone';
    document.getElementById('milestoneModalTitle').textContent = 'Edit Milestone';
    document.getElementById('milestoneSubmitBtn').innerHTML = '<i class="fas fa-check"></i> <span id="milestoneSubmitText">Update Milestone</span>';
    openModal(modalId);
}

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        document.querySelectorAll('.pm-modal-backdrop.open').forEach(m => {
            m.classList.remove('open');
        });
        document.body.style.overflow = '';
        resetModals();
    }
});
</script>

<script>
// ── Table-picker modals for Members & Milestone forms ──────────────────
(function () {
    window._pmEmployees = [
        @foreach (var e in Model.AvailableEmployeePicker) {
            @Html.Raw("{id:" + e.Id + ",name:'" + e.Name.Replace("\\", "\\\\").Replace("'", "\\'") + "',deptId:" + e.DeptId + ",deptName:'" + e.DeptName.Replace("\\", "\\\\").Replace("'", "\\'") + "'},")
        }
    ];
    window._pmEmployeeDepts = (function(){
        var seen = {}, list = [];
        window._pmEmployees.forEach(function(e){ if (e.deptId && !seen[e.deptId]) { seen[e.deptId] = true; list.push({id: e.deptId, name: e.deptName}); } });
        list.sort(function(a,b){ return a.name.localeCompare(b.name); });
        return list;
    })();
    window._pmRoles = [
        @foreach (var r in Model.AvailableProjectRoles) {
            @Html.Raw("{id:" + r.Value + ",name:'" + r.Text.Replace("\\", "\\\\").Replace("'", "\\'") + "'},")
        }
    ];
    window._pmMilestones = [
        @foreach (var t in Model.AvailableMilestones) {
            @Html.Raw("{id:" + t.Value + ",name:'" + t.Text.Replace("\\", "\\\\").Replace("'", "\\'") + "'},")
        }
    ];

    function escH(str) {
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(str || ''));
        return d.innerHTML;
    }

    function buildPickerModal(cfg) {
        // cfg: { modalId, title, subtitle, colHeader, data, key, hiddenId, displayId }
        document.body.insertAdjacentHTML('beforeend',
            '<div class="modal fade" id="' + cfg.modalId + '" tabindex="-1" aria-hidden="true" style="z-index:1060;">'
            + '<div class="modal-dialog modal-dialog-centered modal-lg">'
            + '<div class="modal-content em-picker-modal">'
            + '<div class="em-picker-header">'
            + '<div><h5 class="em-picker-title"><i class="fas fa-table-list"></i> ' + cfg.title + '</h5>'
            + '<p class="em-picker-subtitle">' + cfg.subtitle + '</p></div>'
            + '<button type="button" class="btn-close btn-close-white" id="' + cfg.modalId + 'Close" aria-label="Close"></button>'
            + '</div>'
            + '<div class="em-picker-filters"><div class="em-picker-filters-row">'
            + '<div class="em-picker-search-group"><i class="fas fa-magnifying-glass em-picker-search-icon"></i>'
            + '<input type="text" id="' + cfg.modalId + 'Filter" class="em-picker-search-input" placeholder="Search\u2026" autocomplete="off" />'
            + '</div>'
            + (cfg.depts && cfg.depts.length ? '<div class="em-picker-search-group" style="max-width:220px;margin-left:auto;"><select id="' + cfg.modalId + 'DeptFilter" class="em-picker-search-input" style="cursor:pointer;padding-left:.6rem;"></select></div>' : '')
            + '</div></div>'
            + '<div class="modal-body em-picker-body"><div class="em-picker-table-card">'
            + '<div class="em-picker-table-responsive">'
            + '<table class="em-picker-table" id="' + cfg.modalId + 'Table">'
            + '<thead><tr><th>' + cfg.colHeader + '</th><th style="width:100px;text-align:center;">Action</th></tr></thead>'
            + '<tbody></tbody></table></div>'
            + '<div id="' + cfg.modalId + 'Empty" class="em-picker-empty" style="display:none;">'
            + '<div class="em-picker-empty-icon"><i class="fas fa-magnifying-glass"></i></div>'
            + '<div class="em-picker-empty-title">No matches</div></div>'
            + '<div class="em-picker-pagination"><div class="em-picker-pagination-info" id="' + cfg.modalId + 'Info"></div></div>'
            + '</div></div>'
            + '<div class="em-picker-footer">'
            + '<button type="button" class="em-picker-btn-cancel" id="' + cfg.modalId + 'Cancel">Cancel</button>'
            + '</div>'
            + '</div></div></div>'
        );

        var modalEl   = document.getElementById(cfg.modalId);
        var tableEl   = document.getElementById(cfg.modalId + 'Table');
        var emptyEl   = document.getElementById(cfg.modalId + 'Empty');
        var filterEl  = document.getElementById(cfg.modalId + 'Filter');
        var infoEl    = document.getElementById(cfg.modalId + 'Info');
        var closeBtn  = document.getElementById(cfg.modalId + 'Close');
        var cancelBtn = document.getElementById(cfg.modalId + 'Cancel');
        var deptFilterEl = (cfg.depts && cfg.depts.length) ? document.getElementById(cfg.modalId + 'DeptFilter') : null;
        if (deptFilterEl) {
            var allOpt = document.createElement('option'); allOpt.value = ''; allOpt.textContent = 'All Departments'; deptFilterEl.appendChild(allOpt);
            cfg.depts.forEach(function(d) { var o = document.createElement('option'); o.value = String(d.id); o.textContent = d.name; deptFilterEl.appendChild(o); });
        }

        function showPicker() {
            // Use Bootstrap if available, else manual approach
            if (window.bootstrap && window.bootstrap.Modal) {
                new window.bootstrap.Modal(modalEl).show();
            } else {
                modalEl.style.cssText = 'display:block;position:fixed;left:0;top:0;width:100%;height:100%;z-index:1060;';
                modalEl.classList.add('show');
                document.body.style.overflow = 'hidden';
            }
        }

        function hidePicker() {
            if (window.bootstrap && window.bootstrap.Modal) {
                var inst = window.bootstrap.Modal.getInstance(modalEl);
                if (inst) inst.hide(); else { modalEl.style.display = 'none'; modalEl.classList.remove('show'); }
            } else {
                modalEl.style.display = 'none';
                modalEl.classList.remove('show');
                modalEl.style.zIndex = '';
                document.body.style.overflow = '';
            }
        }

        function renderRows(q, deptId) {
            var tbody = tableEl.querySelector('tbody');
            tbody.innerHTML = '';
            q = (q || '').toLowerCase().trim();
            deptId = deptId ? String(deptId) : '';
            var hidEl = document.getElementById(cfg.hiddenId);
            var currentId = hidEl && hidEl.value && hidEl.value !== '0' ? parseInt(hidEl.value) : null;
            var visible = 0;
            cfg.data.forEach(function (item) {
                var text = item[cfg.key] || '';
                if (q && text.toLowerCase().indexOf(q) === -1) return;
                if (deptId && String(item.deptId) !== deptId) return;
                visible++;
                var isSelected = currentId !== null && currentId === item.id;
                var tr = document.createElement('tr');
                tr.className = 'em-picker-row' + (isSelected ? ' table-active' : '');
                tr.innerHTML =
                    '<td><div class="em-picker-name-text" style="font-size:.9rem;color:#1e293b;">'
                    + escH(text)
                    + (isSelected ? ' <span class="badge bg-primary ms-1" style="font-size:.65rem;">Selected</span>' : '')
                    + '</div></td>'
                    + '<td style="text-align:center;"><button type="button" class="em-picker-select-btn picker-row-btn" data-id="' + item.id + '" data-text="' + escH(text) + '"><i class="fas fa-' + (isSelected ? 'check' : 'plus') + '"></i></button></td>';
                tbody.appendChild(tr);
            });
            emptyEl.style.display = visible === 0 ? '' : 'none';
            if (infoEl) infoEl.textContent = visible === 0 ? 'No matches' : 'Showing ' + visible + ' item' + (visible !== 1 ? 's' : '');
            tbody.querySelectorAll('.picker-row-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var hidElInner = document.getElementById(cfg.hiddenId);
                    var dispEl = document.getElementById(cfg.displayId);
                    if (hidElInner) hidElInner.value = this.dataset.id;
                    if (dispEl) dispEl.value = this.dataset.text;
                    hidePicker();
                });
            });
        }

        // Wire display input to open picker
        var dispEl = document.getElementById(cfg.displayId);
        if (dispEl) dispEl.addEventListener('click', function () {
            if (filterEl) filterEl.value = '';
            if (deptFilterEl) deptFilterEl.value = '';
            renderRows('', '');
            showPicker();
        });

        if (closeBtn)  closeBtn.addEventListener('click',  hidePicker);
        if (cancelBtn) cancelBtn.addEventListener('click', hidePicker);
        if (modalEl)   modalEl.addEventListener('click', function (e) { if (e.target === modalEl) hidePicker(); });
        if (filterEl)  filterEl.addEventListener('input',  function ()  { renderRows(this.value, deptFilterEl ? deptFilterEl.value : ''); });
        if (deptFilterEl) deptFilterEl.addEventListener('change', function() { renderRows(filterEl ? filterEl.value : '', this.value); });
    }

    buildPickerModal({
        modalId: 'empPickerModal', title: 'Select Employee', subtitle: 'Choose a project member to add',
        colHeader: 'Employee', data: window._pmEmployees, key: 'name',
        hiddenId: 'memberEmployeeSelect', displayId: 'memberEmployeeDisplay',
        depts: window._pmEmployeeDepts
    });
    buildPickerModal({
        modalId: 'rolePickerModal', title: 'Select Project Role', subtitle: 'Choose a role for this member',
        colHeader: 'Role', data: window._pmRoles, key: 'name',
        hiddenId: 'memberRoleSelect', displayId: 'memberRoleDisplay'
    });
    buildPickerModal({
        modalId: 'msPickerModal', title: 'Select Milestone Template', subtitle: 'Choose a milestone template',
        colHeader: 'Milestone', data: window._pmMilestones, key: 'name',
        hiddenId: 'milestoneSelect', displayId: 'milestoneDisplay'
    });
})();

// ── Batch Add Members ──────────────────────────────────────────────────
(function () {
    var projectId = @Model.Project.Id;
    var batchUrl = '@Url.Action("AddMembersBatch", "Project", new { area = "ProjectManager" })';
    var _staged = []; // [{id, name, roleId}]

    function escH(str) {
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(str || ''));
        return d.innerHTML;
    }

    var empSearchEl  = document.getElementById('batchEmpSearch');
    var deptFilterEl = document.getElementById('batchDeptFilter');
    var empTbody     = document.getElementById('batchEmpTbody');
    var pickerEmpty  = document.getElementById('batchPickerEmpty');
    var pickerInfo   = document.getElementById('batchPickerInfo');
    var stagedTbody  = document.getElementById('batchStagedTbody');
    var stagedTable  = document.getElementById('batchStagedTable');
    var stagedEmpty  = document.getElementById('batchStagedEmpty');
    var stagedBadge  = document.getElementById('batchStagedBadge');
    var submitBtn    = document.getElementById('batchSubmitBtn');
    var submitCount  = document.getElementById('batchSubmitCount');

    // Populate dept filter
    (window._pmEmployeeDepts || []).forEach(function(d) {
        var o = document.createElement('option');
        o.value = String(d.id);
        o.textContent = d.name;
        deptFilterEl.appendChild(o);
    });

    function isStaged(id) {
        return _staged.some(function(s) { return s.id === id; });
    }

    function addToStaged(id, name) {
        if (isStaged(id)) return;
        _staged.push({ id: id, name: name, roleId: 0 });
        var row = document.getElementById('batchEmpRow_' + id);
        if (row) {
            var btn = row.querySelector('.pm-batch-add-btn');
            if (btn) { btn.innerHTML = '<i class="fas fa-check"></i>'; btn.disabled = true; }
            row.classList.add('pm-batch-row-added');
        }
        renderStagedTable();
        updateSubmitBtn();
    }

    function removeFromStaged(idx) {
        var removed = _staged.splice(idx, 1)[0];
        var row = document.getElementById('batchEmpRow_' + removed.id);
        if (row) {
            var btn = row.querySelector('.pm-batch-add-btn');
            if (btn) { btn.innerHTML = '<i class="fas fa-plus"></i> Add'; btn.disabled = false; }
            row.classList.remove('pm-batch-row-added');
        }
        renderStagedTable();
        updateSubmitBtn();
    }

    function renderEmployeeTable() {
        var q = ((empSearchEl && empSearchEl.value) || '').toLowerCase().trim();
        var deptId = (deptFilterEl && deptFilterEl.value) || '';
        empTbody.innerHTML = '';
        var visible = 0;
        (window._pmEmployees || []).forEach(function(emp) {
            if (q && emp.name.toLowerCase().indexOf(q) === -1) return;
            if (deptId && String(emp.deptId) !== deptId) return;
            visible++;
            var staged = isStaged(emp.id);
            var tr = document.createElement('tr');
            tr.id = 'batchEmpRow_' + emp.id;
            if (staged) tr.classList.add('pm-batch-row-added');
            tr.innerHTML =
                '<td><span style="font-weight:600;font-size:.88rem;color:#1e293b;">' + escH(emp.name) + '</span></td>'
                + '<td style="font-size:.82rem;color:#64748b;">' + escH(emp.deptName || '') + '</td>'
                + '<td style="text-align:center;"><button type="button" class="pm-batch-add-btn" data-id="' + emp.id + '" data-name="' + escH(emp.name) + '"'
                + (staged ? ' disabled' : '') + '>'
                + (staged ? '<i class="fas fa-check"></i>' : '<i class="fas fa-plus"></i> Add')
                + '</button></td>';
            empTbody.appendChild(tr);
        });
        pickerEmpty.style.display = visible === 0 ? '' : 'none';
        if (pickerInfo) pickerInfo.textContent = visible + ' employee' + (visible !== 1 ? 's' : '');
        empTbody.querySelectorAll('.pm-batch-add-btn:not([disabled])').forEach(function(btn) {
            btn.addEventListener('click', function() { addToStaged(parseInt(this.dataset.id), this.dataset.name); });
        });
    }

    function renderStagedTable() {
        stagedTbody.innerHTML = '';
        if (_staged.length === 0) {
            stagedTable.style.display = 'none';
            stagedEmpty.style.display = '';
        } else {
            stagedTable.style.display = '';
            stagedEmpty.style.display = 'none';
            _staged.forEach(function(s, idx) {
                var roleOptions = '<option value="">\u2014 Select Role \u2014</option>';
                (window._pmRoles || []).forEach(function(r) {
                    roleOptions += '<option value="' + r.id + '"' + (s.roleId === r.id ? ' selected' : '') + '>' + escH(r.name) + '</option>';
                });
                var tr = document.createElement('tr');
                tr.innerHTML =
                    '<td style="padding:.45rem .7rem;border-bottom:1px solid rgba(0,0,0,.06);">'
                    + '<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:.3rem;">'
                    + '<div style="min-width:0;flex:1;">'
                    + '<div style="font-weight:600;font-size:.84rem;color:#1e293b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><i class="fas fa-user" style="color:#94a3b8;margin-right:.35rem;font-size:.75rem;"></i>' + escH(s.name) + '</div>'
                    + '<div style="margin-top:.3rem;"><select class="pm-batch-role-select' + (s.roleId === 0 ? ' invalid' : '') + '" data-idx="' + idx + '">' + roleOptions + '</select></div>'
                    + '</div>'
                    + '<button type="button" class="pm-batch-remove-btn" data-idx="' + idx + '" title="Remove" style="flex-shrink:0;margin-top:1px;"><i class="fas fa-times"></i></button>'
                    + '</div>'
                    + '</td>';
                stagedTbody.appendChild(tr);
            });
            stagedTbody.querySelectorAll('.pm-batch-role-select').forEach(function(sel) {
                sel.addEventListener('change', function() {
                    _staged[parseInt(this.dataset.idx)].roleId = parseInt(this.value) || 0;
                    this.classList.toggle('invalid', !this.value);
                    updateSubmitBtn();
                });
            });
            stagedTbody.querySelectorAll('.pm-batch-remove-btn').forEach(function(btn) {
                btn.addEventListener('click', function() { removeFromStaged(parseInt(this.dataset.idx)); });
            });
        }
        stagedBadge.textContent = _staged.length;
    }

    function updateSubmitBtn() {
        var allHaveRole = _staged.length > 0 && _staged.every(function(s) { return s.roleId > 0; });
        submitBtn.disabled = !allHaveRole;
        if (submitCount) submitCount.textContent = _staged.length;
    }

    submitBtn.addEventListener('click', async function() {
        if (_staged.length === 0 || !_staged.every(function(s) { return s.roleId > 0; })) return;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding\u2026';
        var payload = _staged.map(function(s) {
            return { projectId: projectId, employeeId: s.id, projectRoleId: s.roleId };
        });
        try {
            var resp = await fetch(batchUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            var data = await resp.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert(data.error || 'Failed to add members.');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-plus"></i> Add <span id="batchSubmitCount">' + _staged.length + '</span> Member(s)';
            }
        } catch(e) {
            alert('Network error. Please try again.');
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-plus"></i> Add <span id="batchSubmitCount">' + _staged.length + '</span> Member(s)';
        }
    });

    empSearchEl && empSearchEl.addEventListener('input', renderEmployeeTable);
    deptFilterEl && deptFilterEl.addEventListener('change', renderEmployeeTable);

    // Reset and render when batch modal opens
    var _origOpen = window.openModal;
    window.openModal = function(id) {
        _origOpen(id);
        if (id === 'membersModal') {
            _staged = [];
            renderStagedTable();
            updateSubmitBtn();
            renderEmployeeTable();
        }
    };
})();

// Member search filtering
(function(){
    const input = document.getElementById('memberSearch');
    if (!input) return;
    const rows = Array.from(document.querySelectorAll('.emp-member-stack .emp-member-row'));
    function apply(){
        const q = (input.value || '').toLowerCase().trim();
        rows.forEach(r => {
            const name = (r.dataset.name || '').toLowerCase();
            r.style.display = (!q || name.includes(q)) ? '' : 'none';
        });
    }
    input.addEventListener('input', apply);
})();
</script>

