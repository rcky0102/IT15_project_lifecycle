@model project_lifecycle.ViewModels.ProjectManager.ProjectTaskReviewViewModel
@using project_lifecycle.Models
@using System.Linq
@{
    ViewData["Title"] = "Review Task";
    var inputVersions = ViewBag.ProjectTaskVersions as List<ProjectTaskVersion>  ?? new List<ProjectTaskVersion>();
    var noteVersions  = ViewBag.TaskNoteVersions   as List<TaskNoteVersion>      ?? new List<TaskNoteVersion>();
    var orderedNotes  = noteVersions.OrderByDescending(n => n.VersionNumber).ToList();
}

<style>
    .task-review-content { background: #f8fafc; border-radius: 10px; padding: 1.25rem 1.5rem; border: 1px solid #e2e8f0; line-height: 1.7; }
    .task-review-content img { max-width: 100%; border-radius: 6px; }
    .emp-btn-warning { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; border: none; border-radius: 8px; padding: .55rem 1.25rem; font-weight: 600; font-size: .88rem; cursor: pointer; transition: background .2s; text-decoration: none; display: inline-flex; align-items: center; }
    .emp-btn-warning:hover { background: linear-gradient(135deg, #d97706, #b45309); color: #fff; }
    .task-review-section-label { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #64748b; margin-bottom: .75rem; }
    .task-review-empty { color: #94a3b8; font-style: italic; }
    .task-review-actions { display: flex; gap: .75rem; flex-wrap: wrap; align-items: center; margin-top: 1.25rem; }
</style>

<!-- Confirmation modal for status update -->
<div class="emp-modal-backdrop" id="confirmActionModal" role="dialog" aria-modal="true" aria-hidden="true" style="display:none;">
    <div class="emp-modal" role="document">
        <h4 id="confirmActionTitle"><i class="fas fa-exclamation-triangle"></i> Confirm</h4>
        <p id="confirmActionMessage">Are you sure?</p>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn emp-btn-cancel" id="confirmActionCancel">Cancel</button>
            <button type="button" class="emp-btn emp-btn-confirm" id="confirmActionConfirm">Confirm</button>
        </div>
    </div>
</div>

<!-- Hero -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-clipboard-check"></i></span>
                @Model.Name
            </h1>
            @if (Model.AssignedMembers != null && Model.AssignedMembers.Count > 1)
            {
                <div class="task-assigned">
                    <style>
                        .task-assigned { margin-top:.5rem; display:flex; align-items:center; gap:.6rem; }
                        .avatar-stack { display:flex; align-items:center; }
                        .avatar-stack .avatar { width:32px; height:32px; border-radius:50%; overflow:hidden; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,#eef2ff,#f3f7ff); color:#0f172a; font-weight:700; font-size:.8rem; border:2px solid #fff; box-shadow:0 6px 12px rgba(2,6,23,0.06); margin-left:-10px; }
                        .avatar-stack .avatar:first-child { margin-left:0; }
                        .avatar-stack .avatar img { width:100%; height:100%; object-fit:cover; display:block; }
                        .avatar-stack .avatar.more { background:#eef2ff; color:#1e293b; font-size:.75rem; display:flex; align-items:center; justify-content:center; }
                        .assigned-summary { font-size:.88rem; color:#abc2de; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
                    </style>
                    <div class="avatar-stack" aria-hidden="true">
                        @foreach (var m in Model.AssignedMembers.Take(4))
                        {
                            var name = (m.EmployeeName ?? "").ToString();
                            var img = (m.ProfileImage ?? "")?.ToString() ?? "";
                            var initials = string.Concat(name.Split(' ').Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s[0])).ToUpper();
                            if (initials.Length > 2) { initials = initials.Substring(0, 2); }
                            <div class="avatar" title="@name">
                                @if (!string.IsNullOrEmpty(img))
                                {
                                    <img src="@img" alt="@name" />
                                }
                                else
                                {
                                    <span class="initials">@initials</span>
                                }
                            </div>
                        }
                        @if (Model.AssignedMembers.Count > 4)
                        {
                            <div class="avatar more" title="More">+@(Model.AssignedMembers.Count - 4)</div>
                        }
                    </div>
                    <div class="assigned-summary">
                        <strong>@Model.AssignedMembers[0].EmployeeName</strong>
                        <span style="opacity:.8;"> and @(Model.AssignedMembers.Count - 1) others</span>
                    </div>
                </div>
            }
            else
            {
                <p class="emp-page-subtitle">Assigned to: @(Model.AssignedMemberName ?? "(unassigned)")</p>
            }
        </div>
        <div class="emp-page-hero-right" style="display:flex;gap:.5rem;flex-wrap:wrap;">
            <button type="button" class="emp-btn emp-btn-outline" onclick="empModalOpen('versionsModal')">
                <i class="fas fa-clock-rotate-left"></i>
                <span>Versions</span>
                @if (inputVersions.Any()) { <span class="emp-modal-count-chip">@inputVersions.Count</span> }
            </button>
            <button type="button" class="emp-btn emp-btn-outline" onclick="empModalOpen('notesModal')">
                <i class="fas fa-note-sticky"></i>
                <span>Notes</span>
                @if (noteVersions.Any()) { <span class="emp-modal-count-chip">@noteVersions.Count</span> }
            </button>
            <a asp-area="ProjectManager"
               asp-controller="Project"
               asp-action="Milestone"
               asp-route-projectMilestoneId="@Model.ProjectMilestoneId"
               class="emp-btn emp-btn-outline">
                <i class="fas fa-arrow-left me-1"></i>Back to Milestone
            </a>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="emp-alert emp-alert-success">
        <i class="fas fa-check-circle emp-alert-icon"></i>
        <span>@TempData["SuccessMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="emp-alert emp-alert-error">
        <i class="fas fa-exclamation-circle emp-alert-icon"></i>
        <span>@TempData["ErrorMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()">×</button>
    </div>
}

<!-- Instructions -->
<div class="emp-detail-card">
    <div class="emp-detail-card-header">
        <span style="font-size:.95rem;font-weight:700;color:#1e293b;"><i class="fas fa-list-ul" style="color:#006994;margin-right:.4rem;"></i> Task Instructions</span>
    </div>
    <div class="emp-detail-body">
        <div class="task-review-content">@Html.Raw(Model.Instructions)</div>
    </div>
</div>

<!-- Employee Submission -->
<div class="emp-detail-card" style="margin-top:1.25rem;">
    <div class="emp-detail-card-header">
        <span style="font-size:.95rem;font-weight:700;color:#1e293b;"><i class="fas fa-upload" style="color:#006994;margin-right:.4rem;"></i> Employee Submission</span>
    </div>
    <div class="emp-detail-body">
        <div class="task-review-content">
            @if (!string.IsNullOrWhiteSpace(Model.EmployeeInput))
            {
                @Html.Raw(Model.EmployeeInput)
            }
            else
            {
                <span class="task-review-empty">No submission yet.</span>
            }
        </div>
    </div>
</div>

<!-- Feedback / Notes -->
<div class="emp-detail-card" style="margin-top:1.25rem;">
    <div class="emp-detail-card-header">
        <span style="font-size:.95rem;font-weight:700;color:#1e293b;"><i class="fas fa-pen-to-square" style="color:#006994;margin-right:.4rem;"></i>Review &amp; Feedback</span>
        <span class="emp-badge-white" title="Status">
            <span class="emp-status-inline @GetStatusClass(Model.Status)">
                <span class="emp-status-dot"></span>
                <span class="emp-status-text">@Model.Status</span>
            </span>
        </span>
    </div>
    <div class="emp-detail-body">
        <form asp-area="ProjectManager" asp-controller="Project" asp-action="Task" method="post" id="taskReviewForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="action" id="actionHidden" value="" />

            <div style="margin-bottom:1rem;">
                <label for="Notes" style="font-size:.85rem;font-weight:600;color:#374151;display:block;margin-bottom:.4rem;">Feedback / Note</label>
                <textarea id="Notes" name="Notes" rows="5"
                    style="width:100%;padding:.7rem .9rem;border:1.5px solid #e2e8f0;border-radius:10px;font-size:.875rem;font-family:inherit;color:#1e293b;outline:none;resize:vertical;transition:border-color .25s ease,box-shadow .25s ease;"
                    onfocus="this.style.borderColor='#4CA3DD';this.style.boxShadow='0 0 0 3px rgba(76,163,221,.1)'"
                    onblur="this.style.borderColor='#e2e8f0';this.style.boxShadow='none'">@Model.Notes</textarea>
            </div>

            <div style="display:flex;justify-content:flex-end;align-items:center;gap:.625rem;flex-wrap:wrap;">
                <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:nowrap;">
                    <label for="statusSelect" style="font-weight:600;color:#374151;margin-right:.25rem;white-space:nowrap;">Set status</label>
                    <select id="statusSelect" class="emp-select" style="min-width:160px;padding:.45rem .65rem;border-radius:10px;border:1.5px solid #e2e8f0;font-size:.9rem;">
                        <option value="Checked">Mark as Checked</option>
                        <option value="RequireRevision">Require Revision</option>
                    </select>
                    <button type="button" class="emp-btn" style="background:linear-gradient(135deg,#006994,#4CA3DD);color:#fff;padding:.5rem .8rem;"
                            onclick="document.getElementById('actionHidden').value = document.getElementById('statusSelect').value; confirmUpdateStatus();">
                        <i class="fas fa-arrow-up-right-from-square"></i> Update Status
                    </button>
                </div>

                <div style="display:flex;align-items:center;">
                    <button type="button" onclick="document.getElementById('actionHidden').value=''; document.getElementById('taskReviewForm').submit();"
                        class="emp-btn" style="background:linear-gradient(135deg,#006994,#4CA3DD);color:#fff;padding:.5rem .8rem;">
                        <i class="fas fa-paper-plane"></i> Save Note
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
function confirmUpdateStatus() {
    const sel = document.getElementById('statusSelect');
    if (!sel) return;
    const v = sel.value;
    if (v === 'Checked') {
        // Show confirmation modal
        const modal = document.getElementById('confirmActionModal');
        const modalMsg = document.getElementById('confirmActionMessage');
        const cancelBtn = document.getElementById('confirmActionCancel');
        const confirmBtn = document.getElementById('confirmActionConfirm');
        if (!modal) { document.getElementById('taskReviewForm').submit(); return; }

        if (modalMsg) modalMsg.textContent = 'Mark this task as Checked?';

        function hideModal() {
            modal.style.display = 'none';
            modal.setAttribute('aria-hidden', 'true');
            cleanup();
        }
        function onConfirm() {
            hideModal();
            document.getElementById('taskReviewForm').submit();
        }
        function onOverlay(e) { if (e.target === modal) hideModal(); }
        function cleanup() {
            cancelBtn?.removeEventListener('click', hideModal);
            confirmBtn?.removeEventListener('click', onConfirm);
            modal?.removeEventListener('click', onOverlay);
        }

        cancelBtn?.addEventListener('click', hideModal);
        confirmBtn?.addEventListener('click', onConfirm);
        modal?.addEventListener('click', onOverlay);

        modal.style.display = 'flex';
        modal.setAttribute('aria-hidden', 'false');
        return;
    }
    // Require Revision — submit without extra confirmation
    document.getElementById('taskReviewForm').submit();
}
</script>

<!-- ===== Versions Modal ===== -->
<div id="versionsModal" class="emp-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="versionsModalTitle">
    <div class="emp-modal">
        <div class="emp-modal-header">
            <h5 id="versionsModalTitle" class="emp-modal-title"><i class="fas fa-clock-rotate-left"></i> Versions</h5>
            <button class="emp-modal-close" onclick="empModalClose('versionsModal')" aria-label="Close"><i class="fas fa-times"></i></button>
        </div>
        <div class="emp-modal-body">
            <div class="emp-version-item emp-version-current mb-2">
                <strong>Current</strong> — @Model.Name
                <div class="emp-modal-meta"><i class="far fa-calendar"></i> Latest submission</div>
            </div>
            @if (inputVersions.Any())
            {
                @foreach (var v in inputVersions)
                {
                    <div class="emp-version-item mb-2">
                        <a asp-area="ProjectManager" asp-controller="Project" asp-action="TaskVersion" asp-route-id="@v.Id">
                            <strong>Version @v.VersionNumber</strong>
                        </a>
                        <div class="emp-modal-meta"><i class="far fa-calendar"></i> Saved @v.DateCreated.ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                }
            }
            else
            {
                <div class="emp-modal-empty"><i class="fas fa-layer-group"></i><span>No previous versions.</span></div>
            }
        </div>
    </div>
</div>

<!-- ===== Notes Modal ===== -->
<div id="notesModal" class="emp-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="notesModalTitle">
    <div class="emp-modal">
        <div class="emp-modal-header">
            <h5 id="notesModalTitle" class="emp-modal-title"><i class="fas fa-note-sticky"></i> Notes</h5>
            <button class="emp-modal-close" onclick="empModalClose('notesModal')" aria-label="Close"><i class="fas fa-times"></i></button>
        </div>
        <div class="emp-modal-body">
            @if (!string.IsNullOrWhiteSpace(Model.Notes) || orderedNotes.Any())
            {
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="emp-note-item emp-note-current mb-2">
                        <strong>Current</strong>
                        <div class="emp-note-content mt-2">@Html.Raw(Model.Notes)</div>
                    </div>
                }
                @foreach (var n in orderedNotes)
                {
                    <div class="emp-note-item mb-2">
                        <strong>
                            <a asp-area="ProjectManager" asp-controller="Project" asp-action="TaskNote" asp-route-id="@n.Id">Version @n.VersionNumber</a>
                        </strong>
                        <div class="emp-modal-meta"><i class="far fa-calendar"></i> Saved @n.DateCreated.ToString("yyyy-MM-dd HH:mm")</div>
                        <div class="emp-note-content mt-2">@Html.Raw(n.Note)</div>
                    </div>
                }
            }
            else
            {
                <div class="emp-modal-empty"><i class="fas fa-note-sticky"></i><span>No notes available.</span></div>
            }
        </div>
    </div>
</div>

<script>
function empModalOpen(id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.add('emp-modal-visible');
    document.body.style.overflow = 'hidden';
}
function empModalClose(id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.remove('emp-modal-visible');
    document.body.style.overflow = '';
}
document.querySelectorAll('.emp-modal-overlay').forEach(function(overlay) {
    overlay.addEventListener('click', function(e) {
        if (e.target === overlay) empModalClose(overlay.id);
    });
});
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        document.querySelectorAll('.emp-modal-overlay.emp-modal-visible').forEach(function(m) {
            empModalClose(m.id);
        });
    }
});
</script>
@functions {
    private string GetStatusClass(string status) => status switch
    {
        "Pending"          => "emp-status-pending",
        "Checked"          => "emp-status-approved",
        "Require Revision" => "emp-status-revision",
        _                  => "emp-status-default"
    };
}