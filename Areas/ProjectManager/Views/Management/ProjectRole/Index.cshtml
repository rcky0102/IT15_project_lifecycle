@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<project_lifecycle.Models.ProjectRole>
@{
    ViewData["Title"] = "Project Role Management";
    Layout = "~/Areas/ProjectManager/Layout.cshtml";
    var archiveFilter = ViewData["ArchiveFilter"]?.ToString() ?? "active";
}

<!-- ===== Page Hero ===== -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-user-tag"></i></span>
                Project Role Management
            </h1>
            <p class="emp-page-subtitle">Manage roles used in projects</p>
        </div>
        <div class="emp-page-hero-right">
            <button type="button" class="emp-btn emp-btn-outline" data-bs-toggle="modal" data-bs-target="#createRoleModal">
                <i class="fas fa-plus"></i>
                <span>Add Role</span>
            </button>
        </div>
    </div>
</div>

<!-- ===== Alerts ===== -->
<!-- ===== Alerts ===== -->
@if (TempData["Success"] != null)
{
    <div class="emp-alert emp-alert-success">
        <div class="emp-alert-icon"><i class="fas fa-check-circle"></i></div>
        <span>@TempData["Success"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}

<!-- Stats bar removed -->

<!-- ===== Filters ===== -->
<div class="emp-filters-card">
    <div class="emp-filters-row">
        <div class="emp-search-group">
            <i class="fas fa-magnifying-glass emp-search-icon"></i>
            <input id="rolesSearch" type="text" class="emp-search-input" placeholder="Search roles…" autocomplete="off" />
        </div>
        <div class="emp-select-group">
            <select id="rolesArchiveFilter" class="emp-select">
                @if (archiveFilter == "active") { <option value="active" selected>Active</option> } else { <option value="active">Active</option> }
                @if (archiveFilter == "inactive") { <option value="inactive" selected>Archived</option> } else { <option value="inactive">Archived</option> }
                @if (archiveFilter == "all") { <option value="all" selected>All</option> } else { <option value="all">All</option> }
            </select>
        </div>
        <div class="emp-select-group">
            <label for="rolesPageSizeSelect" style="font-size:.82rem;color:var(--emp-muted);margin-right:.4rem;">Show</label>
            <select id="rolesPageSizeSelect" class="emp-select" style="width:92px;">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
    </div>
</div>

<!-- ===== Table ===== -->
<div class="project-table-section">
    <div class="project-table-card">
        @if (Model.Any())
                    {
                        <div class="project-table-responsive">
                            <table class="project-table" id="rolesTable">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Description</th>
                                        <th>Date Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="rolesBody">
                                    @foreach (var item in Model)
                                    {
                                        <tr class="emp-row @(item.IsArchived ? "emp-row-archived" : "")" data-name="@item.Name.ToLower()" data-archived="@(item.IsArchived.ToString().ToLower())">
                                            <td>
                                                <div class="project-name-cell">
                                                    <div class="project-name-icon">
                                                        <i class="fas fa-user-tag"></i>
                                                    </div>
                                                    <div>
                                                        <div class="project-name-text">@item.Name</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.Description))
                                                {
                                                    @item.Description
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No description</span>
                                                }
                                            </td>
                                            <td>@item.DateCreated.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <div style="display:inline-flex;align-items:center;gap:.35rem;">
                                                    <button type="button" class="emp-action-btn emp-action-edit" onclick="editRole(@item.Id)" title="Edit">
                                                        <i class="fas fa-pen-to-square"></i>
                                                    </button>
                                                    @if (!item.IsArchived)
                                                    {
                                                        <button type="button"
                                                                class="emp-action-btn emp-action-archive"
                                                                title="Archive"
                                                                data-action="@Url.Action("ArchiveProjectRole", "Management", new { area = "ProjectManager" })"
                                                                data-id="@item.Id"
                                                                data-message="Archive this project role?">
                                                            <i class="fas fa-box-archive"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class="emp-action-btn emp-action-unarchive"
                                                                title="Unarchive"
                                                                data-action="@Url.Action("UnarchiveProjectRole", "Management", new { area = "ProjectManager" })"
                                                                data-id="@item.Id"
                                                                data-message="Unarchive this project role?">
                                                            <i class="fas fa-box-open"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div id="noFilterResults" class="project-empty-state" style="display:none;">
                            <div class="project-empty-icon"><i class="fas fa-magnifying-glass"></i></div>
                            <div class="project-empty-title">No matching roles</div>
                            <div class="project-empty-text">Try adjusting your search.</div>
                        </div>

                        <div class="emp-pagination" id="rolesPaginationContainer" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem;padding:.75rem 1.25rem;box-sizing:border-box;">
                            <div class="emp-pagination-info" id="rolesPaginationInfo"></div>
                            <div class="emp-pagination-controls" id="rolesPaginationControls"></div>
                        </div>
                    }
                    else
                    {
                        <div class="project-empty-state">
                            <div class="project-empty-icon"><i class="fas fa-user-tag"></i></div>
                            <div class="project-empty-title">No roles created</div>
                            <div class="project-empty-text">Create your first project role to get started.</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Role Modal -->
<div class="modal fade" id="createRoleModal" tabindex="-1" aria-labelledby="createRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content emp-modal-modern">
            <div class="emp-modal-header">
                <h5 class="emp-modal-title" id="createRoleModalLabel">
                    <i class="fas fa-user-tag"></i> Create New Project Role
                </h5>
                <button type="button" class="emp-modal-close" data-bs-dismiss="modal" aria-label="Close"><i class="fas fa-times"></i></button>
            </div>
            <div class="emp-modal-body">
                <form id="createRoleForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="emp-form-label">Role Name <span class="text-danger">*</span></label>
                        <input name="Name" class="emp-form-control" id="roleName" placeholder="Enter role name" />
                        <span class="emp-form-error" data-valmsg-for="Name"></span>
                    </div>
                    <div class="mb-0">
                        <label class="emp-form-label">Description</label>
                        <textarea name="Description" class="emp-form-control" id="roleDescription" rows="4" placeholder="Enter role description (optional)"></textarea>
                        <span class="emp-form-error" data-valmsg-for="Description"></span>
                    </div>
                </form>
            </div>
            <div class="emp-modal-footer">
                <button type="button" class="emp-btn emp-btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="emp-btn emp-btn-primary" id="saveRoleBtn">
                    <i class="fas fa-plus"></i> Create Role
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Role Modal -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-labelledby="editRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content emp-modal-modern">
            <div class="emp-modal-header">
                <h5 class="emp-modal-title" id="editRoleModalLabel">
                    <i class="fas fa-edit"></i> Edit Project Role
                </h5>
                <button type="button" class="emp-modal-close" data-bs-dismiss="modal" aria-label="Close"><i class="fas fa-times"></i></button>
            </div>
            <div class="emp-modal-body">
                <form id="editRoleForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editRoleId" />
                    <input type="hidden" id="editRoleDateCreated" />
                    <div class="mb-4">
                        <label class="emp-form-label">Role Name <span class="text-danger">*</span></label>
                        <input name="Name" class="emp-form-control" id="editRoleName" placeholder="Enter role name" />
                        <span class="emp-form-error" data-valmsg-for="Name"></span>
                    </div>
                    <div class="mb-0">
                        <label class="emp-form-label">Description</label>
                        <textarea name="Description" class="emp-form-control" id="editRoleDescription" rows="4" placeholder="Enter role description (optional)"></textarea>
                        <span class="emp-form-error" data-valmsg-for="Description"></span>
                    </div>
                </form>
            </div>
            <div class="emp-modal-footer">
                <button type="button" class="emp-btn emp-btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="emp-btn emp-btn-primary" id="updateRoleBtn">
                    <i class="fas fa-save"></i> Update Role
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Archive / Unarchive Confirmation Modal -->
<div class="emp-modal-backdrop" id="confirmActionModal" role="dialog" aria-modal="true" aria-hidden="true" style="display:none;">
    <div class="emp-modal" role="document">
        <h4 id="confirmActionTitle"><i class="fas fa-exclamation-triangle"></i> Confirm</h4>
        <p id="confirmActionMessage">Are you sure?</p>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn emp-btn-cancel" id="confirmActionCancel">Cancel</button>
            <form id="confirmActionForm" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="confirmActionId" value="" />
                <button type="submit" class="emp-btn emp-btn-confirm" id="confirmActionConfirm">Confirm</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        /* Modern Modal Styling */
        .emp-modal-modern {
            border: none;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(2, 6, 23, 0.15);
            overflow: hidden;
        }

        .emp-modal-header {
            background: linear-gradient(135deg, #006994, #4CA3DD);
            border: none;
            padding: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .emp-modal-header-danger {
            background: linear-gradient(135deg, #dc2626, #ef4444);
        }

        .emp-modal-title {
            margin: 0;
            font-size: 1.1rem;
            font-weight: 600;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .emp-modal-close {
            background: transparent;
            border: none;
            color: #fff;
            font-size: 1.25rem;
            cursor: pointer;
            padding: 0;
            width: 2rem;
            height: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            transition: background-color 0.2s;
        }

        .emp-modal-close:hover {
            background-color: rgba(255, 255, 255, 0.2);
        }

        .emp-modal-body {
            padding: 2rem;
        }

        .emp-modal-footer {
            background-color: #f8fafc;
            border-top: 1px solid #e2e8f0;
            padding: 1.25rem;
            display: flex;
            gap: 0.75rem;
            justify-content: flex-end;
        }

        /* Form Styling in Modals */
        .emp-form-label {
            display: block;
            font-size: 0.875rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: 0.5rem;
        }

        .emp-form-control {
            width: 100%;
            padding: 0.65rem 0.85rem;
            border: 1.5px solid #e2e8f0;
            border-radius: 8px;
            font-size: 0.875rem;
            font-family: inherit;
            color: #1e293b;
            outline: none;
            transition: border-color 0.25s ease, box-shadow 0.25s ease;
        }

        .emp-form-control:focus {
            border-color: #4CA3DD;
            box-shadow: 0 0 0 3px rgba(76, 163, 221, 0.1);
        }

        .emp-form-error {
            display: block;
            font-size: 0.75rem;
            color: #dc2626;
            margin-top: 0.25rem;
        }

        /* Alert and Info Styling */
        .emp-danger-alert {
            display: flex;
            gap: 0.75rem;
            align-items: flex-start;
            padding: 1rem;
            background: linear-gradient(135deg, #fee2e2, #fecaca);
            border: 1px solid #fca5a5;
            border-radius: 8px;
            color: #991b1b;
            font-size: 0.875rem;
        }

        .emp-danger-alert i {
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .emp-info-box {
            padding: 1rem;
            background-color: #f0f9ff;
            border: 1px solid #bae6fd;
            border-radius: 8px;
            font-size: 0.875rem;
            color: #0c4a6e;
        }

        .emp-highlight-text {
            font-weight: 600;
            color: #006994;
        }

    </style>
    <script>
        $(document).ready(function() {
            // Create role
            $('#saveRoleBtn').click(function() {
                var form = $('#createRoleForm');
                var token = form.find('input[name="__RequestVerificationToken"]').val();
                var data = {
                    Name: $('#roleName').val(),
                    Description: $('#roleDescription').val()
                };

                $.ajax({
                    url: '@Url.Action("CreateProjectRole", "Management", new { area = "ProjectManager" })',
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    data: data,
                    success: function(res) {
                        if (res.success) location.reload();
                        else if (res.errors) {
                            $('.emp-form-error').text('');
                            for (var key in res.errors) {
                                var msgs = res.errors[key];
                                $('[data-valmsg-for="' + key.split('.').pop() + '"]').text(msgs.join(', '));
                            }
                        }
                    }
                });
            });

            $('#createRoleModal').on('hidden.bs.modal', function () { $('#createRoleForm')[0].reset(); $('.emp-form-error').text(''); });

            window.editRole = function(id) {
                var token = $('input[name="__RequestVerificationToken"]').first().val();
                $.ajax({
                    url: '@Url.Action("GetProjectRoleById", "Management", new { area = "ProjectManager" })',
                    method: 'GET',
                    data: { id: id },
                    headers: { 'RequestVerificationToken': token },
                    success: function(res) {
                        if (res && res.success) {
                            $('#editRoleId').val(res.id);
                            $('#editRoleName').val(res.name);
                            $('#editRoleDescription').val(res.description);
                            $('#editRoleDateCreated').val(res.dateCreated);
                            $('#editRoleModal').modal('show');
                        } else {
                            alert(res.message || 'Unable to load role details.');
                        }
                    },
                    error: function() { alert('Unable to load role details.'); }
                });
            };

            $('#updateRoleBtn').click(function() {
                var form = $('#editRoleForm');
                var token = form.find('input[name="__RequestVerificationToken"]').val();
                var id = $('#editRoleId').val();
                var data = {
                    Id: id,
                    Name: $('#editRoleName').val(),
                    Description: $('#editRoleDescription').val(),
                    DateCreated: $('#editRoleDateCreated').val()
                };

                $.ajax({
                    url: '@Url.Action("EditProjectRole", "Management", new { area = "ProjectManager" })',
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    data: data,
                    success: function(res) {
                        if (res.success) location.reload();
                        else if (res.errors) {
                            $('.emp-form-error').text('');
                            for (var key in res.errors) {
                                var msgs = res.errors[key];
                                $('[data-valmsg-for="' + key.split('.').pop() + '"]').text(msgs.join(', '));
                            }
                        }
                    }
                });
            });

            // Confirm archive / unarchive
            var confirmModal = document.getElementById('confirmActionModal');
            var confirmForm  = document.getElementById('confirmActionForm');
            var confirmId    = document.getElementById('confirmActionId');
            var confirmMsg   = document.getElementById('confirmActionMessage');

            function showConfirmModal(actionUrl, id, message) {
                confirmForm.action  = actionUrl;
                confirmId.value     = id;
                confirmMsg.textContent = message;
                confirmModal.style.display = 'flex';
                confirmModal.setAttribute('aria-hidden', 'false');
            }
            function hideConfirmModal() {
                confirmModal.style.display = 'none';
                confirmModal.setAttribute('aria-hidden', 'true');
            }
            document.getElementById('confirmActionCancel').addEventListener('click', hideConfirmModal);
            confirmModal.addEventListener('click', function(e) { if (e.target === confirmModal) hideConfirmModal(); });

            document.querySelectorAll('.emp-action-archive, .emp-action-restore, .emp-action-unarchive').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var action  = btn.getAttribute('data-action');
                    var id      = btn.getAttribute('data-id');
                    var message = btn.getAttribute('data-message') || 'Are you sure?';
                    if (!action || !id) return;
                    showConfirmModal(action, id, message);
                });
            });
        });
    </script>
}
    <script>
(function () {
    let PAGE_SIZE = 10;
    let currentPage = 1;
    let filteredRows = [];

    const searchInput    = document.getElementById('rolesSearch');
    const allRows        = Array.from(document.querySelectorAll('.emp-row'));
    const noResults      = document.getElementById('noFilterResults');
    const pageInfo       = document.getElementById('rolesPaginationInfo');
    const pageControls   = document.getElementById('rolesPaginationControls');
    const pageSizeSelect = document.getElementById('rolesPageSizeSelect');

    function applyFilters() {
        const query = (searchInput?.value ?? '').toLowerCase().trim();
        filteredRows = allRows.filter(row => {
            const name = (row.dataset.name || '');
            return !query || name.includes(query);
        });
        currentPage = 1;
        render();
    }

    function render() {
        const total      = filteredRows.length;
        const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
        currentPage      = Math.min(currentPage, totalPages);
        const start      = (currentPage - 1) * PAGE_SIZE;
        const end        = start + PAGE_SIZE;

        allRows.forEach(r => r.style.display = 'none');
        filteredRows.forEach((r, i) => {
            r.style.display = (i >= start && i < end) ? '' : 'none';
        });

        if (noResults) noResults.style.display = total === 0 ? '' : 'none';

        if (pageInfo) {
            pageInfo.textContent = total === 0 ? '' : `Showing ${start + 1}\u2013${Math.min(end, total)} of ${total}`;
        }

        if (pageControls) {
            pageControls.innerHTML = '';
            const makeBtn = (label, page, disabled, active) => {
                const btn = document.createElement('button');
                btn.className = 'emp-page-btn' + (active ? ' active' : '');
                btn.innerHTML = label;
                btn.disabled  = disabled;
                btn.addEventListener('click', () => { currentPage = page; render(); });
                return btn;
            };
            pageControls.appendChild(makeBtn('<i class="fas fa-chevron-left"></i>', currentPage - 1, currentPage === 1, false));
            const w = 2;
            for (let p = 1; p <= totalPages; p++) {
                if (p === 1 || p === totalPages || (p >= currentPage - w && p <= currentPage + w)) {
                    pageControls.appendChild(makeBtn(p, p, false, p === currentPage));
                } else if (p === currentPage - w - 1 || p === currentPage + w + 1) {
                    const el = document.createElement('span');
                    el.className = 'emp-page-ellipsis';
                    el.textContent = '\u2026';
                    pageControls.appendChild(el);
                }
            }
            pageControls.appendChild(makeBtn('<i class="fas fa-chevron-right"></i>', currentPage + 1, currentPage === totalPages, false));
        }
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);

    if (pageSizeSelect) {
        pageSizeSelect.value = String(PAGE_SIZE);
        pageSizeSelect.addEventListener('change', function () {
            const val = parseInt(pageSizeSelect.value, 10) || 10;
            PAGE_SIZE = Math.max(5, val);
            currentPage = 1;
            render();
        });
    }

    const archiveSelect = document.getElementById('rolesArchiveFilter');
    if (archiveSelect) archiveSelect.addEventListener('change', () => {
        const url = new URL(window.location.href);
        if (archiveSelect.value === 'active') url.searchParams.delete('archiveFilter');
        else url.searchParams.set('archiveFilter', archiveSelect.value);
        window.location.href = url.toString();
    });

    filteredRows = allRows.slice();
    render();
})();
    </script>
