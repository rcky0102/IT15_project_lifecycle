@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<project_lifecycle.Models.Milestone>
@{
    ViewData["Title"] = "Milestone Management";
    Layout = "~/Areas/ProjectManager/Layout.cshtml";
}

<!-- ===== Page Hero ===== -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-flag"></i></span>
                Milestone Management
            </h1>
            <p class="emp-page-subtitle">Manage project milestones globally</p>
        </div>
        <div class="emp-page-hero-right">
            <button type="button" class="emp-btn emp-btn-primary" data-bs-toggle="modal" data-bs-target="#createMilestoneModal">
                <i class="fas fa-plus"></i>
                <span>Add Milestone</span>
            </button>
        </div>
    </div>
</div>

<!-- ===== Alerts ===== -->
<!-- ===== Alerts ===== -->
@if (TempData["Success"] != null)
{
    <div class="emp-alert emp-alert-success">
        <div class="emp-alert-icon"><i class="fas fa-check-circle"></i></div>
        <span>@TempData["Success"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}

<!-- ===== Stats Bar ===== -->
<div class="project-stats-bar">
    <div class="project-stat-card">
        <div class="project-stat-icon blue">
            <i class="fas fa-flag"></i>
        </div>
        <div class="project-stat-info">
            <span class="project-stat-value">@Model.Count()</span>
            <span class="project-stat-label">Total Milestones</span>
        </div>
    </div>
</div>

<!-- ===== Filters ===== -->
<div class="emp-filters-card">
    <div class="emp-filters-row">
        <div class="emp-search-group">
            <i class="fas fa-magnifying-glass emp-search-icon"></i>
            <input id="milestonesSearch" type="text" class="emp-search-input" placeholder="Search milestones…" autocomplete="off" />
        </div>
    </div>
</div>

<!-- ===== Table ===== -->
<div class="project-table-section">
    <div class="project-table-card">
        @if (Model.Any())
                    {
                        <div class="project-table-responsive">
                            <table class="project-table" id="milestonesTable">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Description</th>
                                        <th>Date Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="milestonesBody">
                                    @foreach (var item in Model)
                                    {
                                        <tr class="emp-row" data-name="@item.Name.ToLower()">
                                            <td>
                                                <div class="project-name-cell">
                                                    <div class="project-name-icon">
                                                        <i class="fas fa-flag"></i>
                                                    </div>
                                                    <div>
                                                        <div class="project-name-text">@item.Name</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.Description))
                                                {
                                                    @item.Description
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No description</span>
                                                }
                                            </td>
                                            <td>@item.DateCreated.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <div style="display:flex;gap:.4rem;flex-wrap:wrap;">
                                                    <button type="button" class="emp-btn emp-btn-xs emp-btn-outline" onclick="editMilestone(@item.Id)" title="Edit">
                                                        <i class="fas fa-edit"></i> Edit
                                                    </button>
                                                    <button type="button" class="emp-btn emp-btn-xs emp-btn-danger" onclick="confirmDelete(@item.Id, '@Html.Raw(item.Name.Replace("'", "\\'"))')" title="Delete">
                                                        <i class="fas fa-trash"></i> Delete
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div id="noFilterResults" class="project-empty-state" style="display:none;">
                            <div class="project-empty-icon"><i class="fas fa-magnifying-glass"></i></div>
                            <div class="project-empty-title">No matching milestones</div>
                            <div class="project-empty-text">Try adjusting your search.</div>
                        </div>
                    }
                    else
                    {
                        <div class="project-empty-state">
                            <div class="project-empty-icon"><i class="fas fa-flag"></i></div>
                            <div class="project-empty-title">No milestones created</div>
                            <div class="project-empty-text">Create your first milestone to get started.</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Milestone Modal -->
<div class="modal fade" id="createMilestoneModal" tabindex="-1" aria-labelledby="createMilestoneModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content emp-modal-modern">
            <div class="emp-modal-header">
                <h5 class="emp-modal-title" id="createMilestoneModalLabel">
                    <i class="fas fa-flag"></i> Create New Milestone
                </h5>
                <button type="button" class="emp-modal-close" data-bs-dismiss="modal" aria-label="Close"><i class="fas fa-times"></i></button>
            </div>
            <div class="emp-modal-body">
                <form id="createMilestoneForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="emp-form-label">Milestone Name <span class="text-danger">*</span></label>
                        <input name="Name" class="emp-form-control" id="milestoneName" placeholder="Enter milestone name" />
                        <span class="emp-form-error" data-valmsg-for="Name"></span>
                    </div>
                    <div class="mb-0">
                        <label class="emp-form-label">Description</label>
                        <textarea name="Description" class="emp-form-control" id="milestoneDescription" rows="4" placeholder="Enter milestone description (optional)"></textarea>
                        <span class="emp-form-error" data-valmsg-for="Description"></span>
                    </div>
                </form>
            </div>
            <div class="emp-modal-footer">
                <button type="button" class="emp-btn emp-btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="emp-btn emp-btn-primary" id="saveMilestoneBtn">
                    <i class="fas fa-plus"></i> Create Milestone
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Milestone Modal -->
<div class="modal fade" id="editMilestoneModal" tabindex="-1" aria-labelledby="editMilestoneModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content emp-modal-modern">
            <div class="emp-modal-header">
                <h5 class="emp-modal-title" id="editMilestoneModalLabel">
                    <i class="fas fa-edit"></i> Edit Milestone
                </h5>
                <button type="button" class="emp-modal-close" data-bs-dismiss="modal" aria-label="Close"><i class="fas fa-times"></i></button>
            </div>
            <div class="emp-modal-body">
                <form id="editMilestoneForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editMilestoneId" />
                    <input type="hidden" id="editDateCreated" />
                    <div class="mb-4">
                        <label class="emp-form-label">Milestone Name <span class="text-danger">*</span></label>
                        <input name="Name" class="emp-form-control" id="editMilestoneName" placeholder="Enter milestone name" />
                        <span class="emp-form-error" data-valmsg-for="Name"></span>
                    </div>
                    <div class="mb-0">
                        <label class="emp-form-label">Description</label>
                        <textarea name="Description" class="emp-form-control" id="editMilestoneDescription" rows="4" placeholder="Enter milestone description (optional)"></textarea>
                        <span class="emp-form-error" data-valmsg-for="Description"></span>
                    </div>
                </form>
            </div>
            <div class="emp-modal-footer">
                <button type="button" class="emp-btn emp-btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="emp-btn emp-btn-primary" id="updateMilestoneBtn">
                    <i class="fas fa-save"></i> Update Milestone
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteMilestoneModal" tabindex="-1" aria-labelledby="deleteMilestoneModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content emp-modal-modern">
            <div class="emp-modal-header emp-modal-header-danger">
                <h5 class="emp-modal-title" id="deleteMilestoneModalLabel">
                    <i class="fas fa-exclamation-triangle"></i> Confirm Deletion
                </h5>
                <button type="button" class="emp-modal-close" data-bs-dismiss="modal" aria-label="Close"><i class="fas fa-times"></i></button>
            </div>
            <div class="emp-modal-body">
                <div class="emp-danger-alert">
                    <i class="fas fa-exclamation-circle"></i>
                    <div>
                        <strong>Warning:</strong> Are you sure you want to delete this milestone? This action cannot be undone.
                    </div>
                </div>
                
                <div class="emp-info-box mt-4">
                    <strong>Milestone Name:</strong> <span id="deleteMilestoneName" class="emp-highlight-text"></span>
                </div>
                
                <form id="deleteMilestoneForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteMilestoneId" />
                </form>
            </div>
            <div class="emp-modal-footer">
                <button type="button" class="emp-btn emp-btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="emp-btn emp-btn-danger" id="confirmDeleteBtn">
                    <i class="fas fa-trash"></i> Delete Milestone
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        /* Modern Modal Styling */
        .emp-modal-modern {
            border: none;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(2, 6, 23, 0.15);
            overflow: hidden;
        }

        .emp-modal-header {
            background: linear-gradient(135deg, #006994, #4CA3DD);
            border: none;
            padding: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .emp-modal-header-danger {
            background: linear-gradient(135deg, #dc2626, #ef4444);
        }

        .emp-modal-title {
            margin: 0;
            font-size: 1.1rem;
            font-weight: 600;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .emp-modal-close {
            background: transparent;
            border: none;
            color: #fff;
            font-size: 1.25rem;
            cursor: pointer;
            padding: 0;
            width: 2rem;
            height: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            transition: background-color 0.2s;
        }

        .emp-modal-close:hover {
            background-color: rgba(255, 255, 255, 0.2);
        }

        .emp-modal-body {
            padding: 2rem;
        }

        .emp-modal-footer {
            background-color: #f8fafc;
            border-top: 1px solid #e2e8f0;
            padding: 1.25rem;
            display: flex;
            gap: 0.75rem;
            justify-content: flex-end;
        }

        /* Form Styling in Modals */
        .emp-form-label {
            display: block;
            font-size: 0.875rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: 0.5rem;
        }

        .emp-form-control {
            width: 100%;
            padding: 0.65rem 0.85rem;
            border: 1.5px solid #e2e8f0;
            border-radius: 8px;
            font-size: 0.875rem;
            font-family: inherit;
            color: #1e293b;
            outline: none;
            transition: border-color 0.25s ease, box-shadow 0.25s ease;
        }

        .emp-form-control:focus {
            border-color: #4CA3DD;
            box-shadow: 0 0 0 3px rgba(76, 163, 221, 0.1);
        }

        .emp-form-error {
            display: block;
            font-size: 0.75rem;
            color: #dc2626;
            margin-top: 0.25rem;
        }

        /* Alert and Info Styling */
        .emp-danger-alert {
            display: flex;
            gap: 0.75rem;
            align-items: flex-start;
            padding: 1rem;
            background: linear-gradient(135deg, #fee2e2, #fecaca);
            border: 1px solid #fca5a5;
            border-radius: 8px;
            color: #991b1b;
            font-size: 0.875rem;
        }

        .emp-danger-alert i {
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .emp-info-box {
            padding: 1rem;
            background-color: #f0f9ff;
            border: 1px solid #bae6fd;
            border-radius: 8px;
            font-size: 0.875rem;
            color: #0c4a6e;
        }

        .emp-highlight-text {
            font-weight: 600;
            color: #006994;
        }

        /* Button Styling */
        .emp-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.6rem 1rem;
            border: none;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .emp-btn-primary {
            background: linear-gradient(135deg, #006994, #4CA3DD);
            color: #fff;
        }

        .emp-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(0, 105, 148, 0.3);
        }

        .emp-btn-secondary {
            background-color: #e2e8f0;
            color: #475569;
        }

        .emp-btn-secondary:hover {
            background-color: #cbd5e1;
        }

        .emp-btn-danger {
            background: linear-gradient(135deg, #dc2626, #ef4444);
            color: #fff;
        }

        .emp-btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(220, 38, 38, 0.3);
        }
    </style>
    <script>
        $(document).ready(function() {
            // Create milestone
            $('#saveMilestoneBtn').click(function() {
                var form = $('#createMilestoneForm');
                var token = form.find('input[name="__RequestVerificationToken"]').val();
                var data = {
                    Name: $('#milestoneName').val(),
                    Description: $('#milestoneDescription').val()
                };

                $.ajax({
                    url: '@Url.Action("CreateMilestone", "Management", new { area = "ProjectManager" })',
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    data: data,
                    success: function(res) {
                        if (res.success) location.reload();
                        else if (res.errors) {
                            // simple display
                            $('.emp-form-error').text('');
                            for (var key in res.errors) {
                                var msgs = res.errors[key];
                                $('[data-valmsg-for="' + key.split('.').pop() + '"]').text(msgs.join(', '));
                            }
                        }
                    }
                });
            });

            // Reset form when modal hidden
            $('#createMilestoneModal').on('hidden.bs.modal', function () { $('#createMilestoneForm')[0].reset(); $('.emp-form-error').text(''); });

            // Edit milestone
            window.editMilestone = function(id) {
                var token = $('input[name="__RequestVerificationToken"]').first().val();
                $.ajax({
                    url: '@Url.Action("GetMilestoneById", "Management", new { area = "ProjectManager" })',
                    method: 'GET',
                    data: { id: id },
                    headers: { 'RequestVerificationToken': token },
                    success: function(res) {
                        if (res && res.success) {
                            $('#editMilestoneId').val(res.id);
                            $('#editMilestoneName').val(res.name);
                            $('#editMilestoneDescription').val(res.description);
                            $('#editDateCreated').val(res.dateCreated);
                            $('#editMilestoneModal').modal('show');
                        } else {
                            alert(res.message || 'Unable to load milestone details.');
                        }
                    },
                    error: function() { alert('Unable to load milestone details.'); }
                });
            };

            $('#updateMilestoneBtn').click(function() {
                var form = $('#editMilestoneForm');
                var token = form.find('input[name="__RequestVerificationToken"]').val();
                var id = $('#editMilestoneId').val();
                var data = {
                    Id: id,
                    Name: $('#editMilestoneName').val(),
                    Description: $('#editMilestoneDescription').val(),
                    DateCreated: $('#editDateCreated').val()
                };

                $.ajax({
                    url: '@Url.Action("EditMilestone", "Management", new { area = "ProjectManager" })',
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    data: data,
                    success: function(res) {
                        if (res.success) location.reload();
                        else if (res.errors) {
                            $('.emp-form-error').text('');
                            for (var key in res.errors) {
                                var msgs = res.errors[key];
                                $('[data-valmsg-for="' + key.split('.').pop() + '"]').text(msgs.join(', '));
                            }
                        }
                    }
                });
            });

            // Confirm delete
            window.confirmDelete = function(id, name) {
                $('#deleteMilestoneId').val(id);
                $('#deleteMilestoneName').text(name);
                $('#deleteMilestoneModal').modal('show');
            };

            $('#confirmDeleteBtn').click(function() {
                var form = $('#deleteMilestoneForm');
                var token = form.find('input[name="__RequestVerificationToken"]').val();
                var id = $('#deleteMilestoneId').val();

                $.ajax({
                    url: '@Url.Action("DeleteMilestone", "Management", new { area = "ProjectManager" })',
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    data: { id: id },
                    success: function(res) {
                        if (res.success) location.reload();
                        else alert(res.message || 'Unable to delete');
                    }
                });
            });
        });
    </script>

    <script>
        // Search functionality
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('milestonesSearch');
            const table = document.getElementById('milestonesTable');
            const noResults = document.getElementById('noFilterResults');
            const tbody = document.getElementById('milestonesBody');

            if (searchInput && table) {
                searchInput.addEventListener('keyup', function () {
                    const filter = this.value.toLowerCase();
                    let visibleCount = 0;

                    Array.from(tbody.getElementsByTagName('tr')).forEach(row => {
                        const name = row.getAttribute('data-name') || '';
                        if (name.includes(filter)) {
                            row.style.display = '';
                            visibleCount++;
                        } else {
                            row.style.display = 'none';
                        }
                    });

                    noResults.style.display = visibleCount === 0 && filter ? '' : 'none';
                });
            }
        });
    </script>
