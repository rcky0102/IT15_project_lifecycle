@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/ProjectManager/Layout.cshtml";

    var tasksCompletion = (int)(ViewData["TasksCompletion"] ?? 0);
}

<div class="dashboard-container">
    <!-- Dashboard Header -->
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="dashboard-title">Project Manager Dashboard</h1>
            <p class="dashboard-subtitle">Executive overview of projects, milestones, and team health</p>
        </div>
        <div class="header-actions">
            <a href="@Url.Action("Index", "Project", new { area = "ProjectManager" })" class="btn btn-ocean">
                <i class="fas fa-plus"></i>
                New Project
            </a>
            <a href="@Url.Action("Index", "Dashboard", new { area = "ProjectManager" })" class="btn btn-outline-ocean">
                <i class="fas fa-sync"></i>
                Refresh
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon primary">
                <i class="fas fa-list-check"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number">@ViewData["OpenTasks"]</div>
                <div class="stat-label">Open Tasks</div>
                <div class="stat-change positive">
                    <i class="fas fa-arrow-up"></i> pending
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon success">
                <i class="fas fa-folder-open"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number">@ViewData["ActiveProjects"]</div>
                <div class="stat-label">Active Projects</div>
                <div class="stat-change neutral">
                    <i class="fas fa-minus"></i> stable
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon warning">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number">@ViewData["UpcomingDeadlines"]</div>
                <div class="stat-label">Due in 30 days</div>
                <div class="stat-change negative">
                    <i class="fas fa-exclamation-triangle"></i> attention
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon info">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <div class="stat-number">@ViewData["TeamMembers"]</div>
                <div class="stat-label">Team Members</div>
                <div class="stat-change neutral">
                    <i class="fas fa-user-friends"></i> across projects
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="charts-row">
        <div class="chart-container">
            <div class="chart-header">
                <h3 id="projChartTitle">Tasks Completed</h3>
                <div class="chart-actions">
                    <select id="projRangeSelect" class="form-select form-select-sm">
                        <option value="7" selected>Last 7 days</option>
                        <option value="30">Last 30 days</option>
                        <option value="90">Last 90 days</option>
                    </select>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="projectsProgressChart" height="300"></canvas>
            </div>
        </div>

        <div class="chart-container">
            <div class="chart-header">
                <h3>Task Status</h3>
                <div class="chart-actions">
                    <a href="@Url.Action("Index", "Project", new { area = "ProjectManager" })" class="btn btn-sm btn-outline-ocean">View All</a>
                </div>
            </div>
            <div class="chart-body">
                <canvas id="taskDistributionChart" height="300"></canvas>
            </div>
        </div>
    </div>

    <!-- Activity and Quick Actions -->
    <div class="content-row">
        <div class="activity-panel">
            <div class="panel-header">
                <h3>Recent Activity</h3>
                <a href="@Url.Action("Index", "Project", new { area = "ProjectManager" })" class="btn btn-sm btn-link">View All</a>
            </div>
            <div class="activity-list">
                <div class="activity-item">
                    <div class="activity-icon project">
                        <i class="fas fa-folder-plus"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-title">Project created</div>
                        <div class="activity-description">A new project has been assigned to you</div>
                        <div class="activity-time">Recently</div>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="activity-icon user">
                        <i class="fas fa-check"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-title">Task marked complete</div>
                        <div class="activity-description">A team member completed a milestone task</div>
                        <div class="activity-time">Today</div>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="activity-icon system">
                        <i class="fas fa-flag-checkered"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-title">Milestone reached</div>
                        <div class="activity-description">Project phase milestone has been achieved</div>
                        <div class="activity-time">This week</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="quick-actions-panel">
            <div class="panel-header">
                <h3>Quick Actions</h3>
            </div>
            <div class="quick-actions-grid">
                <a class="quick-action-btn" href="@Url.Action("Index", "Project", new { area = "ProjectManager" })">
                    <i class="fas fa-plus"></i>
                    <span>Create Project</span>
                </a>
                <a class="quick-action-btn" href="@Url.Action("Milestone", "Management", new { area = "ProjectManager" })">
                    <i class="fas fa-flag-checkered"></i>
                    <span>Milestones</span>
                </a>
                <a class="quick-action-btn" href="@Url.Action("ProjectRole", "Management", new { area = "ProjectManager" })">
                    <i class="fas fa-user-tag"></i>
                    <span>Roles</span>
                </a>
                <a class="quick-action-btn" href="@Url.Action("Index", "Proposal", new { area = "ProjectManager" })">
                    <i class="fas fa-file-lines"></i>
                    <span>Proposals</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Workload Status -->
    <div class="system-status-panel">
        <div class="panel-header">
            <h3>Workload</h3>
            <div class="status-indicator online">
                <span class="status-dot"></span>
                Active
            </div>
        </div>
        <div class="status-grid">
            <div class="status-item">
                <div class="status-info">
                    <div class="status-name">Tasks</div>
                    <div class="status-value">@tasksCompletion% Completed</div>
                </div>
                <div class="status-bar">
                    <div class="status-progress" id="tasksCompletionBar" style="width: @(tasksCompletion)%"></div>
                </div>
            </div>

            <div class="status-item">
                <div class="status-info">
                    <div class="status-name">Due Projects</div>
                    <div class="status-value">@ViewData["UpcomingDeadlines"] due soon</div>
                </div>
                <div class="status-bar">
                    <div class="status-progress" style="width: 40%"></div>
                </div>
            </div>

            <div class="status-item">
                <div class="status-info">
                    <div class="status-name">Open Tasks</div>
                    <div class="status-value">@ViewData["OpenTasks"] in progress</div>
                </div>
                <div class="status-bar">
                    <div class="status-progress" style="width: 60%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            // --- Tasks Completed Trend (line chart) ---
            const projCtx = document.getElementById('projectsProgressChart').getContext('2d');
            const projectsChart = new Chart(projCtx, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [{
                        label: 'Tasks Completed',
                        data: [],
                        borderColor: '#4CA3DD',
                        backgroundColor: 'rgba(76,163,221,0.08)',
                        tension: 0.35,
                        fill: true,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.05)' },
                            ticks: { precision: 0 },
                            title: { display: true, text: 'Tasks completed', color: '#64748b', font: { weight: '600', size: 12 } }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { maxRotation: 0, autoSkip: true },
                            title: { display: true, text: 'Date', color: '#64748b', font: { weight: '600', size: 12 } }
                        }
                    }
                }
            });

            const projRangeSelect = document.getElementById('projRangeSelect');
            const titleEl = document.getElementById('projChartTitle');

            function fetchCompletedTasks(days) {
                const url = '@Url.Action("CompletedTasksTrend","Dashboard", new { area = "ProjectManager" })';
                if (titleEl) titleEl.textContent = `Tasks Completed — Last ${days} days`;
                fetch(url + '?days=' + encodeURIComponent(days))
                    .then(r => r.json())
                    .then(payload => {
                        projectsChart.data.labels = (payload.labels || []).map(l => {
                            const d = new Date(l);
                            return d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' });
                        });
                        projectsChart.data.datasets[0].data = payload.data || [];
                        projectsChart.update();
                    })
                    .catch(() => {
                        // fallback placeholder
                        const now = new Date();
                        const labels = [], data = [];
                        for (let i = days - 1; i >= 0; i--) {
                            const d = new Date(now); d.setDate(d.getDate() - i);
                            labels.push(d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' }));
                            data.push(Math.floor(Math.random() * 5));
                        }
                        projectsChart.data.labels = labels;
                        projectsChart.data.datasets[0].data = data;
                        projectsChart.update();
                    });
            }

            projRangeSelect?.addEventListener('change', function () {
                fetchCompletedTasks(parseInt(this.value || '7', 10));
            });
            fetchCompletedTasks(parseInt(projRangeSelect?.value || '7', 10));

            // --- Task Status (doughnut chart) ---
            const distCtx = document.getElementById('taskDistributionChart').getContext('2d');
            new Chart(distCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Completed', 'In Progress', 'Pending', 'Blocked'],
                    datasets: [{
                        data: [60, 25, 10, 5],
                        backgroundColor: ['#006994', '#4CA3DD', '#94D3FF', '#E8F4F8'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        })();
    </script>
}
