@{
    ViewData["Title"] = "Task";
    var taskId    = ViewData["TaskId"] ?? 0;
    var taskName  = ViewData["TaskName"]?.ToString() ?? "Task";
    var projectId = ViewData["ProjectId"];
    var taskStatus = ViewData["TaskStatus"]?.ToString() ?? "Pending";
    var taskNotes  = ViewData["TaskNotes"]?.ToString() ?? string.Empty;
    var versions   = ViewBag.ProjectTaskVersions as List<project_lifecycle.Models.ProjectTaskVersion>   ?? new List<project_lifecycle.Models.ProjectTaskVersion>();
    var noteVersions = ViewBag.TaskNoteVersions  as List<project_lifecycle.Models.TaskNoteVersion>     ?? new List<project_lifecycle.Models.TaskNoteVersion>();
    var orderedNotes = noteVersions.OrderByDescending(n => n.VersionNumber).ToList();
}

<!-- ===== Page Hero ===== -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-circle-check"></i></span>
                @taskName
            </h1>
            <p class="emp-page-subtitle">Submit your work for this task</p>
        </div>
        <div class="emp-page-hero-right" style="display:flex;gap:.5rem;flex-wrap:wrap;">
            <button type="button" class="emp-btn emp-btn-outline" onclick="empModalOpen('versionsModal')">
                <i class="fas fa-clock-rotate-left"></i>
                <span>Versions</span>
                @if (versions.Any())
                {
                    <span class="emp-modal-count-chip">@versions.Count</span>
                }
            </button>
            <button type="button" class="emp-btn emp-btn-outline" onclick="empModalOpen('notesModal')">
                <i class="fas fa-note-sticky"></i>
                <span>Notes</span>
                @if (noteVersions.Any() || !string.IsNullOrWhiteSpace(taskNotes))
                {
                    <span class="emp-modal-count-chip">@(noteVersions.Any() ? noteVersions.Count : 1)</span>
                }
            </button>
            <a asp-area="Employee" asp-controller="Project" asp-action="Show"
               asp-route-id="@projectId" class="emp-btn emp-btn-outline">
                <i class="fas fa-arrow-left"></i>
                <span>Back to Tasks</span>
            </a>
        </div>
    </div>
</div>

<!-- ===== Alerts ===== -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="emp-alert emp-alert-success">
        <div class="emp-alert-icon"><i class="fas fa-check-circle"></i></div>
        <span>@TempData["SuccessMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="emp-alert emp-alert-error">
        <div class="emp-alert-icon"><i class="fas fa-exclamation-circle"></i></div>
        <span>@TempData["ErrorMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}

<!-- ===== Task Form ===== -->
<div class="emp-form-card">
    <div class="emp-form-section">
        <div style="margin-bottom:1rem;">
            @{
                var statusClass = taskStatus switch
                {
                    "Checked"          => "emp-status-approved",
                    "Require Revision" => "emp-status-revision",
                    _                  => "emp-status-pending"
                };
            }
            <span class="emp-status-badge @statusClass">
                <span class="emp-status-dot"></span>
                @taskStatus
            </span>
        </div>

        @{
            var instructionsObj = ViewData["Instructions"] ?? ViewBag.Instructions;
            var instructions    = instructionsObj == null ? null : instructionsObj.ToString();
        }
        @if (!string.IsNullOrWhiteSpace(instructions))
        {
            <div class="emp-instructions-block">
                <div class="emp-instructions-label"><i class="fas fa-circle-info"></i> Instructions</div>
                <div class="emp-instructions-body">@Html.Raw(instructions)</div>
            </div>
        }

        <form asp-area="Employee" asp-controller="Project" asp-action="Task"
              asp-route-id="@taskId" method="post" class="emp-form">
            @Html.AntiForgeryToken()

            <div class="emp-form-row">
                <label for="Input" class="emp-form-label">Your Input</label>
                <textarea id="Input" name="Input" rows="8" class="emp-form-control">@Html.Raw(ViewData["ExistingInput"] ?? string.Empty)</textarea>
                <div style="margin-top:10px; display:flex; gap:8px; align-items:center;">
                    <button type="button" id="insertRichFileBtn" class="emp-btn emp-btn-outline" style="padding:6px 12px;">
                        <i class="fas fa-paperclip"></i> Add file/image
                    </button>
                    <span style="font-size:12px; opacity:.8;">Max 10 MB (images, PDF, DOCX, XLSX, etc.)</span>
                </div>
                <input type="file" id="richFileInput" style="display:none;" />
            </div>

            <div class="emp-form-actions" style="justify-content:flex-end;">
                <button type="reset" class="emp-btn emp-btn-secondary"><i class="fas fa-rotate-left"></i> Reset</button>
                <button type="submit" id="submitProposalBtn" class="emp-btn emp-btn-primary"><i class="fas fa-paper-plane"></i> Submit Input</button>
            </div>
        </form>
    </div>
</div>

<!-- ===== Versions Modal ===== -->
<div id="versionsModal" class="emp-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="versionsModalTitle">
    <div class="emp-modal">
        <div class="emp-modal-header">
            <h5 id="versionsModalTitle" class="emp-modal-title"><i class="fas fa-clock-rotate-left"></i> Versions</h5>
            <button class="emp-modal-close" onclick="empModalClose('versionsModal')" aria-label="Close"><i class="fas fa-times"></i></button>
        </div>
        <div class="emp-modal-body">
            <div class="emp-version-item emp-version-current mb-2">
                <strong>Current</strong>
                <div class="emp-modal-meta"><i class="far fa-calendar"></i> Latest submission</div>
            </div>

            @if (versions.Any())
            {
                @foreach (var v in versions)
                {
                    <div class="emp-version-item mb-2">
                        <a asp-area="Employee" asp-controller="Project" asp-action="TaskVersion" asp-route-id="@v.Id">
                            <strong>Version @v.VersionNumber</strong>
                        </a>
                        <div class="emp-modal-meta"><i class="far fa-calendar"></i> Saved @v.DateCreated.ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                }
            }
            else
            {
                <div class="emp-modal-empty">
                    <i class="fas fa-layer-group"></i>
                    <span>No previous versions.</span>
                </div>
            }
        </div>
    </div>
</div>

<!-- ===== Notes Modal ===== -->
<div id="notesModal" class="emp-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="notesModalTitle">
    <div class="emp-modal">
        <div class="emp-modal-header">
            <h5 id="notesModalTitle" class="emp-modal-title"><i class="fas fa-note-sticky"></i> Notes</h5>
            <button class="emp-modal-close" onclick="empModalClose('notesModal')" aria-label="Close"><i class="fas fa-times"></i></button>
        </div>
        <div class="emp-modal-body">
            @if (orderedNotes.Any())
            {
                var current = orderedNotes.First();
                <div class="emp-note-item emp-note-current mb-2">
                    <strong>
                        <a asp-area="Employee" asp-controller="Project" asp-action="TaskNote" asp-route-id="@current.Id">Current version</a>
                    </strong>@(current.VersionNumber > 0 ? (" (v" + current.VersionNumber + ")") : "")
                    <div class="emp-modal-meta"><i class="far fa-calendar"></i> Saved @current.DateCreated.ToString("yyyy-MM-dd HH:mm")</div>
                    <div class="emp-note-content mt-2">@Html.Raw(current.Note)</div>
                </div>

                @foreach (var n in orderedNotes.Skip(1))
                {
                    <div class="emp-note-item mb-2">
                        <strong>
                            <a asp-area="Employee" asp-controller="Project" asp-action="TaskNote" asp-route-id="@n.Id">Version @n.VersionNumber</a>
                        </strong>
                        <div class="emp-modal-meta"><i class="far fa-calendar"></i> Saved @n.DateCreated.ToString("yyyy-MM-dd HH:mm")</div>
                        <div class="emp-note-content mt-2">@Html.Raw(n.Note)</div>
                    </div>
                }
            }
            else if (!string.IsNullOrWhiteSpace(taskNotes))
            {
                <div class="emp-note-item emp-note-current mb-2">
                    <strong>Current note</strong>
                    <div class="emp-note-content mt-2">@Html.Raw(taskNotes)</div>
                </div>
            }
            else
            {
                <div class="emp-modal-empty">
                    <i class="fas fa-note-sticky"></i>
                    <span>No notes available.</span>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const editorSelector = '#Input';
        const uploadEndpoint = '@Url.Action("UploadRichText", "Proposal", new { area = "Employee" })';
        const formElement = document.querySelector('form.emp-form');
        const submitButton = document.getElementById('submitProposalBtn');
        const titleInput = document.getElementById('Title');
        let editorInstance = null;
        let pendingUploads = 0;
        let explicitSubmitRequested = false;
        let explicitResetRequested = false;
        let isSubmitting = false;
        const draftStorageKey = 'employee-task-input-draft-' + '@taskId';

        function saveDraft() {
            if (isSubmitting) return;

            const inputElement = document.querySelector(editorSelector);
            const payload = {
                title: titleInput ? titleInput.value : '',
                inputHtml: editorInstance ? editorInstance.getData() : (inputElement ? inputElement.value : '')
            };

            try {
                sessionStorage.setItem(draftStorageKey, JSON.stringify(payload));
            } catch {
            }
        }

        function restoreDraft() {
            try {
                const raw = sessionStorage.getItem(draftStorageKey);
                if (!raw) return null;
                return JSON.parse(raw);
            } catch {
                return null;
            }
        }

        function clearDraft() {
            try {
                sessionStorage.removeItem(draftStorageKey);
            } catch {
            }
        }

        function setUploadingState(isUploading) {
            if (submitButton) {
                submitButton.disabled = isUploading;
            }
        }

        function beginUpload() {
            pendingUploads += 1;
            setUploadingState(true);
        }

        function endUpload() {
            pendingUploads = Math.max(0, pendingUploads - 1);
            setUploadingState(pendingUploads > 0);
        }

        const scriptCdnCandidates = [
            'https://cdn.jsdelivr.net/npm/ckeditor5@47.1.0/dist/browser/ckeditor5.umd.js',
            'https://unpkg.com/ckeditor5@47.1.0/dist/browser/ckeditor5.umd.js'
        ];

        const styleCdnCandidates = [
            'https://cdn.jsdelivr.net/npm/ckeditor5@47.1.0/dist/ckeditor5.css',
            'https://unpkg.com/ckeditor5@47.1.0/dist/ckeditor5.css'
        ];

        class ProposalUploadAdapter {
            constructor(loader) {
                this.loader = loader;
                this.abortController = new AbortController();
            }

            async upload() {
                const file = await this.loader.file;
                const result = await uploadFile(file, this.abortController.signal);
                return { default: result.url };
            }

            abort() {
                this.abortController.abort();
            }
        }

        function ProposalUploadAdapterPlugin(editor) {
            editor.plugins.get('FileRepository').createUploadAdapter = (loader) => new ProposalUploadAdapter(loader);
        }

        async function uploadFile(file, abortSignal) {
            beginUpload();
            try {
                const formData = new FormData();
                formData.append('upload', file);

                const response = await fetch(uploadEndpoint, {
                    method: 'POST',
                    body: formData,
                    signal: abortSignal
                });

                const payload = await response.json();
                if (!response.ok) {
                    throw new Error(payload?.error?.message || 'Upload failed.');
                }

                return payload;
            } finally {
                endUpload();
            }
        }

        function wireFileInsertButton() {
            const button = document.getElementById('insertRichFileBtn');
            const input = document.getElementById('richFileInput');

            if (!button || !input) return;

            button.addEventListener('click', function () {
                input.click();
            });

            input.addEventListener('change', async function () {
                if (!editorInstance || !input.files || input.files.length === 0) return;

                const file = input.files[0];
                button.disabled = true;

                try {
                    const result = await uploadFile(file);

                    if (file.type.startsWith('image/')) {
                        editorInstance.model.change(writer => {
                            const imageElement = writer.createElement('imageBlock', { src: result.url });
                            editorInstance.model.insertContent(imageElement, editorInstance.model.document.selection);
                        });
                    } else {
                        editorInstance.model.change(writer => {
                            const linkText = writer.createText(result.fileName || file.name, { linkHref: result.url });
                            editorInstance.model.insertContent(linkText, editorInstance.model.document.selection);
                        });
                    }
                } catch (error) {
                    console.error('File insertion failed:', error);
                    alert(error.message || 'File upload failed.');
                } finally {
                    input.value = '';
                    button.disabled = false;
                }
            });
        }

        function initEditor() {
            if (!window.CKEDITOR || !window.CKEDITOR.ClassicEditor) {
                console.error('CKEditor UMD bundle was not loaded from available CDNs.');
                return;
            }

            const {
                ClassicEditor,
                Essentials,
                Paragraph,
                Heading,
                Bold,
                Italic,
                Link,
                List,
                Indent,
                BlockQuote,
                Table,
                TableToolbar,
                Image,
                ImageCaption,
                ImageStyle,
                ImageToolbar,
                ImageUpload,
                ImageResize,
                ImageResizeEditing,
                ImageResizeHandles,
                MediaEmbed,
                Alignment
            } = window.CKEDITOR;

            ClassicEditor
                .create(document.querySelector(editorSelector), {
                    licenseKey: 'GPL',
                    plugins: [
                        Essentials,
                        Paragraph,
                        Heading,
                        Bold,
                        Italic,
                        Link,
                        List,
                        Indent,
                        BlockQuote,
                        Table,
                        TableToolbar,
                        Image,
                        ImageCaption,
                        ImageStyle,
                        ImageToolbar,
                        ImageUpload,
                        ImageResize,
                        ImageResizeEditing,
                        ImageResizeHandles,
                        MediaEmbed,
                        Alignment
                    ],
                    extraPlugins: [ProposalUploadAdapterPlugin],
                    toolbar: {
                        items: [
                            'undo', 'redo',
                            '|',
                            'heading',
                            '|',
                            'bold', 'italic', 'link',
                            '|',
                            'alignment',
                            '|',
                            'bulletedList', 'numberedList',
                            '|',
                            'outdent', 'indent',
                            '|',
                            'imageUpload', 'insertTable', 'mediaEmbed', 'blockQuote'
                        ],
                        shouldNotGroupWhenFull: true
                    },
                    image: {
                        toolbar: [
                            'imageTextAlternative',
                            'toggleImageCaption',
                            '|',
                            'imageStyle:inline',
                            'imageStyle:block',
                            'imageStyle:side',
                            '|',
                            'resizeImage'
                        ],
                        resizeOptions: [
                            { name: 'resizeImage:original', value: null,  label: 'Original' },
                            { name: 'resizeImage:25',       value: '25',   label: '25%' },
                            { name: 'resizeImage:50',       value: '50',   label: '50%' },
                            { name: 'resizeImage:75',       value: '75',   label: '75%' },
                            { name: 'resizeImage:100',      value: '100',  label: '100%' }
                        ],
                        resizeUnit: '%'
                    },
                    alignment: {
                        options: ['left', 'center', 'right', 'justify']
                    },
                    table: {
                        contentToolbar: ['tableColumn', 'tableRow', 'mergeTableCells']
                    }
                })
                .then(editor => {
                    editorInstance = editor;
                    const draft = restoreDraft();
                    if (draft && typeof draft.inputHtml === 'string' && draft.inputHtml.length > 0) {
                        editor.setData(draft.inputHtml);
                    }

                    editor.model.document.on('change:data', function () {
                        saveDraft();
                    });

                    wireFileInsertButton();
                })
                .catch(error => {
                    console.error('CKEditor initialization error:', error);
                });
        }

        function hasMeaningfulContent(html) {
            if (!html) return false;

            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const text = (doc.body.textContent || '').replace(/\u00A0/g, ' ').trim();
            const media = doc.body.querySelector('img,table,video,audio,iframe,embed,object');

            return text.length > 0 || !!media;
        }

        function wireFormValidation() {
            if (!formElement) return;

            if (submitButton) {
                submitButton.addEventListener('click', function () {
                    explicitSubmitRequested = true;
                });
            }

            const resetButton = formElement.querySelector('button[type="reset"]');
            if (resetButton) {
                resetButton.addEventListener('click', function () {
                    explicitResetRequested = true;
                });
            }

            formElement.addEventListener('reset', function (event) {
                if (!explicitResetRequested) {
                    event.preventDefault();
                    return;
                }

                explicitResetRequested = false;
                explicitSubmitRequested = false;
                clearDraft();
            });

            formElement.addEventListener('submit', function (event) {
                const submitter = event.submitter;
                const isPrimarySubmit = submitter ? submitter === submitButton : explicitSubmitRequested;

                if (!isPrimarySubmit) {
                    event.preventDefault();
                    return;
                }

                if (pendingUploads > 0) {
                    event.preventDefault();
                    explicitSubmitRequested = false;
                    alert('Please wait for file upload to finish before submitting.');
                    return;
                }

                const inputElement = document.querySelector(editorSelector);
                const html = editorInstance ? editorInstance.getData() : (inputElement ? inputElement.value : '');

                if (inputElement) {
                    inputElement.value = html;
                }

                if (!hasMeaningfulContent(html)) {
                    event.preventDefault();
                    explicitSubmitRequested = false;
                    alert('Input is required. Please enter details before submitting.');

                    if (editorInstance) {
                        editorInstance.editing.view.focus();
                    }
                    return;
                }

                isSubmitting = true;
                clearDraft();
            });
        }

        function normalizeFormButtons() {
            if (!formElement) return;

            const buttons = formElement.querySelectorAll('button');
            buttons.forEach(function (button) {
                if (button === submitButton) return;

                const typeAttr = (button.getAttribute('type') || '').toLowerCase();
                if (typeAttr === 'reset' || typeAttr === 'button') return;

                button.setAttribute('type', 'button');
            });
        }

        function observeDynamicButtons() {
            if (!formElement) return;

            const observer = new MutationObserver(function () {
                normalizeFormButtons();
            });

            observer.observe(formElement, { childList: true, subtree: true });
        }

        function loadScriptSequentially(index) {
            if (window.CKEDITOR && window.CKEDITOR.ClassicEditor) {
                initEditor();
                return;
            }

            if (index >= scriptCdnCandidates.length) {
                initEditor();
                return;
            }

            const script = document.createElement('script');
            script.src = scriptCdnCandidates[index];
            script.async = true;

            script.onload = function () {
                initEditor();
            };

            script.onerror = function () {
                loadScriptSequentially(index + 1);
            };

            document.head.appendChild(script);
        }

        function loadStyleSequentially(index) {
            if (document.querySelector('link[data-ckeditor-style="true"]')) {
                loadScriptSequentially(0);
                return;
            }

            if (index >= styleCdnCandidates.length) {
                loadScriptSequentially(0);
                return;
            }

            const style = document.createElement('link');
            style.rel = 'stylesheet';
            style.href = styleCdnCandidates[index];
            style.setAttribute('data-ckeditor-style', 'true');

            style.onload = function () {
                loadScriptSequentially(0);
            };

            style.onerror = function () {
                style.remove();
                loadStyleSequentially(index + 1);
            };

            document.head.appendChild(style);
        }

        function wireDraftHandlers() {
            const draft = restoreDraft();
            if (draft && titleInput && typeof draft.title === 'string' && titleInput.value.trim() === '') {
                titleInput.value = draft.title;
            }

            if (titleInput) {
                titleInput.addEventListener('input', function () {
                    saveDraft();
                });
            }

            const inputElement = document.querySelector(editorSelector);
            if (inputElement) {
                inputElement.addEventListener('input', function () {
                    saveDraft();
                });
            }
        }

        wireFormValidation();
        normalizeFormButtons();
        observeDynamicButtons();
        wireDraftHandlers();
        loadStyleSequentially(0);
    });

    function empModalOpen(id) {
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.add('emp-modal-visible');
        document.body.style.overflow = 'hidden';
    }
    function empModalClose(id) {
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.remove('emp-modal-visible');
        document.body.style.overflow = '';
    }
    document.querySelectorAll('.emp-modal-overlay').forEach(function(overlay) {
        overlay.addEventListener('click', function(e) {
            if (e.target === overlay) empModalClose(overlay.id);
        });
    });
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            document.querySelectorAll('.emp-modal-overlay.emp-modal-visible').forEach(function(m) {
                empModalClose(m.id);
            });
        }
    });
</script>
