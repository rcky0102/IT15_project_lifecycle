                                        '</div>';
                                    collabList.appendChild(item);
                                    wireRemoveButtons(); wireRoleSelects();
                                    if (collabCount) collabCount.textContent = collabList.querySelectorAll('.doc-collab-item').length;
                                    // remove row checkbox if present
                                    const cb = tbody.querySelector('.emp-select-checkbox[data-num="' + empNum + '"]'); if (cb) cb.checked = false;
                                    // close modal after selecting one
                                    closeEmployeeModal();
                                } else {
                                    alert(data.message || 'Failed to add collaborator.');
                                }
                            } catch (e) {
                                alert('Failed to add collaborator.');
                            } finally { this.disabled = false; }
                        }));

                        // wire modal Add button and enable state
                        const empModalRole = document.getElementById('empModalRole');
                        const empModalAddBtn = document.getElementById('empModalAddBtn');
                        function updateModalAddState() {
                            const any = empModalTable.querySelectorAll('.emp-select-checkbox:checked').length > 0;
                            if (empModalAddBtn) empModalAddBtn.disabled = !any;
                        }
                        // reuse updateSelectionState for checkboxes
                        tbody.querySelectorAll('.emp-select-checkbox').forEach(cb => cb.addEventListener('change', updateModalAddState));
                        const selectAll2 = document.getElementById('empModalSelectAll');
                        if (selectAll2) {
                            selectAll2.addEventListener('change', updateModalAddState);
                        }

                        empModalAddBtn?.addEventListener('click', async function () {
                            const checked = empModalTable.querySelectorAll('.emp-select-checkbox:checked');
                            if (!checked.length) return;
