                empModalTable.querySelectorAll('tbody tr').forEach(tr => {
                    const name = (tr.querySelector('.em-picker-name-text')?.textContent || tr.cells[1]?.textContent || '').toLowerCase();
                    const num = (tr.querySelector('.em-picker-empno')?.textContent || tr.cells[2]?.textContent || '').toLowerCase();
                    const show = !q || name.includes(q) || num.includes(q);
                    tr.style.display = show ? '' : 'none';
                    if (show) visible++;
                });
                const pInfo = document.getElementById('empModalPaginationInfo');
                if (pInfo) pInfo.textContent = visible === 0 ? 'No matches' : 'Showing ' + visible + ' employee' + (visible !== 1 ? 's' : '');
