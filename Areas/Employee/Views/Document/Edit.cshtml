                                    '<div class="emp-modal-icon emp-modal-icon-danger"><i class="fas fa-exclamation-triangle"></i></div>' +
                                    '<h5 class="emp-modal-title">Remove Collaborator</h5>' +
                                    '<p class="emp-modal-message">Are you sure you want to remove this collaborator?</p>' +
                                    '<div class="emp-modal-actions">' +
                                        '<button type="button" class="emp-btn-cancel" id="rcCancelBtn">Cancel</button>' +
