                                    fd.append('role', (empModalRole?.value) || roleSelect.value);
                                    fd.append('__RequestVerificationToken', antiForgeryToken);

                                    const resp = await fetch(addCollabEndpoint, { method: 'POST', body: fd });
                                    const data = await resp.json();
                                    if (data.success) {
