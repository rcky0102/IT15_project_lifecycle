@*
    Edit Document Page – Collaborative Editor
*@
@model project_lifecycle.Models.Document
@using project_lifecycle.Models
@{
    ViewData["Title"] = Model.Title;
    var canEdit = (bool)(ViewData["CanEdit"] ?? false);
    var isOwner = (bool)(ViewData["IsOwner"] ?? false);
    var collaborators = ViewData["Collaborators"] as List<DocumentCollaborator> ?? new List<DocumentCollaborator>();
    var versions = ViewData["Versions"] as List<DocumentVersion> ?? new List<DocumentVersion>();
    var currentEmployeeId = (int)(ViewData["CurrentEmployeeId"] ?? 0);
}

<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title" style="align-items:center;">
                <span class="emp-page-title-icon"><i class="fas fa-file-alt"></i></span>
                @if (canEdit)
                {
                    <span id="docTitle" title="Double-click to edit title" style="cursor:default;">@Model.Title</span>
                }
                else
                {
                    <span id="docTitle">@Model.Title</span>
                }
            </h1>
            @if (canEdit)
            {
                <p class="emp-page-hint" style="margin:0 0 4px; font-size:11.5px; opacity:.55;">
                    <i class="fas fa-pencil" style="font-size:10px;"></i> Double-click the title to edit it
                </p>
            }
            <p class="emp-page-subtitle">
                @if (isOwner)
                {
                    <span>You own this document</span>
                }
                else
                {
                    <span>Shared by @Model.OwnerEmployee?.FirstName @Model.OwnerEmployee?.LastName</span>
                }
                <span class="doc-save-status" id="saveStatus" style="margin-left:12px;">
                    <i class="fas fa-cloud-check" style="opacity:.6;"></i>
                    <span id="saveStatusText">Last saved: @((Model.LastModified ?? Model.DateCreated).ToString("MMM dd, yyyy h:mm tt"))</span>
                </span>
            </p>
        </div>
        <div class="emp-page-hero-right" style="display:flex; gap:8px; flex-wrap:wrap;">
            @if (canEdit)
            {
                <button type="button" id="saveDocBtn" class="emp-btn emp-btn-outline">
                    <i class="fas fa-floppy-disk"></i>
                    <span>Save</span>
                </button>
            }
            @if (isOwner)
            {
                <button type="button" id="toggleCollabPanel" class="emp-btn emp-btn-outline">
                    <i class="fas fa-user-plus"></i>
                    <span>Collaborators <span class="collab-count-badge" id="collabCount">@collaborators.Count</span></span>
                </button>
            }
            <button type="button" class="emp-btn emp-btn-outline" onclick="empModalOpen('versionsModal')">
                <i class="fas fa-clock-rotate-left"></i>
                <span>Versions <span class="collab-count-badge" id="versionCount">@versions.Count</span></span>
            </button>
            <a asp-area="Employee" asp-controller="Document" asp-action="Index" class="emp-btn emp-btn-outline">
                <i class="fas fa-arrow-left"></i>
                <span>Back</span>
            </a>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="emp-alert emp-alert-success">
        <div class="emp-alert-icon"><i class="fas fa-check-circle"></i></div>
        <span>@TempData["SuccessMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="emp-alert emp-alert-error">
        <div class="emp-alert-icon"><i class="fas fa-exclamation-circle"></i></div>
        <span>@TempData["ErrorMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}

<!-- ===== Collaborator Side Panel ===== -->
@if (isOwner)
{
    <div class="doc-collab-backdrop" id="collabBackdrop"></div>
    <aside class="doc-collab-panel" id="collabPanel">
        <div class="doc-collab-panel-header">
            <h3><i class="fas fa-users"></i> Collaborators</h3>
            <button type="button" class="doc-collab-close" id="closeCollabPanel"><i class="fas fa-times"></i></button>
        </div>
        <div class="doc-collab-panel-body">
            <!-- Add collaborator form -->
            <div class="doc-collab-add">
                <label class="emp-form-label">Invite Employee</label>
                <div class="doc-collab-search-wrap">
                    <input type="text" id="collabSearchInput" class="emp-form-control" placeholder="Click to pick from department list…" autocomplete="off" readonly />
                    <div class="doc-collab-suggestions" id="collabSuggestions" style="display:none;"></div>
                </div>
                @* <p style="margin:.5rem 0 0; font-size:.85rem; color:#64748b;">Use the <strong>Pick from department</strong> dialog to select and add collaborators.</p> *@
            </div>

            <!-- Collaborator list -->
            <div class="doc-collab-list" id="collabList">
                @if (!collaborators.Any())
                {
                    <div class="doc-collab-empty" id="collabEmpty">
                        <i class="fas fa-user-group" style="font-size:1.5rem; opacity:.4;"></i>
                        <p>No collaborators yet. Invite someone above.</p>
                    </div>
                }
                @foreach (var c in collaborators)
                {
                    <div class="doc-collab-item" data-collab-id="@c.Id">
                        <div class="doc-collab-info">
                            <div class="doc-collab-avatar">@(c.Employee?.FirstName?.Substring(0,1))@(c.Employee?.LastName?.Substring(0,1))</div>
                            <div>
                                <div class="doc-collab-name">@c.Employee?.FirstName @c.Employee?.LastName</div>
                                <div class="doc-collab-meta"><span class="collab-empno">@c.Employee?.EmployeeNumber</span> · <span class="collab-role-text">@c.Role</span></div>
                            </div>
                        </div>
                        <div style="display:flex; gap:8px; align-items:center;">
                            <select class="collab-role-select" data-collab-id="@c.Id" data-role="@c.Role" aria-label="Change access for @c.Employee?.FirstName @c.Employee?.LastName">
                                <option value="Editor">Editor</option>
                                <option value="Viewer">Viewer</option>
                            </select>
                            <button type="button" class="emp-btn emp-btn-sm emp-btn-danger remove-collab-btn" data-id="@c.Id" title="Remove">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </aside>
}

<!-- ===== Versions Modal ===== -->
<div id="versionsModal" class="emp-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="versionsModalTitle">
    <div class="emp-modal">
        <div class="emp-modal-header">
            <h5 id="versionsModalTitle" class="emp-modal-title"><i class="fas fa-clock-rotate-left"></i> Versions</h5>
            <button class="emp-modal-close" onclick="empModalClose('versionsModal')" aria-label="Close"><i class="fas fa-times"></i></button>
        </div>
        <div class="emp-modal-body" id="versionsModalBody">
            <div class="emp-version-item emp-version-current mb-2">
                <strong>Current</strong> — @Model.Title
                <div class="emp-modal-meta"><i class="far fa-calendar"></i> Updated @((Model.LastModified ?? Model.DateCreated).ToString("yyyy-MM-dd HH:mm"))</div>
            </div>

            @if (versions.Any())
            {
                @foreach (var v in versions)
                {
                    <div class="emp-version-item mb-2">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <div>
                                <a asp-area="Employee" asp-controller="Document" asp-action="Version" asp-route-id="@v.Id">
                                    <strong>Version @v.VersionNumber</strong>
                                </a>
                                &nbsp;&mdash;&nbsp;@v.Title
                                <div class="emp-modal-meta">
                                    <i class="far fa-calendar"></i> Saved @v.DateCreated.ToString("yyyy-MM-dd HH:mm")
                                    @if (v.Employee != null)
                                    {
                                        <span> by @v.Employee.FirstName @v.Employee.LastName</span>
                                    }
                                </div>
                            </div>
                            @if (canEdit)
                            {
                                <form asp-area="Employee" asp-controller="Document" asp-action="RestoreVersion" method="post" style="margin:0;" class="restore-version-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="versionId" value="@v.Id" />
                                    <button type="button" class="emp-btn emp-btn-sm emp-btn-outline restore-version-btn" title="Restore this version" style="white-space:nowrap;"
                                            data-message="Restore to version @v.VersionNumber? Your current content will be saved as a new version first.">
                                        <i class="fas fa-rotate-left"></i> Restore
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="emp-modal-empty">
                    <i class="fas fa-layer-group"></i>
                    <span>No previous versions yet. Versions are created each time you save.</span>
                </div>
            }
        </div>
    </div>
</div>

<!-- ===== Editor ===== -->
<div class="doc-editor-card">
    @if (!canEdit)
    {
        <div class="doc-readonly-banner">
            <i class="fas fa-eye"></i> You have view-only access to this document.
        </div>
    }
    <div class="doc-editor-toolbar-area">
        <div style="display:flex; gap:8px; align-items:center;">
            @if (canEdit)
            {
                <button type="button" id="insertRichFileBtn" class="emp-btn emp-btn-outline" style="display:inline-flex; align-items:center; gap:8px; padding:6px 14px; border-radius:12px; border:1px solid rgba(11,127,207,0.15); color:#0b7fcf; background:#fff; font-weight:600; box-shadow:0 1px 0 rgba(11,127,207,0.06);">
                    <i class="fas fa-paperclip" style="color:inherit; font-size:1rem;"></i>
                    <span style="color:inherit;">Add file/image</span>
                </button>
                <span style="font-size:12px; opacity:.8;">Max 10 MB (images, PDF, DOCX, XLSX, etc.)</span>
            }
        </div>
    </div>
    <input type="file" id="richFileInput" style="display:none;" />
    <textarea id="docContent" name="Content" style="display:none;">@Html.Raw(Model.Content)</textarea>
</div>

<!-- ===== Restore Version Confirmation Modal ===== -->
<div class="emp-modal-backdrop" id="restoreVersionModal" style="display:none;">
    <div class="emp-modal">
        <div class="emp-modal-icon">
            <i class="fas fa-question-circle"></i>
        </div>
        <h5 class="emp-modal-title">Confirm Restore</h5>
        <p class="emp-modal-message" id="restoreVersionMessage"></p>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn-cancel" id="restoreVersionCancelBtn">Cancel</button>
            <button type="button" class="emp-btn-confirm" id="restoreVersionOkBtn">Restore</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const editorSelector = '#docContent';
        const uploadEndpoint = '@Url.Action("UploadFile", "Document", new { area = "Employee" })';
        const saveEndpoint = '@Url.Action("Save", "Document", new { area = "Employee" })';
        const searchEndpoint = '@Url.Action("SearchEmployees", "Document", new { area = "Employee" })';
        const departmentEndpoint = '@Url.Action("DepartmentEmployees", "Document", new { area = "Employee" })';
        const addCollabEndpoint = '@Url.Action("AddCollaborator", "Document", new { area = "Employee" })';
        const removeCollabEndpoint = '@Url.Action("RemoveCollaborator", "Document", new { area = "Employee" })';
        const updateCollabEndpoint = '@Url.Action("UpdateCollaboratorRole", "Document", new { area = "Employee" })';
        const documentId = @Model.Id;
        const canEdit = @(canEdit ? "true" : "false");
        const isOwner = @(isOwner ? "true" : "false");
        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value
            || '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1] || '';

        let editorInstance = null;
        let pendingUploads = 0;
        let isSaving = false;
        let currentTitle = document.getElementById('docTitle')?.textContent?.trim() || '';
        let titleDirty = false;

        // ── CKEditor CDN loading ────────────────────────────────
        const scriptCdnCandidates = [
            'https://cdn.jsdelivr.net/npm/ckeditor5@47.1.0/dist/browser/ckeditor5.umd.js',
            'https://unpkg.com/ckeditor5@47.1.0/dist/browser/ckeditor5.umd.js'
        ];
        const styleCdnCandidates = [
            'https://cdn.jsdelivr.net/npm/ckeditor5@47.1.0/dist/ckeditor5.css',
            'https://unpkg.com/ckeditor5@47.1.0/dist/ckeditor5.css'
        ];

        function setUploadingState(u) {
            const btn = document.getElementById('saveDocBtn');
            if (btn) btn.disabled = u;
        }
        function beginUpload() { pendingUploads++; setUploadingState(true); }
        function endUpload() { pendingUploads = Math.max(0, pendingUploads - 1); setUploadingState(pendingUploads > 0); }

        class DocUploadAdapter {
            constructor(loader) { this.loader = loader; this.ac = new AbortController(); }
            async upload() { const f = await this.loader.file; const r = await uploadFile(f, this.ac.signal); return { default: r.url }; }
            abort() { this.ac.abort(); }
        }
        function DocUploadAdapterPlugin(editor) {
            editor.plugins.get('FileRepository').createUploadAdapter = l => new DocUploadAdapter(l);
        }

        async function uploadFile(file, signal) {
            beginUpload();
            try {
                const fd = new FormData(); fd.append('upload', file);
                const resp = await fetch(uploadEndpoint, { method: 'POST', body: fd, signal });
                const data = await resp.json();
                if (!resp.ok) throw new Error(data?.error?.message || 'Upload failed.');
                return data;
            } finally { endUpload(); }
        }

        function wireFileInsertButton() {
            const button = document.getElementById('insertRichFileBtn');
            const input = document.getElementById('richFileInput');
            if (!button || !input) return;
            button.addEventListener('click', () => input.click());
            input.addEventListener('change', async function () {
                if (!editorInstance || !input.files?.length) return;
                const file = input.files[0]; button.disabled = true;
                try {
                    const result = await uploadFile(file);
                    if (file.type.startsWith('image/')) {
                        editorInstance.model.change(writer => {
                            const img = writer.createElement('imageBlock', { src: result.url });
                            editorInstance.model.insertContent(img, editorInstance.model.document.selection);
                        });
                    } else {
                        editorInstance.model.change(writer => {
                            const t = writer.createText(result.fileName || file.name, { linkHref: result.url });
                            editorInstance.model.insertContent(t, editorInstance.model.document.selection);
                        });
                    }
                } catch (e) { alert(e.message || 'Upload failed.'); }
                finally { input.value = ''; button.disabled = false; }
            });
        }

        // ── Save ────────────────────────────────────────────────
        function updateSaveStatus(text, icon) {
            const el = document.getElementById('saveStatusText');
            const ic = document.querySelector('#saveStatus i');
            if (el) el.textContent = text;
            if (ic) ic.className = icon;
        }

        async function saveDocument() {
            if (!editorInstance || isSaving || pendingUploads > 0) return;
            isSaving = true;
            updateSaveStatus('Saving…', 'fas fa-spinner fa-spin');

            try {
                const fd = new FormData();
                fd.append('id', documentId);
                fd.append('Content', editorInstance.getData());
                fd.append('Title', currentTitle);
                fd.append('__RequestVerificationToken', antiForgeryToken);

                const resp = await fetch(saveEndpoint, { method: 'POST', body: fd });
                const data = await resp.json();

                if (data.success) {
                    titleDirty = false;
                    updateSaveStatus('Last saved: ' + data.lastModified, 'fas fa-cloud-check');
                    // Sync title in page
                    if (data.title) {
                        const titleEl = document.getElementById('docTitle');
                        if (titleEl && !titleEl.isContentEditable) titleEl.textContent = data.title;
                        document.title = data.title;
                    }
                    // Update version count badge
                    const vcEl = document.getElementById('versionCount');
                    if (vcEl && data.versionCount !== undefined) {
                        vcEl.textContent = data.versionCount;
                    }
                } else {
                    updateSaveStatus('Save failed: ' + data.message, 'fas fa-exclamation-triangle');
                }
            } catch (e) {
                updateSaveStatus('Save error', 'fas fa-exclamation-triangle');
            } finally {
                isSaving = false;
            }
        }

        // Auto-save removed: saving occurs only when user clicks Save

        // ── Init Editor ─────────────────────────────────────────
        function initEditor() {
            if (!window.CKEDITOR || !window.CKEDITOR.ClassicEditor) return;

            const {
                ClassicEditor, Essentials, Paragraph, Heading, Bold, Italic, Link, List, Indent,
                BlockQuote, Table, TableToolbar, Image, ImageCaption, ImageStyle, ImageToolbar,
                ImageUpload, ImageResize, ImageResizeEditing, ImageResizeHandles, MediaEmbed, Alignment
            } = window.CKEDITOR;

            const plugins = [
                Essentials, Paragraph, Heading, Bold, Italic, Link, List, Indent,
                BlockQuote, Table, TableToolbar, Image, ImageCaption, ImageStyle, ImageToolbar,
                ImageUpload, ImageResize, ImageResizeEditing, ImageResizeHandles, MediaEmbed, Alignment
            ];

            const config = {
                licenseKey: 'GPL',
                plugins: plugins,
                extraPlugins: canEdit ? [DocUploadAdapterPlugin] : [],
                toolbar: canEdit ? {
                    items: [
                        'undo', 'redo', '|', 'heading', '|', 'bold', 'italic', 'link', '|',
                        'alignment', '|', 'bulletedList', 'numberedList', '|', 'outdent', 'indent', '|',
                        'imageUpload', 'insertTable', 'mediaEmbed', 'blockQuote'
                    ],
                    shouldNotGroupWhenFull: true
                } : { items: [] },
                image: {
                    toolbar: ['imageTextAlternative', 'toggleImageCaption', '|', 'imageStyle:inline', 'imageStyle:block', 'imageStyle:side', '|', 'resizeImage'],
                    resizeOptions: [
                        { name: 'resizeImage:original', value: null, label: 'Original' },
                        { name: 'resizeImage:25', value: '25', label: '25%' },
                        { name: 'resizeImage:50', value: '50', label: '50%' },
                        { name: 'resizeImage:75', value: '75', label: '75%' },
                        { name: 'resizeImage:100', value: '100', label: '100%' }
                    ],
                    resizeUnit: '%'
                },
                alignment: { options: ['left', 'center', 'right', 'justify'] },
                table: { contentToolbar: ['tableColumn', 'tableRow', 'mergeTableCells'] }
            };

            ClassicEditor
                .create(document.querySelector(editorSelector), config)
                .then(editor => {
                    editorInstance = editor;

                    if (!canEdit) {
                        editor.enableReadOnlyMode('viewer-lock');
                    }

                    if (canEdit) {
                            wireFileInsertButton();
                            wireTitleEdit();

                            // Manual save button
                            const saveBtn = document.getElementById('saveDocBtn');
                            if (saveBtn) saveBtn.addEventListener('click', saveDocument);

                            // No auto-save: saving only occurs when the user clicks Save
                        }
                })
                .catch(err => console.error('CKEditor init error:', err));
        }

        // ── Inline title editing ────────────────────────────────
        function wireTitleEdit() {
            const titleEl = document.getElementById('docTitle');
            if (!titleEl) return;

            titleEl.addEventListener('dblclick', function () {
                if (titleEl.isContentEditable) return;
                titleEl.setAttribute('contenteditable', 'true');
                titleEl.style.cursor = 'text';
                titleEl.style.outline = 'none';
                titleEl.style.borderBottom = '2px solid var(--emp-primary, #4f8ef7)';
                titleEl.style.minWidth = '120px';
                titleEl.focus();
                // Select all text
                const range = document.createRange();
                range.selectNodeContents(titleEl);
                const sel = window.getSelection();
                sel.removeAllRanges();
                sel.addRange(range);
            });

            function commitTitle() {
                if (!titleEl.isContentEditable) return;
                titleEl.removeAttribute('contenteditable');
                titleEl.style.cursor = 'default';
                titleEl.style.borderBottom = '';
                const newTitle = titleEl.textContent.trim();
                if (!newTitle) {
                    // Revert to previous title if blank
                    titleEl.textContent = currentTitle;
                    return;
                }
                if (newTitle !== currentTitle) {
                    currentTitle = newTitle;
                    titleDirty = true;
                    updateSaveStatus('Unsaved changes…', 'fas fa-circle-dot');
                }
            }

            titleEl.addEventListener('blur', commitTitle);
            titleEl.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); commitTitle(); }
                if (e.key === 'Escape') {
                    titleEl.textContent = currentTitle;
                    titleEl.removeAttribute('contenteditable');
                    titleEl.style.cursor = 'default';
                    titleEl.style.borderBottom = '';
                }
            });
        }

        function loadScriptSequentially(i) {
            if (window.CKEDITOR && window.CKEDITOR.ClassicEditor) { initEditor(); return; }
            if (i >= scriptCdnCandidates.length) { initEditor(); return; }
            const s = document.createElement('script');
            s.src = scriptCdnCandidates[i]; s.async = true;
            s.onload = initEditor;
            s.onerror = () => loadScriptSequentially(i + 1);
            document.head.appendChild(s);
        }
        function loadStyleSequentially(i) {
            if (document.querySelector('link[data-ckeditor-style]')) { loadScriptSequentially(0); return; }
            if (i >= styleCdnCandidates.length) { loadScriptSequentially(0); return; }
            const l = document.createElement('link'); l.rel = 'stylesheet'; l.href = styleCdnCandidates[i];
            l.setAttribute('data-ckeditor-style', 'true');
            l.onload = () => loadScriptSequentially(0);
            l.onerror = () => { l.remove(); loadStyleSequentially(i + 1); };
            document.head.appendChild(l);
        }
        loadStyleSequentially(0);

        // ═══════ Collaborator Panel ═══════════════════════════════
        if (isOwner) {
            const panel = document.getElementById('collabPanel');
            const backdrop = document.getElementById('collabBackdrop');
            const toggleBtn = document.getElementById('toggleCollabPanel');
            const closeBtn = document.getElementById('closeCollabPanel');
            const searchInput = document.getElementById('collabSearchInput');
                        const empModalHtml = `
<div class="modal fade" id="collabEmployeeModal" tabindex="-1" aria-labelledby="collabEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content em-picker-modal">
            <!-- Gradient Header -->
            <div class="em-picker-header">
                <div>
                    <h5 class="em-picker-title" id="collabEmployeeModalLabel"><i class="fas fa-user-plus"></i> Add Collaborator</h5>
                    <p class="em-picker-subtitle">Select employees from your department</p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Filter Bar -->
            <div class="em-picker-filters">
                <div class="em-picker-filters-row">
                    <div class="em-picker-search-group">
                        <i class="fas fa-magnifying-glass em-picker-search-icon"></i>
                        <input type="text" id="empModalFilter" class="em-picker-search-input" placeholder="Search employees\u2026" autocomplete="off" />
                    </div>
                    <div class="em-picker-select-group">
                        <label class="em-picker-select-label">Role</label>
                        <select id="empModalRole" class="em-picker-select">
                            <option value="Editor">Editor</option>
                            <option value="Viewer">Viewer</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Table Body -->
            <div class="modal-body em-picker-body">
                <div class="em-picker-table-card">
                    <div class="em-picker-table-responsive">
                        <table class="em-picker-table" id="empModalTable">
                            <thead>
                                <tr>
                                    <th style="width:44px;text-align:center;"><input type="checkbox" id="empModalSelectAll" class="em-picker-checkbox" /></th>
                                    <th>Employee</th>
                                    <th>Employee #</th>
                                    <th style="width:100px;text-align:center;">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <!-- Empty state -->
                    <div id="empModalEmpty" class="em-picker-empty" style="display:none;">
                        <div class="em-picker-empty-icon"><i class="fas fa-user-group"></i></div>
                        <div class="em-picker-empty-title">No employees found</div>
                        <div class="em-picker-empty-text">There are no available employees in your department.</div>
                    </div>

                    <!-- Pagination info -->
                    <div class="em-picker-pagination" id="empModalPagination">
                        <div class="em-picker-pagination-info" id="empModalPaginationInfo"></div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="em-picker-footer">
