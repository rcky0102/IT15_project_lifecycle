                                    '</div>' +
                                '</div>';
                            document.body.appendChild(backdrop);
                            function cleanup(r) { backdrop.remove(); resolve(r); }
                            document.getElementById('rcCancelBtn').addEventListener('click', function(){ cleanup(false); });
                            document.getElementById('rcOkBtn').addEventListener('click', function(){ cleanup(true); });
                            backdrop.addEventListener('click', function(e){ if(e.target===backdrop) cleanup(false); });
