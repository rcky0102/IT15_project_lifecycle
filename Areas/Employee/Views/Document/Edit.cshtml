                        if (pInfo) pInfo.textContent = 'Showing ' + results.length + ' employee' + (results.length !== 1 ? 's' : '');
                        // wire instant select buttons (per-row)
                        tbody.querySelectorAll('.emp-select-now').forEach(btn => btn.addEventListener('click', async function () {
                            const empNum = this.dataset.num;
                            const empName = this.dataset.name;
                            this.disabled = true;
                            try {
                                const fd = new FormData();
                                fd.append('documentId', documentId);
                                fd.append('employeeSearch', empNum);
                                const role = document.getElementById('empModalRole')?.value || 'Editor';
                                fd.append('role', role);
