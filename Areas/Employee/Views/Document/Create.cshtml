@*
    Create Document Page
*@
@{
    ViewData["Title"] = "New Document";
}

<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-file-circle-plus"></i></span>
                New Document
            </h1>
            <p class="emp-page-subtitle">Create a new collaborative document</p>
        </div>
        <div class="emp-page-hero-right" style="display:flex; gap:8px; flex-wrap:wrap;">
            <button type="button" id="importCloudBtn" class="emp-btn emp-btn-outline">
                <i class="fas fa-cloud-arrow-down"></i>
                <span>Cloud Import</span>
            </button>
            <a asp-area="Employee" asp-controller="Document" asp-action="Index" class="emp-btn emp-btn-outline">
                <i class="fas fa-arrow-left"></i>
                <span>Back to Documents</span>
            </a>
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="emp-alert emp-alert-error">
        <div class="emp-alert-icon"><i class="fas fa-exclamation-circle"></i></div>
        <span>@TempData["ErrorMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}

<div class="emp-form-card">
    <div class="emp-form-section">
        <div class="emp-form-section-title"><i class="fas fa-file-alt"></i> Document Details</div>

        <form asp-area="Employee" asp-controller="Document" asp-action="Create" method="post" class="emp-form" id="createDocForm">
            @Html.AntiForgeryToken()

            <div class="emp-form-row">
                <label for="Title" class="emp-form-label">Document Title</label>
                <input type="text" id="Title" name="Title" class="emp-form-control" placeholder="Enter a descriptive title…" required maxlength="200" />
            </div>

            <div class="emp-form-row">
                <label for="Content" class="emp-form-label">Content</label>
                <textarea id="Content" name="Content" rows="12" class="emp-form-control" placeholder="Start writing your document…"></textarea>
                <div style="margin-top:10px; display:flex; gap:8px; align-items:center;">
                    <button type="button" id="insertRichFileBtn" class="emp-btn emp-btn-outline" style="padding:6px 12px;">
                        <i class="fas fa-paperclip"></i> Add file/image
                    </button>
                    <span style="font-size:12px; opacity:.8;">Max 10 MB (images, PDF, DOCX, XLSX, etc.)</span>
                </div>
                <input type="file" id="richFileInput" style="display:none;" />
            </div>

            <div class="emp-form-actions" style="justify-content:flex-end;">
                <button type="reset" class="emp-btn emp-btn-secondary"><i class="fas fa-rotate-left"></i> Reset</button>
                <button type="submit" id="submitDocBtn" class="emp-btn emp-btn-primary"><i class="fas fa-plus"></i> Create Document</button>
            </div>
        </form>
    </div>
</div>

<!-- ===== Cloud Import Modal ===== -->
<div id="cloudImportModal" class="emp-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="cloudImportTitle">
    <div class="emp-modal" style="max-width:620px; width:95%;">
        <div class="emp-modal-header">
            <h5 id="cloudImportTitle" class="emp-modal-title"><i class="fas fa-cloud-arrow-down"></i> Import from Cloud</h5>
            <button class="emp-modal-close" onclick="empModalClose('cloudImportModal')" aria-label="Close"><i class="fas fa-times"></i></button>
        </div>
        <div class="emp-modal-body">
            <div id="cloudFileSearch" style="margin-bottom:12px;">
                <input type="text" id="cloudFileFilter" class="emp-form-control" placeholder="Search files…" style="width:100%;" />
            </div>
            <div id="cloudFileLoading" style="text-align:center; padding:24px; display:none;">
                <i class="fas fa-spinner fa-spin" style="font-size:1.5rem; opacity:.5;"></i>
                <p style="margin-top:8px; opacity:.6;">Loading cloud files…</p>
            </div>
            <div id="cloudFileEmpty" style="text-align:center; padding:24px; display:none;">
                <i class="fas fa-cloud" style="font-size:2rem; opacity:.3;"></i>
                <p style="margin-top:8px; opacity:.6;">No files found in the cloud.</p>
            </div>
            <div id="cloudFileList" style="max-height:380px; overflow-y:auto;"></div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const editorSelector = '#Content';
        const uploadEndpoint = '@Url.Action("UploadFile", "Document", new { area = "Employee" })';
        const listCloudEndpoint = '@Url.Action("ListCloudFiles", "Document", new { area = "Employee" })';
        const getCloudFileEndpoint = '@Url.Action("GetCloudFile", "Document", new { area = "Employee" })';
        const formElement = document.getElementById('createDocForm');
        const submitButton = document.getElementById('submitDocBtn');
        const titleInput = document.getElementById('Title');
        let editorInstance = null;
        let pendingUploads = 0;
        let isSubmitting = false;

        function setUploadingState(isUploading) {
            if (submitButton) submitButton.disabled = isUploading;
        }

        function beginUpload() { pendingUploads += 1; setUploadingState(true); }
        function endUpload() { pendingUploads = Math.max(0, pendingUploads - 1); setUploadingState(pendingUploads > 0); }

        const scriptCdnCandidates = [
            'https://cdn.jsdelivr.net/npm/ckeditor5@47.1.0/dist/browser/ckeditor5.umd.js',
            'https://unpkg.com/ckeditor5@47.1.0/dist/browser/ckeditor5.umd.js'
        ];
        const styleCdnCandidates = [
            'https://cdn.jsdelivr.net/npm/ckeditor5@47.1.0/dist/ckeditor5.css',
            'https://unpkg.com/ckeditor5@47.1.0/dist/ckeditor5.css'
        ];

        class DocUploadAdapter {
            constructor(loader) { this.loader = loader; this.abortController = new AbortController(); }
            async upload() {
                const file = await this.loader.file;
                const result = await uploadFile(file, this.abortController.signal);
                return { default: result.url };
            }
            abort() { this.abortController.abort(); }
        }

        function DocUploadAdapterPlugin(editor) {
            editor.plugins.get('FileRepository').createUploadAdapter = (loader) => new DocUploadAdapter(loader);
        }

        async function uploadFile(file, abortSignal) {
            beginUpload();
            try {
                const formData = new FormData();
                formData.append('upload', file);
                const response = await fetch(uploadEndpoint, { method: 'POST', body: formData, signal: abortSignal });
                const payload = await response.json();
                if (!response.ok) throw new Error(payload?.error?.message || 'Upload failed.');
                return payload;
            } finally { endUpload(); }
        }

        function wireFileInsertButton() {
            const button = document.getElementById('insertRichFileBtn');
            const input = document.getElementById('richFileInput');
            if (!button || !input) return;

            button.addEventListener('click', function () { input.click(); });
            input.addEventListener('change', async function () {
                if (!editorInstance || !input.files || input.files.length === 0) return;
                const file = input.files[0];
                button.disabled = true;
                try {
                    const result = await uploadFile(file);
                    if (file.type.startsWith('image/')) {
                        editorInstance.model.change(writer => {
                            const img = writer.createElement('imageBlock', { src: result.url });
                            editorInstance.model.insertContent(img, editorInstance.model.document.selection);
                        });
                    } else {
                        editorInstance.model.change(writer => {
                            const link = writer.createText(result.fileName || file.name, { linkHref: result.url });
                            editorInstance.model.insertContent(link, editorInstance.model.document.selection);
                        });
                    }
                } catch (error) {
                    console.error('File insertion failed:', error);
                    alert(error.message || 'File upload failed.');
                } finally {
                    input.value = '';
                    button.disabled = false;
                }
            });
        }

        function initEditor() {
            if (!window.CKEDITOR || !window.CKEDITOR.ClassicEditor) {
                console.error('CKEditor UMD bundle was not loaded.');
                return;
            }

            const {
                ClassicEditor, Essentials, Paragraph, Heading, Bold, Italic, Link, List, Indent,
                BlockQuote, Table, TableToolbar, Image, ImageCaption, ImageStyle, ImageToolbar,
                ImageUpload, ImageResize, ImageResizeEditing, ImageResizeHandles, MediaEmbed, Alignment
            } = window.CKEDITOR;

            ClassicEditor
                .create(document.querySelector(editorSelector), {
                    licenseKey: 'GPL',
                    plugins: [
                        Essentials, Paragraph, Heading, Bold, Italic, Link, List, Indent,
                        BlockQuote, Table, TableToolbar, Image, ImageCaption, ImageStyle, ImageToolbar,
                        ImageUpload, ImageResize, ImageResizeEditing, ImageResizeHandles, MediaEmbed, Alignment
                    ],
                    extraPlugins: [DocUploadAdapterPlugin],
                    toolbar: {
                        items: [
                            'undo', 'redo', '|', 'heading', '|', 'bold', 'italic', 'link', '|',
                            'alignment', '|', 'bulletedList', 'numberedList', '|', 'outdent', 'indent', '|',
                            'imageUpload', 'insertTable', 'mediaEmbed', 'blockQuote'
                        ],
                        shouldNotGroupWhenFull: true
                    },
                    image: {
                        toolbar: ['imageTextAlternative', 'toggleImageCaption', '|', 'imageStyle:inline', 'imageStyle:block', 'imageStyle:side', '|', 'resizeImage'],
                        resizeOptions: [
                            { name: 'resizeImage:original', value: null, label: 'Original' },
                            { name: 'resizeImage:25', value: '25', label: '25%' },
                            { name: 'resizeImage:50', value: '50', label: '50%' },
                            { name: 'resizeImage:75', value: '75', label: '75%' },
                            { name: 'resizeImage:100', value: '100', label: '100%' }
                        ],
                        resizeUnit: '%'
                    },
                    alignment: { options: ['left', 'center', 'right', 'justify'] },
                    table: { contentToolbar: ['tableColumn', 'tableRow', 'mergeTableCells'] }
                })
                .then(editor => {
                    editorInstance = editor;
                    wireFileInsertButton();
                })
                .catch(error => console.error('CKEditor initialization error:', error));
        }

        function hasMeaningfulContent(html) {
            if (!html) return false;
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const text = (doc.body.textContent || '').replace(/\u00A0/g, ' ').trim();
            const media = doc.body.querySelector('img,table,video,audio,iframe,embed,object');
            return text.length > 0 || !!media;
        }

        if (formElement) {
            formElement.addEventListener('submit', function (event) {
                if (pendingUploads > 0) {
                    event.preventDefault();
                    alert('Please wait for file upload to finish.');
                    return;
                }
                const inputEl = document.querySelector(editorSelector);
                const html = editorInstance ? editorInstance.getData() : (inputEl ? inputEl.value : '');
                if (inputEl) inputEl.value = html;
                isSubmitting = true;
            });
        }

        function loadScriptSequentially(index) {
            if (window.CKEDITOR && window.CKEDITOR.ClassicEditor) { initEditor(); return; }
            if (index >= scriptCdnCandidates.length) { initEditor(); return; }
            const script = document.createElement('script');
            script.src = scriptCdnCandidates[index];
            script.async = true;
            script.onload = function () { initEditor(); };
            script.onerror = function () { loadScriptSequentially(index + 1); };
            document.head.appendChild(script);
        }

        function loadStyleSequentially(index) {
            if (document.querySelector('link[data-ckeditor-style="true"]')) { loadScriptSequentially(0); return; }
            if (index >= styleCdnCandidates.length) { loadScriptSequentially(0); return; }
            const style = document.createElement('link');
            style.rel = 'stylesheet';
            style.href = styleCdnCandidates[index];
            style.setAttribute('data-ckeditor-style', 'true');
            style.onload = function () { loadScriptSequentially(0); };
            style.onerror = function () { style.remove(); loadStyleSequentially(index + 1); };
            document.head.appendChild(style);
        }

        loadStyleSequentially(0);

        // ═══════ Cloud Import Modal ═══════════════════════════════
        window.empModalOpen = function (id) {
            const el = document.getElementById(id);
            if (!el) return;
            el.classList.add('emp-modal-visible');
            document.body.style.overflow = 'hidden';
        };
        window.empModalClose = function (id) {
            const el = document.getElementById(id);
            if (!el) return;
            el.classList.remove('emp-modal-visible');
            document.body.style.overflow = '';
        };
        document.querySelectorAll('.emp-modal-overlay').forEach(function (overlay) {
            overlay.addEventListener('click', function (e) {
                if (e.target === overlay) empModalClose(overlay.id);
            });
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.emp-modal-overlay.emp-modal-visible').forEach(function (m) {
                    empModalClose(m.id);
                });
            }
        });

        let _cloudFiles = [];
        const cloudImportBtn = document.getElementById('importCloudBtn');
        const cloudFileList = document.getElementById('cloudFileList');
        const cloudFileLoading = document.getElementById('cloudFileLoading');
        const cloudFileEmpty = document.getElementById('cloudFileEmpty');
        const cloudFileFilter = document.getElementById('cloudFileFilter');

        function formatFileSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / 1048576).toFixed(1) + ' MB';
        }

        function renderCloudFiles(filter) {
            const q = (filter || '').toLowerCase();
            cloudFileList.innerHTML = '';
            const filtered = _cloudFiles.filter(f => !q || f.fileName.toLowerCase().includes(q));

            if (filtered.length === 0) {
                cloudFileEmpty.style.display = _cloudFiles.length === 0 ? '' : 'block';
                if (_cloudFiles.length > 0) {
                    cloudFileEmpty.querySelector('p').textContent = 'No files match your search.';
                }
                return;
            }
            cloudFileEmpty.style.display = 'none';

            filtered.forEach(function (f) {
                const item = document.createElement('div');
                item.style.cssText = 'display:flex; align-items:center; gap:12px; padding:10px 14px; border-bottom:1px solid #f1f5f9; cursor:pointer; transition:background .15s;';
                item.onmouseover = function () { item.style.background = '#f8fafc'; };
                item.onmouseout = function () { item.style.background = ''; };
                item.innerHTML =
                    '<div style="flex-shrink:0; width:36px; height:36px; border-radius:8px; background:linear-gradient(135deg,#f59e0b22,#f59e0b11); display:flex; align-items:center; justify-content:center;">' +
                    '  <i class="fas fa-file-code" style="color:#f59e0b;"></i>' +
                    '</div>' +
                    '<div style="flex:1; min-width:0;">' +
                    '  <div style="font-weight:600; font-size:13.5px; color:#1e293b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">' + f.fileName + '</div>' +
                    '  <div style="font-size:12px; color:#94a3b8;">' + f.lastModified + ' · ' + formatFileSize(f.size) + '</div>' +
                    '</div>' +
                    '<i class="fas fa-arrow-right" style="color:#cbd5e1; font-size:12px;"></i>';
                item.addEventListener('click', function () { importCloudFile(f.key); });
                cloudFileList.appendChild(item);
            });
        }

        async function loadCloudFiles() {
            cloudFileLoading.style.display = '';
            cloudFileEmpty.style.display = 'none';
            cloudFileList.innerHTML = '';
            cloudFileFilter.value = '';
            try {
                const resp = await fetch(listCloudEndpoint);
                const data = await resp.json();
                if (data.success) {
                    _cloudFiles = data.files || [];
                    renderCloudFiles('');
                } else {
                    cloudFileEmpty.style.display = '';
                    cloudFileEmpty.querySelector('p').textContent = data.message || 'Failed to load files.';
                }
            } catch {
                cloudFileEmpty.style.display = '';
                cloudFileEmpty.querySelector('p').textContent = 'Could not connect to cloud storage.';
            } finally {
                cloudFileLoading.style.display = 'none';
            }
        }

        async function importCloudFile(key) {
            empModalClose('cloudImportModal');
            const titleInput = document.getElementById('Title');
            try {
                const resp = await fetch(getCloudFileEndpoint + '?key=' + encodeURIComponent(key));
                const data = await resp.json();
                if (data.success) {
                    if (titleInput && data.title) titleInput.value = data.title;
                    if (editorInstance) {
                        editorInstance.setData(data.content || '');
                    } else {
                        const ta = document.querySelector(editorSelector);
                        if (ta) ta.value = data.content || '';
                    }
                } else {
                    alert(data.message || 'Failed to import file.');
                }
            } catch {
                alert('An error occurred while importing the file.');
            }
        }

        cloudImportBtn?.addEventListener('click', function () {
            empModalOpen('cloudImportModal');
            loadCloudFiles();
        });

        cloudFileFilter?.addEventListener('input', function () {
            renderCloudFiles(cloudFileFilter.value);
        });
    });
</script>
