@model List<project_lifecycle.Models.Document>
@using project_lifecycle.Models
@{
    var filter = ViewData["Filter"]?.ToString() ?? "my";
    var archiveFilter = ViewData["ArchiveFilter"]?.ToString() ?? "active";
    var currentEmployeeId = (int)(ViewData["CurrentEmployeeId"] ?? 0);
    var editableDocIds = ViewData["EditableDocIds"] as HashSet<int> ?? new HashSet<int>();
}

<!-- ===== Page Title Hero ===== -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-file-alt"></i></span>
                Documents
            </h1>
            <p class="emp-page-subtitle">Create and collaborate on documents with your team</p>
        </div>
        <div class="emp-page-hero-right">
            <a asp-area="Employee" asp-controller="Document" asp-action="Create" class="emp-btn emp-btn-outline">
                <i class="fas fa-file-circle-plus"></i>
                <span>New Document</span>
            </a>
        </div>
    </div>
</div>

<!-- Confirmation modal for archive / unarchive actions -->
<div class="emp-modal-backdrop" id="confirmActionModal" role="dialog" aria-modal="true" aria-hidden="true" style="display:none;">
    <div class="emp-modal" role="document">
        <h4 id="confirmActionTitle"><i class="fas fa-exclamation-triangle"></i> Confirm</h4>
        <p id="confirmActionMessage">Are you sure?</p>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn emp-btn-cancel" id="confirmActionCancel">Cancel</button>
            <form id="confirmActionForm" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="confirmActionId" value="" />
                <button type="submit" class="emp-btn emp-btn-confirm" id="confirmActionConfirm">Confirm</button>
            </form>
        </div>
    </div>
</div>

<!-- ===== Alerts ===== -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="emp-alert emp-alert-success">
        <div class="emp-alert-icon"><i class="fas fa-check-circle"></i></div>
        <span>@TempData["SuccessMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="emp-alert emp-alert-error">
        <div class="emp-alert-icon"><i class="fas fa-exclamation-circle"></i></div>
        <span>@TempData["ErrorMessage"]</span>
        <button class="emp-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}

<!-- ===== Filters ===== -->
<div class="emp-filters-card">
    <div class="emp-filters-row">
        <div class="emp-search-group">
            <i class="fas fa-magnifying-glass emp-search-icon"></i>
            <input id="docSearch" type="text" class="emp-search-input" placeholder="Search documents…" autocomplete="off" />
        </div>
        <div class="emp-select-group">
            <select id="docFilter" class="emp-select">
                @if (filter == "my") { <option value="my" selected>My Documents</option> } else { <option value="my">My Documents</option> }
                @if (filter == "shared") { <option value="shared" selected>Shared with Me</option> } else { <option value="shared">Shared with Me</option> }
                @if (filter == "all") { <option value="all" selected>All</option> } else { <option value="all">All</option> }
            </select>
        </div>
        <div class="emp-select-group">
            <select id="docArchiveFilter" class="emp-select">
                @if (archiveFilter == "active") { <option value="active" selected>Active</option> } else { <option value="active">Active</option> }
                @if (archiveFilter == "inactive") { <option value="inactive" selected>Archived</option> } else { <option value="inactive">Archived</option> }
                @if (archiveFilter == "all") { <option value="all" selected>All</option> } else { <option value="all">All</option> }
            </select>
        </div>
        <div class="emp-select-group">
            <label for="docPageSize" style="font-size:.82rem;color:var(--emp-muted);margin-right:.4rem;">Show</label>
            <select id="docPageSize" class="emp-select" style="width:92px;">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
    </div>
</div>

<!-- ===== Table ===== -->
<div class="project-table-section">
    <div class="project-table-card">
        @if (Model.Any())
        {
            <style>
                /* Scoped tweaks for DeptHead-style badges: keep on one line and truncate if too long */ 
                .project-table-card .project-badge-white { white-space: nowrap; }
                .project-table-card .project-badge-white > span:not(.emp-status-inline) {
                    display: inline-block;
                    max-width: 10.5rem;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    vertical-align: middle;
                }
                /* Compact single-line cells for Owner / Last Modified columns */
                .project-table-card .project-cell-truncate {
                    display: inline-block;
                    max-width: 11.5rem;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                    vertical-align: middle;
                    margin-left: .35rem;
                    font-size: .9rem;
                    color: var(--emp-muted);
                }
            </style>

            <div class="project-table-responsive">
                <table class="project-table" id="documentsTable">
                    <colgroup>
                        <col style="width:60%;" />
                        <col style="width:15%;" />
                        <col style="width:15%;" />
                        <col style="width:10%;" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Owner</th>
                            <th>Last Modified</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model)
                        {
                            var isOwner = doc.OwnerEmployeeId == currentEmployeeId;
                            <tr class="doc-row emp-row" data-title="@doc.Title.ToLower()" data-archived="@(doc.IsArchived.ToString().ToLower())">
                                <td>
                                    <div class="project-name-cell">
                                        <div class="project-name-icon">
                                            <i class="fas fa-file-alt"></i>
                                        </div>
                                        <div>
                                            <div class="project-name-text">
                                                <a asp-area="Employee" asp-controller="Document" asp-action="Edit" asp-route-id="@doc.Id" class="doc-title-link">@doc.Title</a>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span title="Owner">
                                        <span class="project-cell-truncate">
                                            @if (isOwner)
                                            {
                                                <text>You</text>
                                            }
                                            else
                                            {
                                                @doc.OwnerEmployee?.FirstName @doc.OwnerEmployee?.LastName
                                            }
                                        </span>
                                    </span>
                                </td>
                                <td>
                                    <span title="Last modified">
                                        <span class="project-cell-truncate">@((doc.LastModified ?? doc.DateCreated).ToString("MMM dd, yyyy h:mm tt"))</span>
                                    </span>
                                </td>
                                <td>
                                    <div style="display:inline-flex;align-items:center;gap:.35rem;">
                                        @if (isOwner || editableDocIds.Contains(doc.Id))
                                        {
                                            <a asp-area="Employee" asp-controller="Document" asp-action="Edit" asp-route-id="@doc.Id"
                                               class="emp-action-btn emp-action-edit" title="Edit">
                                                <i class="fas fa-pen-to-square"></i>
                                            </a>
                                        }
                                        @if (isOwner)
                                        {
                                            if (!doc.IsArchived)
                                            {
                                                <button type="button" class="emp-action-btn emp-action-archive" title="Archive"
                                                        data-action='@Url.Action("Archive", "Document", new { area = "Employee" })'
                                                        data-id="@doc.Id"
                                                        data-message="Archive this document?">
                                                    <i class="fas fa-box-archive"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="emp-action-btn emp-action-unarchive" title="Unarchive"
                                                        data-action='@Url.Action("Unarchive", "Document", new { area = "Employee" })'
                                                        data-id="@doc.Id"
                                                        data-message="Unarchive this document?">
                                                    <i class="fas fa-box-open"></i>
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="noFilterResults" class="project-empty-state" style="display:none;">
                <div class="project-empty-icon"><i class="fas fa-magnifying-glass"></i></div>
                <div class="project-empty-title">No matching documents</div>
                <div class="project-empty-text">Try adjusting your search or filters.</div>
            </div>

            <div class="emp-pagination" id="docPagination"></div>
        }
        else    
        {
            <div class="emp-empty-state">
                <div class="emp-empty-icon"><i class="fas fa-file-alt"></i></div>
                <h3>No documents found</h3>
                <p>Create a new document to get started, or check the shared filter.</p>
                @* <a asp-area="Employee" asp-controller="Document" asp-action="Create" class="emp-btn emp-btn-primary" style="margin-top:.5rem;">
                    <i class="fas fa-plus"></i> New Document
                </a> *@
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Filter change -> reload page
        const filterSelect = document.getElementById('docFilter');
        const archiveSelect = document.getElementById('docArchiveFilter');
        const baseUrl = '@Url.Action("Index", "Document", new { area = "Employee" })';
        if (filterSelect) {
            filterSelect.addEventListener('change', function () {
                const archiveVal = (archiveSelect && archiveSelect.value) ? archiveSelect.value : '@archiveFilter';
                window.location.href = baseUrl + '?filter=' + encodeURIComponent(this.value) + '&archiveFilter=' + encodeURIComponent(archiveVal);
            });
        }
        if (archiveSelect) {
            archiveSelect.addEventListener('change', function () {
                const filterVal = (filterSelect && filterSelect.value) ? filterSelect.value : '@filter';
                window.location.href = baseUrl + '?filter=' + encodeURIComponent(filterVal) + '&archiveFilter=' + encodeURIComponent(this.value);
            });
        }

        // Enhanced client-side search + pagination (matches proposals)
        const searchInput = document.getElementById('docSearch');
        const pageSizeSelect = document.getElementById('docPageSize');
        const table = document.getElementById('documentsTable');
        const paginationEl = document.getElementById('docPagination');
        if (!table || !paginationEl) return;

        const allRows = Array.from(table.querySelectorAll('tbody .emp-row'));
        const noResults = document.getElementById('noFilterResults');
        let PAGE_SIZE = parseInt(pageSizeSelect?.value || '10');
        let currentPage = 1;
        let filteredRows = allRows.slice();

        // prepare pagination containers
        paginationEl.innerHTML = '<div class="emp-pagination-info" id="docPaginationInfo"></div><div class="emp-pagination-controls" id="docPaginationControls"></div>';
        const pageInfo = document.getElementById('docPaginationInfo');
        const pageControls = document.getElementById('docPaginationControls');

        function applyFilters() {
            const term = (searchInput?.value || '').toLowerCase().trim();
            filteredRows = allRows.filter(r => !term || (r.dataset.title || '').includes(term));
            currentPage = 1;
            render();
        }

        function render() {
            const total = filteredRows.length;
            const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
            currentPage = Math.min(currentPage, totalPages);
            const start = (currentPage - 1) * PAGE_SIZE;
            const end = start + PAGE_SIZE;

            allRows.forEach(r => r.style.display = 'none');
            filteredRows.forEach((r, i) => { r.style.display = (i >= start && i < end) ? '' : 'none'; });

            if (noResults) noResults.style.display = total === 0 ? '' : 'none';

            if (pageInfo) {
                pageInfo.textContent = total === 0 ? '' : `Showing ${total === 0 ? 0 : start + 1}–${Math.min(end, total)} of ${total}`;
            }

            if (pageControls) {
                pageControls.innerHTML = '';
                const makeBtn = (label, page, disabled, active) => {
                    const btn = document.createElement('button');
                    btn.className = 'emp-page-btn' + (active ? ' active' : '');
                    btn.innerHTML = label;
                    btn.disabled = !!disabled;
                    btn.addEventListener('click', () => { currentPage = page; render(); });
                    return btn;
                };

                pageControls.appendChild(makeBtn('<i class="fas fa-chevron-left"></i>', Math.max(1, currentPage - 1), currentPage === 1, false));
                const w = 2;
                for (let p = 1; p <= totalPages; p++) {
                    if (p === 1 || p === totalPages || (p >= currentPage - w && p <= currentPage + w)) {
                        pageControls.appendChild(makeBtn(p, p, false, p === currentPage));
                    } else if (p === currentPage - w - 1 || p === currentPage + w + 1) {
                        const el = document.createElement('span');
                        el.className = 'emp-page-ellipsis';
                        el.textContent = '…';
                        pageControls.appendChild(el);
                    }
                }
                pageControls.appendChild(makeBtn('<i class="fas fa-chevron-right"></i>', Math.min(totalPages, currentPage + 1), currentPage === totalPages, false));
            }
        }

        if (searchInput) searchInput.addEventListener('input', applyFilters);
        if (pageSizeSelect) {
            pageSizeSelect.value = String(PAGE_SIZE);
            pageSizeSelect.addEventListener('change', function () {
                const val = parseInt(pageSizeSelect.value, 10) || 10;
                PAGE_SIZE = Math.max(5, val);
                currentPage = 1;
                render();
            });
        }

        filteredRows = allRows.slice();
        render();
    });
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const modal = document.getElementById('confirmActionModal');
    const modalMsg = document.getElementById('confirmActionMessage');
    const modalForm = document.getElementById('confirmActionForm');
    const modalIdInput = document.getElementById('confirmActionId');
    const cancelBtn = document.getElementById('confirmActionCancel');

    function showModal(actionUrl, id, message) {
        if (!modal || !modalForm || !modalIdInput) return;
        modalForm.action = actionUrl;
        modalIdInput.value = id;
        modalMsg.textContent = message || 'Are you sure?';
        modal.style.display = 'flex';
        modal.setAttribute('aria-hidden', 'false');
    }

    function hideModal() {
        if (!modal) return;
        modal.style.display = 'none';
        modal.setAttribute('aria-hidden', 'true');
    }

    // Wire archive/unarchive buttons
    document.querySelectorAll('.emp-action-archive, .emp-action-unarchive').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const action = btn.getAttribute('data-action');
            const id = btn.getAttribute('data-id');
            const message = btn.getAttribute('data-message') || 'Are you sure?';
            if (!action || !id) return;
            showModal(action, id, message);
        });
    });

    // Cancel and backdrop
    cancelBtn?.addEventListener('click', hideModal);
    modal?.addEventListener('click', function (e) { if (e.target === modal) hideModal(); });
});
</script>
