@model project_lifecycle.Models.DocumentVersion
@{
    ViewData["Title"] = $"Version {Model?.VersionNumber} - {Model?.Title}";
}

<!-- ===== Page Hero ===== -->
<div class="emp-page-hero">
    <div class="emp-page-hero-content">
        <div class="emp-page-hero-left">
            <h1 class="emp-page-title">
                <span class="emp-page-title-icon"><i class="fas fa-clock-rotate-left"></i></span>
                Version @Model?.VersionNumber
            </h1>
            <p class="emp-page-subtitle">
                @Model?.Title
                <span style="opacity:.75;"> &mdash; Saved @Model?.DateCreated.ToString("MMM dd, yyyy h:mm tt")</span>
                @if (Model?.Employee != null)
                {
                    <span style="opacity:.75;"> by @Model.Employee.FirstName @Model.Employee.LastName</span>
                }
            </p>
        </div>
        <div class="emp-page-hero-right" style="display:flex;gap:.5rem;flex-wrap:wrap;">
            <form id="restoreVersionForm" asp-area="Employee" asp-controller="Document" asp-action="RestoreVersion" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="versionId" value="@Model?.Id" />
                <button type="button" class="emp-btn emp-btn-outline" id="restoreVersionBtn">
                    <i class="fas fa-rotate-left"></i>
                    <span>Restore this Version</span>
                </button>
            </form>
            <a asp-area="Employee" asp-controller="Document" asp-action="Edit"
               asp-route-id="@Model?.DocumentId" class="emp-btn emp-btn-outline">
                <i class="fas fa-arrow-left"></i>
                <span>Back to Document</span>
            </a>
        </div>
    </div>
</div>

<!-- ===== Version content card ===== -->
<div class="emp-detail-card">
    <div class="emp-detail-card-header">
        <span class="emp-status-badge emp-status-default">
            <span class="emp-status-dot"></span>
            Version @Model?.VersionNumber
        </span>
    </div>
    <div class="emp-detail-body">
        @Html.Raw(Model?.Content ?? string.Empty)
    </div>
</div>

<!-- ===== Restore Confirmation Modal ===== -->
<div class="emp-modal-backdrop" id="restoreConfirmModal" style="display:none;">
    <div class="emp-modal">
        <div class="emp-modal-icon">
            <i class="fas fa-question-circle"></i>
        </div>
        <h5 class="emp-modal-title">Confirm Restore</h5>
        <p class="emp-modal-message">Restore this version? Current content will be saved as a new version first.</p>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn-cancel" id="restoreCancelBtn">Cancel</button>
            <button type="button" class="emp-btn-confirm" id="restoreOkBtn">Restore</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var modal = document.getElementById('restoreConfirmModal');
            var form  = document.getElementById('restoreVersionForm');

            document.getElementById('restoreVersionBtn').addEventListener('click', function () {
                modal.style.display = 'flex';
            });

            document.getElementById('restoreCancelBtn').addEventListener('click', function () {
                modal.style.display = 'none';
            });

            modal.addEventListener('click', function (e) {
                if (e.target === modal) modal.style.display = 'none';
            });

            document.getElementById('restoreOkBtn').addEventListener('click', function () {
                form.submit();
            });
        })();
    </script>
}
