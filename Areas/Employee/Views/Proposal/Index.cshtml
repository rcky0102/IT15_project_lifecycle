    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<ProjectProposal>
@using project_lifecycle.Models
@{
}

<div class="dashboard-container py-4">

    <!-- ===== Page Header ===== -->
    <div class="proposal-page-header">
        <h1><i class="fas fa-lightbulb"></i>&nbsp; @(ViewData["Title"] ?? "Submit Project Proposal")</h1>
        <p class="proposal-subtitle">Create and track project proposals for your team</p>
    </div>

    <!-- ===== Alerts ===== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="proposal-alert success">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="proposal-alert error">
            <i class="fas fa-exclamation-circle"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    @if (ViewData["ErrorMessage"] != null)
    {
        <div class="proposal-alert error">
            <i class="fas fa-exclamation-circle"></i>
            <span>@ViewData["ErrorMessage"]</span>
        </div>
    }

    <!-- ===== Proposal Form ===== -->
    <div class="proposal-form-card">
        <div class="form-section-title">
            <i class="fas fa-pen-to-square"></i> New Proposal
        </div>

        <form asp-area="Employee" asp-controller="Proposal" asp-action="Create" method="post" enctype="multipart/form-data" class="auth-ocean-form">
            @Html.AntiForgeryToken()

            <div class="form-group-ocean">
                <label for="Title" class="form-label-ocean">Project Title</label>
                <input type="text" id="Title" name="Title" class="form-control-ocean" placeholder="Enter a descriptive title…" required maxlength="200" />
            </div>

            <div class="form-group-ocean">
                <label for="Description" class="form-label-ocean">Description</label>
                <textarea id="Description" name="Description" rows="5" class="form-control-ocean" placeholder="Describe the goals, scope and expected outcomes…" required></textarea>
            </div>

            <div class="proposal-date-row">
                <div class="form-group-ocean">
                    <label for="StartDate" class="form-label-ocean">Planned Start</label>
                    <input type="date" id="StartDate" name="StartDate" class="form-control-ocean" />
                </div>
                <div class="form-group-ocean">
                    <label for="EndDate" class="form-label-ocean">Planned End</label>
                    <input type="date" id="EndDate" name="EndDate" class="form-control-ocean" />
                </div>
            </div>

            <div class="form-group-ocean">
                <label class="form-label-ocean">File Attachment</label>
                <div class="proposal-file-upload">
                    <input type="file" id="fileAttachment" name="fileAttachment" />
                    <div class="upload-icon"><i class="fas fa-cloud-arrow-up"></i></div>
                    <div class="upload-text"><span>Click to browse</span> or drag &amp; drop</div>
                    <div class="upload-hint">PDF, DOCX, XLSX — max 10 MB</div>
                </div>
            </div>

            <div class="proposal-actions">
                <button type="submit" class="btn btn-ocean"><i class="fas fa-paper-plane"></i> Submit Proposal</button>
                <button type="reset" class="btn-reset"><i class="fas fa-rotate-left"></i> Reset</button>
            </div>
        </form>
    </div>

    <!-- ===== Proposals Table ===== -->
    <div class="proposal-table-section">
        <div class="proposal-table-header">
            <h3>
                <i class="fas fa-folder-open"></i> My Proposals
                <span class="proposal-count-badge">@Model.Count</span>
            </h3>
        </div>

        <div class="proposal-table-card">
            @if (Model.Any())
            {
                <div class="proposal-table-responsive">
                    <table class="proposal-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Owner / Team</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Budget</th>
                                <th>Status</th>
                                <th style="width:50px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var proposal in Model)
                            {
                                <tr>
                                    <td class="proposal-title-cell">@proposal.Title</td>
                                    <td>—</td>
                                    <td>—</td>
                                    <td class="proposal-date">@proposal.StartDate?.ToString("yyyy-MM-dd")</td>
                                    <td class="proposal-date">@proposal.EndDate?.ToString("yyyy-MM-dd")</td>
                                    <td>—</td>
                                    <td>
                                        <span class="proposal-status @GetStatusClass(proposal.Status)">
                                            <span class="status-dot"></span>
                                            @proposal.Status
                                        </span>
                                    </td>
                                    <td>
                                        <a href="#" class="proposal-view-btn" title="View details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="proposal-empty-state">
                    <div class="empty-icon"><i class="fas fa-inbox"></i></div>
                    <div class="empty-title">No proposals yet</div>
                    <div class="empty-text">Submit your first proposal using the form above.</div>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Pending"     => "status-pending",
            "Approved"    => "status-approved",
            "Rejected"    => "status-rejected",
            "In Progress" => "status-inprogress",
            _             => "status-default"
        };
    }
}
