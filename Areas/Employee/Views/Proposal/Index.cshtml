    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<ProjectProposal>
@using project_lifecycle.Models
@{
}

<div class="dashboard-container py-4">

    <!-- ===== Page Header ===== -->
    <div class="proposal-page-header">
        <h1><i class="fas fa-lightbulb"></i>&nbsp; @(ViewData["Title"] ?? "Proposals")</h1>
        <p class="proposal-subtitle">View and manage your project proposals</p>
    </div>


    <!-- Details are on a dedicated page now; removed modal and inline scripts -->

@if (TempData["SuccessMessage"] != null)
{
    <div class="proposal-alert success">
        <i class="fas fa-check-circle"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="proposal-alert error">
        <i class="fas fa-exclamation-circle"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

@if (ViewData["ErrorMessage"] != null)
{
    <div class="proposal-alert error">
        <i class="fas fa-exclamation-circle"></i>
        <span>@ViewData["ErrorMessage"]</span>
    </div>
}

<!-- ===== Proposals Table ===== -->
<div class="proposal-table-section">
        <div class="proposal-table-header">
            <h3>
                <i class="fas fa-folder-open"></i> My Proposals
                <span class="proposal-count-badge">@Model.Count</span>
            </h3>
            <a asp-area="Employee" asp-controller="Proposal" asp-action="Create" class="btn btn-ocean">
                <i class="fas fa-plus"></i> New Proposal
            </a>
        </div>

        <div class="proposal-table-card">
            @if (Model.Any())
            {
                <div class="proposal-table-responsive">
                    <table class="proposal-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Input Preview</th>
                                <th>Submitted</th>
                                <th>Status</th>
                                <th style="width:50px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var proposal in Model)
                            {
                                <tr>
                                    <td class="proposal-title-cell">
                                        @proposal.Title
                                        
                                    </td>
                                    <td>@GetInputPreview(proposal.Input)</td>
                                    <td class="proposal-date">@proposal.DateCreated.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <span class="proposal-status @GetStatusClass(proposal.Status)">
                                            <span class="status-dot"></span>
                                            @proposal.Status
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-area="Employee" asp-controller="Proposal" asp-action="Details" asp-route-id="@proposal.Id" class="proposal-view-btn" title="View details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="proposal-empty-state">
                    <div class="empty-icon"><i class="fas fa-inbox"></i></div>
                    <div class="empty-title">No proposals yet</div>
                    <div class="empty-text">Get started by creating your first proposal.</div>
                    <a asp-area="Employee" asp-controller="Proposal" asp-action="Create" class="btn btn-ocean" style="margin-top:1rem;">
                        <i class="fas fa-plus"></i> Create Proposal
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    private string GetInputPreview(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
        {
            return "—";
        }

        var withoutTags = System.Text.RegularExpressions.Regex.Replace(html, "<.*?>", " ");
        var normalized = System.Text.RegularExpressions.Regex.Replace(withoutTags, "\\s+", " ").Trim();

        if (string.IsNullOrWhiteSpace(normalized))
        {
            return "—";
        }

        const int maxLength = 120;
        return normalized.Length <= maxLength ? normalized : normalized.Substring(0, maxLength) + "...";
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Pending"           => "status-pending",
            "Approved"          => "status-approved",
            "Rejected"          => "status-rejected",
            "Requires Revision" => "status-requiresrevision",
            _                    => "status-default"
        };
    }
}
