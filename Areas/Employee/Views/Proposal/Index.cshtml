    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<ProjectProposal>
@using project_lifecycle.Models
@{
}
<div class="dashboard-container py-4">
    <div class="dashboard-header">
        <div class="header-content">
            <h1>@(ViewData["Title"] ?? "Submit Project Proposal")</h1>
            <p class="dashboard-subtitle">Create and track project proposals</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="auth-ocean-card" style="border-left:4px solid var(--ocean-deep);">
            <div class="header-content">
                <strong>@TempData["SuccessMessage"]</strong>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="auth-ocean-card" style="border-left:4px solid #ef4444; background-color: #fef2f2;">
            <div class="header-content">
                <strong style="color: #dc2626;">Error: @TempData["ErrorMessage"]</strong>
            </div>
        </div>
    }

    @if (ViewData["ErrorMessage"] != null)
    {
        <div class="auth-ocean-card" style="border-left:4px solid #ef4444; background-color: #fef2f2;">
            <div class="header-content">
                <strong style="color: #dc2626;">@ViewData["ErrorMessage"]</strong>
            </div>
        </div>
    }

    <div class="auth-ocean-card">
        <form asp-area="Employee" asp-controller="Proposal" asp-action="Create" method="post" enctype="multipart/form-data" class="auth-ocean-form">
            @Html.AntiForgeryToken()

            <div class="form-group-ocean">
                <label for="Title" class="form-label-ocean">Project Title</label>
                <input type="text" id="Title" name="Title" class="form-control-ocean" required maxlength="200" />
            </div>

            <div class="form-group-ocean">
                <label for="Description" class="form-label-ocean">Description</label>
                <textarea id="Description" name="Description" rows="5" class="form-control-ocean" required></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 form-group-ocean">
                    <label for="StartDate" class="form-label-ocean">Planned Start</label>
                    <input type="date" id="StartDate" name="StartDate" class="form-control-ocean" />
                </div>
                <div class="col-md-6 form-group-ocean">
                    <label for="EndDate" class="form-label-ocean">Planned End</label>
                    <input type="date" id="EndDate" name="EndDate" class="form-control-ocean" />
                </div>
            </div>

            <div class="form-group-ocean">
                <label for="fileAttachment" class="form-label-ocean">File Attachment</label>
                <input type="file" id="fileAttachment" name="fileAttachment" class="form-control-ocean" />
                <div class="divider-ocean" style="margin-top:.5rem;"><span class="link-ocean">Upload supporting documents (optional)</span></div>
            </div>

            <div style="display:flex;gap:.75rem;margin-top:1rem;">
                <button type="submit" class="btn btn-ocean btn-ocean-lg">Submit Proposal</button>
                <button type="reset" class="btn btn-outline-ocean btn-sm">Reset</button>
            </div>
        </form>
    </div>

    <hr style="margin:2rem 0;border:none;border-top:1px solid #eef2f7;" />

    <h3 class="mb-3">Existing Proposals</h3>
    <div class="card">
        <div class="card-body">
            <table class="table table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Owner / Team</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Budget</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var proposal in Model)
                        {
                            <tr>
                                <td>@proposal.Title</td>
                                <td>-</td>
                                <td>-</td>
                                <td>@proposal.StartDate?.ToString("yyyy-MM-dd")</td>
                                <td>@proposal.EndDate?.ToString("yyyy-MM-dd")</td>
                                <td>-</td>
                                <td><span class="badge @GetStatusColor(proposal.Status)">@proposal.Status</span></td>
                                <td><a href="#" class="text-primary" title="View"><i class="fas fa-eye"></i></a></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-muted text-center py-4">No proposals found. Submit a new proposal above.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning",
            "Approved" => "bg-success",
            "Rejected" => "bg-danger",
            "In Progress" => "bg-info",
            _ => "bg-secondary"
        };
    }
}
