@model project_lifecycle.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<style>
    .profile-container { max-width: 900px; margin: 0 auto; padding: 1.5rem; }
    .profile-header-card {
        background: linear-gradient(135deg, #006994 0%, #4CA3DD 100%);
        border-radius: 16px;
        padding: 2rem;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
        position: relative;
        overflow: hidden;
    }
    .profile-header-card::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 300px;
        height: 300px;
        background: rgba(255,255,255,0.05);
        border-radius: 50%;
    }
    .profile-avatar-wrapper {
        position: relative;
        flex-shrink: 0;
    }
    .profile-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 700;
        color: #fff;
        border: 3px solid rgba(255,255,255,0.4);
        overflow: hidden;
    }
    .profile-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .profile-header-info h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
    }
    .profile-header-info .profile-role-badge {
        display: inline-block;
        background: rgba(255,255,255,0.2);
        padding: .25rem .75rem;
        border-radius: 20px;
        font-size: .8rem;
        font-weight: 600;
        margin-top: .35rem;
    }
    .profile-header-info .profile-email {
        font-size: .9rem;
        opacity: 0.85;
        margin-top: .25rem;
    }

    .profile-section {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        padding: 1.5rem;
        margin-bottom: 1.25rem;
    }
    .profile-section-title {
        font-size: 1rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }
    .profile-section-title i {
        color: #006994;
        font-size: .9rem;
    }
    .profile-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1rem;
    }
    .profile-field {
        display: flex;
        flex-direction: column;
    }
    .profile-field-label {
        font-size: .78rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: .25rem;
    }
    .profile-field-value {
        font-size: .95rem;
        color: #1e293b;
        font-weight: 500;
    }
    .profile-field-value.empty {
        color: #94a3b8;
        font-style: italic;
    }

    /* Edit form */
    .profile-edit-section { display: none; }
    .profile-edit-section.active { display: block; }
    .profile-view-section.hidden { display: none; }

    .profile-form-group {
        margin-bottom: 1rem;
    }
    .profile-form-group label {
        display: block;
        font-size: .82rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: .35rem;
    }
    .profile-form-group input,
    .profile-form-group select {
        width: 100%;
        padding: .55rem .75rem;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: .9rem;
        color: #1e293b;
        background: #fff;
        transition: border-color .2s, box-shadow .2s;
    }
    .profile-form-group input:focus,
    .profile-form-group select:focus {
        outline: none;
        border-color: #006994;
        box-shadow: 0 0 0 3px rgba(0,105,148,0.1);
    }

    .profile-actions {
        display: flex;
        gap: .75rem;
        margin-top: .5rem;
    }
    .btn-profile-edit {
        padding: .55rem 1.25rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: .88rem;
        cursor: pointer;
        border: none;
        transition: all .2s;
    }
    .btn-profile-primary {
        background: linear-gradient(135deg, #006994, #4CA3DD);
        color: #fff;
    }
    .btn-profile-primary:hover { opacity: .9; }
    .btn-profile-secondary {
        background: transparent;
        border: 1px solid #d1d5db;
        color: #475569;
    }
    .btn-profile-secondary:hover { background: #f1f5f9; }

    .profile-img-upload {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: .5rem;
    }
    .profile-img-preview {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #e2e8f0;
    }
    .profile-img-placeholder {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        font-size: 1.2rem;
        border: 2px solid #e2e8f0;
    }

    .alert-profile-success {
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #065f46;
        padding: .75rem 1rem;
        border-radius: 8px;
        margin-bottom: 1rem;
        font-size: .9rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }
</style>

<div class="profile-container">

    @if (TempData["Success"] != null)
    {
        <div class="alert-profile-success">
            <i class="fas fa-check-circle"></i>
            @TempData["Success"]
        </div>
    }

    <!-- Header Card -->
    <div class="profile-header-card">
        <div class="profile-avatar-wrapper">
            <div class="profile-avatar">
                @if (!string.IsNullOrEmpty(Model.ProfileImage))
                {
                    <img src="@Model.ProfileImage" alt="Profile" />
                }
                else
                {
                    @Model.FirstName?.Substring(0, 1)@Model.LastName?.Substring(0, 1)
                }
            </div>
        </div>
        <div class="profile-header-info">
            <h2>@Model.FullName</h2>
            <div class="profile-email"><i class="fas fa-envelope" style="margin-right:.35rem"></i>@Model.Email</div>
            <span class="profile-role-badge"><i class="fas fa-id-badge" style="margin-right:.25rem"></i>@Model.RoleName</span>
        </div>
    </div>

    <!-- View Mode -->
    <div class="profile-view-section" id="viewSection">

        <div class="profile-section">
            <div class="profile-section-title"><i class="fas fa-user"></i> Personal Information</div>
            <div class="profile-grid">
                <div class="profile-field">
                    <span class="profile-field-label">Employee Number</span>
                    <span class="profile-field-value">@Model.EmployeeNumber</span>
                </div>
                <div class="profile-field">
                    <span class="profile-field-label">First Name</span>
                    <span class="profile-field-value">@Model.FirstName</span>
                </div>
                <div class="profile-field">
                    <span class="profile-field-label">Middle Name</span>
                    <span class="profile-field-value @(string.IsNullOrEmpty(Model.MiddleName) ? "empty" : "")">@(Model.MiddleName ?? "N/A")</span>
                </div>
                <div class="profile-field">
                    <span class="profile-field-label">Last Name</span>
                    <span class="profile-field-value">@Model.LastName</span>
                </div>
                @if (Model.Contact != null)
                {
                    <div class="profile-field">
                        <span class="profile-field-label">Contact</span>
                        <span class="profile-field-value @(string.IsNullOrEmpty(Model.Contact) ? "empty" : "")">@(Model.Contact ?? "N/A")</span>
                    </div>
                }
                @if (Model.DateHired.HasValue)
                {
                    <div class="profile-field">
                        <span class="profile-field-label">Date Hired</span>
                        <span class="profile-field-value">@Model.DateHired.Value.ToString("MMMM dd, yyyy")</span>
                    </div>
                }
                @if (Model.CreatedDate.HasValue)
                {
                    <div class="profile-field">
                        <span class="profile-field-label">Date Joined</span>
                        <span class="profile-field-value">@Model.CreatedDate.Value.ToString("MMMM dd, yyyy")</span>
                    </div>
                }
            </div>
        </div>

        <div class="profile-section">
            <div class="profile-section-title"><i class="fas fa-building"></i> Organization</div>
            <div class="profile-grid">
                <div class="profile-field">
                    <span class="profile-field-label">Department</span>
                    <span class="profile-field-value @(string.IsNullOrEmpty(Model.DepartmentName) ? "empty" : "")">@(Model.DepartmentName ?? "N/A")</span>
                </div>
                <div class="profile-field">
                    <span class="profile-field-label">Position</span>
                    <span class="profile-field-value @(string.IsNullOrEmpty(Model.PositionTitle) ? "empty" : "")">@(Model.PositionTitle ?? "N/A")</span>
                </div>
            </div>
        </div>

        <div class="profile-section">
            <div class="profile-section-title"><i class="fas fa-map-marker-alt"></i> Address</div>
            <div class="profile-grid">
                <div class="profile-field">
                    <span class="profile-field-label">Address Line</span>
                    <span class="profile-field-value @(string.IsNullOrEmpty(Model.AddressLine) ? "empty" : "")">@(Model.AddressLine ?? "N/A")</span>
                </div>
                <div class="profile-field">
                    <span class="profile-field-label">Region</span>
                    <span class="profile-field-value @(string.IsNullOrEmpty(Model.Region) ? "empty" : "")">@(Model.Region ?? "N/A")</span>
                </div>
                <div class="profile-field">
                    <span class="profile-field-label">Province</span>
                    <span class="profile-field-value @(string.IsNullOrEmpty(Model.Province) ? "empty" : "")">@(Model.Province ?? "N/A")</span>
                </div>
                <div class="profile-field">
                    <span class="profile-field-label">City</span>
                    <span class="profile-field-value @(string.IsNullOrEmpty(Model.City) ? "empty" : "")">@(Model.City ?? "N/A")</span>
                </div>
                <div class="profile-field">
                    <span class="profile-field-label">Barangay</span>
                    <span class="profile-field-value @(string.IsNullOrEmpty(Model.Barangay) ? "empty" : "")">@(Model.Barangay ?? "N/A")</span>
                </div>
            </div>
        </div>

        <div class="profile-actions">
            <button type="button" class="btn-profile-edit btn-profile-primary" id="editProfileBtn">
                <i class="fas fa-pen" style="margin-right:.35rem"></i> Edit Profile
            </button>
        </div>
    </div>

    <!-- Edit Mode -->
    <div class="profile-edit-section" id="editSection">
        <form asp-action="Update" asp-controller="Profile" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="profile-section">
                <div class="profile-section-title"><i class="fas fa-camera"></i> Profile Picture</div>
                <div class="profile-img-upload">
                    @if (!string.IsNullOrEmpty(Model.ProfileImage))
                    {
                        <img src="@Model.ProfileImage" alt="Profile" class="profile-img-preview" id="imgPreview" />
                    }
                    else
                    {
                        <div class="profile-img-placeholder" id="imgPlaceholder">
                            <i class="fas fa-user"></i>
                        </div>
                        <img src="" alt="" class="profile-img-preview" id="imgPreview" style="display:none;" />
                    }
                    <div>
                        <input type="file" name="ProfileImageFile" accept="image/*" id="profileImageInput" class="form-control form-control-sm" style="max-width:280px;" />
                        <small class="text-muted">JPG, PNG or GIF. Max 5MB.</small>
                    </div>
                </div>
            </div>

            @if (Model.Contact != null)
            {
                <div class="profile-section">
                    <div class="profile-section-title"><i class="fas fa-phone"></i> Contact Information</div>
                    <div class="profile-grid">
                        <div class="profile-form-group">
                            <label for="Contact">Contact Number</label>
                            <input type="text" id="Contact" name="Contact" value="@Model.Contact" placeholder="Enter contact number" />
                        </div>
                    </div>
                </div>
            }

            <div class="profile-section">
                <div class="profile-section-title"><i class="fas fa-map-marker-alt"></i> Address</div>
                <div class="profile-grid">
                    <div class="profile-form-group">
                        <label for="AddressLine">Address Line</label>
                        <input type="text" id="AddressLine" name="AddressLine" value="@Model.AddressLine" placeholder="Street, Building, Unit" />
                    </div>
                    <div class="profile-form-group">
                        <label for="Region">Region</label>
                        <input type="text" id="Region" name="Region" value="@Model.Region" placeholder="Region" />
                    </div>
                    <div class="profile-form-group">
                        <label for="Province">Province</label>
                        <input type="text" id="Province" name="Province" value="@Model.Province" placeholder="Province" />
                    </div>
                    <div class="profile-form-group">
                        <label for="City">City / Municipality</label>
                        <input type="text" id="City" name="City" value="@Model.City" placeholder="City / Municipality" />
                    </div>
                    <div class="profile-form-group">
                        <label for="Barangay">Barangay</label>
                        <input type="text" id="Barangay" name="Barangay" value="@Model.Barangay" placeholder="Barangay" />
                    </div>
                </div>
            </div>

            <div class="profile-actions">
                <button type="submit" class="btn-profile-edit btn-profile-primary">
                    <i class="fas fa-save" style="margin-right:.35rem"></i> Save Changes
                </button>
                <button type="button" class="btn-profile-edit btn-profile-secondary" id="cancelEditBtn">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const editBtn = document.getElementById('editProfileBtn');
        const cancelBtn = document.getElementById('cancelEditBtn');
        const viewSection = document.getElementById('viewSection');
        const editSection = document.getElementById('editSection');

        editBtn?.addEventListener('click', function () {
            viewSection.classList.add('hidden');
            editSection.classList.add('active');
        });

        cancelBtn?.addEventListener('click', function () {
            viewSection.classList.remove('hidden');
            editSection.classList.remove('active');
        });

        // Image preview
        const imgInput = document.getElementById('profileImageInput');
        const imgPreview = document.getElementById('imgPreview');
        const imgPlaceholder = document.getElementById('imgPlaceholder');

        imgInput?.addEventListener('change', function () {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    if (imgPreview) {
                        imgPreview.src = e.target.result;
                        imgPreview.style.display = 'block';
                    }
                    if (imgPlaceholder) {
                        imgPlaceholder.style.display = 'none';
                    }
                };
                reader.readAsDataURL(this.files[0]);
            }
        });
    })();
</script>
}
