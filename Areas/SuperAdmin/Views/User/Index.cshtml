@using project_lifecycle.ViewModels
@model UserListViewModel
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Areas/SuperAdmin/Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">User Management</h2>
            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Existing Users Table -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Existing Users</h5>
                </div>
                <div class="card-body">
                    @if (Model.Users.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Employee Number</th>
                                        <th>Name</th>
                                        <th>Department</th>
                                        <th>Position</th>
                                        <th>Date Hired</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model.Users)
                                    {
                                        <tr>
                                            <td>@user.Email</td>
                                            <td>
                                                <span class="badge bg-@(user.Role switch {
                                                    "HumanResource" => "primary",
                                                    "DepartmentHead" => "success",
                                                    "Executive" => "danger",
                                                    "ProjectManager" => "warning",
                                                    "Employee" => "info",
                                                    _ => "secondary"
                                                })">
                                                    @user.Role
                                                </span>
                                            </td>
                                            <td>@user.EmployeeNumber</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(user.FirstName))
                                                {
                                                    @($"{user.FirstName} {user.MiddleName} {user.LastName}".Replace("  ", " ").Trim())
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                            <td>@user.DepartmentName</td>
                                            <td>@user.PositionName</td>
                                            <td>
                                                @if (user.DateHired.HasValue)
                                                {
                                                    @user.DateHired.Value.ToString("MMM dd, yyyy")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <p class="text-muted mb-0">No users found. Create your first user below.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Create New User Form -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Create New User</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" id="createUserForm">
                        @Html.AntiForgeryToken()
                        
                        <div class="row">
                            <!-- User Account Information -->
                            <div class="col-md-6">
                                <h6 class="text-primary mb-3">Account Information</h6>
                                
                                <div class="mb-3">
                                    <label asp-for="CreateUserViewModel.Email" class="form-label"></label>
                                    <input asp-for="CreateUserViewModel.Email" class="form-control" placeholder="Enter email address" />
                                    <span asp-validation-for="CreateUserViewModel.Email" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="CreateUserViewModel.Password" class="form-label"></label>
                                    <input asp-for="CreateUserViewModel.Password" type="password" class="form-control" placeholder="Enter password" />
                                    <span asp-validation-for="CreateUserViewModel.Password" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="CreateUserViewModel.ConfirmPassword" class="form-label"></label>
                                    <input asp-for="CreateUserViewModel.ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" />
                                    <span asp-validation-for="CreateUserViewModel.ConfirmPassword" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="CreateUserViewModel.Role" class="form-label"></label>
                                    <select asp-for="CreateUserViewModel.Role" class="form-select" id="roleSelect">
                                        <option value="">Select Role</option>
                                        <option value="HumanResource">Human Resource</option>
                                        <option value="DepartmentHead">Department Head</option>
                                        <option value="Executive">Executive</option>
                                        <option value="ProjectManager">Project Manager</option>
                                        <option value="Employee">Employee</option>
                                    </select>
                                    <span asp-validation-for="CreateUserViewModel.Role" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Role-specific Information (shown only for roles that need additional details) -->
                            <div class="col-md-6" id="roleSpecificFields" style="display: none;">
                                <h6 class="text-info mb-3" id="roleFieldsTitle">Role Information</h6>
                                
                                <div class="mb-3" id="employeeNumberField" style="display: none;">
                                    <label asp-for="CreateUserViewModel.EmployeeNumber" class="form-label"></label>
                                    <input asp-for="CreateUserViewModel.EmployeeNumber" class="form-control" placeholder="Enter employee number" readonly />
                                    <span asp-validation-for="CreateUserViewModel.EmployeeNumber" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label asp-for="CreateUserViewModel.FirstName" class="form-label"></label>
                                            <input asp-for="CreateUserViewModel.FirstName" class="form-control" placeholder="Enter first name" />
                                            <span asp-validation-for="CreateUserViewModel.FirstName" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label asp-for="CreateUserViewModel.MiddleName" class="form-label"></label>
                                            <input asp-for="CreateUserViewModel.MiddleName" class="form-control" placeholder="Enter middle name (optional)" />
                                            <span asp-validation-for="CreateUserViewModel.MiddleName" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label asp-for="CreateUserViewModel.LastName" class="form-label"></label>
                                            <input asp-for="CreateUserViewModel.LastName" class="form-control" placeholder="Enter last name" />
                                            <span asp-validation-for="CreateUserViewModel.LastName" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="CreateUserViewModel.DepartmentId" class="form-label"></label>
                                            <select asp-for="CreateUserViewModel.DepartmentId" class="form-select" asp-items="@(new SelectList(Model.CreateUserViewModel.Departments, "Id", "Name"))">
                                                <option value="">Select Department</option>
                                            </select>
                                            <span asp-validation-for="CreateUserViewModel.DepartmentId" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="CreateUserViewModel.PositionId" class="form-label"></label>
                                            <select asp-for="CreateUserViewModel.PositionId" class="form-select" asp-items="@(new SelectList(Model.CreateUserViewModel.Positions, "Id", "Name"))">
                                                <option value="">Select Position</option>
                                            </select>
                                            <span asp-validation-for="CreateUserViewModel.PositionId" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="CreateUserViewModel.DateHired" class="form-label"></label>
                                    <input asp-for="CreateUserViewModel.DateHired" type="date" class="form-control" />
                                    <span asp-validation-for="CreateUserViewModel.DateHired" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12">
                                <button type="submit" class="btn btn-ocean">
                                    <i class="fas fa-user-plus"></i> Create User
                                </button>
                                <button type="reset" class="btn btn-outline-ocean ms-2">
                                    <i class="fas fa-redo"></i> Reset Form
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Show/hide role-specific fields based on role selection
            $('#roleSelect').change(function() {
                const selectedRole = $(this).val();
                const $roleFields = $('#roleSpecificFields');
                const $roleFieldsTitle = $('#roleFieldsTitle');
                
                // Hide all role-specific fields first
                $roleFields.slideUp();
                
                if (selectedRole === 'Employee') {
                    $roleFieldsTitle.text('Employee Information');
                    $roleFields.slideDown();
                    // Make employee fields required (but employee number is auto-generated)
                    $('#CreateUserViewModel_FirstName').prop('required', true);
                    $('#CreateUserViewModel_LastName').prop('required', true);
                    $('#CreateUserViewModel_DepartmentId').prop('required', true);
                    $('#CreateUserViewModel_PositionId').prop('required', true);
                    $('#CreateUserViewModel_DateHired').prop('required', true);
                    // Hide employee number field as it will be auto-generated
                    $('#employeeNumberField').hide();
                } else if (selectedRole === 'DepartmentHead' || selectedRole === 'ProjectManager') {
                    $roleFieldsTitle.text(selectedRole === 'DepartmentHead' ? 'Department Head Information' : 'Project Manager Information');
                    $roleFields.slideDown();
                    // Make basic fields required, but not employee-specific ones
                    $('#CreateUserViewModel_FirstName').prop('required', true);
                    $('#CreateUserViewModel_LastName').prop('required', true);
                    $('#CreateUserViewModel_DepartmentId').prop('required', true);
                    // Hide employee number field
                    $('#employeeNumberField').hide();
                    // Remove required from employee-specific fields
                    $('#CreateUserViewModel_EmployeeNumber').prop('required', false);
                    $('#CreateUserViewModel_PositionId').prop('required', false);
                    $('#CreateUserViewModel_DateHired').prop('required', false);
                } else if (selectedRole === 'HumanResource' || selectedRole === 'Executive') {
                    $roleFieldsTitle.text(selectedRole === 'HumanResource' ? 'Human Resource Information' : 'Executive Information');
                    $roleFields.slideDown();
                    // Make basic fields required
                    $('#CreateUserViewModel_FirstName').prop('required', true);
                    $('#CreateUserViewModel_LastName').prop('required', true);
                    // Hide employee number field
                    $('#employeeNumberField').hide();
                    // Remove required from employee and department-specific fields
                    $('#CreateUserViewModel_EmployeeNumber').prop('required', false);
                    $('#CreateUserViewModel_DepartmentId').prop('required', false);
                    $('#CreateUserViewModel_PositionId').prop('required', false);
                    $('#CreateUserViewModel_DateHired').prop('required', false);
                } else {
                    // Hide employee number field
                    $('#employeeNumberField').hide();
                    // Remove required from all fields
                    $('#CreateUserViewModel_EmployeeNumber').prop('required', false);
                    $('#CreateUserViewModel_FirstName').prop('required', false);
                    $('#CreateUserViewModel_LastName').prop('required', false);
                    $('#CreateUserViewModel_DepartmentId').prop('required', false);
                    $('#CreateUserViewModel_PositionId').prop('required', false);
                    $('#CreateUserViewModel_DateHired').prop('required', false);
                }
            });

            // Reset form handler
            $('button[type="reset"]').click(function(e) {
                e.preventDefault();
                $('#createUserForm')[0].reset();
                $('#roleSpecificFields').slideUp();
                // Clear validation messages
                $('.text-danger').text('');
                $('.form-control, .form-select').removeClass('is-invalid');
            });
        });
    </script>
}
