@using project_lifecycle.ViewModels
@model UserListViewModel
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Areas/SuperAdmin/Layout.cshtml";
}

<!-- ===== Page Title Hero ===== -->
<div class="sa-page-hero">
    <div class="sa-page-hero-content">
        <div class="sa-page-hero-left">
            <h1 class="sa-page-title">
                <span class="sa-page-title-icon"><i class="fas fa-users-gear"></i></span>
                User Management
            </h1>
            <p class="sa-page-subtitle">Manage system users and their roles</p>
        </div>
        <div class="sa-page-hero-right">
            <button type="button" class="sa-btn sa-btn-outline" data-bs-toggle="modal" data-bs-target="#createUserModal">
                <i class="fas fa-user-plus"></i>
                <span>Add User</span>
            </button>
        </div>
    </div>
</div>

<!-- ===== Alerts ===== -->
@if (TempData["Success"] != null)
{
    <div class="sa-alert sa-alert-success">
        <div class="sa-alert-icon"><i class="fas fa-check-circle"></i></div>
        <span>@TempData["Success"]</span>
        <button class="sa-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}

<!-- ===== Filters ===== -->
<div class="sa-filters-card">
    <div class="sa-filters-row">
        <div class="sa-search-group">
            <i class="fas fa-magnifying-glass sa-search-icon"></i>
            <input id="userSearch" type="text" class="sa-search-input" placeholder="Search users…" autocomplete="off" />
        </div>
        <div class="sa-select-group">
            <select id="roleFilter" class="sa-select">
                <option value="">All Roles</option>
                <option value="HumanResource">Human Resource</option>
                <option value="DepartmentHead">Department Head</option>
                <option value="Executive">Executive</option>
                <option value="ProjectManager">Project Manager</option>
                <option value="Employee">Employee</option>
            </select>
        </div>
        <div class="sa-select-group">
            <label for="pageSizeSelect" style="font-size:.82rem;color:var(--sa-muted);margin-right:.4rem;">Show</label>
            <select id="pageSizeSelect" class="sa-select" style="width:92px;">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
    </div>
</div>

<!-- ===== Table ===== -->
<div class="sa-table-section">
    <div class="sa-table-card">
        @if (Model.Users.Any())
        {
            <div class="sa-table-responsive">
                <table class="sa-table" id="usersTable">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Employee #</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Position</th>
                            <th>Date Hired</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="usersBody">
                        @foreach (var user in Model.Users)
                        {
                            var fullName = !string.IsNullOrEmpty(user.FirstName)
                                ? $"{user.FirstName} {user.MiddleName} {user.LastName}".Replace("  ", " ").Trim()
                                : "";
                            <tr class="sa-row"
                                data-email="@user.Email.ToLower()"
                                data-name="@fullName.ToLower()"
                                data-role="@user.Role"
                                data-dept="@(user.DepartmentName?.ToLower() ?? "")"
                                data-empno="@(user.EmployeeNumber?.ToLower() ?? "")">
                                <td>
                                    <div class="sa-name-cell">
                                        @if (!string.IsNullOrEmpty(user.ProfileImage))
                                        {
                                            <img src="@user.ProfileImage" alt="Profile" class="sa-profile-img" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="sa-name-icon">
                                                <i class="fas fa-user"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="sa-name-text">@user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="sa-role-badge sa-role-@user.Role.ToLower()">
                                        <span class="sa-role-dot"></span>
                                        <span>@user.Role</span>
                                    </span>
                                </td>
                                <td class="sa-date">@(user.EmployeeNumber ?? "—")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.FirstName))
                                    {
                                        @fullName
                                    }
                                    else
                                    {
                                        <span style="color:#94a3b8;">N/A</span>
                                    }
                                </td>
                                <td>@(user.DepartmentName ?? "—")</td>
                                <td>@(user.PositionName ?? "—")</td>
                                <td class="sa-date">
                                    @if (user.DateHired.HasValue)
                                    {
                                        @user.DateHired.Value.ToString("MMM dd, yyyy")
                                    }
                                    else
                                    {
                                        <span style="color:#94a3b8;">N/A</span>
                                    }
                                </td>
                                <td>
                                    <div class="sa-action-group">
                                        <button type="button" class="sa-action-btn sa-action-edit" title="Edit user" onclick="editUser('@user.UserId', '@Html.Raw(user.Email.Replace("'", "\\'"))', '@user.Role', '@Html.Raw(user.FirstName?.Replace("'", "\\'") ?? "")', '@Html.Raw(user.MiddleName?.Replace("'", "\\'") ?? "")', '@Html.Raw(user.LastName?.Replace("'", "\\'") ?? "")', '@user.EmployeeNumber', '@Html.Raw(user.DepartmentName?.Replace("'", "\\'") ?? "")', '@Html.Raw(user.PositionName?.Replace("'", "\\'") ?? "")')">
                                            <i class="fas fa-pen-to-square"></i>
                                        </button>
                                        <button type="button" class="sa-action-btn sa-action-delete" title="Delete user" onclick="confirmDeleteUser('@user.UserId', '@Html.Raw(user.Email.Replace("'", "\\'"))')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="noFilterResults" class="sa-empty-state" style="display:none;">
                <div class="sa-empty-icon"><i class="fas fa-magnifying-glass"></i></div>
                <div class="sa-empty-title">No matching users</div>
                <div class="sa-empty-text">Try adjusting your search or filters.</div>
            </div>

            <div class="sa-pagination" id="paginationContainer">
                <div class="sa-pagination-info" id="paginationInfo"></div>
                <div class="sa-pagination-controls" id="paginationControls"></div>
            </div>
        }
        else
        {
            <div class="sa-empty-state">
                <div class="sa-empty-icon"><i class="fas fa-users"></i></div>
                <div class="sa-empty-title">No users found</div>
                <div class="sa-empty-text">Create your first user to get started.</div>
            </div>
        }
    </div>
</div>

<!-- Create User Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-xl">
        <div class="modal-content cp-modal">
            <!-- Gradient Header -->
            <div class="cp-modal-header">
                <div>
                    <h5 class="cp-modal-title" id="createUserModalLabel">
                        <i class="fas fa-user-plus"></i> Create New User
                    </h5>
                    <p class="cp-modal-subtitle" id="stepSubtitle">Step 1 of 4 &mdash; Role Selection</p>
                </div>
                <button type="button" class="btn-close btn-close-white mt-1" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Stepper Track -->
            <div class="cp-stepper">
                <div class="cp-step active" data-step="1" role="button" tabindex="0" aria-label="Go to Role step">
                    <div class="cp-step-circle"><i class="fas fa-user-tag"></i></div>
                    <span class="cp-step-label">Role</span>
                </div>
                <div class="cp-step-line" id="stepLine1"></div>
                <div class="cp-step" data-step="2" role="button" tabindex="0" aria-label="Go to Account step">
                    <div class="cp-step-circle"><i class="fas fa-envelope"></i></div>
                    <span class="cp-step-label">Account</span>
                </div>
                <div class="cp-step-line" id="stepLine2"></div>
                <div class="cp-step" data-step="3" role="button" tabindex="0" aria-label="Go to Details step">
                    <div class="cp-step-circle"><i class="fas fa-id-card"></i></div>
                    <span class="cp-step-label">Details</span>
                </div>
                <div class="cp-step-line" id="stepLine3"></div>
                <div class="cp-step" data-step="4" role="button" tabindex="0" aria-label="Go to Review step">
                    <div class="cp-step-circle"><i class="fas fa-check-circle"></i></div>
                    <span class="cp-step-label">Review</span>
                </div>
            </div>

            <!-- Body -->
            <div class="modal-body cp-modal-body">
                <form id="createUserForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editingUserId" name="UserId" />

                    <!-- Step 1: Role Selection -->
                    <div class="cp-step-panel" id="stepPanel1">
                        <div class="modal-form-section">
                            <div class="modal-section-title">
                                <i class="fas fa-user-tag"></i> Role Selection
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="CreateUserViewModel.Role" class="form-label"></label>
                                    <select asp-for="CreateUserViewModel.Role" class="form-select" id="roleSelect">
                                        <option value="">Select Role</option>
                                        <option value="HumanResource">Human Resource</option>
                                        <option value="DepartmentHead">Department Head</option>
                                        <option value="Executive">Executive</option>
                                        <option value="ProjectManager">Project Manager</option>
                                        <option value="Employee">Employee</option>
                                    </select>
                                    <span asp-validation-for="CreateUserViewModel.Role" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="role-description mt-3" id="roleDescription" style="display: none;">
                                <div class="alert-ocean-light" style="padding:.75rem 1rem;border-radius:10px;">
                                    <i class="fas fa-info-circle"></i> <span id="roleDescriptionText"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Account Information -->
                    <div class="cp-step-panel" id="stepPanel2" style="display: none;">
                        <div class="modal-form-section">
                            <div class="modal-section-title">
                                <i class="fas fa-envelope"></i> Account Information
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="CreateUserViewModel.Email" class="form-label"></label>
                                    <input asp-for="CreateUserViewModel.Email" class="form-control" id="userEmail" placeholder="Enter email address" />
                                    <span asp-validation-for="CreateUserViewModel.Email" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CreateUserViewModel.Password" class="form-label"></label>
                                    <input asp-for="CreateUserViewModel.Password" type="password" class="form-control" id="userPassword" placeholder="Enter password" />
                                    <span asp-validation-for="CreateUserViewModel.Password" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CreateUserViewModel.ConfirmPassword" class="form-label"></label>
                                    <input asp-for="CreateUserViewModel.ConfirmPassword" type="password" class="form-control" id="userConfirmPassword" placeholder="Confirm password" />
                                    <span asp-validation-for="CreateUserViewModel.ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Personal Details -->
                    <div class="cp-step-panel" id="stepPanel3" style="display: none;">
                        <div class="modal-form-section">
                            <div class="modal-section-title" id="personalDetailsTitle">
                                <i class="fas fa-id-card"></i> Personal Details
                            </div>
                            <div class="row g-3 mb-3" id="profileImageContainer" style="display: none;">
                                <div class="col-md-12">
                                    <label class="form-label"><i class="fas fa-camera"></i> Profile Image</label>
                                    <div class="d-flex align-items-center gap-3">
                                        <div id="profileImagePreviewWrapper" style="width:80px;height:80px;border-radius:50%;overflow:hidden;border:2px dashed #cbd5e1;display:flex;align-items:center;justify-content:center;background:#f8fafc;">
                                            <img id="profileImagePreview" src="" alt="Preview" style="width:100%;height:100%;object-fit:cover;display:none;" />
                                            <i class="fas fa-user" id="profileImagePlaceholder" style="font-size:1.8rem;color:#94a3b8;"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <input type="file" class="form-control" id="profileImageFile" name="ProfileImageFile" accept="image/png,image/jpeg,image/gif,image/webp" />
                                            <small class="text-muted">Accepted formats: JPG, PNG, GIF, WebP. Max 2MB.</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row g-3" id="personalFieldsContainer" style="display: none;">
                                <div class="col-md-4" id="employeeNumberField" style="display: none;">
                                    <label asp-for="CreateUserViewModel.EmployeeNumber" class="form-label"></label>
                                    <input asp-for="CreateUserViewModel.EmployeeNumber" class="form-control" id="userEmployeeNumber" placeholder="Enter employee number" readonly />
                                    <span asp-validation-for="CreateUserViewModel.EmployeeNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row g-3" id="nameFieldsContainer" style="display: none;">
                                <div class="col-md-4">
                                    <label asp-for="CreateUserViewModel.FirstName" class="form-label"></label>
                                    <input asp-for="CreateUserViewModel.FirstName" class="form-control" id="userFirstName" placeholder="Enter first name" />
                                    <span asp-validation-for="CreateUserViewModel.FirstName" class="text-danger"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="CreateUserViewModel.MiddleName" class="form-label"></label>
                                    <input asp-for="CreateUserViewModel.MiddleName" class="form-control" id="userMiddleName" placeholder="Enter middle name (optional)" />
                                    <span asp-validation-for="CreateUserViewModel.MiddleName" class="text-danger"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="CreateUserViewModel.LastName" class="form-label"></label>
                                    <input asp-for="CreateUserViewModel.LastName" class="form-control" id="userLastName" placeholder="Enter last name" />
                                    <span asp-validation-for="CreateUserViewModel.LastName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row g-3" id="contactFieldsContainer" style="display: none;">
                                <div class="col-md-6">
                                    <label asp-for="CreateUserViewModel.Contact" class="form-label"></label>
                                    <input asp-for="CreateUserViewModel.Contact" class="form-control" id="userContact" placeholder="Enter contact number" />
                                    <span asp-validation-for="CreateUserViewModel.Contact" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row g-3" id="addressFieldsContainer" style="display: none;">
                                <div class="col-md-6">
                                    <label class="form-label">Region</label>
                                    <select id="psgcRegion" class="form-select"></select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Province</label>
                                    <select id="psgcProvince" class="form-select"></select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">City / Municipality</label>
                                    <select id="psgcCity" class="form-select"></select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Barangay</label>
                                    <select id="psgcBarangay" class="form-select"></select>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Street / Address</label>
                                    <input id="userAddressLine" class="form-control" placeholder="House number, street, subdivision" />
                                </div>
                            </div>
                            <div class="row g-3" id="employmentFieldsContainer" style="display: none;">
                                <div class="col-md-6">
                                    <label asp-for="CreateUserViewModel.DepartmentId" class="form-label"></label>
                                    <select asp-for="CreateUserViewModel.DepartmentId" class="form-select" id="userDepartmentId">
                                        <option value="">Select Department</option>
                                        @foreach (var dept in Model.CreateUserViewModel.Departments)
                                        {
                                            <option value="@dept.Id">@dept.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="CreateUserViewModel.DepartmentId" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CreateUserViewModel.PositionId" class="form-label"></label>
                                    <select asp-for="CreateUserViewModel.PositionId" class="form-select" id="userPositionId">
                                        <option value="">Select Position</option>
                                        @foreach (var pos in Model.CreateUserViewModel.Positions)
                                        {
                                            <option value="@pos.Id">@pos.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="CreateUserViewModel.PositionId" class="text-danger"></span>
                                </div>
                            </div>
                            <input type="hidden" asp-for="CreateUserViewModel.DateHired" id="userDateHired" />
                        </div>
                    </div>

                    <!-- Step 4: Review & Create -->
                    <div class="cp-step-panel" id="stepPanel4" style="display: none;">
                        <div class="modal-form-section">
                            <div class="modal-section-title">
                                <i class="fas fa-check-circle"></i> Review User Information
                            </div>
                            <div class="sa-review-card">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h6 class="sa-review-section-title">Account Information</h6>
                                        <p><strong>Email:</strong> <span id="reviewEmail">-</span></p>
                                        <p><strong>Role:</strong> <span id="reviewRole">-</span></p>
                                    </div>
                                    <div class="col-md-6">
                                        <h6 class="sa-review-section-title">Personal Information</h6>
                                        <div class="d-flex align-items-center gap-2 mb-2" id="reviewProfileImageRow" style="display:none !important;">
                                            <img id="reviewProfileImage" src="" alt="Profile" style="width:48px;height:48px;border-radius:50%;object-fit:cover;" />
                                        </div>
                                        <p><strong>Name:</strong> <span id="reviewName">-</span></p>
                                        <p><strong>Contact:</strong> <span id="reviewContact">-</span></p>
                                    </div>
                                </div>
                                <div class="row mt-3" id="reviewAddressInfo" style="display: none;">
                                    <div class="col-md-6">
                                        <h6 class="sa-review-section-title">Address Information</h6>
                                        <p><strong>Region:</strong> <span id="reviewRegion">-</span></p>
                                        <p><strong>Province:</strong> <span id="reviewProvince">-</span></p>
                                        <p><strong>City / Municipality:</strong> <span id="reviewCity">-</span></p>
                                        <p><strong>Barangay:</strong> <span id="reviewBarangay">-</span></p>
                                        <p><strong>Street / Address:</strong> <span id="reviewAddressLine">-</span></p>
                                    </div>
                                </div>
                                <div class="row mt-3" id="reviewEmploymentInfo" style="display: none;">
                                    <div class="col-md-6">
                                        <h6 class="sa-review-section-title">Employment Information</h6>
                                        <p><strong>Employee Number:</strong> <span id="reviewEmployeeNumber">-</span></p>
                                        <p><strong>Department:</strong> <span id="reviewDepartment">-</span></p>
                                        <p><strong>Position:</strong> <span id="reviewPosition">-</span></p>
                                        <p><strong>Date Hired:</strong> <span id="reviewDateHired">-</span></p>
                                    </div>
                                </div>
                            </div>
                            <div class="sa-alert-warning mt-3">
                                <i class="fas fa-exclamation-triangle"></i> Please review all information before creating the user. This action cannot be undone.
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Stepper Footer -->
            <div class="cp-modal-footer">
                <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal" id="cancelBtn">Cancel</button>
                <div class="cp-step-nav">
                    <button type="button" class="btn-modal-prev" id="prevBtn" style="display: none;">
                        <i class="fas fa-chevron-left"></i> Back
                    </button>
                    <button type="button" class="btn-modal-next" id="nextBtn">
                        Next <i class="fas fa-chevron-right"></i>
                    </button>
                    <button type="button" class="btn-modal-submit" id="saveUserBtn" style="display: none;">
                        <i class="fas fa-user-plus"></i> Create User
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete User Confirmation Modal -->
<div class="emp-modal-backdrop" id="deleteUserModal" role="dialog" aria-modal="true" aria-hidden="true" style="display:none;">
    <div class="emp-modal" role="document">
        <h4 id="deleteUserModalLabel"><i class="fas fa-exclamation-triangle"></i> Confirm User Deletion</h4>
        <p>Are you sure you want to delete this user? All associated data will be permanently removed.</p>
        <p style="text-align:center;margin-top:.5rem;"><strong>User Email:</strong> <span id="deleteUserEmail" style="color:#ef4444;"></span></p>
        <form id="deleteUserForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="deleteUserId" />
        </form>
        <div class="emp-modal-actions">
            <button type="button" class="emp-btn emp-btn-cancel" id="cancelDeleteUserBtn">Cancel</button>
            <button type="button" class="emp-btn emp-btn-confirm" id="confirmDeleteUserBtn" style="background:linear-gradient(135deg,#ef4444,#f87171);"><i class="fas fa-trash"></i> Delete User</button>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/superadmin-management.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/psgc.js" asp-append-version="true"></script>
    <!-- Client-side filter & pagination -->
    <script>
    (function () {
        let PAGE_SIZE = 10;
        let currentPage = 1;
        let filteredRows = [];

        const searchInput  = document.getElementById('userSearch');
        const roleSelect   = document.getElementById('roleFilter');
        const allRows      = Array.from(document.querySelectorAll('.sa-row'));
        const noResults    = document.getElementById('noFilterResults');
        const pageInfo     = document.getElementById('paginationInfo');
        const pageControls = document.getElementById('paginationControls');
        const pageSizeSelect = document.getElementById('pageSizeSelect');

        function applyFilters() {
            const query = (searchInput?.value ?? '').toLowerCase().trim();
            const role  = roleSelect?.value ?? '';
            filteredRows = allRows.filter(row => {
                const email   = row.dataset.email || '';
                const name    = row.dataset.name || '';
                const dept    = row.dataset.dept || '';
                const empno   = row.dataset.empno || '';
                const textMatch = !query || email.includes(query) || name.includes(query) || dept.includes(query) || empno.includes(query);
                const roleMatch = !role || row.dataset.role === role;
                return textMatch && roleMatch;
            });
            currentPage = 1;
            render();
        }

        function render() {
            const total = filteredRows.length;
            const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
            currentPage = Math.min(currentPage, totalPages);
            const start = (currentPage - 1) * PAGE_SIZE;
            const end   = start + PAGE_SIZE;

            allRows.forEach(r => r.style.display = 'none');
            filteredRows.forEach((r, i) => {
                r.style.display = (i >= start && i < end) ? '' : 'none';
            });

            if (noResults) noResults.style.display = total === 0 ? '' : 'none';
            if (pageInfo) {
                pageInfo.textContent = total === 0 ? '' : 'Showing ' + (start + 1) + '\u2013' + Math.min(end, total) + ' of ' + total;
            }

            if (pageControls) {
                pageControls.innerHTML = '';
                const makeBtn = (label, page, disabled, active) => {
                    const btn = document.createElement('button');
                    btn.className = 'sa-page-btn' + (active ? ' active' : '');
                    btn.innerHTML = label;
                    btn.disabled  = disabled;
                    btn.addEventListener('click', () => { currentPage = page; render(); });
                    return btn;
                };
                pageControls.appendChild(makeBtn('<i class="fas fa-chevron-left"></i>', currentPage - 1, currentPage === 1, false));
                const w = 2;
                for (let p = 1; p <= totalPages; p++) {
                    if (p === 1 || p === totalPages || (p >= currentPage - w && p <= currentPage + w)) {
                        pageControls.appendChild(makeBtn(p, p, false, p === currentPage));
                    } else if (p === currentPage - w - 1 || p === currentPage + w + 1) {
                        const el = document.createElement('span');
                        el.className = 'sa-page-ellipsis';
                        el.textContent = '\u2026';
                        pageControls.appendChild(el);
                    }
                }
                pageControls.appendChild(makeBtn('<i class="fas fa-chevron-right"></i>', currentPage + 1, currentPage === totalPages, false));
            }
        }

        if (searchInput)  searchInput.addEventListener('input', applyFilters);
        if (roleSelect)   roleSelect.addEventListener('change', applyFilters);
        if (pageSizeSelect) {
            pageSizeSelect.value = String(PAGE_SIZE);
            pageSizeSelect.addEventListener('change', function () {
                PAGE_SIZE = Math.max(5, parseInt(pageSizeSelect.value, 10) || 10);
                currentPage = 1;
                render();
            });
        }

        filteredRows = allRows.slice();
        render();
    })();
    </script>
    <script>
        $(document).ready(function() {
            let currentStep = 1;
            const totalSteps = 4;

            // Role descriptions
            const roleDescriptions = {
                'HumanResource': 'Manages employee records, payroll, and HR-related tasks.',
                'DepartmentHead': 'Oversees department operations and team members.',
                'Executive': 'Senior management with strategic decision-making authority.',
                'ProjectManager': 'Manages projects, timelines, and project teams.',
                'Employee': 'Regular team member with assigned tasks and responsibilities.'
            };

            // Initialize stepper
            function initStepper() {
                // Set today's date as the default date hired
                const today = new Date().toISOString().split('T')[0];
                $('#userDateHired').val(today);
                
                updateStepperUI();
                showStep(1);
            }

            // Step subtitles
            const stepSubtitles = {
                1: 'Step 1 of 4 &mdash; Role Selection',
                2: 'Step 2 of 4 &mdash; Account Information',
                3: 'Step 3 of 4 &mdash; Personal Details',
                4: 'Step 4 of 4 &mdash; Review & Create'
            };

            // Update stepper UI
            function updateStepperUI() {
                $('.cp-step').removeClass('active completed');
                $('.cp-step-line').removeClass('completed');
                
                for (let i = 1; i <= totalSteps; i++) {
                    const $stepItem = $('.cp-step[data-step="' + i + '"]');
                    if (i < currentStep) {
                        $stepItem.addClass('completed');
                    } else if (i === currentStep) {
                        $stepItem.addClass('active');
                    }
                }
                // Mark step lines as completed
                for (let i = 1; i < currentStep; i++) {
                    $('#stepLine' + i).addClass('completed');
                }
                // Update subtitle
                $('#stepSubtitle').html(stepSubtitles[currentStep] || '');
            }

            // Show specific step
            function showStep(step) {
                $('.cp-step-panel').hide();
                $('#stepPanel' + step).fadeIn(250);
                currentStep = step;
                updateStepperUI();
                updateButtons();
                
                // Update review data when reaching step 4
                if (step === 4) {
                    updateReviewData();
                }
            }

            // Update button visibility and text
            function updateButtons() {
                const $prevBtn = $('#prevBtn');
                const $nextBtn = $('#nextBtn');
                const $saveBtn = $('#saveUserBtn');

                if (currentStep === 1) {
                    $prevBtn.hide();
                    $nextBtn.show().html('Next <i class="fas fa-chevron-right"></i>');
                    $saveBtn.hide();
                } else if (currentStep === totalSteps) {
                    $prevBtn.show();
                    $nextBtn.hide();
                    $saveBtn.show();
                } else {
                    $prevBtn.show();
                    $nextBtn.show();
                    $saveBtn.hide();
                    
                    if (currentStep === 3) {
                        $nextBtn.html('Review <i class="fas fa-chevron-right"></i>');
                    } else {
                        $nextBtn.html('Next <i class="fas fa-chevron-right"></i>');
                    }
                }
            }

            // Validate current step
            function validateStep(step) {
                let isValid = true;
                $('.text-danger').text('');

                if (step === 1) {
                    // Validate role selection
                    const role = $('#roleSelect').val();
                    if (!role) {
                        $('#roleSelect').siblings('.text-danger').text('The User Role field is required.');
                        isValid = false;
                    }
                } else if (step === 2) {
                    // Validate account information
                    const email = $('#userEmail').val().trim();
                    const password = $('#userPassword').val();
                    const confirmPassword = $('#userConfirmPassword').val();

                    if (!email) {
                        $('#userEmail').siblings('.text-danger').text('The Email field is required.');
                        isValid = false;
                    } else if (!isValidEmail(email)) {
                        $('#userEmail').siblings('.text-danger').text('The Email field is not a valid e-mail address.');
                        isValid = false;
                    }

                    if (!password) {
                        $('#userPassword').siblings('.text-danger').text('The Password field is required.');
                        isValid = false;
                    }

                    if (!confirmPassword) {
                        $('#userConfirmPassword').siblings('.text-danger').text('The Confirm password field is required.');
                        isValid = false;
                    } else if (password !== confirmPassword) {
                        $('#userConfirmPassword').siblings('.text-danger').text('The password and confirmation password do not match.');
                        isValid = false;
                    }
                } else if (step === 3) {
                    // Validate personal details based on role
                    const role = $('#roleSelect').val();
                    const firstName = $('#userFirstName').val().trim();
                    const lastName = $('#userLastName').val().trim();

                    if (role && (firstName || lastName || $('#userContact').val() || $('#userDepartmentId').val())) {
                        if (!firstName) {
                            $('#userFirstName').siblings('.text-danger').text('The First Name field is required.');
                            isValid = false;
                        }
                        if (!lastName) {
                            $('#userLastName').siblings('.text-danger').text('The Last Name field is required.');
                            isValid = false;
                        }
                    }

                    // Role-specific validation
                    if (role === 'Employee') {
                        // Employee: Department required, Position required
                        if (!$('#userDepartmentId').val()) {
                            $('#userDepartmentId').siblings('.text-danger').text('The Department field is required.');
                            isValid = false;
                        }
                        if (!$('#userPositionId').val()) {
                            $('#userPositionId').siblings('.text-danger').text('The Position field is required.');
                            isValid = false;
                        }
                    } else if (role === 'DepartmentHead') {
                        // DepartmentHead: Department required, Position optional
                        if (!$('#userDepartmentId').val()) {
                            $('#userDepartmentId').siblings('.text-danger').text('The Department field is required.');
                            isValid = false;
                        }
                    } else if (role === 'ProjectManager') {
                        // ProjectManager: Department required, Position optional
                        if (!$('#userDepartmentId').val()) {
                            $('#userDepartmentId').siblings('.text-danger').text('The Department field is required.');
                            isValid = false;
                        }
                    }
                    // HumanResource and Executive: Department optional, Position optional - no validation needed
                }

                return isValid;
            }

            // Email validation helper
            function isValidEmail(email) {
                return /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email);
            }

            // Update review data
            function updateReviewData() {
                const email = $('#userEmail').val() || '-';
                const role = $('#roleSelect').val();
                const roleText = $('#roleSelect option:selected').text() || '-';
                const firstName = $('#userFirstName').val() || '';
                const middleName = $('#userMiddleName').val() || '';
                const lastName = $('#userLastName').val() || '';
                const contact = $('#userContact').val() || '-';
                const employeeNumber = $('#userEmployeeNumber').val() || '-';
                const department = $('#userDepartmentId option:selected').text() || '-';
                const position = $('#userPositionId option:selected').text() || '-';
                const dateHired = $('#userDateHired').val() || '-';

                $('#reviewEmail').text(email);
                $('#reviewRole').text(roleText);
                $('#reviewName').text((firstName + ' ' + middleName + ' ' + lastName).trim() || '-');
                $('#reviewContact').text(contact);

                // Address review
                const addr = window.getPSGCAddressText ? window.getPSGCAddressText() : {};
                const hasAddress = addr.region || addr.province || addr.city || addr.barangay || $('#userAddressLine').val();
                if (hasAddress) {
                    $('#reviewAddressInfo').show();
                    $('#reviewRegion').text(addr.region || '-');
                    $('#reviewProvince').text(addr.province || '-');
                    $('#reviewCity').text(addr.city || '-');
                    $('#reviewBarangay').text(addr.barangay || '-');
                    $('#reviewAddressLine').text($('#userAddressLine').val() || '-');
                } else {
                    $('#reviewAddressInfo').hide();
                }

                // Show employment info only if relevant
                if (role === 'Employee' || employeeNumber !== '-' || department !== '-' || position !== '-' || dateHired !== '-') {
                    $('#reviewEmploymentInfo').show();
                    $('#reviewEmployeeNumber').text(employeeNumber);
                    $('#reviewDepartment').text(department);
                    $('#reviewPosition').text(position);
                    $('#reviewDateHired').text(dateHired ? new Date(dateHired).toLocaleDateString() : '-');
                } else {
                    $('#reviewEmploymentInfo').hide();
                }

                // Profile image review
                const previewSrc = $('#profileImagePreview').attr('src');
                if (previewSrc && $('#profileImagePreview').is(':visible')) {
                    $('#reviewProfileImage').attr('src', previewSrc);
                    $('#reviewProfileImageRow').css('display', 'flex').show();
                } else {
                    $('#reviewProfileImageRow').hide();
                }
            }

            // Role selection change handler
            $('#roleSelect').change(function() {
                const selectedRole = $(this).val();
                const $roleDescription = $('#roleDescription');
                const $roleDescriptionText = $('#roleDescriptionText');
                const $personalFieldsContainer = $('#personalFieldsContainer');
                const $nameFieldsContainer = $('#nameFieldsContainer');
                const $contactFieldsContainer = $('#contactFieldsContainer');
                const $employmentFieldsContainer = $('#employmentFieldsContainer');
                const $personalDetailsTitle = $('#personalDetailsTitle');

                // Show/hide role description
                if (selectedRole && roleDescriptions[selectedRole]) {
                    $roleDescriptionText.text(roleDescriptions[selectedRole]);
                    $roleDescription.show();
                } else {
                    $roleDescription.hide();
                }

                // Show personal fields for any role
                if (selectedRole) {
                    $personalFieldsContainer.show();
                    $nameFieldsContainer.show();
                    $contactFieldsContainer.show();
                    $('#addressFieldsContainer').show();
                    $('#profileImageContainer').show();
                    $personalDetailsTitle.html(selectedRole === 'Employee' ? '<i class="fas fa-id-card"></i> Employee Information' : 
                                                  selectedRole === 'DepartmentHead' ? '<i class="fas fa-id-card"></i> Department Head Information' :
                                                  selectedRole === 'ProjectManager' ? '<i class="fas fa-id-card"></i> Project Manager Information' :
                                                  selectedRole === 'HumanResource' ? '<i class="fas fa-id-card"></i> Human Resource Information' :
                                                  selectedRole === 'Executive' ? '<i class="fas fa-id-card"></i> Executive Information' : '<i class="fas fa-id-card"></i> Personal Details');

                    // Set required fields based on role
                    $('#userFirstName').prop('required', true);
                    $('#userLastName').prop('required', true);

                    // Generate employee number for all roles
                    const year = new Date().getFullYear();
                    const random = Math.floor(Math.random() * 10000).toString().padStart(4, '0');
                    let employeeNumber = '';
                    
                    if (selectedRole === 'Employee') {
                        employeeNumber = 'EMP' + year + random;
                    } else if (selectedRole === 'DepartmentHead') {
                        employeeNumber = 'DH' + year + random;
                    } else if (selectedRole === 'ProjectManager') {
                        employeeNumber = 'PM' + year + random;
                    } else if (selectedRole === 'HumanResource') {
                        employeeNumber = 'HR' + year + random;
                    } else if (selectedRole === 'Executive') {
                        employeeNumber = 'EX' + year + random;
                    }
                    
                    $('#userEmployeeNumber').val(employeeNumber);
                    $('#employeeNumberField').show();

                    // Show employment fields based on role requirements
                    if (selectedRole === 'Employee') {
                        // Employee: Department required, Position required
                        $employmentFieldsContainer.show();
                        $('#userDepartmentId').prop('required', true);
                        $('#userPositionId').prop('required', true);
                    } else if (selectedRole === 'DepartmentHead') {
                        // DepartmentHead: Department required, Position optional
                        $employmentFieldsContainer.show();
                        $('#userDepartmentId').prop('required', true);
                        $('#userPositionId').prop('required', false);
                    } else if (selectedRole === 'ProjectManager') {
                        // ProjectManager: Department required, Position optional
                        $employmentFieldsContainer.show();
                        $('#userDepartmentId').prop('required', true);
                        $('#userPositionId').prop('required', false);
                    } else if (selectedRole === 'HumanResource') {
                        // HumanResource: Department optional, Position optional
                        $employmentFieldsContainer.show();
                        $('#userDepartmentId').prop('required', false);
                        $('#userPositionId').prop('required', false);
                    } else if (selectedRole === 'Executive') {
                        // Executive: Department optional, Position optional
                        $employmentFieldsContainer.show();
                        $('#userDepartmentId').prop('required', false);
                        $('#userPositionId').prop('required', false);
                    }
                } else {
                    $personalFieldsContainer.hide();
                    $nameFieldsContainer.hide();
                    $contactFieldsContainer.hide();
                    $('#addressFieldsContainer').hide();
                    $('#profileImageContainer').hide();
                    $employmentFieldsContainer.hide();
                    $employeeNumberField.hide();
                    $roleDescription.hide();
                }
            });

            // Profile image preview
            $('#profileImageFile').on('change', function() {
                const file = this.files[0];
                if (file) {
                    if (file.size > 2 * 1024 * 1024) {
                        alert('File size must be less than 2MB.');
                        $(this).val('');
                        return;
                    }
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        $('#profileImagePreview').attr('src', e.target.result).show();
                        $('#profileImagePlaceholder').hide();
                    };
                    reader.readAsDataURL(file);
                } else {
                    $('#profileImagePreview').hide().attr('src', '');
                    $('#profileImagePlaceholder').show();
                }
            });

            // Next button click
            $('#nextBtn').click(function() {
                if (validateStep(currentStep)) {
                    if (currentStep < totalSteps) {
                        showStep(currentStep + 1);
                    }
                }
            });

            // Previous button click
            $('#prevBtn').click(function() {
                if (currentStep > 1) {
                    showStep(currentStep - 1);
                }
            });

            // Create user button click
            $('#saveUserBtn').click(function() {
                if (!validateStep(currentStep)) {
                    return;
                }

                const form = $('#createUserForm');
                
                // Add validation attributes dynamically
                $('#userEmail').attr('data-val', 'true');
                $('#userEmail').attr('data-val-required', 'The Email field is required.');
                $('#userEmail').attr('data-val-email', 'The Email field is not a valid e-mail address.');
                
                $('#userPassword').attr('data-val', 'true');
                $('#userPassword').attr('data-val-required', 'The Password field is required.');
                
                $('#userConfirmPassword').attr('data-val', 'true');
                $('#userConfirmPassword').attr('data-val-required', 'The Confirm password field is required.');
                $('#userConfirmPassword').attr('data-val-equalto', 'The password and confirmation password do not match.');
                $('#userConfirmPassword').attr('data-val-equalto-other', 'userPassword');
                
                $('#roleSelect').attr('data-val', 'true');
                $('#roleSelect').attr('data-val-required', 'The User Role field is required.');
                
                const formData = new FormData();
                formData.append('__RequestVerificationToken', form.find('input[name="__RequestVerificationToken"]').val());
                if ($('#editingUserId').val()) formData.append('UserId', $('#editingUserId').val());
                formData.append('Email', $('#userEmail').val().trim());
                formData.append('Password', $('#userPassword').val());
                formData.append('ConfirmPassword', $('#userConfirmPassword').val());
                formData.append('Role', $('#roleSelect').val());
                formData.append('EmployeeNumber', $('#userEmployeeNumber').val());
                formData.append('FirstName', $('#userFirstName').val().trim());
                formData.append('MiddleName', $('#userMiddleName').val().trim());
                formData.append('LastName', $('#userLastName').val().trim());
                formData.append('Contact', $('#userContact').val().trim());
                if ($('#userAddressLine').val()) formData.append('AddressLine', $('#userAddressLine').val().trim());
                if (window.getPSGCAddressText) {
                    const addr = window.getPSGCAddressText();
                    if (addr.region) formData.append('Region', addr.region);
                    if (addr.province) formData.append('Province', addr.province);
                    if (addr.city) formData.append('City', addr.city);
                    if (addr.barangay) formData.append('Barangay', addr.barangay);
                }
                if ($('#userDepartmentId').val()) formData.append('DepartmentId', parseInt($('#userDepartmentId').val()));
                if ($('#userPositionId').val()) formData.append('PositionId', parseInt($('#userPositionId').val()));
                formData.append('DateHired', $('#userDateHired').val());

                // Append profile image file if selected
                const profileFile = $('#profileImageFile')[0].files[0];
                if (profileFile) {
                    formData.append('ProfileImageFile', profileFile);
                }
                
                // Disable button and show loading
                $('#saveUserBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Creating...');
                
                const isEditing = $('#editingUserId').val();
                const ajaxUrl = isEditing ? '@Url.Action("Update", "User", new { area = "SuperAdmin" })' : '@Url.Action("Create", "User", new { area = "SuperAdmin" })';

                $.ajax({
                    url: ajaxUrl,
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    timeout: 30000, // 30 second timeout
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        if (response.success) {
                            // Close modal
                            $('#createUserModal').modal('hide');
                            
                            // Show success message
                            const alertHtml = '<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                                response.message +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                                '</div>';
                            $('.container-fluid .row .col-12').prepend(alertHtml);
                            
                            // Reset form
                            form[0].reset();
                            $('.cp-step-panel').hide();
                            $('.role-description').hide();
                            $('.text-danger').text('');
                            
                            // Reload page after a short delay to show updated list
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            // Show detailed error message
                            let errorHtml = '<div class="alert alert-danger alert-dismissible fade show" role="alert" style="max-height: 400px; overflow-y: auto;">' +
                                '<strong><i class="fas fa-exclamation-circle"></i> Error Creating User:</strong><br>';
                            
                            // Show the detailed message if available
                            if (response.detailedMessage) {
                                errorHtml += '<code style="color: #721c24; background-color: #f8d7da; padding: 8px; border-radius: 4px; display: block; margin: 10px 0; white-space: pre-wrap; word-wrap: break-word;">' +
                                    response.detailedMessage +
                                    '</code>';
                            } else if (response.message) {
                                errorHtml += '<p>' + response.message + '</p>';
                            }
                            
                            // Show validation errors if present
                            if (response.errors) {
                                let hasErrors = false;
                                for (const key in response.errors) {
                                    if (response.errors[key] && response.errors[key].length > 0) {
                                        hasErrors = true;
                                        const errorMessages = response.errors[key];
                                        for (let i = 0; i < errorMessages.length; i++) {
                                            errorHtml += '<div style="margin: 5px 0;"><i class="fas fa-times-circle"></i> ' + errorMessages[i] + '</div>';
                                        }
                                        // Also add to field validation
                                        const fieldId = key.replace('CreateUserViewModel.', '').toLowerCase();
                                        const $field = $('#' + fieldId);
                                        if ($field.length) {
                                            $field.siblings('.text-danger').text(response.errors[key][0]);
                                        }
                                    }
                                }
                            }
                            
                            errorHtml += '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                                '</div>';
                            
                            // Remove any existing error alerts first
                            $('.modal-body .alert-danger').remove();
                            // Add the new error alert at the top of modal body
                            $('.modal-body').prepend(errorHtml);
                            
                            // Scroll to top of modal
                            $('.modal-body').scrollTop(0);
                        }
                    },
                    error: function(xhr, status, error) {
                        let errorMessage = 'An error occurred while creating user.';
                        let detailedInfo = '';
                        
                        // Handle timeout specifically
                        if (status === 'timeout') {
                            errorMessage = 'Request timed out. The server is taking too long to respond. Please try again.';
                            detailedInfo = 'The request exceeded the 30-second timeout limit.';
                        } else if (status === 'abort') {
                            errorMessage = 'Request was cancelled.';
                        } else if (status === 'parsererror') {
                            errorMessage = 'Invalid server response format.';
                            detailedInfo = 'The server returned an unexpected response format.';
                        }
                        
                        // Try to extract specific error message from response
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.detailedMessage) {
                                detailedInfo = xhr.responseJSON.detailedMessage;
                            } else if (xhr.responseJSON.message) {
                                errorMessage = xhr.responseJSON.message;
                            } 
                            
                            if (xhr.responseJSON.errors) {
                                // Handle validation errors
                                const errors = xhr.responseJSON.errors;
                                if (typeof errors === 'object') {
                                    for (const key in errors) {
                                        if (Array.isArray(errors[key]) && errors[key].length > 0) {
                                            errorMessage = errors[key][0];
                                            break;
                                        }
                                    }
                                }
                            }
                        } else if (xhr.responseText) {
                            try {
                                const responseText = JSON.parse(xhr.responseText);
                                if (responseText.detailedMessage) {
                                    detailedInfo = responseText.detailedMessage;
                                } else if (responseText.message) {
                                    errorMessage = responseText.message;
                                }
                            } catch (e) {
                                // If JSON parsing fails, try to extract text
                                if (xhr.statusText) {
                                    detailedInfo = xhr.responseText.substring(0, 500);
                                }
                            }
                        }
                        
                        // Add specific error context based on status code
                        let statusInfo = '';
                        if (xhr.status === 400) {
                            statusInfo = 'Validation error: The data you submitted is invalid.';
                        } else if (xhr.status === 401) {
                            statusInfo = 'Unauthorized: You do not have permission to create users.';
                        } else if (xhr.status === 403) {
                            statusInfo = 'Forbidden: Access denied while creating user.';
                        } else if (xhr.status === 409) {
                            statusInfo = 'Conflict: User with this email already exists.';
                        } else if (xhr.status === 500) {
                            statusInfo = 'Server error: An unexpected error occurred on the server.';
                        } else if (xhr.status === 0) {
                            statusInfo = 'Network error: Unable to connect to the server. Check your internet connection.';
                        }
                        
                        // Build comprehensive error display
                        let errorHtml = '<div class="alert alert-danger alert-dismissible fade show" role="alert" style="max-height: 500px; overflow-y: auto;">' +
                            '<strong><i class="fas fa-exclamation-triangle"></i> Error Creating User</strong><br>';
                        
                        if (errorMessage) {
                            errorHtml += '<div style="margin: 10px 0;"><strong>Error:</strong> <code style="background-color: #f8d7da; padding: 4px 6px; border-radius: 3px;">' + 
                                errorMessage + '</code></div>';
                        }
                        
                        if (detailedInfo) {
                            errorHtml += '<div style="margin: 10px 0;"><strong>Details:</strong><br>' +
                                '<code style="background-color: #f8d7da; padding: 8px; border-radius: 3px; display: block; white-space: pre-wrap; word-wrap: break-word; margin-top: 5px;">' +
                                detailedInfo + '</code></div>';
                        }
                        
                        if (statusInfo) {
                            errorHtml += '<div style="margin: 10px 0;"><strong>Status:</strong> ' + statusInfo + '</div>';
                        }
                        
                        if (xhr.status) {
                            errorHtml += '<div style="margin: 10px 0; font-size: 0.9em; color: #666;">' +
                                'HTTP Status: ' + xhr.status + ' ' + (xhr.statusText || 'Unknown') + '</div>';
                        }
                        
                        errorHtml += '<div style="margin-top: 10px; font-size: 0.85em; color: #666;">' +
                            '<strong>Tip:</strong> If the error persists, check the browser console (F12) or application logs for more details.' +
                            '</div>' +
                            '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                            '</div>';
                        
                        // Remove any existing error alerts first
                        $('.modal-body .alert-danger').remove();
                        $('.modal-body').prepend(errorHtml);
                        
                        // Log full error to console for debugging
                        console.error('AJAX Error Details:', {
                            status: status,
                            statusCode: xhr.status,
                            statusText: xhr.statusText,
                            responseText: xhr.responseText,
                            responseJSON: xhr.responseJSON,
                            error: error
                        });
                    },
                    complete: function() {
                        // Re-enable button
                        $('#saveUserBtn').prop('disabled', false).html('<i class="fas fa-user-plus"></i> Create User');
                    }
                });
            });
            
            // Reset form when modal is hidden
            $('#createUserModal').on('hidden.bs.modal', function () {
                $('#createUserForm')[0].reset();
                $('.cp-step-panel').hide();
                $('.role-description').hide();
                $('.text-danger').text('');
                $('.alert').remove();
                currentStep = 1;
                // Clear editing state and reset buttons
                $('#editingUserId').val('');
                $('#userAddressLine').val('');
                if (window.resetPSGCSelects) window.resetPSGCSelects();
                // Reset profile image
                $('#profileImageFile').val('');
                $('#profileImagePreview').hide().attr('src', '');
                $('#profileImagePlaceholder').show();
                $('#reviewProfileImageRow').hide();
                $('#saveUserBtn').html('<i class="fas fa-user-plus"></i> Create User').hide();
                initStepper();
            });

            // Confirm delete user function
            window.confirmDeleteUser = function(id, email) {
                $('#deleteUserId').val(id);
                $('#deleteUserEmail').text(email);
                var modal = document.getElementById('deleteUserModal');
                if (modal) { modal.style.display = 'flex'; modal.setAttribute('aria-hidden', 'false'); }
            };

            // Edit user function - populate the create modal for editing
            window.editUser = function(id, email, role, firstName, middleName, lastName, employeeNumber, departmentName, positionName) {
                // Reset form state
                $('#createUserForm')[0].reset();
                $('.text-danger').text('');
                $('.modal-body .alert-danger').remove();

                // Populate fields
                $('#editingUserId').val(id);
                $('#userEmail').val(email);
                $('#roleSelect').val(role).trigger('change');
                $('#userEmployeeNumber').val(employeeNumber);
                $('#userFirstName').val(firstName);
                $('#userMiddleName').val(middleName);
                $('#userLastName').val(lastName);

                // Try to select department and position by text if provided
                if (departmentName) {
                    $('#userDepartmentId option').filter(function() { return $(this).text() === departmentName; }).prop('selected', true);
                }
                if (positionName) {
                    $('#userPositionId option').filter(function() { return $(this).text() === positionName; }).prop('selected', true);
                }

                // We do not prefill password fields for security; leave empty to keep existing password
                $('#userPassword').val('');
                $('#userConfirmPassword').val('');

                // Show modal and go to Account step for editing
                $('#createUserModal').modal('show');
                $('#createUserModalLabel').html('<i class="fas fa-user-edit"></i> Edit User');
                showStep(2);

                // Update buttons/UI to editing mode
                $('#saveUserBtn').show().html('<i class="fas fa-save"></i> Update User');
            };
            
            // Helper to hide delete modal
            function hideDeleteUserModal() {
                var modal = document.getElementById('deleteUserModal');
                if (modal) { modal.style.display = 'none'; modal.setAttribute('aria-hidden', 'true'); }
            }

            // Cancel/backdrop close for delete modal
            $('#cancelDeleteUserBtn').click(hideDeleteUserModal);
            $(document).on('click', '#deleteUserModal', function(e) { if (e.target === this) hideDeleteUserModal(); });

            // Confirm delete user button click
            $('#confirmDeleteUserBtn').click(function() {
                var form = $('#deleteUserForm');
                var formData = {
                    __RequestVerificationToken: form.find('input[name="__RequestVerificationToken"]').val(),
                    id: $('#deleteUserId').val()
                };
                
                // Disable button and show loading
                $('#confirmDeleteUserBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Deleting...');
                
                $.ajax({
                    url: '@Url.Action("Delete", "User", new { area = "SuperAdmin" })',
                    type: 'POST',
                    data: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        if (response.success) {
                            hideDeleteUserModal();
                            
                            // Show success message
                            var alertHtml = '<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                                response.message +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                                '</div>';
                            $('.container-fluid .row .col-12').prepend(alertHtml);
                            
                            // Reset form
                            form[0].reset();
                            
                            // Reload page after a short delay to show updated list
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            // Show error message
                            var alertHtml = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                                (response.message || 'An error occurred while deleting the user.') +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                                '</div>';
                            $('.container-fluid .row .col-12').prepend(alertHtml);
                            
                            hideDeleteUserModal();
                        }
                    },
                    error: function(xhr, status, error) {
                        var alertHtml = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                            'An error occurred while deleting the user. Please try again.' +
                            '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                            '</div>';
                        $('.container-fluid .row .col-12').prepend(alertHtml);
                        
                        hideDeleteUserModal();
                    },
                    complete: function() {
                        // Re-enable button
                        $('#confirmDeleteUserBtn').prop('disabled', false).html('<i class="fas fa-trash"></i> Delete User');
                    }
                });
            });
            
            // Reset delete form when modal is hidden
            $(document).on('click', '#cancelDeleteUserBtn', function () {
                $('#deleteUserForm')[0].reset();
            });

            // Initialize stepper on load
            initStepper();

            // Allow clicking the stepper circles to jump to that step
            $(document).on('click', '.cp-step', function() {
                const step = $(this).data('step');
                if (!step) return;
                // If modal is not open, open it first
                if (!$('#createUserModal').hasClass('show')) {
                    $('#createUserModal').modal('show');
                }
                showStep(parseInt(step));
            });
        });
    </script>
}
