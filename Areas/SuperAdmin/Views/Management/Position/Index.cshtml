@model IEnumerable<project_lifecycle.Models.Position>
@{
    ViewData["Title"] = "Position Management";
    Layout = "~/Areas/SuperAdmin/Layout.cshtml";
}

<!-- ===== Page Title Hero ===== -->
<div class="sa-page-hero">
    <div class="sa-page-hero-content">
        <div class="sa-page-hero-left">
            <h1 class="sa-page-title">
                <span class="sa-page-title-icon"><i class="fas fa-briefcase"></i></span>
                Position Management
            </h1>
            <p class="sa-page-subtitle">Manage system positions</p>
        </div>
        <div class="sa-page-hero-right">
            <button type="button" class="sa-btn sa-btn-outline" data-bs-toggle="modal" data-bs-target="#createPositionModal">
                <i class="fas fa-plus"></i>
                <span>Add Position</span>
            </button>
        </div>
    </div>
</div>

<!-- ===== Alerts ===== -->
@if (TempData["Success"] != null)
{
    <div class="sa-alert sa-alert-success">
        <div class="sa-alert-icon"><i class="fas fa-check-circle"></i></div>
        <span>@TempData["Success"]</span>
        <button class="sa-alert-close" onclick="this.parentElement.remove()" aria-label="Close"><i class="fas fa-times"></i></button>
    </div>
}

<!-- ===== Filters ===== -->
<div class="sa-filters-card">
    <div class="sa-filters-row">
        <div class="sa-search-group">
            <i class="fas fa-magnifying-glass sa-search-icon"></i>
            <input id="posSearch" type="text" class="sa-search-input" placeholder="Search positions…" autocomplete="off" />
        </div>
        <div class="sa-select-group">
            <label for="pageSizeSelect" style="font-size:.82rem;color:var(--sa-muted);margin-right:.4rem;">Show</label>
            <select id="pageSizeSelect" class="sa-select" style="width:92px;">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
    </div>
</div>

<!-- ===== Table ===== -->
<div class="sa-table-section">
    <div class="sa-table-card">
        @if (Model.Any())
        {
            <div class="sa-table-responsive">
                <table class="sa-table" id="posTable">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Date Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="posBody">
                        @foreach (var item in Model)
                        {
                            <tr class="sa-row"
                                data-name="@item.Name.ToLower()"
                                data-desc="@(item.Description?.ToLower() ?? "")">
                                <td>
                                    <div class="sa-name-cell">
                                        <div class="sa-name-icon">
                                            <i class="fas fa-briefcase"></i>
                                        </div>
                                        <div>
                                            <div class="sa-name-text">@item.Name</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="sa-desc">
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        @item.Description
                                    }
                                    else
                                    {
                                        <span style="color:#94a3b8;">No description</span>
                                    }
                                </td>
                                <td class="sa-date">@item.DateCreated.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="sa-action-group">
                                        <button type="button" class="sa-action-btn sa-action-edit" title="Edit position"
                                                onclick="editPosition(@item.Id, '@Html.Raw(item.Name.Replace("'", "\\'"))', '@Html.Raw(item.Description?.Replace("'", "\\'") ?? "")')">
                                            <i class="fas fa-pen-to-square"></i>
                                        </button>
                                        <button type="button" class="sa-action-btn sa-action-delete" title="Delete position"
                                                onclick="confirmDelete(@item.Id, '@Html.Raw(item.Name.Replace("'", "\\'"))')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="noFilterResults" class="sa-empty-state" style="display:none;">
                <div class="sa-empty-icon"><i class="fas fa-magnifying-glass"></i></div>
                <div class="sa-empty-title">No matching positions</div>
                <div class="sa-empty-text">Try adjusting your search.</div>
            </div>

            <div class="sa-pagination" id="paginationContainer">
                <div class="sa-pagination-info" id="paginationInfo"></div>
                <div class="sa-pagination-controls" id="paginationControls"></div>
            </div>
        }
        else
        {
            <div class="sa-empty-state">
                <div class="sa-empty-icon"><i class="fas fa-briefcase"></i></div>
                <div class="sa-empty-title">No positions found</div>
                <div class="sa-empty-text">Create your first position to get started.</div>
            </div>
        }
    </div>
</div>

<!-- Create Position Modal -->
<div class="modal fade" id="createPositionModal" tabindex="-1" aria-labelledby="createPositionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-modern">
            <div class="modal-header modal-header-ocean">
                <h5 class="modal-title" id="createPositionModalLabel">
                    <i class="fas fa-briefcase"></i> Create New Position
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-custom">
                <form id="createPositionForm">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="positionName" class="form-label-custom">Position Name</label>
                                <input name="Name" class="form-control-custom" id="positionName" placeholder="Enter position name" />
                                <span class="text-danger" data-valmsg-for="Name"></span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="positionDescription" class="form-label-custom">Description</label>
                                <textarea name="Description" class="form-control-custom" id="positionDescription" rows="4" placeholder="Enter position description (optional)"></textarea>
                                <span class="text-danger" data-valmsg-for="Description"></span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer modal-footer-custom">
                <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="btn-save-user" id="savePositionBtn">
                    <i class="fas fa-save"></i> Create Position
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Position Modal -->
<div class="modal fade" id="editPositionModal" tabindex="-1" aria-labelledby="editPositionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-modern">
            <div class="modal-header modal-header-ocean">
                <h5 class="modal-title" id="editPositionModalLabel">
                    <i class="fas fa-edit"></i> Edit Position
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-custom">
                <form id="editPositionForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editPositionId" />
                    <input type="hidden" id="editDateCreated" />
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="editPositionName" class="form-label-custom">Position Name</label>
                                <input name="Name" class="form-control-custom" id="editPositionName" placeholder="Enter position name" />
                                <span class="text-danger" data-valmsg-for="Name"></span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="editPositionDescription" class="form-label-custom">Description</label>
                                <textarea name="Description" class="form-control-custom" id="editPositionDescription" rows="4" placeholder="Enter position description (optional)"></textarea>
                                <span class="text-danger" data-valmsg-for="Description"></span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer modal-footer-custom">
                <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="btn-save-user" id="updatePositionBtn">
                    <i class="fas fa-save"></i> Update Position
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deletePositionModal" tabindex="-1" aria-labelledby="deletePositionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-modern">
            <div class="modal-header modal-header-ocean">
                <h5 class="modal-title" id="deletePositionModalLabel">
                    <i class="fas fa-exclamation-triangle"></i> Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-custom">
                <div class="alert alert-danger-custom" role="alert">
                    <i class="fas fa-exclamation-circle"></i>
                    <strong>Warning:</strong> Are you sure you want to delete this position? This action cannot be undone.
                </div>
                <div class="mb-3">
                    <strong>Position Name:</strong> <span id="deletePositionName"></span>
                </div>
                <form id="deletePositionForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deletePositionId" />
                </form>
            </div>
            <div class="modal-footer modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="fas fa-trash"></i> Delete Position
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/superadmin-management.css" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        /* ===== Client-side filter & pagination ===== */
        (function () {
            var searchInput  = document.getElementById('posSearch');
            var pageSizeSel  = document.getElementById('pageSizeSelect');
            var tbody        = document.getElementById('posBody');
            if (!tbody) return;

            var allRows      = Array.prototype.slice.call(tbody.querySelectorAll('tr.sa-row'));
            var filtered     = allRows.slice();
            var currentPage  = 1;

            function applyFilters() {
                var q = (searchInput.value || '').toLowerCase().trim();
                filtered = allRows.filter(function (r) {
                    if (q && r.dataset.name.indexOf(q) === -1 && r.dataset.desc.indexOf(q) === -1) return false;
                    return true;
                });
                currentPage = 1;
                render();
            }

            function render() {
                var size  = parseInt(pageSizeSel.value, 10) || 10;
                var pages = Math.ceil(filtered.length / size) || 1;
                if (currentPage > pages) currentPage = pages;
                var start = (currentPage - 1) * size;
                var end   = start + size;

                allRows.forEach(function (r) { r.style.display = 'none'; });
                filtered.slice(start, end).forEach(function (r) { r.style.display = ''; });

                var noRes = document.getElementById('noFilterResults');
                if (noRes) noRes.style.display = filtered.length === 0 ? '' : 'none';

                var info = document.getElementById('paginationInfo');
                var ctrl = document.getElementById('paginationControls');
                if (info) info.textContent = 'Showing ' + (filtered.length ? start + 1 : 0) + '–' + Math.min(end, filtered.length) + ' of ' + filtered.length;
                if (ctrl) {
                    ctrl.innerHTML = '';
                    if (pages > 1) {
                        var prev = btn('‹', currentPage > 1, function () { currentPage--; render(); });
                        ctrl.appendChild(prev);
                        for (var i = 1; i <= pages; i++) (function (p) {
                            ctrl.appendChild(btn(p, true, function () { currentPage = p; render(); }, p === currentPage));
                        })(i);
                        var next = btn('›', currentPage < pages, function () { currentPage++; render(); });
                        ctrl.appendChild(next);
                    }
                }
            }

            function btn(label, enabled, cb, active) {
                var b = document.createElement('button');
                b.className = 'sa-page-btn' + (active ? ' active' : '');
                b.textContent = label;
                b.disabled = !enabled;
                if (enabled) b.addEventListener('click', cb);
                return b;
            }

            searchInput.addEventListener('input', applyFilters);
            pageSizeSel.addEventListener('change', applyFilters);
            applyFilters();
        })();
    </script>

    <script>
        $(document).ready(function() {
            // Create position
            $('#savePositionBtn').click(function() {
                var form = $('#createPositionForm');

                $('#positionName').attr('data-val', 'true');
                $('#positionName').attr('data-val-required', 'The Name field is required.');

                var formData = {
                    __RequestVerificationToken: form.find('input[name="__RequestVerificationToken"]').val(),
                    Name: $('#positionName').val().trim(),
                    Description: $('#positionDescription').val().trim()
                };

                $('.text-danger').text('');

                if (!formData.Name) {
                    $('#positionName').siblings('.text-danger').text('The Name field is required.');
                    return;
                }

                $('#savePositionBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Creating...');

                $.ajax({
                    url: '@Url.Action("Create", "Position")',
                    type: 'POST',
                    data: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function(response) {
                        if (response.success) {
                            $('#createPositionModal').modal('hide');
                            var alertHtml = '<div class="sa-alert sa-alert-success"><div class="sa-alert-icon"><i class="fas fa-check-circle"></i></div><span>' + response.message + '</span><button class="sa-alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button></div>';
                            $('.sa-page-hero').after(alertHtml);
                            form[0].reset();
                            setTimeout(function() { location.reload(); }, 1500);
                        } else {
                            if (response.errors) {
                                for (var key in response.errors) {
                                    $('#' + key.toLowerCase() + 'Error').text(response.errors[key][0]);
                                }
                            } else {
                                $('#positionName').siblings('.text-danger').text(response.message || 'An error occurred while creating the position.');
                            }
                        }
                    },
                    error: function() {
                        $('#positionName').siblings('.text-danger').text('An error occurred while creating the position. Please try again.');
                    },
                    complete: function() {
                        $('#savePositionBtn').prop('disabled', false).html('<i class="fas fa-save"></i> Create Position');
                    }
                });
            });

            // Reset create form
            $('#createPositionModal').on('hidden.bs.modal', function () {
                $('#createPositionForm')[0].reset();
                $('.text-danger').text('');
            });

            // Edit position
            window.editPosition = function(id, name, description) {
                $.ajax({
                    url: '@Url.Action("GetPositionById", "Position")',
                    type: 'GET',
                    data: { id: id },
                    success: function(position) {
                        $('#editPositionId').val(position.id);
                        $('#editPositionName').val(position.name);
                        $('#editPositionDescription').val(position.description || '');
                        $('#editDateCreated').val(position.dateCreated);
                        $('#editPositionModal').modal('show');
                    },
                    error: function() {
                        $('#editPositionId').val(id);
                        $('#editPositionName').val(name);
                        $('#editPositionDescription').val(description);
                        $('#editDateCreated').val(new Date().toISOString());
                        $('#editPositionModal').modal('show');
                    }
                });
            };

            // Update position
            $('#updatePositionBtn').click(function() {
                var form = $('#editPositionForm');

                $('#editPositionName').attr('data-val', 'true');
                $('#editPositionName').attr('data-val-required', 'The Name field is required.');

                var formData = {
                    __RequestVerificationToken: form.find('input[name="__RequestVerificationToken"]').val(),
                    Id: $('#editPositionId').val(),
                    Name: $('#editPositionName').val().trim(),
                    Description: $('#editPositionDescription').val().trim(),
                    DateCreated: $('#editDateCreated').val()
                };

                $('#editPositionModal .text-danger').text('');

                if (!formData.Name) {
                    $('#editPositionName').siblings('.text-danger').text('The Name field is required.');
                    return;
                }

                $('#updatePositionBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Updating...');

                $.ajax({
                    url: '@Url.Action("Edit", "Position")',
                    type: 'POST',
                    data: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function(response) {
                        if (response.success) {
                            $('#editPositionModal').modal('hide');
                            var alertHtml = '<div class="sa-alert sa-alert-success"><div class="sa-alert-icon"><i class="fas fa-check-circle"></i></div><span>' + response.message + '</span><button class="sa-alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button></div>';
                            $('.sa-page-hero').after(alertHtml);
                            form[0].reset();
                            setTimeout(function() { location.reload(); }, 1500);
                        } else {
                            if (response.errors) {
                                for (var key in response.errors) {
                                    $('#editPositionModal #' + key.toLowerCase() + 'Error').text(response.errors[key][0]);
                                }
                            } else {
                                $('#editPositionName').siblings('.text-danger').text(response.message || 'An error occurred while updating the position.');
                            }
                        }
                    },
                    error: function() {
                        $('#editPositionName').siblings('.text-danger').text('An error occurred while updating the position. Please try again.');
                    },
                    complete: function() {
                        $('#updatePositionBtn').prop('disabled', false).html('<i class="fas fa-save"></i> Update Position');
                    }
                });
            });

            // Reset edit form
            $('#editPositionModal').on('hidden.bs.modal', function () {
                $('#editPositionForm')[0].reset();
                $('#editPositionModal .text-danger').text('');
            });

            // Confirm delete
            window.confirmDelete = function(id, name) {
                $('#deletePositionId').val(id);
                $('#deletePositionName').text(name);
                $('#deletePositionModal').modal('show');
            };

            // Delete position
            $('#confirmDeleteBtn').click(function() {
                var form = $('#deletePositionForm');
                var formData = {
                    __RequestVerificationToken: form.find('input[name="__RequestVerificationToken"]').val(),
                    id: $('#deletePositionId').val()
                };

                $('#confirmDeleteBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Deleting...');

                $.ajax({
                    url: '@Url.Action("Delete", "Position")',
                    type: 'POST',
                    data: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function(response) {
                        if (response.success) {
                            $('#deletePositionModal').modal('hide');
                            var alertHtml = '<div class="sa-alert sa-alert-success"><div class="sa-alert-icon"><i class="fas fa-check-circle"></i></div><span>' + response.message + '</span><button class="sa-alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button></div>';
                            $('.sa-page-hero').after(alertHtml);
                            form[0].reset();
                            setTimeout(function() { location.reload(); }, 1500);
                        } else {
                            var alertHtml = '<div class="sa-alert sa-alert-error"><div class="sa-alert-icon"><i class="fas fa-exclamation-circle"></i></div><span>' + (response.message || 'An error occurred while deleting the position.') + '</span><button class="sa-alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button></div>';
                            $('.sa-page-hero').after(alertHtml);
                            $('#deletePositionModal').modal('hide');
                        }
                    },
                    error: function() {
                        var alertHtml = '<div class="sa-alert sa-alert-error"><div class="sa-alert-icon"><i class="fas fa-exclamation-circle"></i></div><span>An error occurred while deleting the position. Please try again.</span><button class="sa-alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button></div>';
                        $('.sa-page-hero').after(alertHtml);
                        $('#deletePositionModal').modal('hide');
                    },
                    complete: function() {
                        $('#confirmDeleteBtn').prop('disabled', false).html('<i class="fas fa-trash"></i> Delete Position');
                    }
                });
            });

            // Reset delete form
            $('#deletePositionModal').on('hidden.bs.modal', function () {
                $('#deletePositionForm')[0].reset();
            });
        });
    </script>
}
