@model IEnumerable<project_lifecycle.Models.Position>
@{
    ViewData["Title"] = "Position Management";
    Layout = "~/Areas/SuperAdmin/Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Position Management</h2>
                <button type="button" class="btn btn-ocean" data-bs-toggle="modal" data-bs-target="#createPositionModal">
                    <i class="fas fa-plus"></i> Add Position
                </button>
            </div>
            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Positions</h5>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.Name)</th>
                                        <th>@Html.DisplayNameFor(model => model.Description)</th>
                                        <th>@Html.DisplayNameFor(model => model.DateCreated)</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.Description))
                                                {
                                                    @Html.DisplayFor(modelItem => item.Description)
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No description</span>
                                                }
                                            </td>
                                            <td>@item.DateCreated.ToString("MMM dd, yyyy")</td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="editPosition(@item.Id, '@Html.Raw(item.Name.Replace("'", "\\'"))', '@Html.Raw(item.Description?.Replace("'", "\\'") ?? "")')">
                                                        <i class="fas fa-edit"></i> Edit
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete(@item.Id, '@Html.Raw(item.Name.Replace("'", "\\'"))')">
                                                        <i class="fas fa-trash"></i> Delete
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-briefcase fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No positions found</h5>
                            <p class="text-muted">Create your first position to get started.</p>
                            <button type="button" class="btn btn-ocean" data-bs-toggle="modal" data-bs-target="#createPositionModal">
                                <i class="fas fa-plus"></i> Add Position
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Position Modal -->
<div class="modal fade" id="createPositionModal" tabindex="-1" aria-labelledby="createPositionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createPositionModalLabel">
                    <i class="fas fa-briefcase"></i> Create New Position
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createPositionForm">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label">Position Name</label>
                                <input asp-for="Name" class="form-control" id="positionName" placeholder="Enter position name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>
                        
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">Description</label>
                                <textarea asp-for="Description" class="form-control" id="positionDescription" rows="4" placeholder="Enter position description (optional)"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="btn btn-primary" id="savePositionBtn">
                    <i class="fas fa-save"></i> Create Position
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Position Modal -->
<div class="modal fade" id="editPositionModal" tabindex="-1" aria-labelledby="editPositionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editPositionModalLabel">
                    <i class="fas fa-edit"></i> Edit Position
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editPositionForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editPositionId" />
                    <input type="hidden" id="editDateCreated" />
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label">Position Name</label>
                                <input asp-for="Name" class="form-control" id="editPositionName" placeholder="Enter position name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>
                        
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">Description</label>
                                <textarea asp-for="Description" class="form-control" id="editPositionDescription" rows="4" placeholder="Enter position description (optional)"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="btn btn-primary" id="updatePositionBtn">
                    <i class="fas fa-save"></i> Update Position
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deletePositionModal" tabindex="-1" aria-labelledby="deletePositionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="deletePositionModalLabel">
                    <i class="fas fa-exclamation-triangle"></i> Confirm Deletion
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-exclamation-circle"></i>
                    <strong>Warning:</strong> Are you sure you want to delete this position? This action cannot be undone.
                </div>
                
                <div class="mb-3">
                    <strong>Position Name:</strong> <span id="deletePositionName"></span>
                </div>
                
                <form id="deletePositionForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deletePositionId" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="fas fa-trash"></i> Delete Position
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Create position button click
            $('#savePositionBtn').click(function() {
                var form = $('#createPositionForm');
                
                // Add validation attributes dynamically
                $('#positionName').attr('data-val', 'true');
                $('#positionName').attr('data-val-required', 'The Name field is required.');
                
                var formData = {
                    __RequestVerificationToken: form.find('input[name="__RequestVerificationToken"]').val(),
                    Name: $('#positionName').val().trim(),
                    Description: $('#positionDescription').val().trim()
                };
                
                // Clear previous validation messages
                $('.text-danger').text('');
                
                // Basic client-side validation
                if (!formData.Name) {
                    $('#positionName').siblings('.text-danger').text('The Name field is required.');
                    return;
                }
                
                // Disable button and show loading
                $('#savePositionBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Creating...');
                
                $.ajax({
                    url: '@Url.Action("Create", "Position")',
                    type: 'POST',
                    data: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        if (response.success) {
                            // Close modal
                            $('#createPositionModal').modal('hide');
                            
                            // Show success message
                            var alertHtml = '<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                                response.message +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                                '</div>';
                            $('.container-fluid .row .col-12').prepend(alertHtml);
                            
                            // Reset form
                            form[0].reset();
                            
                            // Reload page after a short delay to show updated list
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            // Show error message
                            if (response.errors) {
                                for (var key in response.errors) {
                                    $('#' + key.toLowerCase() + 'Error').text(response.errors[key][0]);
                                }
                            } else {
                                $('#positionName').siblings('.text-danger').text(response.message || 'An error occurred while creating the position.');
                            }
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#positionName').siblings('.text-danger').text('An error occurred while creating the position. Please try again.');
                    },
                    complete: function() {
                        // Re-enable button
                        $('#savePositionBtn').prop('disabled', false).html('<i class="fas fa-save"></i> Create Position');
                    }
                });
            });
            
            // Reset form when modal is hidden
            $('#createPositionModal').on('hidden.bs.modal', function () {
                $('#createPositionForm')[0].reset();
                $('.text-danger').text('');
            });
            
            // Edit position function
            window.editPosition = function(id, name, description) {
                // Fetch complete position data including DateCreated
                $.ajax({
                    url: '@Url.Action("GetPositionById", "Position")',
                    type: 'GET',
                    data: { id: id },
                    success: function(position) {
                        $('#editPositionId').val(position.id);
                        $('#editPositionName').val(position.name);
                        $('#editPositionDescription').val(position.description || '');
                        $('#editDateCreated').val(position.dateCreated);
                        $('#editPositionModal').modal('show');
                    },
                    error: function() {
                        // Fallback to basic data if AJAX fails
                        $('#editPositionId').val(id);
                        $('#editPositionName').val(name);
                        $('#editPositionDescription').val(description);
                        $('#editDateCreated').val(new Date().toISOString());
                        $('#editPositionModal').modal('show');
                    }
                });
            };
            
            // Update position button click
            $('#updatePositionBtn').click(function() {
                var form = $('#editPositionForm');
                
                // Add validation attributes dynamically
                $('#editPositionName').attr('data-val', 'true');
                $('#editPositionName').attr('data-val-required', 'The Name field is required.');
                
                var formData = {
                    __RequestVerificationToken: form.find('input[name="__RequestVerificationToken"]').val(),
                    Id: $('#editPositionId').val(),
                    Name: $('#editPositionName').val().trim(),
                    Description: $('#editPositionDescription').val().trim(),
                    DateCreated: $('#editDateCreated').val()
                };
                
                // Clear previous validation messages
                $('#editPositionModal .text-danger').text('');
                
                // Basic client-side validation
                if (!formData.Name) {
                    $('#editPositionName').siblings('.text-danger').text('The Name field is required.');
                    return;
                }
                
                // Disable button and show loading
                $('#updatePositionBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Updating...');
                
                $.ajax({
                    url: '@Url.Action("Edit", "Position")',
                    type: 'POST',
                    data: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        if (response.success) {
                            // Close modal
                            $('#editPositionModal').modal('hide');
                            
                            // Show success message
                            var alertHtml = '<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                                response.message +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                                '</div>';
                            $('.container-fluid .row .col-12').prepend(alertHtml);
                            
                            // Reset form
                            form[0].reset();
                            
                            // Reload page after a short delay to show updated list
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            // Show error message
                            if (response.errors) {
                                for (var key in response.errors) {
                                    $('#editPositionModal #' + key.toLowerCase() + 'Error').text(response.errors[key][0]);
                                }
                            } else {
                                $('#editPositionName').siblings('.text-danger').text(response.message || 'An error occurred while updating the position.');
                            }
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#editPositionName').siblings('.text-danger').text('An error occurred while updating the position. Please try again.');
                    },
                    complete: function() {
                        // Re-enable button
                        $('#updatePositionBtn').prop('disabled', false).html('<i class="fas fa-save"></i> Update Position');
                    }
                });
            });
            
            // Reset edit form when modal is hidden
            $('#editPositionModal').on('hidden.bs.modal', function () {
                $('#editPositionForm')[0].reset();
                $('#editPositionModal .text-danger').text('');
            });
            
            // Confirm delete function
            window.confirmDelete = function(id, name) {
                $('#deletePositionId').val(id);
                $('#deletePositionName').text(name);
                $('#deletePositionModal').modal('show');
            };
            
            // Confirm delete button click
            $('#confirmDeleteBtn').click(function() {
                var form = $('#deletePositionForm');
                var formData = {
                    __RequestVerificationToken: form.find('input[name="__RequestVerificationToken"]').val(),
                    id: $('#deletePositionId').val()
                };
                
                // Disable button and show loading
                $('#confirmDeleteBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Deleting...');
                
                $.ajax({
                    url: '@Url.Action("Delete", "Position")',
                    type: 'POST',
                    data: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        if (response.success) {
                            // Close modal
                            $('#deletePositionModal').modal('hide');
                            
                            // Show success message
                            var alertHtml = '<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                                response.message +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                                '</div>';
                            $('.container-fluid .row .col-12').prepend(alertHtml);
                            
                            // Reset form
                            form[0].reset();
                            
                            // Reload page after a short delay to show updated list
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            // Show error message
                            var alertHtml = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                                (response.message || 'An error occurred while deleting the position.') +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                                '</div>';
                            $('.container-fluid .row .col-12').prepend(alertHtml);
                            
                            // Close modal
                            $('#deletePositionModal').modal('hide');
                        }
                    },
                    error: function(xhr, status, error) {
                        var alertHtml = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                            'An error occurred while deleting the position. Please try again.' +
                            '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                            '</div>';
                        $('.container-fluid .row .col-12').prepend(alertHtml);
                        
                        // Close modal
                        $('#deletePositionModal').modal('hide');
                    },
                    complete: function() {
                        // Re-enable button
                        $('#confirmDeleteBtn').prop('disabled', false).html('<i class="fas fa-trash"></i> Delete Position');
                    }
                });
            });
            
            // Reset delete form when modal is hidden
            $('#deletePositionModal').on('hidden.bs.modal', function () {
                $('#deletePositionForm')[0].reset();
            });
        });
    </script>
}
