@model IEnumerable<project_lifecycle.Models.Department>
@{
    ViewData["Title"] = "Department Management";
    Layout = "~/Areas/SuperAdmin/Layout.cshtml";
}

<div class="container-fluid user-management-container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center user-management-header">
                <div>
                    <h1 class="user-management-title">Department Management</h1>
                    <p class="user-management-subtitle">Manage system departments</p>
                </div>
                <button type="button" class="btn-add-user" data-bs-toggle="modal" data-bs-target="#createDepartmentModal">
                    <i class="fas fa-building"></i> Add Department
                </button>
            </div>
            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success-ocean alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle"></i>
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Existing Departments Table -->
            <div class="card users-card">
                <div class="card-header users-card-header">
                    <h5>
                        <i class="fas fa-building"></i>
                        Existing Departments
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="table-responsive users-table-wrapper">
                            <table class="table table-users mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Description</th>
                                        <th>Date Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr class="user-row">
                                            <td>
                                                <div class="user-email">
                                                    <i class="fas fa-building text-muted"></i>
                                                    <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                                                </div>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.Description))
                                                {
                                                    @Html.DisplayFor(modelItem => item.Description)
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No description</span>
                                                }
                                            </td>
                                            <td>@item.DateCreated.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <div class="btn-group-actions">
                                                    <button type="button" class="btn-icon-edit" onclick="editDepartment(@item.Id, '@Html.Raw(item.Name.Replace("'", "\\'"))', '@Html.Raw(item.Description?.Replace("'", "\\'") ?? "")')" title="Edit Department">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button type="button" class="btn-icon-delete" onclick="confirmDelete(@item.Id, '@Html.Raw(item.Name.Replace("'", "\\'"))')" title="Delete Department">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-building fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No departments found</h5>
                            <p class="text-muted">Create your first department to get started.</p>
                            <button type="button" class="btn-add-user" data-bs-toggle="modal" data-bs-target="#createDepartmentModal">
                                <i class="fas fa-plus"></i> Add Department
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Department Modal -->
<div class="modal fade" id="createDepartmentModal" tabindex="-1" aria-labelledby="createDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-modern">
            <div class="modal-header modal-header-ocean">
                <h5 class="modal-title" id="createDepartmentModalLabel">
                    <i class="fas fa-building"></i> Create New Department
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-custom">
                <form id="createDepartmentForm">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="departmentName" class="form-label-custom">Department Name</label>
                                <input name="Name" class="form-control-custom" id="departmentName" placeholder="Enter department name" />
                                <span class="text-danger" data-valmsg-for="Name"></span>
                            </div>
                        </div>
                        
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="departmentDescription" class="form-label-custom">Description</label>
                                <textarea name="Description" class="form-control-custom" id="departmentDescription" rows="4" placeholder="Enter department description (optional)"></textarea>
                                <span class="text-danger" data-valmsg-for="Description"></span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer modal-footer-custom">
                <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="btn-save-user" id="saveDepartmentBtn">
                    <i class="fas fa-save"></i> Create Department
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Department Modal -->
<div class="modal fade" id="editDepartmentModal" tabindex="-1" aria-labelledby="editDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-modern">
            <div class="modal-header modal-header-ocean">
                <h5 class="modal-title" id="editDepartmentModalLabel">
                    <i class="fas fa-edit"></i> Edit Department
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-custom">
                <form id="editDepartmentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editDepartmentId" />
                    <input type="hidden" id="editDateCreated" />
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="editDepartmentName" class="form-label-custom">Department Name</label>
                                <input name="Name" class="form-control-custom" id="editDepartmentName" placeholder="Enter department name" />
                                <span class="text-danger" data-valmsg-for="Name"></span>
                            </div>
                        </div>
                        
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="editDepartmentDescription" class="form-label-custom">Description</label>
                                <textarea name="Description" class="form-control-custom" id="editDepartmentDescription" rows="4" placeholder="Enter department description (optional)"></textarea>
                                <span class="text-danger" data-valmsg-for="Description"></span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer modal-footer-custom">
                <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="btn-save-user" id="updateDepartmentBtn">
                    <i class="fas fa-save"></i> Update Department
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteDepartmentModal" tabindex="-1" aria-labelledby="deleteDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-modern">
            <div class="modal-header modal-header-danger">
                <h5 class="modal-title" id="deleteDepartmentModalLabel">
                    <i class="fas fa-exclamation-triangle"></i> Confirm Deletion
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-body-custom">
                <div class="alert alert-danger-custom" role="alert">
                    <i class="fas fa-exclamation-circle"></i>
                    <strong>Warning:</strong> Are you sure you want to delete this department? This action cannot be undone.
                </div>
                
                <div class="mb-3">
                    <strong>Department Name:</strong> <span id="deleteDepartmentName"></span>
                </div>
                
                <form id="deleteDepartmentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteDepartmentId" />
                </form>
            </div>
            <div class="modal-footer modal-footer-custom">
                <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="btn-delete" id="confirmDeleteBtn">
                    <i class="fas fa-trash"></i> Delete Department
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        /* Ocean Blue Theme - Color Constants */
        :root {
            --ocean-primary: #0066a1;
            --ocean-light: #0099cc;
            --ocean-dark: #004d7a;
            --ocean-very-light: #e3f2fd;
            --ocean-lighter: #f0f7ff;
            --text-dark: #1a1a1a;
            --text-muted: #666666;
            --border-light: #e0e0e0;
            --success-color: #28a745;
            --danger-color: #dc3545;
            --warning-color: #ffc107;
            --shadow-sm: 0 2px 8px rgba(0, 102, 161, 0.08);
            --shadow-md: 0 4px 16px rgba(0, 102, 161, 0.12);
            --shadow-lg: 0 8px 24px rgba(0, 102, 161, 0.15);
        }

        /* Page Background */
        .container-fluid {
            background: linear-gradient(135deg, #f5f9fc 0%, #e8f4f8 100%);
            min-height: 100vh;
        }

        /* Headers */
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .user-management-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--ocean-primary);
            margin-bottom: 0.5rem;
        }

        .user-management-subtitle {
            color: var(--text-muted);
            font-size: 1rem;
            margin-bottom: 0;
        }

        .user-management-header {
            margin-bottom: 2rem;
        }

        /* Cards - Ocean Theme */
        .users-card {
            border: none;
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .users-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .users-card-header {
            background: linear-gradient(135deg, var(--ocean-primary) 0%, var(--ocean-light) 100%);
            border-bottom: none;
            padding: 20px;
            color: white;
        }

        /* Table Styling */
        .users-table-wrapper {
            overflow-x: auto;
        }

        .table-users {
            border-collapse: collapse;
        }

        .table-users thead {
            background: #f8f9fa;
            border-bottom: 2px solid var(--ocean-primary);
        }

        .table-users thead th {
            color: var(--ocean-primary);
            font-weight: 600;
            padding: 16px 12px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border: none;
        }

        .table-users tbody td {
            padding: 16px 12px;
            border-bottom: 1px solid #f0f0f0;
            vertical-align: middle;
        }

        .user-row {
            transition: background-color 0.3s ease;
        }

        .user-row:hover {
            background-color: #f8fafb;
        }

        .user-row:last-child td {
            border-bottom: none;
        }

        .user-email {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Action Buttons */
        .btn-group-actions {
            display: flex;
            gap: 8px;
            justify-content: center;
        }

        .btn-icon-edit, .btn-icon-delete {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-icon-edit {
            background-color: #e3f2fd;
            color: var(--ocean-primary);
        }

        .btn-icon-edit:hover {
            background-color: var(--ocean-primary);
            color: white;
            transform: scale(1.1);
        }

        .btn-icon-delete {
            background-color: #ffebee;
            color: var(--danger-color);
        }

        .btn-icon-delete:hover {
            background-color: var(--danger-color);
            color: white;
            transform: scale(1.1);
        }

        /* Add User Button */
        .btn-add-user {
            background: linear-gradient(135deg, var(--ocean-primary) 0%, var(--ocean-light) 100%);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: var(--shadow-md);
        }

        .btn-add-user:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
            color: white;
        }

        /* Modal Styling */
        .modal-modern {
            border: none;
            border-radius: 16px;
            box-shadow: 0 10px 40px rgba(0, 102, 161, 0.2);
            overflow: hidden;
        }

        .modal-header-ocean {
            background: linear-gradient(135deg, var(--ocean-primary) 0%, var(--ocean-light) 100%);
            border: none;
            padding: 24px;
        }

        .modal-header-danger {
            background: linear-gradient(135deg, #dc3545 0%, #e74c3c 100%);
            border: none;
            padding: 24px;
        }

        .modal-body-custom {
            padding: 28px;
            background-color: #fafbfc;
        }

        .modal-footer-custom {
            background-color: #f5f7fa;
            border-top: 1px solid var(--border-light);
            padding: 20px;
            gap: 10px;
        }

        /* Form Elements */
        .form-label-custom {
            color: var(--text-dark);
            font-weight: 600;
            font-size: 0.95rem;
            margin-bottom: 8px;
        }

        .form-control-custom, .form-select-custom {
            border: 1.5px solid var(--border-light);
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background-color: white;
        }

        .form-control-custom:focus, .form-select-custom:focus {
            border-color: var(--ocean-primary);
            box-shadow: 0 0 0 0.2rem rgba(0, 102, 161, 0.15);
            outline: none;
        }

        .form-control-custom:hover, .form-select-custom:hover {
            border-color: var(--ocean-light);
        }

        /* Alert Styling */
        .alert-success-ocean {
            background: linear-gradient(135deg, var(--ocean-very-light) 0%, #cfe9f3 100%);
            border: 1px solid #90caf9;
            border-radius: 10px;
            color: var(--ocean-dark);
            padding: 14px 16px;
        }

        .alert-success-ocean i {
            color: var(--ocean-primary);
            margin-right: 8px;
        }

        .alert-danger-custom {
            background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
            border: 1px solid #f5c2c7;
            border-radius: 10px;
            color: #842029;
            padding: 14px 16px;
        }

        /* Button Variants */
        .btn-save-user {
            background: linear-gradient(135deg, var(--success-color) 0%, #20c997 100%);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-save-user:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
        }

        .btn-save-user:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .btn-secondary-custom {
            background-color: #f0f0f0;
            color: var(--text-dark);
            border: 1px solid var(--border-light);
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-secondary-custom:hover:not(:disabled) {
            background-color: #e0e0e0;
            transform: translateY(-2px);
        }

        .btn-delete {
            background: linear-gradient(135deg, #dc3545 0%, #e74c3c 100%);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-delete:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
        }

        .btn-delete:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        /* Smooth Transitions */
        * {
            transition-property: background-color, border-color, color, box-shadow;
            transition-duration: 0.2s;
            transition-timing-function: ease-in-out;
        }
    </style>
    <script>
        $(document).ready(function() {
            $('#saveDepartmentBtn').click(function() {
                var form = $('#createDepartmentForm');
                
                // Add validation attributes dynamically
                $('#departmentName').attr('data-val', 'true');
                $('#departmentName').attr('data-val-required', 'The Name field is required.');
                
                // Parse and validate form
                var formData = {
                    __RequestVerificationToken: form.find('input[name="__RequestVerificationToken"]').val(),
                    Name: $('#departmentName').val().trim(),
                    Description: $('#departmentDescription').val().trim()
                };
                
                // Clear previous validation messages
                $('.text-danger').text('');
                
                // Basic client-side validation
                if (!formData.Name) {
                    $('#departmentName').siblings('.text-danger').text('The Name field is required.');
                    return;
                }
                
                // Disable button and show loading
                $('#saveDepartmentBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Creating...');
                
                $.ajax({
                    url: '@Url.Action("Create", "Department")',
                    type: 'POST',
                    data: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        if (response.success) {
                            // Close modal
                            $('#createDepartmentModal').modal('hide');
                            
                            // Show success message
                            var alertHtml = '<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                                response.message +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                                '</div>';
                            $('.container-fluid .row .col-12').prepend(alertHtml);
                            
                            // Reset form
                            form[0].reset();
                            
                            // Reload page after a short delay to show updated list
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            // Show error message
                            if (response.errors) {
                                for (var key in response.errors) {
                                    $('#' + key.toLowerCase() + 'Error').text(response.errors[key][0]);
                                }
                            } else {
                                $('#departmentName').siblings('.text-danger').text(response.message || 'An error occurred while creating the department.');
                            }
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#departmentName').siblings('.text-danger').text('An error occurred while creating the department. Please try again.');
                    },
                    complete: function() {
                        // Re-enable button
                        $('#saveDepartmentBtn').prop('disabled', false).html('<i class="fas fa-save"></i> Create Department');
                    }
                });
            });
            
            // Reset form when modal is hidden
            $('#createDepartmentModal').on('hidden.bs.modal', function () {
                $('#createDepartmentForm')[0].reset();
                $('.text-danger').text('');
            });
            
            // Edit department function
            window.editDepartment = function(id, name, description) {
                // Fetch complete department data including DateCreated
                $.ajax({
                    url: '@Url.Action("GetDepartmentById", "Department")',
                    type: 'GET',
                    data: { id: id },
                    success: function(department) {
                        $('#editDepartmentId').val(department.id);
                        $('#editDepartmentName').val(department.name);
                        $('#editDepartmentDescription').val(department.description || '');
                        $('#editDateCreated').val(department.dateCreated);
                        $('#editDepartmentModal').modal('show');
                    },
                    error: function() {
                        // Fallback to basic data if AJAX fails
                        $('#editDepartmentId').val(id);
                        $('#editDepartmentName').val(name);
                        $('#editDepartmentDescription').val(description);
                        $('#editDateCreated').val(new Date().toISOString());
                        $('#editDepartmentModal').modal('show');
                    }
                });
            };
            
            // Update department button click
            $('#updateDepartmentBtn').click(function() {
                var form = $('#editDepartmentForm');
                
                // Add validation attributes dynamically
                $('#editDepartmentName').attr('data-val', 'true');
                $('#editDepartmentName').attr('data-val-required', 'The Name field is required.');
                
                var formData = {
                    __RequestVerificationToken: form.find('input[name="__RequestVerificationToken"]').val(),
                    Id: $('#editDepartmentId').val(),
                    Name: $('#editDepartmentName').val().trim(),
                    Description: $('#editDepartmentDescription').val().trim(),
                    DateCreated: $('#editDateCreated').val()
                };
                
                // Clear previous validation messages
                $('#editDepartmentModal .text-danger').text('');
                
                // Basic client-side validation
                if (!formData.Name) {
                    $('#editDepartmentName').siblings('.text-danger').text('The Name field is required.');
                    return;
                }
                
                // Disable button and show loading
                $('#updateDepartmentBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Updating...');
                
                $.ajax({
                    url: '@Url.Action("Edit", "Department")',
                    type: 'POST',
                    data: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        if (response.success) {
                            // Close modal
                            $('#editDepartmentModal').modal('hide');
                            
                            // Show success message
                            var alertHtml = '<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                                response.message +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                                '</div>';
                            $('.container-fluid .row .col-12').prepend(alertHtml);
                            
                            // Reset form
                            form[0].reset();
                            
                            // Reload page after a short delay to show updated list
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            // Show error message
                            if (response.errors) {
                                for (var key in response.errors) {
                                    $('#editDepartmentModal #' + key.toLowerCase() + 'Error').text(response.errors[key][0]);
                                }
                            } else {
                                $('#editDepartmentName').siblings('.text-danger').text(response.message || 'An error occurred while updating the department.');
                            }
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#editDepartmentName').siblings('.text-danger').text('An error occurred while updating the department. Please try again.');
                    },
                    complete: function() {
                        // Re-enable button
                        $('#updateDepartmentBtn').prop('disabled', false).html('<i class="fas fa-save"></i> Update Department');
                    }
                });
            });
            
            // Reset edit form when modal is hidden
            $('#editDepartmentModal').on('hidden.bs.modal', function () {
                $('#editDepartmentForm')[0].reset();
                $('#editDepartmentModal .text-danger').text('');
            });
            
            // Confirm delete function
            window.confirmDelete = function(id, name) {
                $('#deleteDepartmentId').val(id);
                $('#deleteDepartmentName').text(name);
                $('#deleteDepartmentModal').modal('show');
            };
            
            // Confirm delete button click
            $('#confirmDeleteBtn').click(function() {
                var form = $('#deleteDepartmentForm');
                var formData = {
                    __RequestVerificationToken: form.find('input[name="__RequestVerificationToken"]').val(),
                    id: $('#deleteDepartmentId').val()
                };
                
                // Disable button and show loading
                $('#confirmDeleteBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Deleting...');
                
                $.ajax({
                    url: '@Url.Action("Delete", "Department")',
                    type: 'POST',
                    data: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        if (response.success) {
                            // Close modal
                            $('#deleteDepartmentModal').modal('hide');
                            
                            // Show success message
                            var alertHtml = '<div class="alert alert-success alert-dismissible fade show" role="alert">' +
                                response.message +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                                '</div>';
                            $('.container-fluid .row .col-12').prepend(alertHtml);
                            
                            // Reset form
                            form[0].reset();
                            
                            // Reload page after a short delay to show updated list
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            // Show error message
                            var alertHtml = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                                (response.message || 'An error occurred while deleting the department.') +
                                '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                                '</div>';
                            $('.container-fluid .row .col-12').prepend(alertHtml);
                            
                            // Close modal
                            $('#deleteDepartmentModal').modal('hide');
                        }
                    },
                    error: function(xhr, status, error) {
                        var alertHtml = '<div class="alert alert-danger alert-dismissible fade show" role="alert">' +
                            'An error occurred while deleting the department. Please try again.' +
                            '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                            '</div>';
                        $('.container-fluid .row .col-12').prepend(alertHtml);
                        
                        // Close modal
                        $('#deleteDepartmentModal').modal('hide');
                    },
                    complete: function() {
                        // Re-enable button
                        $('#confirmDeleteBtn').prop('disabled', false).html('<i class="fas fa-trash"></i> Delete Department');
                    }
                });
            });
            
            // Reset delete form when modal is hidden
            $('#deleteDepartmentModal').on('hidden.bs.modal', function () {
                $('#deleteDepartmentForm')[0].reset();
            });
        });
    </script>
}
