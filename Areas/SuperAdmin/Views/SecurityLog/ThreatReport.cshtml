@model project_lifecycle.Services.ThreatReport
@{
    ViewData["Title"] = "Security Threat Report";
    var fromDate = ViewData["FromDate"]?.ToString();
    var toDate = ViewData["ToDate"]?.ToString();
}

@section Styles {
<link rel="stylesheet" href="~/css/superadmin-auditlog.css" asp-append-version="true" />
<style>
    :root {
        --threat-critical: #ff4d4d;
        --threat-high: #ff944d;
        --threat-medium: #ffdb4d;
        --threat-low: #4dff88;
        --glass-bg: rgba(255, 255, 255, 0.95);
        --primary-gradient: linear-gradient(135deg, #006994 0%, #004a69 100%);
    }

    .report-container {
        max-width: 1300px;
        margin: 0 auto;
        animation: fadeIn 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        padding: 0 1rem;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Premium Compact Header */
    .premium-header {
        background: var(--primary-gradient);
        color: white;
        padding: 1.5rem 2rem;
        border-radius: 16px;
        margin-bottom: 1.5rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 105, 148, 0.2);
    }

    .premium-header::after {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        border-radius: 50%;
    }

    .header-content {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-info h1 {
        font-size: 1.75rem;
        font-weight: 800;
        margin-bottom: 0.25rem;
        letter-spacing: -0.5px;
    }

    .header-info p {
        font-size: 0.95rem;
        opacity: 0.9;
        margin: 0;
    }

    .header-actions {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    /* Summary Grid */
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .summary-card {
        background: var(--glass-bg);
        padding: 1.25rem 1rem;
        border-radius: 14px;
        border: 1px solid #eef2f5;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .summary-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
    }

    .summary-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
    }

    .summary-card.critical::before { background: var(--threat-critical); }
    .summary-card.high::before { background: var(--threat-high); }
    .summary-card.medium::before { background: var(--threat-medium); }
    .summary-card.low::before { background: var(--threat-low); }

    .card-icon {
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
        opacity: 0.8;
    }

    .critical .card-icon { color: var(--threat-critical); }
    .high .card-icon { color: var(--threat-high); }
    .medium .card-icon { color: var(--threat-medium); }
    .low .card-icon { color: var(--threat-low); }

    .summary-number {
        font-size: 1.75rem;
        font-weight: 800;
        color: #1a3a52;
        margin-bottom: 0.1rem;
    }

    .summary-label {
        font-size: 0.75rem;
        color: #7c97ac;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Section Styling */
    .report-section {
        background: white;
        padding: 1.5rem;
        border-radius: 16px;
        margin-bottom: 1.5rem;
        border: 1px solid #eef2f5;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
        color: #1a3a52;
    }

    .section-title i {
        background: #f0f8fc;
        color: #006994;
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 1.1rem;
    }

    .section-title h2 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 700;
    }

    /* Table Styling */
    .threat-table th {
        padding: 0.75rem 1rem;
        color: #7c97ac;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .threat-row td {
        padding: 0.75rem 1rem;
    }

    .level-badge {
        padding: 0.3rem 0.6rem;
        border-radius: 6px;
        font-size: 0.75rem;
    }

    /* Recommendations */
    .advice-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .advice-card {
        padding: 1.25rem;
        border-radius: 14px;
    }

    .advice-card h4 {
        margin-bottom: 1rem;
        font-size: 1rem;
    }

    .advice-card li {
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    /* Buttons */
    .btn-premium {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.2rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.2s;
        cursor: pointer;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .btn-pdf { background: #e53e3e; color: white; border: none; }
    .btn-pdf:hover { background: #c53030; transform: translateY(-2px); }

    .btn-back { background: rgba(255, 255, 255, 0.1); color: white; backdrop-filter: blur(5px); }
    .btn-back:hover { background: rgba(255, 255, 255, 0.2); transform: translateY(-2px); }

    @@media print {
        .header-actions { display: none; }
        .premium-header { background: white !important; color: black !important; border: 1px solid #ccc; box-shadow: none; }
    }
</style>
}

<div class="report-container">
    <div class="premium-header">
        <div class="header-content">
            <div class="header-info">
                <h1><i class="fas fa-shield-virus"></i> Intelligence</h1>
                <p>Generated: @Model.ReportGenerated.ToString("MMM dd, yyyy HH:mm")</p>
            </div>
            <div class="header-actions">
                <a href="@Url.Action("Index")" class="btn-premium btn-back">
                    <i class="fas fa-arrow-left"></i> Back to Logs
                </a>
                <button type="button" class="btn-premium btn-pdf" onclick="exportToPdf()">
                    <i class="fas fa-file-pdf"></i> Generate PDF
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(fromDate) || !string.IsNullOrEmpty(toDate))
    {
        <div style="margin-bottom: 1.5rem; padding: 0 0.5rem; color: #7c97ac; font-weight: 500; font-size: 0.85rem;">
            <i class="far fa-calendar-alt"></i> Period: 
            <span style="color: #1a3a52;">
                @(fromDate ?? "Beginning") — @(toDate ?? "Present")
            </span>
        </div>
    }

    <div class="summary-grid">
        <div class="summary-card critical">
            <div class="card-icon"><i class="fas fa-biohazard"></i></div>
            <div class="summary-number">@Model.CriticalThreats</div>
            <div class="summary-label">Critical</div>
        </div>
        <div class="summary-card high">
            <div class="card-icon"><i class="fas fa-exclamation-triangle"></i></div>
            <div class="summary-number">@Model.HighThreats</div>
            <div class="summary-label">High Risk</div>
        </div>
        <div class="summary-card medium">
            <div class="card-icon"><i class="fas fa-bolt"></i></div>
            <div class="summary-number">@Model.MediumThreats</div>
            <div class="summary-label">Medium</div>
        </div>
        <div class="summary-card low">
            <div class="card-icon"><i class="fas fa-check-shield"></i></div>
            <div class="summary-number">@Model.LowThreats</div>
            <div class="summary-label">Low Risk</div>
        </div>
        <div class="summary-card" style="background: var(--primary-gradient); color: white;">
            <div class="card-icon"><i class="fas fa-database" style="color: white;"></i></div>
            <div class="summary-number" style="color: white;">@Model.TotalSecurityEvents</div>
            <div class="summary-label" style="color: rgba(255,255,255,0.8);">Analyzed</div>
        </div>
    </div>

    <div class="report-section">
        <div class="section-title">
            <i class="fas fa-list-ul"></i>
            <h2>Top Vulnerabilities</h2>
        </div>
        
        @if (Model.TopThreats.Any())
        {
            <div class="threat-table-wrap">
                <table class="threat-table">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Count</th>
                            <th>Level</th>
                            <th>Top IP</th>
                            <th>Top User</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var threat in Model.TopThreats)
                        {
                            <tr class="threat-row">
                                <td><strong style="color: #1a3a52; font-size: 0.9rem;">@threat.EventType</strong></td>
                                <td style="font-size: 0.9rem;">@threat.Count</td>
                                <td>
                                    <span class="level-badge l@threat.ThreatLevel">
                                        Level @threat.ThreatLevel
                                    </span>
                                </td>
                                <td><code style="background: #f0f4f8; padding: 0.2rem 0.5rem; border-radius: 4px; color: #006994; font-size: 0.8rem;">@threat.TopIpAddress</code></td>
                                <td style="font-size: 0.9rem; font-weight: 600;">@threat.TopUserName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="advice-grid">
        <div class="report-section" style="margin-bottom: 0;">
            <div class="advice-card mitigation">
                <h4><i class="fas fa-lightbulb"></i> Mitigation</h4>
                @if (Model.MitigationRecommendations.Any())
                {
                    <ul>
                        @foreach (var rec in Model.MitigationRecommendations)
                        {
                            <li>@rec</li>
                        }
                    </ul>
                }
                else
                {
                    <p style="font-size: 0.85rem; color: #718096;">Continue existing protocols.</p>
                }
            </div>
        </div>

        <div class="report-section" style="margin-bottom: 0;">
            <div class="advice-card containment">
                <h4><i class="fas fa-shield-alt"></i> Containment</h4>
                @if (Model.ContainmentStrategies.Any())
                {
                    <ul>
                        @foreach (var strategy in Model.ContainmentStrategies)
                        {
                            <li>@strategy</li>
                        }
                    </ul>
                }
                else
                {
                    <p style="font-size: 0.85rem; color: #718096;">Monitor for anomalies.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function exportToPdf() {
        const btn = event.currentTarget;
        const originalContent = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
        btn.disabled = true;

        // Using print for a premium look or backend export
        // For this demo, we'll try to trigger the existing backend export if it exists
        // but since we want it to look "WOW", we can also trigger window.print() 
        // with specific print styles.
        
        const fromDate = '@fromDate';
        const toDate = '@toDate';

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '@Url.Action("ExportToPdf")';
        form.style.display = 'none';

        const fields = {
            'from': fromDate,
            'to': toDate,
            '__RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
        };

        for (const [key, value] of Object.entries(fields)) {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = key;
            input.value = value;
            form.appendChild(input);
        }

        document.body.appendChild(form);
        form.submit();

        setTimeout(() => {
            btn.innerHTML = originalContent;
            btn.disabled = false;
            document.body.removeChild(form);
        }, 3000);
    }
</script>
}
