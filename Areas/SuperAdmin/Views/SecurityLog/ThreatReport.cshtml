@model project_lifecycle.Services.ThreatReport
@{
    ViewData["Title"] = "Security Threat Report";
    var fromDate = ViewData["FromDate"]?.ToString();
    var toDate = ViewData["ToDate"]?.ToString();
}

@section Styles {
<link rel="stylesheet" href="~/css/superadmin-auditlog.css" asp-append-version="true" />
<style>
    :root {
        --threat-critical: #ff4d4d;
        --threat-high: #ff944d;
        --threat-medium: #ffdb4d;
        --threat-low: #4dff88;
        --glass-bg: rgba(255, 255, 255, 0.95);
        --primary-gradient: linear-gradient(135deg, #006994 0%, #004a69 100%);
    }

    .report-container {
        max-width: 1400px;
        margin: 0 auto;
        animation: fadeIn 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Premium Header */
    .premium-header {
        background: var(--primary-gradient);
        color: white;
        padding: 3rem 2.5rem;
        border-radius: 20px;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 105, 148, 0.2);
    }

    .premium-header::after {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        border-radius: 50%;
    }

    .header-content {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .header-info h1 {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        letter-spacing: -0.5px;
    }

    .header-info p {
        font-size: 1.1rem;
        opacity: 0.9;
        margin: 0;
    }

    .header-meta {
        text-align: right;
    }

    .timestamp-badge {
        background: rgba(255, 255, 255, 0.15);
        padding: 0.6rem 1.2rem;
        border-radius: 50px;
        font-size: 0.9rem;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    /* Summary Grid */
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
    }

    .summary-card {
        background: var(--glass-bg);
        padding: 2rem;
        border-radius: 18px;
        border: 1px solid #eef2f5;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .summary-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(0,0,0,0.08);
    }

    .summary-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
    }

    .summary-card.critical::before { background: var(--threat-critical); }
    .summary-card.high::before { background: var(--threat-high); }
    .summary-card.medium::before { background: var(--threat-medium); }
    .summary-card.low::before { background: var(--threat-low); }

    .card-icon {
        font-size: 1.5rem;
        margin-bottom: 1rem;
        opacity: 0.8;
    }

    .critical .card-icon { color: var(--threat-critical); }
    .high .card-icon { color: var(--threat-high); }
    .medium .card-icon { color: var(--threat-medium); }
    .low .card-icon { color: var(--threat-low); }

    .summary-number {
        font-size: 2.5rem;
        font-weight: 800;
        color: #1a3a52;
        margin-bottom: 0.25rem;
    }

    .summary-label {
        font-size: 0.9rem;
        color: #7c97ac;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Section Styling */
    .report-section {
        background: white;
        padding: 2.5rem;
        border-radius: 20px;
        margin-bottom: 2rem;
        border: 1px solid #eef2f5;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
        color: #1a3a52;
    }

    .section-title i {
        background: #f0f8fc;
        color: #006994;
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.25rem;
    }

    .section-title h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
    }

    /* Table Styling */
    .threat-table-wrap {
        overflow-x: auto;
    }

    .threat-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

    .threat-table th {
        padding: 1rem 1.5rem;
        color: #7c97ac;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-align: left;
    }

    .threat-row {
        background: #fcfdfe;
        transition: all 0.2s;
    }

    .threat-row:hover {
        background: #f5faff;
        transform: scale(1.005);
    }

    .threat-row td {
        padding: 1.25rem 1.5rem;
        border-top: 1px solid #eef2f5;
        border-bottom: 1px solid #eef2f5;
    }

    .threat-row td:first-child { border-left: 1px solid #eef2f5; border-radius: 12px 0 0 12px; }
    .threat-row td:last-child { border-right: 1px solid #eef2f5; border-radius: 0 12px 12px 0; }

    .level-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .level-badge.l4 { background: #fff5f5; color: #e53e3e; border: 1px solid #feb2b2; }
    .level-badge.l3 { background: #fffaf0; color: #dd6b20; border: 1px solid #fbd38d; }
    .level-badge.l2 { background: #fffff0; color: #d69e2e; border: 1px solid #faf089; }
    .level-badge.l1 { background: #f0fff4; color: #38a169; border: 1px solid #9ae6b4; }

    /* Recommendations */
    .advice-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
    }

    .advice-card {
        padding: 1.5rem;
        border-radius: 16px;
        height: 100%;
    }

    .advice-card.mitigation { background: #f0fdf4; border: 1px solid #dcfce7; }
    .advice-card.containment { background: #eff6ff; border: 1px solid #dbeafe; }

    .advice-card h4 {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a3a52;
    }

    .advice-card ul {
        margin: 0;
        padding-left: 1.25rem;
        list-style-type: none;
    }

    .advice-card li {
        position: relative;
        margin-bottom: 0.75rem;
        font-size: 0.95rem;
        line-height: 1.5;
        color: #4a5568;
    }

    .advice-card li::before {
        content: '→';
        position: absolute;
        left: -1.25rem;
        color: #006994;
        font-weight: bold;
    }

    /* Buttons */
    .action-bar {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 3rem;
        padding: 2rem 0;
        border-top: 1px solid #eef2f5;
    }

    .btn-premium {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.8rem 1.5rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.2s;
        cursor: pointer;
        text-decoration: none;
        border: none;
    }

    .btn-pdf { background: #e53e3e; color: white; }
    .btn-pdf:hover { background: #c53030; transform: translateY(-2px); }
    
    .btn-csv { background: #2f855a; color: white; }
    .btn-csv:hover { background: #276749; transform: translateY(-2px); }

    .btn-back { background: #edf2f7; color: #4a5568; }
    .btn-back:hover { background: #e2e8f0; }

    @@media print {
        .action-bar, .btn-back { display: none; }
        .premium-header { background: white !important; color: black !important; border: 1px solid #ccc; box-shadow: none; }
        .report-section { box-shadow: none; border: 1px solid #eee; }
    }
</style>
}

<div class="report-container">
    <div class="premium-header">
        <div class="header-content">
            <div class="header-info">
                <h1><i class="fas fa-shield-virus"></i> Threat Intelligence</h1>
                <p>Security Analysis & Risk Assessment Report</p>
            </div>
            <div class="header-meta">
                <div class="timestamp-badge">
                    <i class="far fa-clock"></i> Generated: @Model.ReportGenerated.ToString("MMM dd, yyyy HH:mm")
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(fromDate) || !string.IsNullOrEmpty(toDate))
    {
        <div style="margin-bottom: 2rem; padding: 0 0.5rem; color: #7c97ac; font-weight: 500;">
            <i class="far fa-calendar-alt"></i> Analysis Period: 
            <span style="color: #1a3a52;">
                @(fromDate ?? "Beginning") — @(toDate ?? "Present")
            </span>
        </div>
    }

    <div class="summary-grid">
        <div class="summary-card critical">
            <div class="card-icon"><i class="fas fa-biohazard"></i></div>
            <div class="summary-number">@Model.CriticalThreats</div>
            <div class="summary-label">Critical</div>
        </div>
        <div class="summary-card high">
            <div class="card-icon"><i class="fas fa-exclamation-triangle"></i></div>
            <div class="summary-number">@Model.HighThreats</div>
            <div class="summary-label">High Risk</div>
        </div>
        <div class="summary-card medium">
            <div class="card-icon"><i class="fas fa-bolt"></i></div>
            <div class="summary-number">@Model.MediumThreats</div>
            <div class="summary-label">Medium Risk</div>
        </div>
        <div class="summary-card low">
            <div class="card-icon"><i class="fas fa-check-shield"></i></div>
            <div class="summary-number">@Model.LowThreats</div>
            <div class="summary-label">Low Risk</div>
        </div>
        <div class="summary-card">
            <div class="card-icon"><i class="fas fa-eye"></i></div>
            <div class="summary-number">@Model.SuspiciousEvents</div>
            <div class="summary-label">Suspicious</div>
        </div>
        <div class="summary-card" style="background: var(--primary-gradient); color: white;">
            <div class="card-icon"><i class="fas fa-database" style="color: white;"></i></div>
            <div class="summary-number" style="color: white;">@Model.TotalSecurityEvents</div>
            <div class="summary-label" style="color: rgba(255,255,255,0.8);">Total Analyzed</div>
        </div>
    </div>

    <div class="report-section">
        <div class="section-title">
            <i class="fas fa-list-ul"></i>
            <h2>Top Security Vulnerabilities</h2>
        </div>
        
        @if (Model.TopThreats.Any())
        {
            <div class="threat-table-wrap">
                <table class="threat-table">
                    <thead>
                        <tr>
                            <th>Event Type</th>
                            <th>Incidents</th>
                            <th>Threat Level</th>
                            <th>Originating IP</th>
                            <th>Target Username</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var threat in Model.TopThreats)
                        {
                            <tr class="threat-row">
                                <td><strong style="color: #1a3a52;">@threat.EventType</strong></td>
                                <td>@threat.Count</td>
                                <td>
                                    <span class="level-badge l@threat.ThreatLevel">
                                        <i class="fas fa-circle" style="font-size: 0.5rem;"></i>
                                        Level @threat.ThreatLevel
                                    </span>
                                </td>
                                <td><code style="background: #f0f4f8; padding: 0.2rem 0.5rem; border-radius: 4px; color: #006994;">@threat.TopIpAddress</code></td>
                                <td><span style="font-weight: 600;">@threat.TopUserName</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 3rem; color: #7c97ac;">
                <i class="fas fa-shield-check" style="font-size: 3rem; opacity: 0.3; margin-bottom: 1rem;"></i>
                <p>No major threats detected during this period.</p>
            </div>
        }
    </div>

    <div class="advice-grid">
        <div class="report-section" style="margin-bottom: 0;">
            <div class="advice-card mitigation">
                <h4><i class="fas fa-lightbulb"></i> Mitigation Recommendations</h4>
                @if (Model.MitigationRecommendations.Any())
                {
                    <ul>
                        @foreach (var rec in Model.MitigationRecommendations)
                        {
                            <li>@rec</li>
                        }
                    </ul>
                }
                else
                {
                    <p style="font-size: 0.9rem; color: #718096;">Continue existing security protocols.</p>
                }
            </div>
        </div>

        <div class="report-section" style="margin-bottom: 0;">
            <div class="advice-card containment">
                <h4><i class="fas fa-shield-alt"></i> Containment Strategies</h4>
                @if (Model.ContainmentStrategies.Any())
                {
                    <ul>
                        @foreach (var strategy in Model.ContainmentStrategies)
                        {
                            <li>@strategy</li>
                        }
                    </ul>
                }
                else
                {
                    <p style="font-size: 0.9rem; color: #718096;">Monitor for new anomalies.</p>
                }
            </div>
        </div>
    </div>

    <div class="action-bar">
        <a href="@Url.Action("Index")" class="btn-premium btn-back">
            <i class="fas fa-arrow-left"></i> Return to Logs
        </a>
        <form method="post" asp-action="Export" style="display: inline;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="from" value="@fromDate" />
            <input type="hidden" name="to" value="@toDate" />
            <button type="submit" class="btn-premium btn-csv">
                <i class="fas fa-file-csv"></i> Export Data (CSV)
            </button>
        </form>
        <button type="button" class="btn-premium btn-pdf" onclick="exportToPdf()">
            <i class="fas fa-file-pdf"></i> Generate PDF
        </button>
    </div>
</div>

@section Scripts {
<script>
    function exportToPdf() {
        const btn = event.currentTarget;
        const originalContent = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
        btn.disabled = true;

        // Using print for a premium look or backend export
        // For this demo, we'll try to trigger the existing backend export if it exists
        // but since we want it to look "WOW", we can also trigger window.print() 
        // with specific print styles.
        
        const fromDate = '@fromDate';
        const toDate = '@toDate';

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '@Url.Action("ExportToPdf")';
        form.style.display = 'none';

        const fields = {
            'from': fromDate,
            'to': toDate,
            '__RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
        };

        for (const [key, value] of Object.entries(fields)) {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = key;
            input.value = value;
            form.appendChild(input);
        }

        document.body.appendChild(form);
        form.submit();

        setTimeout(() => {
            btn.innerHTML = originalContent;
            btn.disabled = false;
            document.body.removeChild(form);
        }, 3000);
    }
</script>
}
