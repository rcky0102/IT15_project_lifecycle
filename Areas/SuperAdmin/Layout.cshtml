@{
    Layout = null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Super Admin Dashboard</title>

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/proposal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/depthead-project.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employee-proposal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employee-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employee-project.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/superadmin-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/superadmin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/project_lifecycle.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="superadmin-body">

    <!-- Mobile overlay -->
    <div class="sa-sidebar-overlay" id="sidebarOverlay"></div>

    <div class="superadmin-layout">

        <!-- ========== SIDEBAR ========== -->
        <aside class="sa-sidebar" id="saSidebar">

            <!-- Brand -->
            <div class="sa-sidebar-header">
                <a href="@Url.Action("Index", "Dashboard", new { area = "SuperAdmin" })" class="sa-sidebar-brand">
                    <div class="sa-brand-icon">
                        <img src="~/css/Images/LOGO (final).png" asp-append-version="true" alt="Project Lifecycle Logo" class="brand-logo sa-brand-logo" />
                    </div>
                    <span class="sa-brand-text">
                        Project <br />
                        Lifecycle
                    </span>
                </a>
                <button class="sa-sidebar-toggle" id="sidebarToggle" title="Toggle Sidebar">
                    <i class="fas fa-bars fa-sm"></i>
                </button>
            </div>

            <!-- Navigation -->
            <nav class="sa-sidebar-nav">
                <span class="sa-nav-section-title">Menu</span>
                <ul class="sa-nav-list">
                    <li class="sa-nav-item">
                        <a href="@Url.Action("Index", "Dashboard", new { area = "SuperAdmin" })"
                           class="sa-nav-link @(currentController == "Dashboard" ? "active" : "")"
                           data-tooltip="Dashboard">
                            <i class="fas fa-th-large"></i>
                            <span class="sa-nav-text">Dashboard</span>
                        </a>
                    </li>
                    <li class="sa-nav-item">
                        <a href="@Url.Action("Index", "User", new { area = "SuperAdmin" })"
                           class="sa-nav-link @(currentController == "User" ? "active" : "")"
                           data-tooltip="Users">
                            <i class="fas fa-users"></i>
                            <span class="sa-nav-text">User Management</span>
                        </a>
                    </li>
                    <li class="sa-nav-item">
                        <a href="@Url.Action("Index", "Proposal", new { area = "SuperAdmin" })"
                           class="sa-nav-link @(currentController == "Proposal" ? "active" : "")"
                           data-tooltip="Proposals">
                            <i class="fas fa-file-lines"></i>
                            <span class="sa-nav-text">Proposals</span>
                        </a>
                    </li>
                    <li class="sa-nav-item">
                        <a href="@Url.Action("Index", "Project", new { area = "SuperAdmin" })"
                           class="sa-nav-link @(currentController == "Project" ? "active" : "")"
                           data-tooltip="Projects">
                            <i class="fas fa-diagram-project"></i>
                            <span class="sa-nav-text">Projects</span>
                        </a>
                    </li>
                    <li class="sa-nav-item">
                        <a href="#" class="sa-nav-link sa-collapsible-toggle @(currentController == "Department" || currentController == "Position" ? "expanded" : "")"
                           data-target="managementSubmenu"
                           data-tooltip="Management">
                            <i class="fas fa-tasks"></i>
                            <span class="sa-nav-text">Management</span>
                            <i class="fas fa-chevron-down sa-nav-arrow"></i>
                        </a>
                        <ul class="sa-nav-submenu @(currentController == "Department" || currentController == "Position" ? "expanded" : "")" id="managementSubmenu">
                            <li class="sa-nav-subitem">
                                <a href="@Url.Action("Index", "Department", new { area = "SuperAdmin" })"
                                   class="sa-nav-sublink @(currentController == "Department" ? "active" : "")">
                                    <i class="fas fa-building"></i> Departments
                                </a>
                            </li>
                            <li class="sa-nav-subitem">
                                <a href="@Url.Action("Index", "Position", new { area = "SuperAdmin" })"
                                   class="sa-nav-sublink @(currentController == "Position" ? "active" : "")">
                                    <i class="fas fa-briefcase"></i> Positions
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Audit Logs -->
                    <li class="sa-nav-item">
                        <a href="@Url.Action("Index", "AuditLog", new { area = "SuperAdmin" })"
                           class="sa-nav-link @(currentController == "AuditLog" ? "active" : "")">
                            <i class="fas fa-clipboard-list sa-nav-icon"></i>
                            <span class="sa-nav-text">Audit Logs</span>
                        </a>
                    </li>

                    <!-- Security Logs -->
                    <li class="sa-nav-item">
                        <a href="@Url.Action("Index", "SecurityLog", new { area = "SuperAdmin" })"
                           class="sa-nav-link @(currentController == "SecurityLog" ? "active" : "")">
                            <i class="fas fa-shield-alt sa-nav-icon"></i>
                            <span class="sa-nav-text">Security Logs</span>
                        </a>
                    </li>

                    <!-- Database Backup -->
                    <li class="sa-nav-item">
                        <a href="@Url.Action("Index", "Backup", new { area = "SuperAdmin" })"
                           class="sa-nav-link @(currentController == "Backup" ? "active" : "")">
                            <i class="fas fa-database sa-nav-icon"></i>
                            <span class="sa-nav-text">Backup</span>
                        </a>
                    </li>
                </ul>
            </nav>

        </aside>

        <!-- ========== MAIN ========== -->
        <div class="sa-main">

            <!-- Header -->
            <header class="sa-header" id="saHeader">
                <div class="sa-header-left">
                    <button class="sa-mobile-toggle" id="mobileSidebarToggle" aria-label="Open menu">
                        <i class="fas fa-bars"></i>
                    </button>
                    <nav class="sa-breadcrumb" aria-label="Breadcrumb">
                        <a href="@Url.Action("Index", "Dashboard", new { area = "SuperAdmin" })" class="sa-breadcrumb-home">
                            <i class="fas fa-home"></i>
                        </a>
                        <span class="sa-breadcrumb-sep"><i class="fas fa-chevron-right"></i></span>
                        <span class="sa-breadcrumb-current">@(ViewData["Title"] ?? "Dashboard")</span>
                    </nav>
                </div>

                <div class="sa-header-right">
                    <div class="notif-wrapper">
                        <button class="sa-header-btn notif-bell-btn" id="notifBellBtn" title="Notifications" aria-expanded="false">
                            <i class="fas fa-bell"></i>
                            <span class="notif-badge" id="notifBadge">0</span>
                            <span class="sa-notif-dot" id="notifDot" style="display:none"></span>
                        </button>
                        <div class="notif-dropdown" id="notifDropdown">
                            <div class="notif-dropdown-header">
                                <h6><i class="fas fa-bell"></i> Notifications</h6>
                                <button class="notif-mark-all" id="notifMarkAllRead" style="display:none">Mark all read</button>
                            </div>
                            <div class="notif-list" id="notifList"></div>
                            <div class="notif-empty" id="notifEmpty">
                                <i class="fas fa-bell-slash"></i>
                                <span>No notifications yet</span>
                            </div>
                        </div>
                    </div>

                    <div class="sa-header-divider"></div>

                    <div class="sa-header-profile" id="userDropdownToggle" style="cursor:pointer;position:relative;">
                        <div class="sa-header-avatar" id="headerUserAvatar">SA</div>
                        <div class="sa-header-user-info">
                            <div class="sa-header-greeting" id="headerGreeting">Welcome back</div>
                            <div class="sa-header-name" id="headerUserName">Super Admin</div>
                        </div>
                        <i class="fas fa-chevron-down" style="font-size:.7rem;color:#64748b;margin-left:.25rem"></i>
                        <div class="sa-user-dropdown" id="userDropdown">
                            <a href="@Url.Action("Index", "Profile", new { area = "SuperAdmin" })" class="sa-user-dropdown-item">
                                <i class="fas fa-user-circle"></i>
                                <span>My Profile</span>
                            </a>
                            <button type="button" class="sa-user-dropdown-item sa-user-dropdown-logout" id="logoutBtn">
                                <i class="fas fa-arrow-right-from-bracket"></i>
                                <span>Logout</span>
                            </button>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="sa-content">
                @RenderBody()
            </main>
        </div>

    </div>

    <!-- Hidden logout form -->
    <form action="/Identity/Account/Logout" method="post" id="logoutForm" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="/" />
    </form>

    <!-- Logout confirmation modal -->

    <style>
    .sa-modal-backdrop { position: fixed; inset: 0; background: rgba(3,7,18,0.6); display: none; align-items: center; justify-content: center; z-index: 2000; }
    .sa-modal-backdrop.active { display: flex; }
    .sa-modal { background: #fff; border-radius: 12px; width: 94%; max-width: 420px; padding: 1.25rem; box-shadow: 0 10px 30px rgba(2,6,23,0.35); }
    .sa-modal h4 { margin: 0 0 .5rem; font-size: 1.05rem; color: #0f172a; }
    .sa-modal p { margin: 0 0 1rem; color: #64748b; font-size: .92rem; }
    .sa-modal .sa-modal-actions { display:flex; gap:.5rem; justify-content:flex-end; }
    .sa-modal .sa-btn { border-radius: 8px; padding: .5rem .85rem; font-weight:600; cursor:pointer; }
    .sa-modal .sa-btn-cancel { background: transparent; border:1px solid #e6eef6; color:#475569; }
    .sa-modal .sa-btn-confirm { background: linear-gradient(90deg,#006994,#4CA3DD); color:#fff; border:none; }
    /* User dropdown */
    .sa-user-dropdown { position:absolute; top:calc(100% + 4px); right:0; background:#fff; border-radius:8px; box-shadow:0 2px 12px rgba(0,0,0,.10); min-width:150px; padding:.3rem 0; display:none; z-index:1500; }
    .sa-user-dropdown.active { display:block; }
    .sa-user-dropdown-item { display:flex; align-items:center; gap:.45rem; padding:.35rem .75rem; font-size:.8rem; color:#334155; text-decoration:none; cursor:pointer; border:none; background:transparent; width:100%; text-align:left; }
    .sa-user-dropdown-item:hover { background:#f1f5f9; color:#0f172a; }
    .sa-user-dropdown-item i { width:15px; text-align:center; font-size:.78rem; }
    .sa-user-dropdown-logout { color:#ef4444; }
    .sa-user-dropdown-logout:hover { background:#fef2f2; color:#dc2626; }
    </style>

    <div class="sa-modal-backdrop" id="logoutModal" role="dialog" aria-modal="true" aria-hidden="true">
        <div class="sa-modal" role="document">
            <h4>Sign out</h4>
            <p>Are you sure you want to sign out of your account?</p>
            <div class="sa-modal-actions">
                <button type="button" class="sa-btn sa-btn-cancel" id="cancelLogoutBtn">Cancel</button>
                <button type="button" class="sa-btn sa-btn-confirm" id="confirmLogoutBtn">Sign out</button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    <script src="~/js/header-user.js" asp-append-version="true"></script>

    <script>
    (function () {
        const sidebar  = document.getElementById('saSidebar');
        const toggle   = document.getElementById('sidebarToggle');
        const mobile   = document.getElementById('mobileSidebarToggle');
        const overlay  = document.getElementById('sidebarOverlay');
        const header   = document.getElementById('saHeader');
        const greeting = document.getElementById('headerGreeting');

        /* --- Time-based greeting --- */
        const hour = new Date().getHours();
        if (greeting) {
            greeting.textContent = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
        }

        /* --- Sidebar collapse toggle (desktop) --- */
        toggle?.addEventListener('click', function () {
            const icon = this.querySelector('i');
            const collapsed = sidebar.classList.toggle('collapsed');
            icon.className = collapsed ? 'fas fa-chevron-right fa-sm' : 'fas fa-bars fa-sm';
            this.setAttribute('title', collapsed ? 'Expand Sidebar' : 'Collapse Sidebar');
            localStorage.setItem('saSidebarCollapsed', collapsed);
        });

        /* --- Restore collapsed state --- */
        if (localStorage.getItem('saSidebarCollapsed') === 'true') {
            sidebar?.classList.add('collapsed');
            const icon = toggle?.querySelector('i');
            if (icon) {
                icon.className = 'fas fa-chevron-right fa-sm';
                toggle.setAttribute('title', 'Expand Sidebar');
            }
        }

        /* --- Mobile sidebar --- */
        function openMobile()  { sidebar?.classList.add('mobile-open');    overlay?.classList.add('active'); }
        function closeMobile() { sidebar?.classList.remove('mobile-open'); overlay?.classList.remove('active'); }

        mobile?.addEventListener('click', function () {
            sidebar?.classList.contains('mobile-open') ? closeMobile() : openMobile();
        });
        overlay?.addEventListener('click', closeMobile);

        document.addEventListener('click', function (e) {
            if (window.innerWidth <= 768 &&
                sidebar?.classList.contains('mobile-open') &&
                !sidebar.contains(e.target) &&
                !mobile?.contains(e.target)) {
                closeMobile();
            }
        });

        /* --- Sticky header shadow on scroll --- */
        window.addEventListener('scroll', function () {
            header?.classList.toggle('scrolled', window.scrollY > 8);
        }, { passive: true });

        /* --- Notifications --- */
        if (typeof initNotifications === 'function') initNotifications();

        /* --- Collapsible submenu handling --- */
        document.querySelectorAll('.sa-collapsible-toggle').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                const targetId = this.getAttribute('data-target');
                const submenu = document.getElementById(targetId);
                const isExpanded = this.classList.contains('expanded');

                if (submenu) {
                    if (isExpanded) {
                        this.classList.remove('expanded');
                        submenu.classList.remove('expanded');
                    } else {
                        this.classList.add('expanded');
                        submenu.classList.add('expanded');
                    }
                }

                // Close other submenus
                document.querySelectorAll('.sa-collapsible-toggle').forEach(function (other) {
                    if (other !== btn) {
                        const otherId = other.getAttribute('data-target');
                        const otherSub = document.getElementById(otherId);
                        if (otherSub) {
                            other.classList.remove('expanded');
                            otherSub.classList.remove('expanded');
                        }
                    }
                });
            });
        });

        /* --- User dropdown toggle --- */
        const userDropdownToggle = document.getElementById('userDropdownToggle');
        const userDropdown = document.getElementById('userDropdown');
        userDropdownToggle?.addEventListener('click', function (e) {
            e.stopPropagation();
            userDropdown?.classList.toggle('active');
        });
        document.addEventListener('click', function (e) {
            if (!userDropdownToggle?.contains(e.target)) {
                userDropdown?.classList.remove('active');
            }
        });

        /* --- Logout confirmation modal --- */
        const logoutForm = document.getElementById('logoutForm');
        const logoutBtn = document.getElementById('logoutBtn');
        const logoutModal = document.getElementById('logoutModal');
        const confirmLogoutBtn = document.getElementById('confirmLogoutBtn');
        const cancelLogoutBtn = document.getElementById('cancelLogoutBtn');

        function showLogoutModal() {
            if (!logoutModal) return;
            logoutModal.classList.add('active');
            logoutModal.setAttribute('aria-hidden', 'false');
        }
        function hideLogoutModal() {
            if (!logoutModal) return;
            logoutModal.classList.remove('active');
            logoutModal.setAttribute('aria-hidden', 'true');
        }

        logoutBtn?.addEventListener('click', function (e) {
            e.preventDefault();
            showLogoutModal();
        });

        cancelLogoutBtn?.addEventListener('click', function () { hideLogoutModal(); });

        // Close modal when clicking backdrop
        logoutModal?.addEventListener('click', function (e) {
            if (e.target === logoutModal) hideLogoutModal();
        });

        confirmLogoutBtn?.addEventListener('click', function () {
            if (logoutForm) logoutForm.submit();
        });
    })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
